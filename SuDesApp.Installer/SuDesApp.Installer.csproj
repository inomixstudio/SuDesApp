<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SuDesAppSetup</AssemblyName>
    <RootNamespace>SuDesApp.Installer</RootNamespace>
    <AssemblyVersion>2.12.0.0</AssemblyVersion>
    <FileVersion>2.12.0.0</FileVersion>
    <Version>2.12.0</Version>
    <Product>SuDesApp</Product>
    <Company>Sumberjaya Dev.</Company>
    <ApplicationIcon>..\\Resources\\AppIcon.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS0108;CS0618;CS0168;CS8765</WarningsNotAsErrors>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Payload aplikasi (zip hasil publish) ditanam sebagai resource bila ada.
       Tools/Buat-Installer-Wpf.ps1 menyalin artifacts/payload-2.12.0.zip ke sini
       sebelum build; tanpa zip, instalasi memakai folder Payload/ di samping exe. -->
  <ItemGroup>
    <EmbeddedResource Include="Payload.zip" Condition="Exists('Payload.zip')" LogicalName="Payload.zip" />
    <Resource Include="..\\Resources\\AppIcon-256.png" Link="Resources\\AppIcon-256.png" />
    <Resource Include="..\\SuDesApp.Wpf\\Fonts\\GoogleSans.ttc" Link="Fonts\\GoogleSans.ttc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\\SuDesApp.Core\\SuDesApp.Core.csproj" />
  </ItemGroup>

</Project>
