@* Aplikasi Android hanya memuat menu pembuatan surat: beranda
   (sambungan + menu surat), formulir, dan register. Tidak ada login atau
   halaman modul desktop. *@
<Router AppAssembly="typeof(MauiProgram).Assembly"
        NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(LayoutUtama)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
