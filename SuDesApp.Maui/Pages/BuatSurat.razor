@page "/buat-surat"

<PageTitle>Buat Surat Baru</PageTitle>

@if (_terpilih == null)
{
    <button class="tautan-kembali" type="button" @onclick="KeBeranda">&#8592; Beranda</button>
    <h1 class="judul-halaman">Buat Surat Baru</h1>
    <p class="keterangan-halaman">Pilih jenis surat. Isian yang bertanda * wajib diisi.</p>

    @foreach (var kelompok in Kelompok)
    {
        <h2 class="judul-kelompok">@kelompok.Key</h2>
        <div class="daftar-kartu">
            @foreach (var surat in kelompok)
            {
                <button class="kartu-jenis" type="button" @onclick="() => Pilih(surat)">
                    <span class="kartu-judul">@surat.Nama</span>
                    <span class="kartu-ket">@surat.Ringkasan</span>
                    <span class="kartu-tanda">@surat.LabelNomor</span>
                </button>
            }
        </div>
    }
}
else
{
    <button class="tautan-kembali" type="button" @onclick="Tutup">&#8592; Daftar surat</button>
    <h1 class="judul-halaman">@_terpilih.Nama</h1>
    <p class="keterangan-halaman">@_terpilih.Ringkasan</p>

    <div class="kartu-formulir">
        <dl class="ringkas">
            <dt>Judul cetak</dt>
            <dd>@_terpilih.Judul</dd>
            <dt>Nomor</dt>
            <dd>@Layanan.NomorBerikutnya(_terpilih, DateTime.Today)</dd>
        </dl>

        <FormIsian Surat="_terpilih" Nilai="_nilai" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_galat))
    {
        <p class="galat">@_galat</p>
    }

    @if (!string.IsNullOrWhiteSpace(_pesan))
    {
        <p class="berhasil">@_pesan</p>
    }

    <div class="aksi">
        <button class="tombol-utama" type="button" disabled="@_sibuk" @onclick="Cetak">
            @(_sibuk ? "Menyiapkan…" : "Buat PDF & Cetak")
        </button>
    </div>
}

@code {
    private void KeBeranda() => Navigasi.NavigateTo("/");

    private DefinisiSurat? _terpilih;
    private Dictionary<string, string> _nilai = new();
    private string? _galat;
    private string? _pesan;
    private bool _sibuk;

    private IEnumerable<IGrouping<string, DefinisiSurat>> Kelompok =>
        Layanan.SuratBaru.GroupBy(s => string.IsNullOrWhiteSpace(s.Kategori) ? "Surat" : s.Kategori);

    protected override void OnParametersSet()
    {
        // Submenu "Buat Surat Baru" di beranda membuka jenis tertentu lewat ?kode=.
        var alamat = new Uri(Navigasi.Uri);
        string? kode = alamat.Query
            .TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(bagian => bagian.Split('=', 2))
            .Where(pasangan => pasangan.Length == 2 && pasangan[0] == "kode")
            .Select(pasangan => Uri.UnescapeDataString(pasangan[1]))
            .FirstOrDefault();

        if (string.IsNullOrWhiteSpace(kode) || _terpilih != null) return;

        var surat = KatalogSurat.Cari(kode);
        if (surat?.Kelompok == KelompokMenu.SuratBaru) Pilih(surat);
    }

    private void Pilih(DefinisiSurat surat)
    {
        _terpilih = surat;
        _nilai = surat.Kolom.ToDictionary(k => k.Kunci, k => k.Bawaan ?? string.Empty);
        _galat = null;
        _pesan = null;
    }

    private void Tutup()
    {
        _terpilih = null;
        _nilai = new();
        _galat = null;
        _pesan = null;
    }

    private async Task Cetak()
    {
        if (_terpilih == null) return;

        _sibuk = true;
        _galat = null;
        _pesan = null;

        try
        {
            var hasil = Layanan.Buat(_terpilih, _nilai, DateTime.Today);
            await PencetakAndroid.CetakAsync(FormatSurat.NamaBerkas(hasil.Surat.Nomor), hasil.Pdf);
            _pesan = $"Surat {hasil.Surat.Nomor} dibuat. Pilih pencetak pada layar cetak Android.";
            _terpilih = null;
        }
        catch (Exception ex)
        {
            _galat = ex.Message;
        }
        finally
        {
            _sibuk = false;
        }
    }
}
