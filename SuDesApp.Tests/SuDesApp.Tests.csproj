<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8625;CS8629;CS0108;CS0618;CS0168</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuDesApp.Core\SuDesApp.Core.csproj" />
    <ProjectReference Include="..\SuDesApp.Server\SuDesApp.Server.csproj" />
    <ProjectReference Include="..\SuDesApp.Wpf\SuDesApp.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Salinan skema untuk Supabase CLI ditanam supaya ujinya bisa
         membandingkan isinya dengan schema.sql yang dijalankan server tanpa
         bergantung pada lokasi berkas saat test dijalankan. -->
    <EmbeddedResource Include="..\supabase\migrations\20261022000000_skema_lisensi.sql">
      <Link>migrations\20261022000000_skema_lisensi.sql</Link>
    </EmbeddedResource>
  </ItemGroup>
</Project>
