<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Surat yang dibuat di sini dijadikan PDF dan disimpan ke Downloads. Kiriman
      ke antrean Supabase hanya memuat isian surat (nomor, NIK, dan kolom
      formulir) supaya register desktop bisa melanjutkan penomoran resmi —
      jadi izin jaringan tetap diperlukan.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Pindai QR pairing dari halaman Sinkron Android di desktop. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SuDesAndroid">

        <!--
          Aplikasi dibuka lewat pemasangan perangkat: operator menghubungkan
          perangkat ke desktop (pindai QR atau ketik manual) lebih dulu, dan
          menu utama hanya muncul setelah tersambung.
        -->
        <activity
            android:screenOrientation="portrait"
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:screenOrientation="portrait"
            android:name=".BuatSuratActivity"
            android:exported="false"
            android:label="@string/menu_buat_surat"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:screenOrientation="portrait"
            android:name=".RegisterSuratActivity"
            android:exported="false"
            android:label="@string/menu_register_surat" />

        <activity
            android:screenOrientation="portrait"
            android:name=".DaftarHadirActivity"
            android:exported="false"
            android:label="@string/menu_daftar_hadir"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:screenOrientation="portrait"
            android:name=".PengaturanActivity"
            android:exported="false"
            android:label="@string/menu_pengaturan" />

        <!-- Pemindai QR milik pustaka zxing: paksa portrait supaya kamera tidak
             memutar layar ke landscape. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="screenOrientation" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.berkas"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/berkas_file_paths" />
        </provider>
    </application>

</manifest>
