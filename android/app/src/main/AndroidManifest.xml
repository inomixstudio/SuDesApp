<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Aplikasi ini tidak mengirim data ke mana pun, jadi izin jaringan dan
      kamera tidak diperlukan. Izin tulis hanya untuk menyimpan PDF ke
      Downloads pada Android 10 ke bawah; Android 11+ memakai MediaStore yang
      tidak butuh izin.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SuDesAndroid">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BuatSuratActivity"
            android:exported="false"
            android:label="@string/menu_buat_surat" />

        <activity
            android:name=".RegisterSuratActivity"
            android:exported="false"
            android:label="@string/menu_register_surat" />

        <activity
            android:name=".DaftarHadirActivity"
            android:exported="false"
            android:label="@string/menu_daftar_hadir" />

        <activity
            android:name=".PengaturanActivity"
            android:exported="false"
            android:label="@string/menu_pengaturan" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.berkas"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/berkas_file_paths" />
        </provider>
    </application>

</manifest>
