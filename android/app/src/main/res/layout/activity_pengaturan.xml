<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/kepala"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_pengaturan"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ket_pengaturan_header"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/konten"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/KartuStatis"
                app:cardBackgroundColor="@color/accent_muda"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info"
                        app:tint="@color/accent_dark" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/pengaturan_sumber"
                        android:textColor="@color/accent_dark"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/JudulGrup"
                android:text="@string/grup_kop_surat" />

            <com.google.android.material.card.MaterialCardView style="@style/KartuStatis">

                <LinearLayout
                    android:id="@+id/wadah_pengaturan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp" />
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btn_sinkronkan"
                style="@style/TombolUtama"
                android:layout_marginTop="18dp"
                android:text="@string/pengaturan_sinkronkan"
                app:icon="@drawable/ic_sinkron"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/on_accent" />

            <TextView
                android:id="@+id/status_pengaturan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/pengaturan_sinkron_awal"
                android:textColor="@color/teks_redup"
                android:textSize="12sp" />

            <TextView
                style="@style/JudulGrup"
                android:text="@string/grup_sinkronisasi" />

            <com.google.android.material.card.MaterialCardView style="@style/KartuStatis">

                <LinearLayout
                    android:id="@+id/wadah_sinkron"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp" />
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btn_kirim_tertunda"
                style="@style/TombolSekunder"
                android:layout_marginTop="12dp"
                android:text="@string/btn_kirim_tertunda"
                app:icon="@drawable/ic_sinkron"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <Button
                android:id="@+id/btn_keluar_perangkat"
                style="@style/TombolKecil"
                android:layout_marginTop="4dp"
                android:text="@string/btn_keluar_perangkat" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
