<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gulir"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/kepala"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="30dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <FrameLayout
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:background="@drawable/bg_lingkaran_putih">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/pindai_qr"
                    android:src="@drawable/ic_qr"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/label_pasang_perangkat"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/petunjuk_pasang"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/konten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/KartuStatis"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/status_pasang_awal"
                        android:textColor="@color/teks_redup"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_pindai"
                        style="@style/TombolUtama"
                        android:layout_marginTop="22dp"
                        android:text="@string/pindai_qr"
                        app:icon="@drawable/ic_qr"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/on_accent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Jalur kedua: kode 4 angka, untuk kamera yang tidak bisa dipakai.
                 Pindai QR tetap cara utama (kamera terbuka sendiri). -->
            <com.google.android.material.card.MaterialCardView
                style="@style/KartuStatis"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/kode_manual_judul"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/kode_manual_petunjuk"
                        android:textColor="@color/teks_redup"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/kode_manual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:autofillHints=""
                        android:gravity="center"
                        android:hint="@string/kode_manual_hint"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:letterSpacing="0.4"
                        android:maxLength="4"
                        android:textColorHint="@color/teks_redup"
                        android:textSize="28sp" />

                    <Button
                        android:id="@+id/btn_kode"
                        style="@style/TombolUtama"
                        android:layout_marginTop="16dp"
                        android:text="@string/hubungkan_kode" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/catatan_privasi"
                android:textColor="@color/teks_redup"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
