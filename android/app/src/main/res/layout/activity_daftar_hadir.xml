<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/kepala"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_daftar_hadir"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ket_daftar_hadir_form"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/konten"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/JudulGrup"
                android:text="@string/grup_judul_surat" />

            <com.google.android.material.card.MaterialCardView style="@style/KartuStatis">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/BidangIsian"
                        android:hint="@string/dh_judul_harian">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_judul"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textCapSentences|textMultiLine"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/BidangIsian"
                        android:layout_marginTop="12dp"
                        android:hint="@string/hint_hari_tanggal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_hari_tanggal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/BidangIsian"
                        android:layout_marginTop="12dp"
                        android:hint="@string/hint_pukul">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_pukul"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/BidangIsian"
                        android:layout_marginTop="12dp"
                        android:hint="@string/hint_tempat">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_tempat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btn_hari_ini"
                        style="@style/TombolKecil"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:text="@string/dh_hari_ini" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/JudulGrup"
                android:text="@string/grup_kolom_dicetak" />

            <com.google.android.material.card.MaterialCardView style="@style/KartuStatis">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_no"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:enabled="false"
                        android:text="No. (wajib)" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_nama"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:enabled="false"
                        android:text="Nama (wajib)" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_jk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Jenis Kelamin (L/P)" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_jabatan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Jabatan" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_ttd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:enabled="false"
                        android:text="Tanda Tangan (wajib)" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_nip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="NIP" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_nik"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="NIK" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_nohp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No. Handphone" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_alamat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Alamat" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_ket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Keterangan" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_kop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:checked="true"
                        android:text="Tampilkan Kop Surat" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_footer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Tampilkan Tanda Tangan Kepala Desa" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/JudulGrup"
                android:text="@string/grup_peserta" />

            <com.google.android.material.card.MaterialCardView style="@style/KartuStatis">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/info_peserta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/teks_redup" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_tambah"
                            style="@style/TombolKecil"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/dh_tambah" />

                        <Button
                            android:id="@+id/btn_hapus"
                            style="@style/TombolKecil"
                            android:layout_width="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/dh_hapus" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/wadah_peserta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_cetak"
                style="@style/TombolUtama"
                android:layout_marginTop="18dp"
                android:text="@string/cetak_pdf"
                app:icon="@drawable/ic_surat"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/on_accent" />

            <Button
                android:id="@+id/btn_bersihkan"
                style="@style/TombolKecil"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="@string/dh_bersihkan" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
