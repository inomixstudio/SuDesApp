<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SuDesApp.Wpf</RootNamespace>
    <AssemblyName>SuDesApp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <AssemblyVersion>2.5.4.0</AssemblyVersion>
    <FileVersion>2.5.4.0</FileVersion>
    <!-- Identitas aplikasi: tampil di halaman Tentang (detail aplikasi) -->
    <Product>SuDesApp</Product>
    <Company>Sumberjaya Dev.</Company>
    <Copyright>Copyright © INOMIX Studio</Copyright>
    <!-- Ikon aplikasi: file .ico multi-ukuran hasil Tools\generate-app-icon.ps1
         (vector art WPF: tile emerald + amplop + segel lilin "SD"). -->
    <ApplicationIcon>..\Resources\AppIcon.ico</ApplicationIcon>
    <!-- TreatWarningsAsErrors untuk mencegah kode mati; nullability + legacy warnings tetap warning -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8625;CS8629;CS0108;CS0618;CS0168;CS8765</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms (referensi framework saja, bukan UseWindowsForms) dibutuhkan khusus
         untuk dialog cetak Windows standar (System.Windows.Forms.PrintDialog) + 
         PdfiumViewer CreatePrintDocument — padanan alur cetak aplikasi lama. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageReference Include="PdfiumViewer.Updated" Version="2.14.5" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuDesApp.Core\SuDesApp.Core.csproj" />
  </ItemGroup>

  <!-- File runtime yang di-share dengan proyek WinForms (data query, konfigurasi, template, aset). -->
  <ItemGroup>
    <None Include="..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\desa.db.sql" Link="desa.db.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SuDesApp.Core\Data\Queries\SuratQueries.sql" Link="Data\Queries\SuratQueries.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SuDesApp.Core\Configuration\JenisSuratConfig.json" Link="Configuration\JenisSuratConfig.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Resources\logo.png" Link="Resources\logo.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ikon aplikasi + versi PNG besar (dibundel sebagai resource WPF). -->
    <Resource Include="..\Resources\AppIcon.ico" Link="Resources\AppIcon.ico" />
    <Resource Include="..\Resources\AppIcon-256.png" Link="Resources\AppIcon-256.png" />
    <!-- (Ikon "surat terbuka" lama sudah tidak dipakai — diganti AppIcon-256.png di
         header sidebar & login agar identitas visual konsisten dengan ikon aplikasi.) -->
    <!-- Kunci service account Google (Resources/sudesapp.json) SENGAJA tidak lagi
         disalin ke folder keluaran: sumber pembaruan memakai updateCheckUrl HTTPS
         publik. Jangan tambahkan kembali baris CopyToOutput untuk berkas kunci. -->
    <None Include="..\Resources\Fonts\**" Link="Resources\Fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Templates\**" Link="Templates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Skrip otomatisasi (PowerShell/Python) untuk ScriptAutomationService -->
  </ItemGroup>
  <ItemGroup>
    <None Remove="..\Templates\F-1.02.pdf" />
    <None Remove="..\Templates\F-1.03.pdf" />
    <None Remove="..\Templates\F-1.05.pdf" />
    <None Remove="..\Templates\F-1.06.pdf" />
    <None Remove="..\Templates\F-2.01.pdf" />
  </ItemGroup>

  <!--
    CATATAN MIGRASI:
    HandyControl (https://github.com/HandyOrg/HandyControl) opsional untuk UI modern:
    <PackageReference Include="HandyControl" Version="3.6.0" />

    CommunityToolkit.Mvvm opsional untuk Source Generator MVVM:
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    Pratinjau PDF memakai PDFium (PdfiumViewer.Updated + native), bukan WebView2.
    PdfiumViewer.Updated = 2.14.5, native x64 v8-xfa = 2018.4.8.256
  -->

</Project>
