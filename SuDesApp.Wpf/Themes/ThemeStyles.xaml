<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ctrl="clr-namespace:SuDesApp.Wpf.Controls"
                    xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities"
                    xmlns:conv="clr-namespace:SuDesApp.Wpf.Converters">

    <!--
        Shared control styles & helper brushes (theme-agnostic).
        All color values use DynamicResource so they update automatically
        when ThemeService swaps the active theme ResourceDictionary.

        Input controls (TextBox/PasswordBox/ComboBox/ListBox) use themed templates
        so they always follow the active theme (including Dark/Slate).
    -->

    <ResourceDictionary.MergedDictionaries>
        <!-- Palet tetap dimuat DI DALAM kamus ini supaya gaya bisa dipakai
             berdiri sendiri (uji render, alat pratinjau) tanpa bergantung pada
             urutan kamus induk. StaticResource di bawah (PutihColor,
             BayanganHitamColor) diselesaikan saat kamus ini dimuat — kalau
             palet hanya ada sebagai kamus saudara di App.xaml, pemuatan di
             luar aplikasi gagal dengan "Cannot find resource". -->
        <ResourceDictionary Source="PaletTetap.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ========== Shared UI tokens ========== -->
    <conv:NotNullConverter x:Key="IndukTombolAda"/>
    <!-- Membatasi aturan warna teks tombol agar berhenti di batas ToolTip. -->
    <conv:TeksMilikTombolConverter x:Key="TeksMilikTombol"/>
    <!-- Untuk ListViewItem: tahu apakah ListView sedang memakai View (GridView),
         supaya template baris bisa memilih penyaji kolom atau penyaji isi biasa. -->
    <conv:NotNullConverter x:Key="TampilanAda"/>
    <SolidColorBrush x:Key="ToggleHoverBrush" Color="{StaticResource PutihColor}" Opacity="0.2"/>
    <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
    <Thickness x:Key="CardPadding">16</Thickness>

    <!-- ========== Ukuran baku kontrol isian & tombol ==========
         Satu angka untuk ketiganya: kolom isian (TextBox), pilihan (ComboBox),
         dan tombol sebelumnya berbeda tinggi karena tombol punya MinHeight 32
         sementara kolom isian hanya setinggi isinya (± 28) — deretan kolom isian
         dan tombol jadi bergerigi. Semuanya dipatok ke satu tinggi yang sama, dan
         tampilan tidak lagi perlu menulis Height sendiri: nilai lokal akan menimpa
         nilai baku ini, jadi justru itu sumber ketidakseragaman yang lama.

         Ukuran baku 13 menjaga keterbacaan sekaligus memberi ruang lebih lega
         pada formulir dan daftar. Teks keterangan kecil (9–12) tetap menjadi
         tingkat sekunder agar hierarki informasi mudah dibaca. -->
    <sys:Double x:Key="TinggiKontrol">34</sys:Double>
    <sys:Double x:Key="UkuranTeksKontrol">12</sys:Double>
    <!-- Ukuran teks menu ringkas: MenuItem, TabItem, dan ikon menu di dalam baris
         nav. Label navigasi sidebar memakai UkuranTeksNavigasi di bawah. -->
    <sys:Double x:Key="UkuranTeksMenu">12</sys:Double>
    <!-- Satu ukuran untuk SEMUA label navigasi: label seksi, judul akordeon,
         item menu, dan anak akordeon. Dulu label seksi 11, judul akordeon 14,
         dan judul item 12 (gaya implisit TextBlock menimpa FontSize tombol),
         sehingga daftar menu tampak tidak rata. -->
    <sys:Double x:Key="UkuranTeksNavigasi">13</sys:Double>
    <!-- Ukuran glyph ikon navigasi (ikon item, ikon akordeon, ikon mode ciut). -->
    <sys:Double x:Key="UkuranIkonNavigasi">15</sys:Double>
    <!-- Ukuran ikon penanda kecil di baris menu: chevron, gembok, centang tema. -->
    <sys:Double x:Key="UkuranIkonPenanda">11</sys:Double>
    <!-- Ukuran teks tooltip. Dipakai dua tempat: gaya ToolTip dan gaya teks di
         dalam templatnya — keduanya harus memakai token ini agar tetap sama. -->
    <sys:Double x:Key="UkuranTeksTooltip">13</sys:Double>

    <!-- Bayangan lembut dipakai lapisan mengambang (dropdown, toast, popup)
         supaya terasa terangkat di atas konten tanpa aturan bayangan per view. -->
    <DropShadowEffect x:Key="BayanganLembut" BlurRadius="14" ShadowDepth="3"
                      Opacity="0.22" Direction="270" Color="{StaticResource BayanganHitamColor}"/>

    <!-- Bayangan lebih dalam untuk kartu melayang besar (jendela login) supaya
         terpisah jelas dari latar tanpa aturan bayangan per view. -->
    <!-- Bayangan kartu jendela (login) — parameter disamakan persis dengan
         kartu SplashStartupWindow agar tampilan konsisten dari splash ke login. -->
    <DropShadowEffect x:Key="BayanganTebal" BlurRadius="26" ShadowDepth="3"
                      Opacity="0.38" Direction="270" Color="{StaticResource BayanganHitamColor}"/>

    <!-- Semua jendela dan teks biasa harus mengikuti tema aktif. Tanpa style
         implisit ini WPF dapat mewariskan warna teks default Windows (hitam),
         terutama pada tema gelap dan dialog yang dibuat terpisah. -->
    <Style TargetType="Window">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <!-- Ukuran teks dasar standar untuk seluruh konten jendela. -->
        <Setter Property="FontSize" Value="{StaticResource UkuranTeksKontrol}"/>
    </Style>

    <!-- Warna teks bawaan mengikuti tema, TETAPI bila TextBlock berada di
         dalam sebuah Button, warnanya mengikuti Foreground tombol. Tanpa ini
         teks di dalam tombol berwarna (mis. tombol hijau tema hijau) tetap
         memakai TextBrush (gelap) sehingga tampak hitam di atas hijau. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Style.Triggers>
            <!-- Isi ToolTip juga berada di pohon logis tombol pemiliknya, jadi tanpa
                 batas, aturan ini ikut mewarnai teks tooltip dengan Foreground tombol
                 (putih di atas permukaan putih pada tema terang). TeksMilikTombol
                 menghentikan penelusuran di ToolTip pertama: teks tooltip selalu
                 memakai warna tema, teks isi tombol tetap memakai warna tombol. -->
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource TeksMilikTombol}">
                        <Binding RelativeSource="{RelativeSource AncestorType=Button}"/>
                        <Binding RelativeSource="{RelativeSource Self}"/>
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Foreground"
                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ========== Default Button ========== -->
    <!-- Background = SecondaryBrush: di semua tema secondary adalah shade lebih
         tua dari primary (memang tidak dipakai view lain), dan di tema Dark
         secondary sengaja pink gelap agar tombol berwarna pink. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryTextBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource UkuranTeksKontrol}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="{StaticResource TinggiKontrol}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Tombol sekunder & garis: keduanya perlu latar berubah saat hover —
         template bawaan hanya menurunkan Opacity, sehingga latar Transparan
         tidak pernah bereaksi. Isian PanelBrush + garis aksen membuat hover
         terasa hidup tanpa mengubah kontras teks. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSuccessTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnErrorTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Sidebar child button ========== -->
    <!-- Font ikon monokrom untuk sidebar: glyph mengikuti warna tema (emoji tidak bisa).
         Segoe Fluent Icons dipakai di Windows 11, MDL2 sebagai cadangan Windows 10. -->
    <FontFamily x:Key="AppIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="SidebarChildButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="{StaticResource UkuranTeksNavigasi}"/>
        <Setter Property="Margin" Value="0,1"/>
        <!-- Bantalan vertikal kecil supaya baris anak akordeon bernapas seperti
             baris induknya; tanpa ini baris 17 px saling menempel. -->
        <Setter Property="Padding" Value="0,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Sorotan hover dijalankan HoverAnimasiSidebar (kode) supaya durasinya
                         mengikuti kecepatan animasi pilihan pengguna di Pengaturan Aplikasi. -->
                    <Grid ctrl:HoverAnimasiSidebar.Aktif="True"
                          ctrl:HoverAnimasiSidebar.AnimasikanPill="True">
                        <!-- Pill aksen kiri: muncul saat hover/tekan -->
                        <Border x:Name="AccentPill" Width="3" HorizontalAlignment="Left"
                                CornerRadius="1.5" Margin="0,5"
                                Background="{DynamicResource SidebarAccentBrush}"
                                Opacity="0"/>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="IsiBaris" Grid.Column="0" Orientation="Horizontal">
                                    <!-- Swatch warna (pemilih tema visual): bulatan
                                         warna aksen tema di samping namanya. Hanya tampil
                                         bila item punya SwatchBrush; Fill null → transparan
                                         sehingga jebakan visibilitas di bawah yang menjaga. -->
                                    <Ellipse Width="13" Height="13" Margin="11,0,7,0" VerticalAlignment="Center"
                                             Fill="{Binding SwatchBrush}"
                                             Stroke="{DynamicResource BorderBrush}" StrokeThickness="1">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SwatchBrush}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                               FontSize="{StaticResource UkuranIkonNavigasi}" Width="20" Margin="10,0,8,0" VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource AppIconFont}"
                                               Foreground="{DynamicResource SidebarAccentBrush}" Opacity="0.85">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <!-- Tag kosong (item swatch) → jangan menyisakan
                                                         celah ikon 36 px yang menggantung. -->
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Ujung kanan baris: gembok untuk menu vital yang
                                     terkunci, dan centang untuk tema aktif. Keduanya
                                     tidak pernah tampil bersamaan (pilihan tema bukan
                                     menu vital), jadi cukup satu kolom. -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Static u:IkonMenu.Gembok}"
                                               FontFamily="{StaticResource AppIconFont}"
                                               FontSize="{StaticResource UkuranIkonPenanda}" Margin="8,0,4,0"
                                               Foreground="{DynamicResource SidebarAccentBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Terkunci}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Tanda centang tema aktif di ujung kanan baris — meniru
                                         pemilih tema visual yang menandai tema terpilih. -->
                                    <TextBlock Text="{x:Static u:IkonMenu.Verifikasi}" FontFamily="{StaticResource AppIconFont}"
                                               FontSize="{StaticResource UkuranIkonPenanda}" Margin="8,0,10,0"
                                               Foreground="{DynamicResource SidebarAccentBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTemaAktif}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Sorotan hover beranimasi (memudar, tidak berkedip) -->
                        <Border x:Name="HoverOverlay" CornerRadius="7" IsHitTestVisible="False"
                                Background="{DynamicResource SidebarHoverBrush}" Opacity="0"/>
                        <!-- Cincin fokus keyboard: umpan balik navigasi Tab yang jelas. -->
                        <Border x:Name="FocusBorder" CornerRadius="7" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource SidebarAccentBrush}"
                                BorderThickness="1" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusBorder" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarPressedBrush}"/>
                        </Trigger>
                        <!-- Menu vital terkunci: teks & ikon diredupkan supaya terlihat
                             belum bisa dipakai, gemboknya tetap tegas. -->
                        <DataTrigger Binding="{Binding Terkunci}" Value="True">
                            <Setter TargetName="IsiBaris" Property="Opacity" Value="0.55"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== TextBox / PasswordBox ========== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="{StaticResource UkuranTeksKontrol}"/>
        <Setter Property="MinHeight" Value="{StaticResource TinggiKontrol}"/>
        <!-- Teks satu baris di tengah tinggi baku; kotak isian panjang (mis. alamat)
             tetap mulai dari atas supaya isinya tidak “melayang” (lihat pemicu di bawah). -->
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Grid>
                            <!-- Bantalan kolom dipasang SEKALI saja, pada Padding host ini.
                                 Sebelumnya bantalan yang sama juga dipasang sebagai Margin di
                                 sini, sehingga isi kolom terhimpit dua kali dan kotak isian jadi
                                 40 px — lebih tinggi dari tombol dan pilihan (34 px). -->
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"/>
                            <!-- Cincin fokus aksen 2 px: fokus keyboard terlihat jelas
                                 tanpa menggeser isi kolom. -->
                            <Border x:Name="FocusRing" CornerRadius="6" Margin="-1"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                                    IsHitTestVisible="False" Opacity="0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Ketikan beberapa baris: tinggi baku dilepas agar tidak menyulitkan
                 penulisan, dan teksnya kembali rata atas seperti kotak catatan. -->
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModernTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>

    <!-- Kotak isian di dalam ComboBox yang bisa disunting (PART_EditableTextBox).
         WAJIB berdasarkan gaya TextBox tema: tanpa gaya, kotak itu memakai
         chrome bawaan Windows (kotak putih cekung dengan tepi sistem).
         Pemaksaan tinggi/bantalan dilepas supaya tinggi combobox tidak ikut
         membesar — alasan aslinya gaya ini di-set nol. -->
    <Style x:Key="KotakIsiComboBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="{StaticResource UkuranTeksKontrol}"/>
        <Setter Property="MinHeight" Value="{StaticResource TinggiKontrol}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Grid>
                            <!-- Sama seperti kolom isian biasa: bantalannya dipasang sekali saja. -->
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"/>
                            <!-- Cincin fokus aksen (sama dengan TextBox) supaya kolom
                                 sandi terlihat fokus seperti kolom isian lainnya. -->
                            <Border x:Name="FocusRing" CornerRadius="6" Margin="-1"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                                    IsHitTestVisible="False" Opacity="0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== ComboBox ========== -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="{StaticResource UkuranTeksKontrol}"/>
        <Setter Property="MinHeight" Value="{StaticResource TinggiKontrol}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" ClickMode="Press" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6">
                                        <Border x:Name="arrowHost" Height="16" Width="18" Margin="0,0,5,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <!-- Panah memakai glyph font ikon supaya sejajar
                                                 dan tajam, bukan karakter ▾ teks biasa. -->
                                            <TextBlock Text="&#xEDDB;" FontFamily="{StaticResource AppIconFont}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="PART_EditableTextBox"
                                 Margin="{TemplateBinding Padding}"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{DynamicResource TextBrush}"
                                 Visibility="Hidden" Focusable="True"
                                 Style="{StaticResource KotakIsiComboBox}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Slide"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border x:Name="DropDownBorder" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="6,4" Padding="2"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                    Effect="{StaticResource BayanganLembut}">
                                <ScrollViewer VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                              HorizontalScrollBarVisibility="Hidden">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>

    <!-- ========== Form field (input surat) ========== -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DropDown" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ========== ListBox & items ========== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="3"
                            Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Baris tabel pola "tinggi mengikuti isi" (pemakaian: Daftar Api, Riwayat,
         Register, dll. — pengganti DataGrid karena RowHeight="Auto" memicu loop
         layout). Berdasarkan ListBoxItem tema: seleksi/hover tetap memakai warna
         tema; yang diatur ulang hanya peregangan isi (lewat kolom bintang) dan
         padding baris yang dibuat nol supaya pemisah baris milik konten sendiri. -->
    <Style x:Key="TabelBaris" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- Baris tabel dengan zebra: latar baris bergantian memakai
         ZebraBrush (index bergantian 1 & 3; pemakaian setel
         AlternationCount=4 pada ListBox). Template sendiri
         diperlukan karena gaya implisit ListBoxItem tema mengunci
         latar border ke Transparan — template ini mengikat latar
         lewat TemplateBinding sehingga zebra tampak. Trigger hover
         dan seleksi diletakkan setelah zebra sehingga keduanya
         tetap menutupi zebra. -->
    <Style x:Key="TabelBarisZebra" TargetType="ListBoxItem" BasedOn="{StaticResource TabelBaris}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3"
                            Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ZebraBrush}"/>
                        </Trigger>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="3">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ZebraBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pita kepala kolom tabel tinggi-ikuti-isi: latar panel
         tipis dengan garis bawah sehingga kepala kolom terbaca
         sebagai satu pita, bukan baris biasa. Padding horisontal
         sengaja nol supaya teks kepala sejajar dengan isi baris. -->
    <Style x:Key="TabelKepalaPita" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,4,0,5"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ========== ListView & GridView (tabel data) ========== -->
    <!-- WPF TIDAK punya gaya implisit untuk ListView/GridView: tanpa blok ini,
         kepala kolom memakai chrome Aero2 (gradien perak + teks hitam) dan baris
         memakai warna sistem (Foreground #042271, latar seleksi biru Windows).
         Akibatnya dua halaman yang memakai tabel jenis ini — IDM (rincian
         indikator, tahun penilaian) dan APBDES (daftar dokumen) — tetap tampak
         terang di tema gelap: pita kepala kolom putih, teks baris nyaris hilang,
         dan sorotan seleksi biru bawaan. Gaya di bawah menggantinya penuh
         dengan warna tema, seperti yang sudah dilakukan DataGrid.

         Padding kepala kolom dan bantalan baris sengaja sama (10 px) supaya
         teks kepala sejajar dengan teks sel di bawahnya; latar sorotan baris
         tetap penuh karena bantalan berada di DALAM Border template. -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- Baris tabel: template ini WAJIB memuat GridViewRowPresenter. Template
         bawaan ListViewItem memang punya penyaji itu; begitu diganti dengan
         ContentPresenter saja, setiap ListView ber-View GridView kehilangan
         kolomnya dan yang tampil hanya nama kelas objek baris
         ("SuDesApp.Wpf.ViewModels…"). Karena itu di sini ada DUA penyaji:
         GridViewRowPresenter saat ListView punya View, ContentPresenter biasa
         saat ListView tanpa View (daftar sederhana). Masing-masing disembunyikan
         lewat trigger sesuai keadaan View. -->
    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="3"
                            Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                        <Grid>
                            <!-- Penyaji kolom GridView: satu sel per GridViewColumn,
                                 selebar kolomnya masing-masing. -->
                            <GridViewRowPresenter x:Name="barisKolom"
                                                  Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="True"/>
                            <!-- Daftar tanpa View: isi baris digambar apa adanya. -->
                            <ContentPresenter x:Name="isiBiasa"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Tanpa View: tidak ada kolom, jadi matikan penyaji kolom. -->
                        <DataTrigger Value="{x:Null}"
                                     Binding="{Binding View, RelativeSource={RelativeSource AncestorType=ListView}}">
                            <Setter TargetName="barisKolom" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <!-- Dengan View: isi baris sudah dipecah per kolom. -->
                        <DataTrigger Value="True"
                                     Binding="{Binding View, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource TampilanAda}}">
                            <Setter TargetName="isiBiasa" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                        </Trigger>
                        <!-- Seleksi memakai aksen lembut (bukan PrimaryBrush penuh)
                             supaya teks sekunder di dalam baris tetap terbaca —
                             sama seperti baris DataGrid. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kepala kolom GridView. PART_HeaderGripper WAJIB ada: GridViewColumnHeader
         mencari Thumb bernama itu untuk menggeser lebar kolom; tanpa part itu
         kolom tidak bisa ditarik lagi. Peran Padding/Floating (sisa ruang di
         kanan kepala) dibuat transparan supaya tidak ada potongan chrome perak. -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border x:Name="headerBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <!-- Pegangan lebar kolom. WAJIB punya template sendiri: template
                             Thumb bawaan Aero2 menggambar bilah putih, sehingga di tema
                             gelap muncul serpihan terang di antara kepala kolom. -->
                        <Thumb x:Name="PART_HeaderGripper"
                               HorizontalAlignment="Right" VerticalAlignment="Stretch"
                               Width="8" Margin="0,0,-4,0"
                               Background="Transparent" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="grip" Background="{TemplateBinding Background}"
                                            CornerRadius="1" Margin="1,4"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="grip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="grip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Sisa ruang di kanan kepala kolom: jangan digambar. -->
            <Trigger Property="Role" Value="Padding">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Trigger>
            <Trigger Property="Role" Value="Floating">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== ContextMenu / MenuItem ========== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{StaticResource UkuranTeksMenu}"/>
        <Setter Property="Padding" Value="10,6"/>
        <!-- Chrome menu bawaan Windows diganti penuh dengan warna tema (highlight
             = AccentSubtleBrush, teks = TextBrush) agar tak ada kotak/menu putih
             di tema gelap. Template seragam utk tiap role; Popup submenu hanya
             aktif saat item benar-benar punya child (IsSubmenuOpen). -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconHost" Grid.Column="0"
                                                  ContentSource="Icon" Margin="0,0,4,0"
                                                  VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <TextBlock x:Name="Arrow" Grid.Column="2" Text="&#x25B8;" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" VerticalOffset="-4"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{Binding IsSubmenuOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Margin="4" Padding="2" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== CheckBox ========== -->
    <!-- Kotak centang bertema penuh (dulu masih chrome bawaan Windows yang
         selalu putih) — kotak mengikuti permukaan tema, centang memakai
         warna aksen interaktif (pink di tema Pink/Dark, dst). -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="17" Height="17" CornerRadius="3"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="check" Data="M 2 6.5 L 6 10.5 L 12 2"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource OnAccentTextBrush}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter x:Name="content" Margin="7,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="content" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Expander ========== -->
    <!-- Template sendiri WAJIB: tanpa template, Expander memakai gaya bawaan
         WPF yang menampilkan tombol header chrome Windows (gradien tombol
         sistem + panah sistem) di dalam Expander yang tidak ikut tema.
         Header di sini memakai glyph font ikon seperti panah ComboBox dan
         latar mengikuti tema; isi muncul lewat pemicu IsExpanded. -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite" ClickMode="Press" Focusable="False"
                                      Padding="{TemplateBinding Padding}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                      HorizontalContentAlignment="Left">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="hd" Background="Transparent" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <TextBlock x:Name="Chevron" Text="&#xEDDB;"
                                                       FontFamily="{StaticResource AppIconFont}" FontSize="10"
                                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="-90"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hd" Property="Background"
                                                    Value="{DynamicResource PanelBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="0"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" Margin="0,2,0,0" Visibility="Collapsed"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== GroupBox (kartu form input surat) ========== -->
    <Style TargetType="GroupBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Header}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       Margin="0,0,0,10"/>
                            <ContentPresenter/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== DataGrid Column Header (Sortable) ========== -->
    <!-- Kepala kolom memakai PanelBrush + TextBrush, sama seperti kepala kolom
         GridView. Sebelumnya latarnya PrimaryBrush dengan teks putih yang
         diwariskan; gaya implisit TextBlock (Foreground TextBrush) MENANG atas
         warisan itu, sehingga di tema terang muncul teks hitam di atas biru
         tua/teks putih di atas primary terang (mis. Orbit, Ember) yang gagal
         WCAG AA. Latar netral membuat warna teks tidak lagi bergantung pada
         palet aksen dan otomatis aman di semua sebelas tema. -->
    <Style TargetType="DataGridColumnHeader" x:Key="SortableColumnHeader">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid Background="Transparent">
                    <!-- Gripper kanan: pegangan tarik lebar kolom. Nama PART_RightHeaderGripper
                         di-wire otomatis oleh DataGridColumnHeader untuk resizing.
                         Template sendiri wajib: Thumb bawaan Aero2 menggambar bilah
                         putih yang menyolok di tema gelap. -->
                    <Thumb x:Name="PART_RightHeaderGripper"
                           HorizontalAlignment="Right" VerticalAlignment="Stretch"
                           Width="8" Background="Transparent" Cursor="SizeWE">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="grip" Background="{TemplateBinding Background}"
                                        CornerRadius="1" Margin="1,5"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="grip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="grip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Border x:Name="headerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,0,6,0"
                            SnapsToDevicePixels="True">
                        <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            <Path x:Name="SortArrow" Grid.Column="1" Margin="6,0,0,0"
                                  Width="8" Height="6" Stretch="Uniform"
                                  Fill="{DynamicResource TextBrush}"
                                  Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortArrow" Property="Data" Value="M 0 4 L 4 0 L 8 4 Z"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 4 L 8 0 Z"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortArrow" Property="Data" Value="M 0 4 L 4 0 L 8 4 Z"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 4 L 8 0 Z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="headerBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                        </Trigger>
                        <!-- Indikator pegangan saat hover di area gripper -->
                        <Trigger SourceName="PART_RightHeaderGripper" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_RightHeaderGripper" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SortableColumnHeader}"/>

    <!-- ========== DataGrid Row ========== -->
    <!-- Zebra/hover/seleksi memakai Background via trigger style di bawah.
         Template row minimal menggantikan template Aero2 yang memakai warna
         seleksi SISTEM (SystemColors.Highlight — penyebab baris terpilih tampak
         putih/biru bawaan Windows dan tidak mengikuti tema). Dengan template ini
         Background baris sepenuhnya dikendalikan trigger style = bertema penuh.
         Struktur SelectiveScrollingGrid mengikuti kerangka baku DataGrid. -->
    <Style TargetType="DataGridRow" x:Key="ModernDataGridRowStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ValidationErrorTemplate" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="rowBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </SelectiveScrollingGrid.ColumnDefinitions>
                            <SelectiveScrollingGrid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </SelectiveScrollingGrid.RowDefinitions>
                            <DataGridCellsPresenter Grid.Column="1"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1"
                                                      Visibility="{TemplateBinding DetailsVisibility}"
                                                      SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"/>
                            <DataGridRowHeader Grid.Column="0" Grid.RowSpan="2" Width="0" Visibility="Collapsed"
                                               SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"/>
                        </SelectiveScrollingGrid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource ZebraBrush}"/>
            </Trigger>
            <Trigger Property="AlternationIndex" Value="3">
                <Setter Property="Background" Value="{DynamicResource ZebraBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRowStyle}"/>

    <!-- ========== DataGrid Cell ========== -->
    <Style TargetType="DataGridCell" x:Key="ModernDataGridCell">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="cellBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="cellBorder" Property="Background" Value="Transparent"/>
                        </Trigger>
                        <Trigger Property="IsEditing" Value="True">
                            <Setter TargetName="cellBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            <Setter TargetName="cellBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="cellBorder" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernDataGridCell}"/>

    <!-- ========== Modern DataGrid ========== -->
    <Style TargetType="DataGrid" x:Key="ModernDataGrid">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- Vertikal SELALU tampil (bukan Auto): ruang scrollbar dipastikan ada sejak
             awal, sehingga lebar kolom bintang tidak pernah berubah saat baris bertambah
             atau berkurang — teks tidak pernah melipat ulang dan baris tidak bergeser. -->
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <!-- Tinggi baris TETAP 40 px di semua tabel: satu baris teks + padding sel
             (12 px), tanpa pengukuran dinamis — jadi tidak ada baris yang berubah
             tinggi atau bergeser saat data dimuat. Teks panjang dipotong dengan
             elipsis oleh ElementStyle kolom dan terbaca utuh lewat tooltip. -->
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="AlternationCount" Value="4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="EnableRowVirtualization" Value="False"/>
        <Setter Property="EnableColumnVirtualization" Value="False"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource SortableColumnHeader}"/>
        <Setter Property="RowStyle" Value="{StaticResource ModernDataGridRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource ModernDataGridCell}"/>
        <!-- Responsive column sizing -->
        <Setter Property="ColumnWidth" Value="*"/>
        <Setter Property="MinColumnWidth" Value="80"/>
        <Setter Property="MaxColumnWidth" Value="500"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
    </Style>

    <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}"/>

    <!-- ========== Editable DataGrid (edit-in-place untuk form, mis. rincian garapan) ========== -->
    <!-- Sama dengan ModernDataGrid tetapi membolehkan pengeditan sel + virtualisasi tetap dimatikan.
         Tinggi baris mengikuti ModernDataGrid (40 px) supaya seragam di seluruh aplikasi. -->
    <Style TargetType="DataGrid" x:Key="EditableDataGrid" BasedOn="{StaticResource ModernDataGrid}">
        <Setter Property="IsReadOnly" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="RowHeight" Value="40"/>
    </Style>

    <Style TargetType="DataGridComboBoxColumn">
        <Setter Property="EditingElementStyle">
            <Setter.Value>
                <Style TargetType="ComboBox">
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="FontSize" Value="13"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridTemplateColumn">
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernDataGridCell}">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== DatePicker ========== -->
    <!-- Catatan sejarah: kedua template kustom DatePicker sebelumnya pernah gagal
         saat render pertama (FormatException Fill="None" dan layout loop). Karena
         itu template di bawah sengaja dibuat sesederhana mungkin: hanya Border,
         Grid, teks, dan Popup — tanpa geometri/Path dinamis yang bisa memicu dua
         masalah tersebut. -->
    <!-- Tombol pembuka kalender di dalam DatePicker. Template DatePicker di bawah
         memakainya langsung (bukan lewat Style.Resources), sehingga chrome tombol
         bawaan Aero2 — kotak putih berbingkai perak — tidak lagi muncul di tema
         gelap. Tinggi mengikuti baris, bukan bantalan sendiri. -->
    <Style x:Key="TombolKalenderTanggal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <!-- Mengisi tinggi baris DatePicker, bukan mengambang di tengahnya. -->
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Teks bayang "Pilih tanggal" pada kolom kosong (teks bawaan Aero2 hitam). -->
    <Style x:Key="TeksBayangTanggal" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                      VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DatePickerTextBox: kotak isian DI DALAM DatePicker. Template bawaan Aero2
         menggambar sendiri latar gradien putih + bingkai perak (tidak lewat
         Background/BorderBrush), jadi menyetel kedua properti itu tidak cukup —
         kolom tanggal tetap kotak putih di tema gelap. Template ini hanya
         menyisakan teks &amp; caret di atas latar transparan milik DatePicker.
         PART_ContentHost (dipakai TextBox untuk mengetik) dan PART_Watermark
         (teks bayang) wajib ada. -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="WatermarkStates">
                                <VisualState x:Name="Unwatermarked"/>
                                <VisualState x:Name="Watermarked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Watermark"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                        <ContentControl x:Name="PART_Watermark" Opacity="0" Margin="2,0,0,0"
                                        Focusable="False" IsHitTestVisible="False"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Style="{StaticResource TeksBayangTanggal}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontSize" Value="{StaticResource UkuranTeksKontrol}"/>
        <Setter Property="MinHeight" Value="{StaticResource TinggiKontrol}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- Template tema penuh. Dulu DatePicker sengaja dibiarkan memakai template
             bawaan karena template kustom pernah memicu crash (Fill="None") dan
             layout loop. Masalahnya, template bawaan Aero2 menggambar kotak isian
             putih serta tombol kalender ber-chrome perak dari template-nya sendiri,
             sehingga tema gelap tetap menampilkan kotak tanggal putih. Template di
             bawah hanya memakai warna tema, tanpa geometri dinamis: PART_TextBox
             (DatePickerTextBox), PART_Button (pembuka kalender), dan PART_Popup
             tetap ada agar perilaku pemilih tanggal tidak berubah. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"/>
                            <Button x:Name="PART_Button" Grid.Column="1"
                                    Style="{StaticResource TombolKalenderTanggal}"
                                    AutomationProperties.Name="Buka kalender">
                                <TextBlock Text="{x:Static u:IkonMenu.Kalender}" FontSize="15"
                                           FontFamily="{StaticResource AppIconFont}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   Placement="Bottom" StaysOpen="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Template bawaan Aero2 meredupkan isi saat DatePicker
                             dinonaktifkan; tanpa trigger ini kolom yang tidak boleh
                             diisi tampak seperti bisa diisi. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pemilih tanggal berdiri sejajar dengan kolom isian & pilihan, jadi tingginya
         memakai angka baku yang sama. -->
    <!-- Berbasis gaya DatePicker implisit: gaya berkunci TIDAK mewarisi gaya
         implisit secara otomatis, dan dulu itulah sebabnya kolom tanggal yang
         memakai FormDate kembali ke template Aero2 (kotak putih) meski gaya
         implisit DatePicker sudah dirapikan. -->
    <Style x:Key="ModernDatePicker" TargetType="DatePicker"
           BasedOn="{StaticResource {x:Type DatePicker}}">
        <Setter Property="FontSize" Value="{StaticResource UkuranTeksKontrol}"/>
        <Setter Property="MinHeight" Value="{StaticResource TinggiKontrol}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ========== RadioButton ========== -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Border x:Name="bulletBorder" Width="14" Height="14"
                                    CornerRadius="7" BorderThickness="2"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}">
                                <Border x:Name="bulletInner" Width="6" Height="6"
                                        CornerRadius="3"
                                        Background="{DynamicResource AccentBrush}"
                                        Visibility="Collapsed"/>
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bulletInner" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="bulletBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bulletBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== ProgressBar ========== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="3" BorderThickness="0">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Slider ========== -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Background="{TemplateBinding Foreground}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{TemplateBinding Foreground}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Background="{TemplateBinding Background}" Opacity="0.4"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== TabControl / TabItem ========== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource UkuranTeksMenu}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="tabBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Calendar ========== -->
    <Style TargetType="Calendar">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="CalendarNavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CalendarItem: template bertema penuh untuk popup DatePicker. Template
         bawaan Aero2 berlatar putih dengan teks hitam (menyolok di tema gelap).
         Nama PART_* wajib: dicari oleh logika Calendar. PART_MonthView wajib Grid
         7x7 (baris 1 = judul hari via DayTitleTemplateResourceKey). -->
    <Style TargetType="CalendarItem">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,2"/>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PART_PreviousButton" Grid.Row="1" Grid.Column="0"
                                    Width="26" Height="24" Margin="0,0,6,0"
                                    Style="{StaticResource CalendarNavButton}"
                                    Command="{Binding PreviousScrollCommand, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
                                <TextBlock Text="&#x2039;" FontSize="15" Margin="0,-4,0,0"/>
                            </Button>
                            <!-- Content header ("September 2026") diisi runtime oleh Calendar
                                 via code, bukan binding — cukup Style + Command -->
                            <Button x:Name="PART_HeaderButton" Grid.Row="1" Grid.Column="1"
                                    Style="{StaticResource CalendarNavButton}"
                                    Command="{Binding DisplayModeCommand, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False"/>
                            <Button x:Name="PART_NextButton" Grid.Row="1" Grid.Column="2"
                                    Width="26" Height="24" Margin="6,0,0,0"
                                    Style="{StaticResource CalendarNavButton}"
                                    Command="{Binding NextScrollCommand, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
                                <TextBlock Text="&#x203A;" FontSize="15" Margin="0,-4,0,0"/>
                            </Button>
                            <Grid x:Name="PART_MonthView" Grid.Row="2" Grid.ColumnSpan="3"
                                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                            </Grid>
                            <Grid x:Name="PART_YearView" Grid.Row="2" Grid.ColumnSpan="3" Visibility="Hidden"
                                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                                  MinWidth="248">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- Visibilitas PART_MonthView/PART_YearView diatur langsung oleh
                         Calendar (code) saat ganti mode bulan/tahun/dekade -->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" Padding="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                        </Trigger>
                        <!-- Hari di luar bulan aktif diredupkan (belum ada di template lama) -->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CalendarButton: tombol bulan/tahun (mode Year/Decade) dan hari kosong -->
    <Style TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== ScrollBar ========== -->
    <!-- Thumb memakai AccentBrush (ada di semua tema) sehingga SELALU terlihat
         (sebelumnya BorderBrush nyaris tak terlihat di tema terang — dianggap
         "scrollbar tidak ada"). RepeatButton halaman dibuat transparan tanpa
         chrome bawaan. Thumb diberi ukuran minimal agar tidak jadi serpihan
         1-2 px yang mustahil digenggam saat konten panjang (terasa "macet"). -->
    <ControlTemplate x:Key="ScrollBarThumbTemplate" TargetType="Thumb">
        <Border x:Name="thumbBorder"
                Background="{TemplateBinding Background}"
                CornerRadius="3" Margin="3"
                Opacity="0.45"/>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="thumbBorder" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="thumbBorder" Property="Opacity" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="TransparentRepeatButtonTemplate" TargetType="RepeatButton">
        <Rectangle Fill="Transparent"/>
    </ControlTemplate>

    <!-- Template vertical (default) -->
    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False"
                                  Template="{StaticResource TransparentRepeatButtonTemplate}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Background="{TemplateBinding Foreground}" MinHeight="32"
                           Template="{StaticResource ScrollBarThumbTemplate}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False"
                                  Template="{StaticResource TransparentRepeatButtonTemplate}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Template horizontal (dedicated; rotasi LayoutTransform menyebabkan layout loop) -->
    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False" IsTabStop="False"
                                  Template="{StaticResource TransparentRepeatButtonTemplate}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Background="{TemplateBinding Foreground}" MinWidth="32"
                           Template="{StaticResource ScrollBarThumbTemplate}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False" IsTabStop="False"
                                  Template="{StaticResource TransparentRepeatButtonTemplate}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== ScrollViewer ========== -->
    <!-- Tanpa PanningMode: "Both" mencuri gesture scroll pada beberapa perangkat
         sentuh dan membuat scrollbar terasa macet. -->
    <!-- Horisontal scroll KRUSIAL HANYA untuk DataGrid (kanan-kiri kolom).
         Di luar DataGrid sengaja default WPF (Disabled) agar konten yang lebih
         lebar dari viewport TIDAK memunculkan scrollbar horisontal tak terduga.
         Scrollbar DataGrid diatur eksplisit di style ModernDataGrid (Auto dua
         arah); ScrollViewer pada view menentukan sendiri visibilitas vertikal. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- ========== ToolTip ========== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="FontSize" Value="{StaticResource UkuranTeksTooltip}"/>
        <Setter Property="Placement" Value="Mouse"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <!-- Sudut 6 + bayangan lembut: tooltip ikut bahasa visual
                         kartu/dropdown lain (terangkat dari konten). -->
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            Effect="{StaticResource BayanganLembut}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Teks tooltip ditulis sebagai TextBlock bertema: ukuran
                                 baku tooltip, membungkus baris panjang, dan warna teks
                                 yang tidak bergantung pada kontrol pemiliknya. -->
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <TextBlock Text="{Binding}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="{StaticResource UkuranTeksTooltip}"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Separator ========== -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <!-- ========== Modern Card & KPI Styles ========== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Effect" Value="{StaticResource BayanganLembut}"/>
    </Style>

    <!-- Kartu KPI: bayangan lembut + sudut membulat, sama dengan kartu lain,
         supaya deretan statistik terasa seperti kartu sungguhan. -->
    <Style x:Key="KpiCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect" Value="{StaticResource BayanganLembut}"/>
    </Style>

    <!-- Kartu KPI berderet: jarak antar kartu milik gaya, bukan salinan di tiap
         halaman. Halaman yang butuh jarak lain cukup menimpanya lewat Margin. -->
    <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource KpiCardStyle}">
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <!-- Petak KPI datar (di dalam kartu): dipakai halaman Langganan. Sengaja TIDAK
         memakai bayangan KpiCardStyle karena petak ini berada di atas permukaan
         kartu, bukan di atas latar halaman. -->
    <Style x:Key="KpiTile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,11"/>
    </Style>

    <!-- Tipografi KPI: SATU definisi untuk seluruh aplikasi. Dulu Daftar Hadir
         dan Langganan masing-masing menyalinnya dengan berat huruf dan margin
         yang sedikit berbeda, sehingga dua halaman menampilkan angka yang sama
         dengan rupa berbeda. Label wajib membungkus: "TERAKHIR DIPERIKSA" lebih
         lebar daripada petaknya pada jendela sempit. -->
    <Style x:Key="KpiLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>

    <Style x:Key="KpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <!-- Chip ikon 36×36 untuk baris KPI dan kepala section. Satu ukuran, satu
         sudut, satu latar; isi ikonnya tetap milik halaman. -->
    <Style x:Key="KpiIconChip" TargetType="Border">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StatusBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ========== Shared layout: header & toolbar (gaya seragam semua halaman) ========== -->
    <!-- Kepala halaman memakai gradien Primary → Secondary, sama persis dengan
         kepala sidebar, sehingga satu bahasa visual dari menu sampai isi halaman.
         Kedua warna dari palet tema, jadi putih di atasnya tetap kontras di
         semua tema (termasuk Kontras Tinggi). -->
    <Style x:Key="PageHeader" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource SecondaryColor}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Effect" Value="{StaticResource BayanganLembut}"/>
    </Style>

    <!-- Shared shell for data views: pages provide their own header content and
         body layout while this control owns the common header surface. -->
    <Style TargetType="{x:Type ctrl:DataPageFrame}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:DataPageFrame}">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
                            <ContentPresenter Content="{TemplateBinding HeaderContent}"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" Content="{TemplateBinding PageContent}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip ikon: latar putih + bayangan tipis supaya terangkat dari gradien. -->
    <Style x:Key="HeaderIconChip" TargetType="Border">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource PutihBrush}"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Effect" Value="{StaticResource BayanganLembut}"/>
    </Style>

    <Style x:Key="HeaderTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
        <Setter Property="LineHeight" Value="22"/>
    </Style>

    <Style x:Key="HeaderSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{DynamicResource HeaderSubtitleBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="LineHeight" Value="17"/>
    </Style>

    <!-- Tombol aksi di dalam header halaman, dipakai halaman data seperti Data
         Warga, Laporan Penduduk, API Desa, dan pembaca dokumen. Latar PUTIH +
         teks Primary sejajar dengan chip ikon header yang juga putih, sehingga
         menonjol di atas gradien Primary → Secondary di semua tema (latar
         Secondary lama nyaris menyatu dengan sisi kanan gradien). Hover memakai
         template bawaan (opacity turun → warna gradien merembes tipis). -->
    <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource PutihBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- Tombol garis di header: transparan agar tidak berebut perhatian dari
         tombol utama, dengan kilau putih tipis saat hover supaya terasa hidup
         di atas gradien. -->
    <Style x:Key="HeaderGhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HeaderSubtitleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="Margin" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource LapisanLembutBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AccentSectionBar" TargetType="Border">
        <Setter Property="Width" Value="4"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="ToolbarCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect" Value="{StaticResource BayanganLembut}"/>
    </Style>

    <Style x:Key="GridHostCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- Bayangan hanya terlihat bila sudut membulat tampil rapi; bila
             terpotong ClipToBounds, tidak ada perubahan visual (tetap aman). -->
        <Setter Property="Effect" Value="{StaticResource BayanganLembut}"/>
    </Style>

    <!-- ========== Form Input Surat (kartu section + baris label/nilai) ==========
         Semua form input surat memakai token ini agar seragam dan SELALU muat
         lebar jendela (kolom nilai memakai * sehingga ikut menyusut), tanpa
         scroll horizontal. -->
    <Style x:Key="FormCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <!-- Judul section (bukan judul halaman — judul halaman memakai HeaderTitle):
         satu definisi untuk halaman data, Tentang Aplikasi, dan panduan. Dulu
         tiga berkas menyalinnya sendiri-sendiri, jadi satu halaman bisa memakai
         pembungkus teks sementara halaman lain tidak. -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Varian judul section di dalam kartu besar (mis. Langganan). Berbeda satu
         tingkat huruf agar hierarki kartu tetap terbaca, tetapi seluruh sifat
         lainnya mewarisi SectionTitle. -->
    <Style x:Key="SectionTitleLarge" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="FormSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}"/>

    <!-- Label field: lebar Auto + batas max agar tidak menelan ruang di jendela sempit,
         dan teks tetap membungkus rapi (tanpa mendorong melebar ke kanan). -->
    <Style x:Key="FormLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,6,10,6"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FormField" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
        <Setter Property="Margin" Value="0,6"/>
    </Style>

    <Style x:Key="FormCombo" TargetType="ComboBox" BasedOn="{StaticResource DropDown}">
        <Setter Property="Margin" Value="0,6"/>
    </Style>

    <Style x:Key="FormDate" TargetType="DatePicker" BasedOn="{StaticResource ModernDatePicker}">
        <Setter Property="Margin" Value="0,6"/>
    </Style>

    <!-- Judul section dengan garis aksen kiri -->
    <Style x:Key="FormSectionHeaderPanel" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <!-- ========== Chrome Jendela Bertema (title bar kustom) ========== -->
    <!-- Mengganti title bar bawaan Windows (yang selalu abu-abu/putih) agar
         aplikasi 100% mengikuti tema aktif. Warna mengikuti Sidebar/Menu
         sehingga menyatu dengan bagian atas aplikasi. Tombol min/max/close
         memanggil AppChromeCommands; CommandBinding dipasang lewat
         ChromeWindowBehavior.Attach(window) di code-behind. -->

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TutupCaptionBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PutihBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Panel judul: drag penuh (Chrome.DragMove), tombol tetap klik-able
         lewat WindowChrome.IsHitTestVisibleInChrome. -->
    <Style x:Key="WindowCaptionStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="False"/>
    </Style>

    <Style x:Key="WindowTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

</ResourceDictionary>
