<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Green Theme — Nuansa hijau pedesaan, versi tenang -->
    <!--
        Palet ini dibangun dari tiga keputusan:

          1. KROMAT HANYA DI KULIT. Hijau dipakai pada chrome (sidebar, kepala
             halaman, tombol, tautan) dan berhenti di sana. Latar halaman,
             kartu, garis dan teks tidak lagi ikut hijau — sebelumnya halaman
             terang seluruhnya (#F0FDF4 di atas #FFFFFF dengan garis #C8EED6),
             sehingga kartu seolah tidak punya tepi dan semuanya tampak "satu
             warna hijau". Netral dingin (#F4F7F5 / #D5E0D8) membuat kartu
             terbaca sebagai objek dan warna aksen terasa disengaja.

          2. HIJAU YANG LEBIH DALAM DAN DINGIN. Primary turun dari #166534 ke
             #0F5132 dan sidebar ke #0C3F2A: dua tingkat lebih gelap, sedikit
             lebih biru. Header dan sidebar tetap satu bahasa visual, tetapi
             tidak lagi menyala seperti tombol hijau.

          3. TINTA HAMPIR HITAM. Teks utama #12201A (bukan #052E16) supaya
             kontras tidak bergantung pada warna tema; teks sekunder #4A6355
             lolos AA di kartu, panel, latar, baris zebra, dan lencana halus.

        Semua nilai masih diuji berpasangan oleh Tools/check-kontras-wcag.ps1.
    -->

    <!-- Header gradien digelapkan satu tingkat agar subjudul (putih 85%) tetap
         lolos WCAG AA di atasnya — diperiksa alat Tools/check-kontras-wcag.ps1. -->
    <Color x:Key="PrimaryColor">#0F5132</Color>
    <Color x:Key="SecondaryColor">#093A26</Color>
    <Color x:Key="AccentColor">#12805A</Color>
    <Color x:Key="BackgroundColor">#F4F7F5</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="TextColor">#12201A</Color>
    <Color x:Key="TextSecondaryColor">#4A6355</Color>
    <Color x:Key="TextSelectedColor">#0F5132</Color>
    <Color x:Key="BorderColor">#D5E0D8</Color>
    <Color x:Key="PanelColor">#E9F0EB</Color>
    <Color x:Key="SuccessColor">#12805A</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="MenuBackgroundColor">#0C3F2A</Color>
    <Color x:Key="MenuTextColor">#FFFFFF</Color>
    <Color x:Key="AccentLightColor">#5BD0A0</Color>

    <!-- Subtle badge colors: tint status dinaikkan sedikit kejenuhannya supaya
         masih terlihat sebagai "berwarna" di atas latar halaman yang kini netral. -->
    <Color x:Key="SuccessSubtleColor">#E2F3EA</Color>
    <Color x:Key="WarningSubtleColor">#FBF1DE</Color>
    <Color x:Key="ErrorSubtleColor">#FBE5E5</Color>
    <Color x:Key="AccentSubtleColor">#E2F3EA</Color>
    <Color x:Key="ZebraColor">#F7FAF8</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextSelectedBrush" Color="{StaticResource TextSelectedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <!-- Subtle Badge & Chip Brushes -->
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}"/>
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="{StaticResource ErrorSubtleColor}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}"/>
    <SolidColorBrush x:Key="ZebraBrush" Color="{StaticResource ZebraColor}"/>

    <!-- Warna teks status digelapkan: warna isian (SuccessColor/Warning/Error)
         terlalu terang untuk teks — diperiksa alat Tools/check-kontras-wcag.ps1. -->
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#0B6B4A"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#8A5108"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#B02323"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource PrimaryColor}"/>

    <!-- Sidebar / StatusBar -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource MenuBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource MenuTextColor}"/>
    <SolidColorBrush x:Key="SidebarAccentBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="White" Opacity="0.12"/>
    <SolidColorBrush x:Key="SidebarPressedBrush" Color="White" Opacity="0.2"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource MenuBackgroundColor}"/>
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="{StaticResource MenuTextColor}"/>

    <!-- Helper brushes -->
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderSubtitleBrush" Color="#FFFFFF" Opacity="0.85"/>
    <SolidColorBrush x:Key="ErrorOverlayBrush" Color="{StaticResource ErrorColor}" Opacity="0.12"/>

    <SolidColorBrush x:Key="OnPrimaryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnPrimarySubtleBrush" Color="#FFFFFF" Opacity="0.85"/>
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF"/>

    <!-- Teks di atas lencana/tombol status. Nilainya dipilih agar lolos WCAG AA
         (>= 4,5:1 terhadap latarnya) — diperiksa Tools/check-kontras-wcag.ps1
         dan dijaga alat Tools/check-kontras-wcag.ps1. -->
    <SolidColorBrush x:Key="OnSuccessTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnWarningTextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="OnErrorTextBrush" Color="#FFFFFF"/>

    <!-- Font -->
    <FontFamily x:Key="AppFontFamily">pack://application:,,,/SuDesApp;component/Fonts/GoogleSans.ttc#Google Sans, Segoe UI Variable, Segoe UI</FontFamily>

</ResourceDictionary>
