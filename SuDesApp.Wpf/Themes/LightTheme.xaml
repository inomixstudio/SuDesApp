<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Modern — Material Design Light berpadu Fluent, profesional ala admin publik -->
    <!-- Palet: latar abu Material Grey-100, kartu putih, navigasi putih, aksen Material Blue -->

    <!-- Palette dasar -->
    <Color x:Key="PrimaryColor">#1976D2</Color>
    <Color x:Key="SecondaryColor">#1565C0</Color>
    <Color x:Key="AccentColor">#2196F3</Color>
    <Color x:Key="BackgroundColor">#F5F5F5</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="TextColor">#212121</Color>
    <Color x:Key="TextSecondaryColor">#616161</Color>
    <Color x:Key="TextSelectedColor">#1565C0</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="PanelColor">#EEEEEE</Color>
    <Color x:Key="SuccessColor">#2E7D32</Color>
    <Color x:Key="WarningColor">#ED6C02</Color>
    <Color x:Key="ErrorColor">#C62828</Color>

    <!-- Chrome (sidebar, title bar, status bar) terang ala Material nav drawer -->
    <Color x:Key="MenuBackgroundColor">#FFFFFF</Color>
    <Color x:Key="MenuTextColor">#212121</Color>
    <Color x:Key="AccentLightColor">#90CAF9</Color>
    <Color x:Key="AccentDarkColor">#0D47A1</Color>
    <Color x:Key="ShadowColor">#26000000</Color>

    <!-- Subtle badge colors -->
    <Color x:Key="SuccessSubtleColor">#E6F4EA</Color>
    <Color x:Key="WarningSubtleColor">#FFF3CD</Color>
    <Color x:Key="ErrorSubtleColor">#FBEAE9</Color>
    <Color x:Key="AccentSubtleColor">#E3F2FD</Color>
    <Color x:Key="ZebraColor">#F8FAFB</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextSelectedBrush" Color="{StaticResource TextSelectedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <!-- Subtle Badge & Chip Brushes -->
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}"/>
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="{StaticResource ErrorSubtleColor}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}"/>
    <SolidColorBrush x:Key="ZebraBrush" Color="{StaticResource ZebraColor}"/>

    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource PrimaryColor}"/>

    <!-- Sidebar / StatusBar (terang, Material) -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource MenuBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource MenuTextColor}"/>
    <SolidColorBrush x:Key="SidebarAccentBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="Black" Opacity="0.06"/>
    <SolidColorBrush x:Key="SidebarPressedBrush" Color="Black" Opacity="0.12"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="{StaticResource TextSecondaryColor}"/>

    <!-- Helper brushes untuk teks di atas header/tombol primer -->
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderSubtitleBrush" Color="#FFFFFF" Opacity="0.85"/>
    <SolidColorBrush x:Key="LogoCircleBackgroundBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="ErrorOverlayBrush" Color="{StaticResource ErrorColor}" Opacity="0.10"/>

    <SolidColorBrush x:Key="OnPrimaryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnPrimarySubtleBrush" Color="#FFFFFF" Opacity="0.85"/>
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF"/>

    <!-- Font -->
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

</ResourceDictionary>