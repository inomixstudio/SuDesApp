<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Pink Theme — Pink lembut, terang dan manis -->
    <!-- Palet: putih + pink pastel, sidebar pink muda berteks plum, aksen pink cerah lembut -->

    <Color x:Key="PrimaryColor">#EC4899</Color>
    <Color x:Key="SecondaryColor">#DB2777</Color>
    <Color x:Key="AccentColor">#F472B6</Color>
    <Color x:Key="BackgroundColor">#FFF7FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="TextColor">#44333F</Color>
    <Color x:Key="TextSecondaryColor">#8D7381</Color>
    <Color x:Key="TextSelectedColor">#DB2777</Color>
    <Color x:Key="BorderColor">#F9D8E3</Color>
    <Color x:Key="PanelColor">#FDF0F5</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="MenuBackgroundColor">#FDF0F5</Color>
    <Color x:Key="MenuTextColor">#44333F</Color>
    <Color x:Key="AccentLightColor">#F9A8D4</Color>
    <Color x:Key="AccentDarkColor">#DB2777</Color>
    <Color x:Key="ShadowColor">#26000000</Color>

    <!-- Subtle badge colors -->
    <Color x:Key="SuccessSubtleColor">#DCFCE7</Color>
    <Color x:Key="WarningSubtleColor">#FEF3C7</Color>
    <Color x:Key="ErrorSubtleColor">#FEE2E2</Color>
    <Color x:Key="AccentSubtleColor">#FCE7F3</Color>
    <Color x:Key="ZebraColor">#FDF7F9</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextSelectedBrush" Color="{StaticResource TextSelectedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <!-- Subtle Badge & Chip Brushes -->
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}"/>
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="{StaticResource ErrorSubtleColor}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}"/>
    <SolidColorBrush x:Key="ZebraBrush" Color="{StaticResource ZebraColor}"/>

    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource SecondaryColor}"/>

    <!-- Sidebar / StatusBar (pink muda, teks plum — lembut, tidak gelap) -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource MenuBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource MenuTextColor}"/>
    <SolidColorBrush x:Key="SidebarAccentBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="Black" Opacity="0.06"/>
    <SolidColorBrush x:Key="SidebarPressedBrush" Color="Black" Opacity="0.12"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="{StaticResource TextSecondaryColor}"/>

    <!-- Helper brushes -->
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderSubtitleBrush" Color="#FFFFFF" Opacity="0.85"/>
    <SolidColorBrush x:Key="LogoCircleBackgroundBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ErrorOverlayBrush" Color="{StaticResource ErrorColor}" Opacity="0.10"/>

    <SolidColorBrush x:Key="OnPrimaryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnPrimarySubtleBrush" Color="#FFFFFF" Opacity="0.85"/>
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF"/>

    <!-- Font -->
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

</ResourceDictionary>