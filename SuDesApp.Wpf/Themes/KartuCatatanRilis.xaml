<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SuDesApp.Wpf.ViewModels">
    <!--
        Satu kartu versi catatan rilis, dipakai halaman Catatan Rilis (tiga kartu
        terbaru). Bentuk kartunya hanya ditulis sekali di kamus ini.

        Pemakaian di halaman:
            <ItemsControl ItemsSource="{Binding Entries}"
                          ItemTemplate="{StaticResource KartuCatatanRilis}"/>
    -->
    <!-- Konverter sendiri supaya kamus ini bisa dipakai halaman mana pun tanpa
         bergantung pada konverter milik App.xaml. -->
    <BooleanToVisibilityConverter x:Key="RilisVis"/>

    <DataTemplate x:Key="KartuCatatanRilis">
        <Border Style="{DynamicResource CardStyle}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <!-- Judul versi + badge TERBARU (satu baris yang membungkus bila panjang,
                         sehingga judul panjang tidak pernah terpotong oleh lebar kartu) -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                            Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Center">
                        <TextBlock Text="&#x1F4CC;" FontSize="14" Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontWeight="Bold"
                               FontSize="15" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                    <Border Grid.Column="2" Background="{DynamicResource AccentBrush}" CornerRadius="10"
                            Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsLatest, Converter={StaticResource RilisVis}}">
                        <TextBlock Text="TERBARU" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource OnAccentTextBrush}"/>
                    </Border>
                </Grid>

                <!-- Bagian di dalam satu versi -->
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Bar aksen kiri: warnanya mengikuti jenis sub-bagian
                                         (Fitur Baru = hijau, Perbaikan = oranye, lainnya = aksen tema) -->
                                    <Border Grid.Column="0" Width="4" Height="14" CornerRadius="2"
                                            Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Jenis}" Value="{x:Static local:GayaRilisCatatan.FiturBaru}">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Jenis}" Value="{x:Static local:GayaRilisCatatan.Perbaikan}">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding Heading}" FontWeight="SemiBold"
                                               FontSize="13" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>

                                    <!-- Badge jenis sub-bagian -->
                                    <Border Grid.Column="2" CornerRadius="9" Padding="8,2" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Jenis}" Value="{x:Static local:GayaRilisCatatan.FiturBaru}">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Jenis}" Value="{x:Static local:GayaRilisCatatan.Perbaikan}">
                                                        <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding LabelJenis}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Jenis}" Value="{x:Static local:GayaRilisCatatan.FiturBaru}">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Jenis}" Value="{x:Static local:GayaRilisCatatan.Perbaikan}">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Points}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Grid (bukan StackPanel Horizontal) agar kolom teks
                                                 terikat lebar viewport dan wrap — tidak memicu
                                                 scroll horizontal. -->
                                            <Grid Margin="12,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#x2022;"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           LineHeight="20"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
