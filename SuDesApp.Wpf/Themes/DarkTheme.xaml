<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme — Material dark + aksen hijau emerald: kanvas #121212,
         kartu #1E1E1E, panel #242424 (Material); aksen emerald #34D399 (logo,
         seleksi), header emerald tua #047857, sidebar/statusbar hijau tua
         #14261F. Semua warna statis di sini TIDAK ikut berubah saat pengguna
         mengganti tema berwarna. -->

    <!-- Header/tombol digelapkan ke emerald-700/800 agar teks putih di atasnya
         lolos WCAG AA — diperiksa KontrasTemaTests. -->
    <Color x:Key="PrimaryColor">#047857</Color>
    <!-- Secondary = emerald-800: dipakai tombol utama (PrimaryButton) -->
    <Color x:Key="SecondaryColor">#065F46</Color>
    <Color x:Key="AccentColor">#34D399</Color>
    <Color x:Key="BackgroundColor">#121212</Color>
    <Color x:Key="SurfaceColor">#1E1E1E</Color>
    <Color x:Key="TextColor">#E0E0E0</Color>
    <Color x:Key="TextSecondaryColor">#BDBDBD</Color>
    <Color x:Key="TextSelectedColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#2F3733</Color>
    <Color x:Key="PanelColor">#242424</Color>
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="MenuBackgroundColor">#14261F</Color>
    <Color x:Key="MenuTextColor">#E6F2EC</Color>
    <Color x:Key="AccentLightColor">#6EE7B7</Color>
    <Color x:Key="AccentDarkColor">#047857</Color>
    <Color x:Key="ShadowColor">#50000000</Color>

    <!-- Subtle badge colors for dark mode -->
    <Color x:Key="SuccessSubtleColor">#14532D</Color>
    <Color x:Key="WarningSubtleColor">#78350F</Color>
    <Color x:Key="ErrorSubtleColor">#7F1D1D</Color>
    <Color x:Key="AccentSubtleColor">#123B2C</Color>
    <Color x:Key="ZebraColor">#212925</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextSelectedBrush" Color="{StaticResource TextSelectedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <!-- Subtle Badge & Chip Brushes -->
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}"/>
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="{StaticResource ErrorSubtleColor}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}"/>
    <SolidColorBrush x:Key="ZebraBrush" Color="{StaticResource ZebraColor}"/>

    <SolidColorBrush x:Key="SuccessTextBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FCD34D"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#6EE7B7"/>

    <!-- Sidebar / StatusBar -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource MenuBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource MenuTextColor}"/>
    <SolidColorBrush x:Key="SidebarAccentBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource AccentColor}" Opacity="0.15"/>
    <SolidColorBrush x:Key="SidebarPressedBrush" Color="{StaticResource AccentColor}" Opacity="0.25"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource MenuBackgroundColor}"/>
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="{StaticResource TextSecondaryColor}"/>

    <!-- Helper brushes untuk teks di atas header berwarna -->
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="HeaderSubtitleBrush" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="LogoCircleBackgroundBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ErrorOverlayBrush" Color="{StaticResource ErrorColor}" Opacity="0.18"/>

    <SolidColorBrush x:Key="OnPrimaryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnPrimarySubtleBrush" Color="#FFFFFF" Opacity="0.85"/>
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#0F172A"/>

    <!-- Teks di atas lencana/tombol status. Nilainya dipilih agar lolos WCAG AA
         (>= 4,5:1 terhadap latarnya) — diperiksa Tools/check-kontras-wcag.ps1
         dan dijaga otomatis oleh uji KontrasTemaTests. -->
    <SolidColorBrush x:Key="OnSuccessTextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="OnWarningTextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="OnErrorTextBrush" Color="#0F172A"/>

    <!-- Font -->
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

</ResourceDictionary>
