<UserControl x:Class="SuDesApp.Wpf.Views.FormulirView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Baris daftar formulir: kartu ringkas yang menyala saat disentuh kursor. -->
        <Style x:Key="BarisFormulir" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Kotak centang bulat bertema (sama seperti daftar fitur di halaman lain). -->
        <Style x:Key="CentangFormulir" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CheckMark" Text="&#x2713;" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource OnPrimaryTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Papan angka ringkas di atas daftar (jumlah formulir, ukuran, pilihan). -->
        <Style x:Key="PapanAngka" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="PapanAngkaJudul" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PapanAngkaNilai" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Keterangan pendukung (kartu informasi di bawah daftar). -->
        <Style x:Key="InformasiJudul" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="InformasiIsi" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Kepala halaman ===== -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#x1F4C1;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
<StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
    <TextBlock Text="PENGATURAN FORMULIR" Style="{StaticResource HeaderTitle}"
               AutomationProperties.Name="PENGATURAN FORMULIR"/>
    <TextBlock Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"
               Text="Kelola template formulir PDF yang dipakai menu Formulir — tambah berkas sendiri, unduh formulir resmi, cadangkan ke Google Drive, atau buka pratinjau langsung di aplikasi."/>
</StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Isi halaman ===== -->
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Papan angka: keadaan folder dan pilihan sekarang (membungkus di jendela sempit) -->
                <WrapPanel Margin="0,0,0,12">
                    <Border Style="{StaticResource PapanAngka}" MinWidth="190">
                        <StackPanel>
                            <TextBlock Text="Formulir tersedia" Style="{StaticResource PapanAngkaJudul}"/>
                            <TextBlock Text="{Binding RingkasanJumlah, Mode=OneWay}" Style="{StaticResource PapanAngkaNilai}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PapanAngka}" MinWidth="190">
                        <StackPanel>
                            <TextBlock Text="Folder template" Style="{StaticResource PapanAngkaJudul}"/>
                            <TextBlock Text="{Binding NamaFolderTemplates, Mode=OneWay}" Style="{StaticResource PapanAngkaNilai}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PapanAngka}" MinWidth="190"
                            ToolTip="{Binding FolderTemplates, Mode=OneWay}">
                        <StackPanel>
                            <TextBlock Text="Pilihan Anda" Style="{StaticResource PapanAngkaJudul}"/>
                            <TextBlock Text="{Binding TeksTerpilih, Mode=OneWay}" Style="{StaticResource PapanAngkaNilai}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PapanAngka}" MinWidth="190"
                            ToolTip="{Binding KeteranganCadanganDrive, Mode=OneWay}">
                        <StackPanel>
                            <TextBlock Text="Cadangan Google Drive" Style="{StaticResource PapanAngkaJudul}"/>
                            <TextBlock FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PapanAngkaNilai}">
                                        <Setter Property="Text" Value="Nonaktif"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CadanganDriveAktif}" Value="True">
                                                <Setter Property="Text" Value="Aktif"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Kartu tawaran unduh (menggantikan popup otomatis) -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                        Background="{DynamicResource WarningSubtleBrush}"
                        Visibility="{Binding AdaTawaranUnduh, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="&#x26A0;" FontSize="18" Margin="0,0,10,0"
                                   VerticalAlignment="Top" Foreground="{DynamicResource WarningTextBrush}"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Formulir belum lengkap" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningTextBrush}"
                                       AutomationProperties.Name="Tawaran unduh formulir"/>
                            <TextBlock Text="{Binding TawaranUnduhTeks, Mode=OneWay}" TextWrapping="Wrap"
                                       FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource WarningTextBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                            <Button Content="Unduh Sekarang" Command="{Binding TerimaTawaranUnduhCommand}"
                                    Height="30" Padding="12,0" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="Nanti" Command="{Binding TutupTawaranUnduhCommand}"
                                    Height="30" Padding="12,0" Margin="8,0,0,0"
                                    Style="{StaticResource OutlineButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Kartu hasil unduhan / kesalahan terakhir (menggantikan dialog kabar) -->
                <Border Margin="0,0,0,12"
                        Visibility="{Binding AdaHasilUnduhan, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                            <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasilUnduhanBerhasil}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource ErrorSubtleBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontSize="17" Margin="0,0,10,0" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#x2714;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasilUnduhanBerhasil}" Value="False">
                                            <Setter Property="Text" Value="&#x2715;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding HasilUnduhanJudul, Mode=OneWay}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                       AutomationProperties.Name="Hasil unduh formulir"/>
                            <TextBlock Text="{Binding HasilUnduhanRingkas, Mode=OneWay}" TextWrapping="Wrap"
                                       FontSize="12" Margin="0,4,0,0" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <ItemsControl ItemsSource="{Binding HasilUnduhanRincian}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11.5"
                                                   Margin="0,1,0,1" LineHeight="17"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Button Grid.Column="2" Content="&#x2715;" Command="{Binding TutupHasilUnduhanCommand}"
                                Width="26" Height="26" VerticalAlignment="Top" BorderThickness="0"
                                FontSize="12" Cursor="Hand" ToolTip="Tutup ringkasan ini"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                AutomationProperties.Name="Tutup ringkasan unduhan"/>
                    </Grid>
                </Border>

                <!-- ===== Kartu daftar formulir ===== -->
                <Border Style="{StaticResource CardStyle}" Padding="14">
                    <StackPanel>
                        <!-- Baris alat: pencarian + tombol pilih semua & buka folder -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBox Style="{StaticResource FormField}"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Cari nama formulir atau kodenya, mis. SKTM atau F-1"
                                         AutomationProperties.Name="Cari formulir"/>
                                <TextBlock FontSize="11" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Ketik nama atau kode formulir untuk menyaring daftar di bawah."/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="{Binding TeksPilihSemua, Mode=OneWay}"
                                    Command="{Binding TogglePilihSemuaCommand}"
                                    Height="32" Padding="14,0" Margin="0,0,8,0" VerticalAlignment="Top"
                                    Style="{StaticResource OutlineButton}"
                                    ToolTip="Centang/hapus centang semua formulir yang sedang tampil"
                                    AutomationProperties.Name="Pilih semua formulir tampil"/>

                            <Button Grid.Column="2" Content="Buka Folder"
                                    Command="{Binding BukaFolderCommand}"
                                    Height="32" Padding="14,0" VerticalAlignment="Top"
                                    Style="{StaticResource OutlineButton}"
                                    ToolTip="{Binding FolderTemplates, Mode=OneWay}"
                                    AutomationProperties.Name="Buka folder Templates"/>
                        </Grid>

                        <!-- Daftar formulir -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                Visibility="{Binding HasTemplates, Converter={StaticResource BoolToVis}}">
                            <ListBox ItemsSource="{Binding TemplatesTampil}"
                                     BorderThickness="0" Margin="4"
                                     SelectionMode="Single"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MaxHeight="330"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BarisFormulir}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" Style="{StaticResource CentangFormulir}"
                                                          IsChecked="{Binding IsChecked}"
                                                          AutomationProperties.Name="{Binding NamaBerkas, Mode=OneWay}"
                                                          ToolTip="Centang untuk memilih formulir ini"/>

                                                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding RingkasanTeks, Mode=OneWay}"
                                                               FontSize="11" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>

<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
    <Border CornerRadius="5" Padding="7,2" Margin="0,0,8,0"
            VerticalAlignment="Center"
            Background="{DynamicResource AccentSubtleBrush}"
            Visibility="{Binding AdaKode, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding KodeFormulir, Mode=OneWay}" FontSize="10.5"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentTextBrush}"/>
    </Border>

    <Button Content="Pratinjau" Command="{Binding BukaCommand}"
            Height="26" Padding="10,0" BorderThickness="0"
            Cursor="Hand" Background="Transparent"
            Foreground="{DynamicResource AccentTextBrush}"
            ToolTip="Buka pratinjau PDF formulir ini di dalam aplikasi"
            AutomationProperties.Name="Pratinjau formulir"/>
</StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Daftar kosong (belum ada berkas atau pencarian tanpa hasil) -->
                        <Border Padding="18" CornerRadius="8"
                                Background="{DynamicResource PanelBrush}"
                                Visibility="{Binding KosongTanpaFormulir, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#x1F4C4;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Belum ada formulir di folder Templates" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Tambahkan berkas PDF sendiri lewat tombol Tambah, atau unduh formulir resmi dengan tombol Unduh dari Sumber."
                                               TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Padding="18" CornerRadius="8"
                                Background="{DynamicResource PanelBrush}"
                                Visibility="{Binding KosongKarenaPencarian, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding PesanKosong, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>

                        <!-- Tombol aksi daftar -->
                        <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Unduh dari Sumber" Command="{Binding DownloadCommand}"
                                    Height="34" Padding="16,0" Margin="0,0,8,8"
                                    Style="{StaticResource SuccessButton}"
                                    ToolTip="Ambil daftar formulir resmi, lalu unduh yang belum ada di folder Templates"
                                    AutomationProperties.Name="Unduh formulir dari sumber"/>

                            <Button Content="Tambah" Command="{Binding AddCommand}"
                                    Height="34" Padding="16,0" Margin="0,0,8,8"
                                    Style="{StaticResource PrimaryButton}"
                                    ToolTip="Salin satu berkas PDF dari komputer ke folder Templates"
                                    AutomationProperties.Name="Tambah formulir"/>

                        </WrapPanel>

                        <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Tombol Segarkan dan Hapus Terpilih ada di bilah bawah halaman. Formulir yang dicentang hanya ditandai; berkasnya benar-benar dihapus setelah Anda menekan Hapus Terpilih dan menyetujui konfirmasi."/>

                        <!-- Penanda pekerjaan berjalan (unduh/segarkan) tanpa dialog -->
                        <Border Margin="0,6,0,0" CornerRadius="6" Padding="8,3"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentSubtleBrush}"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Sedang bekerja — lihat keterangan di bilah bawah" FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== Kartu informasi ===== -->
                <Border Style="{StaticResource FormCard}" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="INFORMASI PENGGUNAAN" Style="{StaticResource FormSectionTitle}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
                                <TextBlock Text="&#x1F4C4;  Folder Templates" Style="{StaticResource InformasiJudul}"/>
                                <TextBlock Style="{StaticResource InformasiIsi}"
                                           Text="Setiap berkas PDF di folder Templates menjadi satu formulir pada menu Formulir. Nama berkas digunakan sebagai nama formulir — ganti nama berkas jika ingin nama yang lebih rapi."/>
                                <TextBlock Style="{StaticResource InformasiIsi}" FontSize="11"
                                           Text="{Binding FolderTemplates, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="&#x1F310;  Sumber Resmi" Style="{StaticResource InformasiJudul}"/>
                                <TextBlock Style="{StaticResource InformasiIsi}">
                                    <Run Text="Tombol &#x201C;Unduh dari Sumber&#x201D; mengambil formulir dari "/>
                                    <Run Text="{Binding SumberFormulirTeks, Mode=OneWay}"/>
                                    <Run Text=" dan melewati formulir yang sudah ada, sehingga aman ditekan berulang kali. Setiap berkas divalidasi terlebih dahulu apakah benar berformat PDF sebelum disimpan."/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="&#x2601;  Cadangan Google Drive" Style="{StaticResource InformasiJudul}"/>
                                <TextBlock Style="{StaticResource InformasiIsi}"
                                           Text="{Binding KeteranganCadanganDrive, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="&#x1F6E1;  Keamanan Data" Style="{StaticResource InformasiJudul}"/>
                                <TextBlock Style="{StaticResource InformasiIsi}"
                                           Text="Halaman ini hanya mengelola berkas formulir. Database surat, template surat, dan pengaturan desa tidak pernah diubah oleh operasi tambah, unduh, maupun hapus formulir. Sebelum berkas dihapus, aplikasi selalu meminta konfirmasi terlebih dahulu."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Catatan: formulir bertanda kode (mis. F-1.01) adalah formulir resmi Dukcapil; formulir tanpa kode adalah berkas yang Anda tambahkan sendiri."/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Statusbar halaman (kontrol bersama, sama seperti Pengaturan Aplikasi) ===== -->
        <c:AppStatusBar Grid.Row="2" Margin="0,12,0,0"
                        StatusText="{Binding StatusText, FallbackValue='Siap'}">
            <c:AppStatusBar.Buttons>
                <Button Content="Segarkan" Command="{Binding RefreshCommand}"
                        Width="104" Height="30" Margin="0,0,8,0" VerticalAlignment="Center"
                        Style="{StaticResource OutlineButton}"/>
                <Button Content="Hapus Terpilih" Command="{Binding DeleteCommand}"
                        Width="120" Height="30" VerticalAlignment="Center"
                        Style="{StaticResource DangerButton}"/>
            </c:AppStatusBar.Buttons>
        </c:AppStatusBar>
    </Grid>
</UserControl>
