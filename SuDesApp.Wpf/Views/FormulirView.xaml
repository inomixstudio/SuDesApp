<UserControl x:Class="SuDesApp.Wpf.Views.FormulirView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#x1F4C1;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Pengaturan Formulir" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Kelola template formulir (PDF) di folder Templates" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Daftar template dengan checkbox -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Daftar Template PDF" FontWeight="SemiBold"
                           FontSize="14" Margin="2,2,6,10"
                           Foreground="{DynamicResource TextBrush}"/>

                <ListBox Grid.Row="1" ItemsSource="{Binding Templates}"
                         BorderThickness="0" Margin="0"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Padding="10,6" Margin="0,2"
                                    BorderThickness="0" Background="Transparent" CornerRadius="6">
                                <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="Box" Grid.Column="0" Width="18" Height="18"
                                                        CornerRadius="4" Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="CheckMark" Text="&#x2713;" FontSize="11"
                                                               FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="Collapsed"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="&#x1F4C4;" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="15" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1" Text="Belum ada template. Gunakan tombol Tambah untuk menambahkan file PDF."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- Statusbar: tinggi tetap agar tombol tidak bergeser saat teks muncul -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12,6" MinHeight="34"
                Margin="0,12,0,0" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <!-- spinner kecil -->
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <Border Grid.Column="2" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="9"
                        Padding="9,2" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}">
                        <Run Text="{Binding TemplateCount, Mode=OneWay}"/>
                        <Run Text="formulir"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- Tombol -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"
                    Visibility="{Binding HasTemplates, Converter={StaticResource BoolToVis}}">
            <Button Content="Unduh dari Sumber" Command="{Binding DownloadCommand}" Width="150" Height="34" Margin="0,0,8,0"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentTextBrush}"/>
            <Button Content="Segarkan" Command="{Binding RefreshCommand}" Width="100" Height="34" Margin="0,0,8,0"/>
            <Button Content="Tambah" Command="{Binding AddCommand}" Width="100" Height="34" Margin="0,0,8,0"
                    Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryTextBrush}"/>
            <Button Content="Hapus" Command="{Binding DeleteCommand}" Width="100" Height="34"
                    Background="{DynamicResource ErrorBrush}" Foreground="{DynamicResource OnAccentTextBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>