<UserControl x:Class="SuDesApp.Wpf.Views.IsiTemplateSuratView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kepala halaman -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#128196;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NamaTemplate, Mode=OneWay}" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Style="{StaticResource HeaderSubtitle}"
                               Text="{Binding KeteranganHalaman, Mode=OneWay}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
            <StackPanel>
                <!-- Surat & nomor -->
                <Border Style="{StaticResource FormCard}">
                  <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="SURAT &amp; NOMOR" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nomor Surat" Style="{StaticResource FormLabel}"
                                   Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Tanggal Surat" Style="{StaticResource FormLabel}"
                                   Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Nama Penandatangan (opsional)" Style="{StaticResource FormLabel}"
                                   Margin="0,0,0,0"/>

                        <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource FormField}" Margin="0,0,8,0"
                                 Text="{Binding NomorSurat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Nomor Surat"
                                 ToolTip="Nomor terisi otomatis; boleh diubah bila kantor desa memakai nomor lain"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" Style="{StaticResource FormDate}" Margin="0,0,8,0"
                                    SelectedDate="{Binding TanggalSurat, Mode=TwoWay}"
                                    AutomationProperties.Name="Tanggal Surat"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource FormField}" Margin="0,0,0,0"
                                 Text="{Binding NamaPejabat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Nama Penandatangan"
                                 ToolTip="Kosongkan untuk memakai nama Kepala Desa dari pengaturan"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Kolom isian sesuai pilihan pada template -->
                <ItemsControl ItemsSource="{Binding Kolom}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FormCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Kelompok, Mode=OneWay}" FontWeight="Bold" FontSize="13"
                                               TextWrapping="Wrap" Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,0,0,4"
                                               Visibility="{Binding TampilKelompok, Converter={StaticResource BoolToVis}}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding LabelTampil}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Bantuan, Mode=OneWay}" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="8,0,0,0"/>
                                    </Grid>

                                    <ComboBox ItemsSource="{Binding Pilihan}" SelectedItem="{Binding Nilai, Mode=TwoWay}"
                                              Style="{StaticResource FormCombo}"
                                              Visibility="{Binding PunyaPilihan, Converter={StaticResource BoolToVis}}"
                                              ToolTip="Pilih salah satu"/>

                                    <TextBox Text="{Binding Nilai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="{Binding MultiBaris, Mode=OneWay}"
                                             TextWrapping="Wrap" MinHeight="30" Margin="0,6,0,0"
                                             VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="{Binding Label}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource FormField}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PunyaPilihan}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <TextBlock Text="{Binding Kesalahan, Mode=OneWay}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource ErrorTextBrush}"
                                               FontWeight="SemiBold"
                                               Visibility="{Binding AdaKesalahan, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Template ini tidak memakai kolom isian — cukup nomor dan tanggal surat."
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                           Visibility="{Binding TidakAdaKolom, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Panel aksi -->
        <Border Grid.Row="2" Style="{StaticResource ToolbarCard}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RingkasanSusunan, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PesanKesalahan, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,0"
                               FontWeight="SemiBold" Foreground="{DynamicResource ErrorTextBrush}"
                               Visibility="{Binding AdaKesalahan, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Kosongkan" Command="{Binding KosongkanCommand}" Style="{StaticResource OutlineButton}"
                            Height="34" Margin="0,0,8,0" ToolTip="Kosongkan seluruh isian"/>
                    <Button Content="Batal" Command="{Binding BatalCommand}" Style="{StaticResource SecondaryButton}"
                            Height="34" Margin="0,0,8,0" ToolTip="Kembali ke tampilan awal"/>
                    <Button Content="{Binding TeksTombolSimpan, Mode=OneWay}" Command="{Binding SimpanCommand}" Style="{StaticResource SuccessButton}"
                            Height="34" MinWidth="160" IsDefault="True"
                            ToolTip="Buat PDF surat lalu tampilkan pratinjaunya"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
