<UserControl xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities" x:Class="SuDesApp.Wpf.Views.BerandaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             FontSize="14" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <!-- Kartu statistik: angka besar + label kecil (basis KpiCardStyle global) -->
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource KpiCardStyle}">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>

        <!-- Chip ikon bulat kartu KPI: 40 px, sama seperti halaman Register, supaya
             deretan angka tidak tampak setengah jadi. -->
        <Style x:Key="KpiChipBulat" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
        <Style x:Key="KpiChipIkon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppIconFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Tombol pintasan jenis surat: kartu klik-able. Angkat/tekan/pantul ditangani
             ctrl:KartuHalus supaya durasinya ikut kecepatan animasi pilihan pengguna —
             dulu EventTrigger dengan durasi tetap 140/180 ms di XAML, dan nilai itu
             tidak bisa berubah saat aplikasi berjalan. -->
        <Style x:Key="PintasanCard" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="11,9"
                                c:KartuHalus.Aktif="True"
                                c:KartuHalus.JarakAngkat="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header halaman -->
        <Border x:Name="HeaderKartu" Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="{x:Static u:IkonMenu.Beranda}" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource AppIconFont}"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="BERANDA" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Style="{StaticResource HeaderSubtitle}">
                        <Run Text="{Binding Sapaan, Mode=OneWay}"/>
                        <Run Text="  •  "/>
                        <Run Text="{Binding TanggalTeks, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Skeleton loading: tampil selama memuat supaya kartu tidak kosong 0 -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,0,8">
                    <Border Style="{StaticResource SkeletonBar}" Width="220" HorizontalAlignment="Left"/>
                    <Border Style="{StaticResource SkeletonBar}" Width="160" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- ===== Kartu statistik ===== -->
                <!-- Sama seperti kartu KPI halaman Register: angka di kiri, chip ikon
                     bulat di kanan. Tanpa chip, kartu 4 kolom hanya berisi dua baris
                     teks dan menyisakan ruang kosong selebar kartu di tiap kolom. -->
                <UniformGrid x:Name="StatGrid" Columns="4" Margin="0,0,-12,0">
                    <Border Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="SURAT HARI INI" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="NilaiHariIni" Text="{Binding SuratHariIni}" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource KpiChipBulat}"
                                    Background="{DynamicResource AccentSubtleBrush}">
                                <TextBlock Text="{x:Static u:IkonMenu.Dokumen}" Style="{StaticResource KpiChipIkon}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="SURAT BULAN INI" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="NilaiBulanIni" Text="{Binding SuratBulanIni}" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource KpiChipBulat}"
                                    Background="{DynamicResource AccentSubtleBrush}">
                                <TextBlock Text="{x:Static u:IkonMenu.Agenda}" Style="{StaticResource KpiChipIkon}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL REGISTER" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="NilaiTotal" Text="{Binding TotalSurat}" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource KpiChipBulat}"
                                    Background="{DynamicResource PanelBrush}">
                                <TextBlock Text="{x:Static u:IkonMenu.SuratMasuk}" Style="{StaticResource KpiChipIkon}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="WARGA TERDATA" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="NilaiWarga" Text="{Binding TotalWarga}" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource KpiChipBulat}"
                                    Background="{DynamicResource SuccessSubtleBrush}">
                                <TextBlock Text="{x:Static u:IkonMenu.Orang}" Style="{StaticResource KpiChipIkon}"
                                           Foreground="{DynamicResource SuccessTextBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- ===== Pintasan cepat ===== -->
                <Border x:Name="PintasanKartu" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="PINTASAN CEPAT" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text=" — jenis surat yang paling sering dipakai"
                                       FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Pintasan}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PintasanCard}" Margin="0,0,10,10"
                                            Command="{Binding Buka}" CommandParameter="{Binding Jenis}"
                                            AutomationProperties.Name="{Binding Nama}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Ikon}" FontSize="15" FontFamily="{StaticResource AppIconFont}"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       Width="24" TextAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Nama}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding JumlahTeks}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== Aktivitas terbaru + aksi cepat ===== -->
                <Grid x:Name="BawahGrid" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Aktivitas terbaru -->
                    <!-- Isi kartu memakai Grid dua baris: judul di atas, badan mengisi
                     sisa tinggi. Kartu ini berdiri di lajur yang sama dengan kartu
                     "Aksi Cepat" yang lebih tinggi, jadi tanpa badan yang mengisi,
                     keadaan kosong menumpuk di sudut kiri atas dan separuh kartu
                     menjadi ruang kosong. -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource AccentSectionBar}"/>
                                <TextBlock Text="AKTIVITAS TERBARU" FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <c:EmptyStateView Ikon="{x:Static u:IkonMenu.Dokumen}"
                                                  Judul="Belum ada surat di register"
                                                  Pesan="Surat yang Anda buat akan tercatat di sini."
                                                  Petunjuk="Mulai dari menu Buat Surat Baru atau buka Pintasan Cepat di atas."
                                                  VerticalAlignment="Center">
                                    <c:EmptyStateView.Style>
                                        <Style TargetType="c:EmptyStateView">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Terbaru.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </c:EmptyStateView.Style>
                                </c:EmptyStateView>

                                <ItemsControl ItemsSource="{Binding Terbaru}" VerticalAlignment="Top">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}"
                                                Padding="0,9" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding TanggalSurat, StringFormat='{}{0:dd/MM/yyyy}'}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding JenisSurat}" FontWeight="SemiBold"
                                                               FontSize="13" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding NomorSurat, Mode=OneWay}"/>
                                                        <Run Text="  •  "/>
                                                        <Run Text="{Binding Perihal, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Aksi cepat -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource AccentSectionBar}"/>
                                <TextBlock Text="AKSI CEPAT" FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Content="Register Surat" Margin="0,0,0,8"
                                    Style="{StaticResource OutlineButton}"
                                    Command="{Binding BukaHalamanCommand}" CommandParameter="REGISTER"/>
                            <Button Content="Riwayat Aktivitas" Margin="0,0,0,8"
                                    Style="{StaticResource OutlineButton}"
                                    Command="{Binding BukaHalamanCommand}" CommandParameter="RIWAYAT"/>
                            <Button Content="Pengaturan Surat" Margin="0,0,0,8"
                                    Style="{StaticResource OutlineButton}"
                                    Command="{Binding BukaHalamanCommand}" CommandParameter="PENGATURAN"/>
                            <Button Content="Template Surat" Margin="0,0,0,8"
                                    Style="{StaticResource OutlineButton}"
                                    Command="{Binding BukaHalamanCommand}" CommandParameter="TEMPLATE"/>
                            <Button Content="Muat Ulang Ringkasan"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding MuatUlangCommand}"/>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Tip: klik jenis surat pada Pintasan Cepat untuk langsung membuka form pengisian."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Statusbar halaman: status ringkasan (kiri) + identitas aplikasi (kanan) -->
        <c:AppStatusBar Grid.Row="2" Margin="0,12,0,0" StatusText="{Binding PesanStatus, Mode=OneWay}"/>
    </Grid>
</UserControl>