<UserControl x:Class="SuDesApp.Wpf.Views.PdfPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄" Foreground="{DynamicResource TextBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="EditBtn" Content="✏️ Edit" Command="{Binding EditCommand}"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                            ToolTip="Perbaiki data surat ini — buka form edit (menu utama nonaktif sampai form ditutup)"
                            Style="{StaticResource PrimaryButton}" Height="30" Margin="0,0,8,0"/>
                    <Button x:Name="ZoomOutBtn" Content="−" Click="ZoomOut_Click" ToolTip="Perkecil"
                            Width="32" Height="30"/>
                    <TextBlock x:Name="ZoomText" Text="100%" FontSize="12" VerticalAlignment="Center" Margin="4,0"
                               MinWidth="46" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="ZoomInBtn" Content="+" Click="ZoomIn_Click" ToolTip="Perbesar"
                            Width="32" Height="30"/>
                    <Button x:Name="FitWidthBtn" Content="⤢" Click="FitWidth_Click" ToolTip="Sesuaikan lebar"
                            Width="32" Height="30" Margin="8,0,8,0"/>
                    <Button x:Name="ExportBtn" Content="📤 Ekspor" Command="{Binding ExportCommand}"
                            ToolTip="Simpan salinan PDF ini ke lokasi pilihan Anda"
                            Style="{StaticResource SuccessButton}" Height="30" Margin="0,0,8,0"/>
                    <Button x:Name="PrintBtn" Content="Cetak" Click="Print_Click" ToolTip="Cetak dokumen ke printer"
                            Style="{StaticResource SecondaryButton}" Height="30" Margin="0,0,8,0"/>
                    <Button Content="Batal" Command="{Binding BatalCommand}" ToolTip="Kembali ke tampilan awal"
                            Style="{StaticResource OutlineButton}" Height="30"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pratinjau PDF (PDFium) -->
        <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True">
            <Grid>
                <ScrollViewer x:Name="ScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Background="White">
                    <StackPanel x:Name="PagesPanel" Margin="16" VerticalAlignment="Top">
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="MissingPanel" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⚠️ Dokumen tidak ditemukan" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="File PDF yang dituju tidak dapat dibuka."
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>