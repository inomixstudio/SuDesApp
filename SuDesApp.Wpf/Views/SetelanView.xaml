<UserControl x:Class="SuDesApp.Wpf.Views.SetelanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#x1F3E1;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Pengaturan Desa" Style="{StaticResource HeaderTitle}"
                               AutomationProperties.Name="PENGATURAN DESA"/>
                    <TextBlock Text="Konfigurasi data informasi desa" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- DATA DESA -->
                <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="DATA DESA" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center"
                                       AutomationProperties.Name="DATA DESA"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama Desa *" VerticalAlignment="Center" Margin="0,6"
                                       Foreground="{DynamicResource TextBrush}"
                                       AutomationProperties.Name="Nama Desa"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NamaDesa, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"
                                     AutomationProperties.Name="Nama Desa"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Kecamatan *" VerticalAlignment="Center" Margin="0,6"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Kecamatan, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Kabupaten *" VerticalAlignment="Center" Margin="0,6"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Kabupaten, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Alamat *" VerticalAlignment="Center" Margin="0,6"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Alamat, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Kodepos" VerticalAlignment="Center" Margin="0,6"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Kodepos, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PEJABAT DESA -->
                <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="PEJABAT DESA" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Kepala Desa *" VerticalAlignment="Center" Margin="0,6"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding KepalaDesa, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Sekretaris Desa *" VerticalAlignment="Center" Margin="0,6"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Sekdes, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PEJABAT KECAMATAN -->
                <Border Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="PEJABAT KECAMATAN" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama Camat" VerticalAlignment="Center" Margin="0,6"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NamaCamat, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="NIP Camat" VerticalAlignment="Center" Margin="0,6"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NipCamat, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Golongan" VerticalAlignment="Center" Margin="0,6"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GolCamat, UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PENGATURAN CETAK: ukuran kertas & logo kop -->
                <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="PENGATURAN CETAK" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ukuran Kertas PDF" VerticalAlignment="Top" Margin="0,6"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,6">
                                <RadioButton Content="A4 — 210 x 297 mm (bawaan)" GroupName="UkuranKertasSurat"
                                             IsChecked="{Binding UkuranKertasA4}" Margin="0,0,0,6"
                                             Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Ukuran kertas A4"/>
                                <RadioButton Content="F4 / Folio — 8,5 x 13 inci" GroupName="UkuranKertasSurat"
                                             IsChecked="{Binding UkuranKertasF4}"
                                             Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Ukuran kertas F4"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Logo Kop Surat" VerticalAlignment="Top" Margin="0,6"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="8" HorizontalAlignment="Left">
                                    <Image Source="{Binding JalurLogo}" Height="72" Stretch="Uniform"
                                           HorizontalAlignment="Left" AutomationProperties.Name="Pratinjau logo kop"/>
                                </Border>
                                <TextBlock Text="{Binding KeteranganLogo}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Ganti Logo…" Command="{Binding GantiLogoCommand}" Height="32" Padding="14,0"
                                            Style="{StaticResource OutlineButton}" AutomationProperties.Name="Ganti logo kop surat"/>
                                    <Button Content="Pakai Logo Bawaan" Command="{Binding PakaiLogoBawaanCommand}" Height="32" Padding="14,0"
                                            Margin="8,0,0,0" Style="{StaticResource OutlineButton}"
                                            AutomationProperties.Name="Pakai logo bawaan"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock TextWrapping="Wrap" Margin="0,14,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Ukuran kertas dan logo ini dipakai semua dokumen: surat, daftar hadir, dan rekening koran. Perubahan langsung tersimpan tanpa menekan tombol Simpan."/>
                    </StackPanel>
                </Border>

                <!-- Pengaturan login & keamanan pindah ke menu Pengaturan Aplikasi -->
            </StackPanel>
        </ScrollViewer>

        <!-- Statusbar halaman: status simpan (kiri) + identitas aplikasi + tombol (kanan) -->
        <c:AppStatusBar Grid.Row="2" Margin="0,16,0,0" StatusText="{Binding StatusPesan, FallbackValue='Siap'}">
            <c:AppStatusBar.Buttons>
                <Button Content="Batal" Command="{Binding CancelCommand}" Width="104" Height="30" Margin="0,0,8,0"
                        Style="{StaticResource OutlineButton}"/>
                <Button Content="Simpan" Command="{Binding SaveCommand}" Width="104" Height="30"
                        Style="{StaticResource PrimaryButton}"
                        AutomationProperties.Name="Simpan"/>
            </c:AppStatusBar.Buttons>
        </c:AppStatusBar>
    </Grid>
</UserControl>