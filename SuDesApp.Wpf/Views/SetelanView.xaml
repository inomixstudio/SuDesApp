<UserControl x:Class="SuDesApp.Wpf.Views.SetelanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ===== Tombol bagian pada navigasi kiri ===== -->
        <Style x:Key="BagianTombol" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Penanda kiri: bar aksen tipis pada bagian yang sedang aktif -->
                                <Border x:Name="BdIndikator" Grid.Column="0" Width="3"
                                        CornerRadius="1.5" Margin="0,2,8,2"
                                        Background="Transparent" VerticalAlignment="Stretch"/>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Aktif}" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter TargetName="BdIndikator" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Isi halaman (kepala, pratinjau kop, navigasi bagian, dan isian) digulir
                 sebagai satu halaman naik-turun; statusbar tetap di bawah. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" Padding="0,0,4,0">
        <!-- Seluruh isi halaman dibungkus satu kali di sini supaya dapat digulir
             naik-turun sebagai satu halaman; anak-anaknya masih memakai Grid.Row
             seperti sebelumnya (diabaikan StackPanel, jadi tidak perlu diubah). -->
        <StackPanel>

        <!-- ===== Kepala halaman ===== -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#127968;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Pengaturan Surat" Style="{StaticResource HeaderTitle}"
                               AutomationProperties.Name="PENGATURAN SURAT"/>
                    <TextBlock Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"
                               Text="Data desa dan pejabat yang dipakai seluruh surat, daftar hadir, dan rekening koran. Pilih bagian di sebelah kiri."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Pratinjau kop surat: mengikuti isian, belum perlu disimpan =====
             Warna kertas &amp; tinta sengaja tetap putih/gelap di semua tema karena
             yang digambar adalah hasil cetak — sama seperti pratinjau PDF di aplikasi. -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="PRATINJAU KOP SURAT" Style="{StaticResource FormSectionTitle}"
                                   AutomationProperties.Name="Pratinjau kop surat"/>
                        <TextBlock Text="langsung dari isian di halaman ini" FontSize="11" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PratinjauSesuaiTersimpan}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding PratinjauStatus, Mode=OneWay}" FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PratinjauSesuaiTersimpan}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <Button Content="{Binding PratinjauToggleTeks, Mode=OneWay}"
                                Command="{Binding PratinjauToggleCommand}"
                                Height="28" Padding="12,0" Margin="8,0,0,0"
                                Style="{StaticResource OutlineButton}"
                                AutomationProperties.Name="Buka tutup pratinjau kop surat"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0"
                      Visibility="{Binding PratinjauTerbuka, Converter={StaticResource BoolToVis}}">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                        <Border Background="#FFFFFF" BorderBrush="#D7DDE5" BorderThickness="1"
                                CornerRadius="3" Padding="22,14" Width="{Binding PratinjauLebarKertas}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Kotak logo: lebarnya tetap walau tanpa gambar, sama seperti PDF -->
                                    <Border Grid.Column="0" Width="{Binding PratinjauLebarLogo}"
                                            VerticalAlignment="Top">
                                        <Image Source="{Binding PratinjauJalurLogo, Mode=OneWay}"
                                               Stretch="Uniform" StretchDirection="DownOnly"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Visibility="{Binding PratinjauAdaLogo, Converter={StaticResource BoolToVis}}"
                                               AutomationProperties.Name="Pratinjau logo kop surat"/>
                                    </Border>

                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding PratinjauKop}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Baris kop: teks utama, lalu surel desa (bila diisi)
                                                     dengan warna biru — sama seperti yang dicetak PDF. -->
                                                <TextBlock FontSize="{Binding Ukuran, Mode=OneWay}"
                                                           FontWeight="{Binding Ketebalan}"
                                                           FontFamily="Times New Roman"
                                                           Foreground="#111827" TextAlignment="Center">
                                                    <Run Text="{Binding Teks, Mode=OneWay}"/>
                                                    <Run Text="{Binding TeksSurel, Mode=OneWay}"
                                                         Foreground="{Binding WarnaSurel}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <!-- Garis ganda pemisah kop, seperti pada surat tercetak -->
                                <Rectangle Height="1.2" Fill="#111827" Margin="0,6,0,0"/>
                                <Rectangle Height="2.4" Fill="#111827" Margin="0,2,0,0"/>

                                <TextBlock Text="Blok tanda tangan di bagian bawah surat" FontSize="10"
                                           FontFamily="Segoe UI" Margin="0,8,0,0" Foreground="#6B7280"/>

                                <ItemsControl ItemsSource="{Binding PratinjauPejabat}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding PratinjauKolomPejabat}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Judul, Mode=OneWay}" FontSize="10"
                                                               FontWeight="SemiBold" FontFamily="Segoe UI"
                                                               Foreground="#4B5563"/>
                                                    <Border CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                                            Background="#FEF3C7"
                                                            Visibility="{Binding Kosong, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="belum diisi" FontSize="9"
                                                                   FontFamily="Segoe UI" Foreground="#92400E"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Jabatan, Mode=OneWay}" FontSize="11"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"
                                                           FontFamily="Times New Roman"
                                                           Foreground="#374151"/>
                                                <TextBlock Text="{Binding Nama, Mode=OneWay}" FontSize="12"
                                                           FontWeight="Bold" Margin="0,8,0,0"
                                                           TextWrapping="Wrap" FontFamily="Times New Roman"
                                                           Foreground="#111827"/>
                                                <TextBlock Text="{Binding BarisTambahan, Mode=OneWay}" FontSize="10"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"
                                                           Foreground="#4B5563"
                                                           Visibility="{Binding AdaBarisTambahan, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Viewbox>
                </Grid>

                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding PratinjauTerbuka, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding PratinjauInfoKertas, Mode=OneWay}" TextWrapping="Wrap"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PratinjauInfoCamat, Mode=OneWay}" TextWrapping="Wrap"
                               FontSize="11" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PratinjauInfoSurel, Mode=OneWay}" TextWrapping="Wrap"
                               FontSize="11" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PratinjauCatatanBersih, Mode=OneWay}" TextWrapping="Wrap"
                               FontSize="11" Margin="0,3,0,0"
                               Foreground="{DynamicResource AccentTextBrush}"
                               Visibility="{Binding AdaPratinjauCatatanBersih, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Teks dalam [kurung siku] atau garis bawah berarti kolomnya belum diisi dan surat akan mencetak penanda itu. Perubahan tersimpan setelah Anda menekan Simpan."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Navigasi bagian + isi bagian ===== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigasi kiri -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}" Margin="0,0,0,4">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="BAGIAN PENGATURAN" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Bagian}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BagianTombol}"
                                        Command="{Binding DataContext.PilihBagianCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Keterangan}"
                                        AutomationProperties.Name="{Binding Judul}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                                VerticalAlignment="Top" Margin="0,1,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Aktif}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding NomorTeks, Mode=OneWay}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Aktif}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Judul, Mode=OneWay}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Aktif}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Keterangan, Mode=OneWay}" FontSize="11"
                                                       Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                                            <Border Margin="0,6,0,0" CornerRadius="10" Padding="8,2"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding AdaLencana, Converter={StaticResource BoolToVis}}"
                                                    Background="{DynamicResource PanelBrush}">
                                                <TextBlock Text="{Binding Lencana, Mode=OneWay}" FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LencanaPeringatan}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource WarningTextBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Perubahan di halaman ini dipakai surat berikutnya setelah Anda menekan Simpan. Ukuran kertas dan logo tersimpan langsung."/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Isi bagian yang dipilih -->
            <Grid Grid.Column="1" Margin="14,0,0,0">
                <StackPanel>

                    <!-- Peringatan data contoh (hilang setelah data desa diisi) -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                            Background="{DynamicResource WarningSubtleBrush}"
                            Visibility="{Binding AdaPeringatanContoh, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#9888;" FontSize="18" Margin="0,0,10,0"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource WarningTextBrush}"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Data desa masih contoh bawaan aplikasi"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           AutomationProperties.Name="Peringatan data desa masih contoh"/>
                                <TextBlock Text="{Binding PesanPeringatanContoh, Mode=OneWay}" TextWrapping="Wrap"
                                           FontSize="12" Margin="0,4,0,0"
                                           Foreground="{DynamicResource WarningTextBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="Isi Data Desa" Height="30" Padding="12,0"
                                    VerticalAlignment="Top" Margin="12,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding PilihBagianCommand}"
                                    CommandParameter="{Binding Bagian[0]}"
                                    ToolTip="Buka bagian Data Desa untuk mengganti data contoh"/>
                        </Grid>
                    </Border>

                    <!-- ===== 1. DATA DESA ===== -->
                    <Border Style="{StaticResource FormCard}"
                            Visibility="{Binding TampilDesa, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                                <Border Style="{StaticResource AccentSectionBar}"/>
                                <TextBlock Text="DATA DESA" Style="{StaticResource FormSectionTitle}"/>
                            </StackPanel>

                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Nama desa, kecamatan, dan kabupaten dicetak pada kop surat; alamat dan kodepos melengkapinya, sedangkan email — bila diisi — dicetak biru di baris yang sama."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama Desa *" Style="{StaticResource FormLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                         Text="{Binding NamaDesa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Nama Desa"
                                         ToolTip="Nama desa tanpa kata &quot;Desa&quot;, mis. Sumberjaya"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Kecamatan *" Style="{StaticResource FormLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                         Text="{Binding Kecamatan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Kecamatan"
                                         ToolTip="Nama kecamatan tanpa kata &quot;Kecamatan&quot;, mis. Tempuran"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Kabupaten *" Style="{StaticResource FormLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormField}"
                                         Text="{Binding Kabupaten, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Kabupaten"
                                         ToolTip="Nama kabupaten tanpa kata &quot;Kabupaten&quot;, mis. Karawang"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Alamat *" Style="{StaticResource FormLabel}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormField}"
                                         Text="{Binding Alamat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Alamat Desa"
                                         ToolTip="Alamat kantor desa, mis. Jl. Raya Sumberjaya No. 1"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Kodepos" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Row="4" Grid.Column="1">
                                    <TextBox Style="{StaticResource FormField}" MaxLength="5"
                                             Text="{Binding Kodepos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Kodepos"
                                             ToolTip="Kodepos 5 digit, boleh dikosongkan"/>
                                    <TextBlock Text="5 digit angka (mis. 41361) — boleh dikosongkan."
                                               FontSize="11" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <!-- Email desa: opsional, dicetak biru di baris alamat kop. -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Email" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Row="5" Grid.Column="1">
                                    <TextBox Style="{StaticResource FormField}"
                                             Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Email Desa"
                                             ToolTip="Email kantor desa — opsional, dicetak biru pada baris alamat kop surat"/>
                                    <TextBlock Text="{Binding InfoEmail, Mode=OneWay}" TextWrapping="Wrap"
                                               FontSize="11" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== 2. PEJABAT DESA ===== -->
                    <Border Style="{StaticResource FormCard}"
                            Visibility="{Binding TampilPejabatDesa, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                                <Border Style="{StaticResource AccentSectionBar}"/>
                                <TextBlock Text="PEJABAT DESA" Style="{StaticResource FormSectionTitle}"/>
                            </StackPanel>

                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Nama pejabat dicetak pada blok tanda tangan surat — tulis lengkap dengan gelar bila perlu (mis. H. Suryana)."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Kepala Desa *" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBox Style="{StaticResource FormField}"
                                             Text="{Binding KepalaDesa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Kepala Desa"
                                             ToolTip="Nama Kepala Desa pada tanda tangan surat"/>
                                    <TextBlock Text="Dipakai pada surat yang ditandatangani Kepala Desa."
                                               FontSize="11" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Sekretaris Desa *" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBox Style="{StaticResource FormField}"
                                             Text="{Binding Sekdes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Sekretaris Desa"
                                             ToolTip="Nama Sekretaris Desa bila surat ditandatangani a.n. Kepala Desa"/>
                                    <TextBlock Text="Dipakai bila surat ditandatangani a.n. Kepala Desa (Sekretaris Desa)."
                                               FontSize="11" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== 3. PEJABAT KECAMATAN (opsional) ===== -->
                    <Border Style="{StaticResource FormCard}"
                            Visibility="{Binding TampilPejabatKecamatan, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                                <Border Style="{StaticResource AccentSectionBar}"/>
                                <TextBlock Text="PEJABAT KECAMATAN (OPSIONAL)" Style="{StaticResource FormSectionTitle}"/>
                                <Border Background="{DynamicResource SuccessSubtleBrush}" CornerRadius="10"
                                        Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Boleh dikosongkan" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessTextBrush}"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding InfoPejabatKecamatan, Mode=OneWay}" TextWrapping="Wrap"
                                       FontSize="12" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       AutomationProperties.Name="Keterangan Pejabat Kecamatan"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama Camat" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBox Style="{StaticResource FormField}"
                                             Text="{Binding NamaCamat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Nama Camat"
                                             ToolTip="Kosongkan bila tidak diperlukan — aplikasi tidak mengisi contoh"/>
                                    <TextBlock Text="Kosongkan bila surat tidak memakai nama camat."
                                               FontSize="11" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="NIP Camat" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBox Style="{StaticResource FormField}"
                                             Text="{Binding NipCamat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="NIP Camat"
                                             ToolTip="Minimal 9 digit bila diisi; boleh dikosongkan"/>
                                    <TextBlock Text="Minimal 9 digit bila diisi — boleh dikosongkan."
                                               FontSize="11" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Golongan" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBox Style="{StaticResource FormField}"
                                             Text="{Binding GolCamat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Golongan Camat"
                                             ToolTip="Mis. Pembina (IV/a); boleh dikosongkan"/>
                                    <TextBlock Text="Mis. Pembina (IV/a) — boleh dikosongkan."
                                               FontSize="11" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== 4. CETAK & LOGO ===== -->
                    <Border Style="{StaticResource FormCard}"
                            Visibility="{Binding TampilCetak, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                                <Border Style="{StaticResource AccentSectionBar}"/>
                                <TextBlock Text="CETAK &amp; LOGO" Style="{StaticResource FormSectionTitle}"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ukuran Kertas PDF" Style="{StaticResource FormLabel}"
                                           VerticalAlignment="Top"/>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <RadioButton Content="A4 — 210 x 297 mm (bawaan)" GroupName="UkuranKertasSurat"
                                                 IsChecked="{Binding UkuranKertasA4}"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 AutomationProperties.Name="Ukuran kertas A4"/>
                                    <RadioButton Content="F4 / Folio — 8,5 x 13 inci" GroupName="UkuranKertasSurat"
                                                 IsChecked="{Binding UkuranKertasF4}" Margin="0,6,0,0"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 AutomationProperties.Name="Ukuran kertas F4"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Logo Kop Surat" Style="{StaticResource FormLabel}"
                                           VerticalAlignment="Top" Margin="0,14,0,0"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                                    <Border Background="{DynamicResource PanelBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="8"
                                            HorizontalAlignment="Left">
                                        <Image Source="{Binding JalurLogo, Mode=OneWay}" Height="72" Stretch="Uniform"
                                               HorizontalAlignment="Left"
                                               AutomationProperties.Name="Pratinjau logo kop"/>
                                    </Border>
                                    <TextBlock Text="{Binding KeteranganLogo, Mode=OneWay}" TextWrapping="Wrap"
                                               Margin="0,8,0,0" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Ganti Logo…" Command="{Binding GantiLogoCommand}"
                                                Height="32" Padding="14,0"
                                                Style="{StaticResource OutlineButton}"
                                                AutomationProperties.Name="Ganti logo kop surat"/>
                                        <Button Content="Pakai Logo Bawaan" Command="{Binding PakaiLogoBawaanCommand}"
                                                Height="32" Padding="14,0" Margin="8,0,0,0"
                                                Style="{StaticResource OutlineButton}"
                                                AutomationProperties.Name="Pakai logo bawaan"/>
                                    </StackPanel>

                                    <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Ukuran kertas dan logo dipakai semua dokumen: surat, daftar hadir, dan rekening koran. Keduanya tersimpan langsung tanpa menekan Simpan."/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Pengaturan login & keamanan ada di menu Pengaturan Aplikasi -->
                </StackPanel>
            </Grid>
        </Grid>
        </StackPanel>
        </ScrollViewer>

        <!-- ===== Statusbar halaman: status simpan + tombol ===== -->
        <c:AppStatusBar Grid.Row="1" Margin="0,16,0,0" StatusText="{Binding StatusPesan, FallbackValue='Siap'}">
            <c:AppStatusBar.Buttons>
                <Button Content="Batal" Command="{Binding CancelCommand}" Width="104" Height="30" Margin="0,0,8,0"
                        Style="{StaticResource OutlineButton}"/>
                <Button Content="Simpan" Command="{Binding SaveCommand}" Width="104" Height="30"
                        Style="{StaticResource PrimaryButton}"
                        AutomationProperties.Name="Simpan"/>
            </c:AppStatusBar.Buttons>
        </c:AppStatusBar>
    </Grid>
</UserControl>
