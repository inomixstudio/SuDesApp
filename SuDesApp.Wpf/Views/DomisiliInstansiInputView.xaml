<UserControl x:Class="SuDesApp.Wpf.Views.DomisiliInstansiInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             FontSize="13"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
            >

    <!-- Satu kolom: field lebar penuh, hanya scroll vertikal. -->
    <Grid IsSharedSizeScope="True">
        <StackPanel>

            <!-- NOMOR SURAT -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="NOMOR SURAT" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nomor Surat *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource FormField}"
                                 IsEnabled="{Binding NomorSuratEnabled}"
                                 Text="{Binding NomorSurat, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nomor surat (otomatis jika dikelola register)"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- DATA INSTANSI -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="DATA INSTANSI" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama Instansi *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding NamaInstansi, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nama instansi"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Alamat Instansi *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding AlamatInstansi, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Jln/Dusun dan RT/RW"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- KETERANGAN SURAT -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="KETERANGAN SURAT" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Keterangan *" Style="{StaticResource FormLabel}" VerticalAlignment="Top"/>
                        <TextBox Grid.Column="1" Style="{StaticResource FormField}" Height="90"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Keterangan, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Keterangan tambahan untuk surat"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- PEJABAT PENANDATANGAN -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="PEJABAT PENANDATANGAN" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Kepala Desa" GroupName="pejabat" Margin="0,0,24,0"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding IsKadesSelected, Mode=TwoWay}"/>
                        <RadioButton Content="Sekretaris Desa" GroupName="pejabat"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding IsSekdesSelected, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
