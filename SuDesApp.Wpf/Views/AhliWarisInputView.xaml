<UserControl x:Class="SuDesApp.Wpf.Views.AhliWarisInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             FontSize="13"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
            >

    <Grid IsSharedSizeScope="True">
        <StackPanel>

            <!-- NOMOR SURAT -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="NOMOR SURAT" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nomor Surat *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource FormField}"
                                 IsEnabled="{Binding NomorSuratEnabled}"
                                 Text="{Binding NomorSurat, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nomor surat (otomatis jika dikelola register)"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- DATA ALMARHUM/AH | DATA PASANGAN — berdampingan -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource FormCard}" Padding="14">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="DATA ALMARHUM/AH" Style="{StaticResource FormSectionTitle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="96" MaxWidth="130" SharedSizeGroup="FormLabelPair"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"
                                     CharacterCasing="Upper" ToolTip="Nama Almarhum/ah (huruf saja)"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Jenis Kelamin *" Style="{StaticResource FormLabel}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormCombo}"
                                      ItemsSource="{Binding JenisKelaminOptions}"
                                      SelectedItem="{Binding JenisKelamin, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Dusun/Jalan *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Dusun, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Jln./Dusun dan RT/RW almarhum/ah"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Desa *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Desa, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Kecamatan *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Kecamatan, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Kabupaten *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Kabupaten, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Tanggal Kematian *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding TanggalKematian, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Format: DD-MM-YYYY"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Hari Kematian" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FormField}"
                                     IsReadOnly="True" Background="{DynamicResource PanelBrush}"
                                     Text="{Binding HariKematian, Mode=OneWay}"
                                     ToolTip="Hari kematian (otomatis diisi dari tanggal kematian)"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource FormCard}" Padding="14">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="DATA PASANGAN" Style="{StaticResource FormSectionTitle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="96" MaxWidth="130" SharedSizeGroup="FormLabelPair"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding NamaPasangan, UpdateSourceTrigger=PropertyChanged}"
                                     CharacterCasing="Upper"
                                     ToolTip="Nama pasangan almarhum/ah"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tempat Lahir" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding TempatLahirPasangan, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tgl. Lahir" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding TanggalLahirPasangan, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Format: DD-MM-YYYY"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Jenis Kelamin" Style="{StaticResource FormLabel}"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormCombo}"
                                      ItemsSource="{Binding JenisKelaminOptions}"
                                      SelectedItem="{Binding JenisKelaminPasangan, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Alamat: Dusun/Jalan" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FormField}"
                                     IsEnabled="{Binding IsAlamatPasanganEditable}"
                                     Text="{Binding DusunPasangan, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Desa" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FormField}"
                                     IsEnabled="{Binding IsAlamatPasanganEditable}"
                                     Text="{Binding DesaPasangan, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Kecamatan" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FormField}"
                                     IsEnabled="{Binding IsAlamatPasanganEditable}"
                                     Text="{Binding KecamatanPasangan, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Kabupaten" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FormField}"
                                     IsEnabled="{Binding IsAlamatPasanganEditable}"
                                     Text="{Binding KabupatenPasangan, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>

                        <CheckBox Margin="0,10,0,0" Content="Alamat sama dengan Almarhum/ah"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding AlamatPasanganSamaAlmarhum, Mode=TwoWay}"
                                  ToolTip="Centang jika alamat pasangan sama dengan alamat almarhum"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DATA ANAK (AHLI WARIS) -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="DATA ANAK (AHLI WARIS)" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,12,0"
                                   Text="Klik sel untuk mengedit. Baris tanpa data otomatis dilewati saat disimpan:"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+ Tambah Anak" Padding="10,2" Height="30" MinWidth="110"
                                    Command="{Binding AddAnakCommand}"
                                    ToolTip="Tambah baris anak ahli waris"/>
                            <Button Content="Hapus" Padding="10,2" Height="30" MinWidth="70" Margin="6,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RemoveAnakCommand}"
                                    CommandParameter="{Binding SelectedAnak}"
                                    ToolTip="Hapus baris anak yang dipilih"/>
                        </StackPanel>
                    </Grid>

                    <!-- Kolom grid memakai * (proporsional) supaya SELALU muat lebar kartu. -->
                    <DataGrid x:Name="AnakGrid"
                              ItemsSource="{Binding AnakItems}"
                              SelectedItem="{Binding SelectedAnak, Mode=TwoWay}"
                              Style="{StaticResource EditableDataGrid}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              Height="170"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nama" Width="*" MinWidth="110"
                                                Binding="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Tempat Lahir" Width="0.8*" MinWidth="90"
                                                Binding="{Binding TempatLahir, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Tgl Lahir" Width="0.8*" MinWidth="85"
                                                Binding="{Binding TanggalLahir, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTemplateColumn Header="Jenis Kelamin" Width="0.9*" MinWidth="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding JenisKelamin}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="2,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.JenisKelaminOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding JenisKelamin, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Alamat (Dusun, Desa, Kec, Kab)" Width="1.6*" MinWidth="140"
                                                Binding="{Binding Alamat, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTemplateColumn Header="Aksi" Width="64" MinWidth="64" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Hapus" Margin="2" Padding="6,2"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.RemoveAnakCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Hapus baris ini"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- PENERIMA KUASA -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="PENERIMA KUASA" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding NamaPenerimaKuasa, UpdateSourceTrigger=PropertyChanged}"
                                 CharacterCasing="Upper"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tempat Lahir" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding TempatLahirPenerimaKuasa, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tgl. Lahir" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding TanggalLahirPenerimaKuasa, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Format: DD-MM-YYYY"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Jenis Kelamin" Style="{StaticResource FormLabel}"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormCombo}"
                                  ItemsSource="{Binding JenisKelaminOptions}"
                                  SelectedItem="{Binding JenisKelaminPenerimaKuasa, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Alamat" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding AlamatPenerimaKuasa, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Alamat penerima kuasa (Dusun, Desa, Kecamatan, Kabupaten)"
                                 MaxLength="200"/>
                    </Grid>


                    <TextBlock FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="Otomatis terisi dari data anak pertama bila dikosongkan."/>
                </StackPanel>
            </Border>

            <!-- KEPERLUAN SURAT -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="KEPERLUAN SURAT" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Keperluan *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding Keterangan, UpdateSourceTrigger=PropertyChanged}"
                                 CharacterCasing="Upper"
                                 ToolTip="Keperluan surat (misalnya: Pengurusan Klaim Asuransi)"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- PEJABAT PENANDATANGAN -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="PEJABAT PENANDATANGAN" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Kepala Desa" GroupName="pejabat" Margin="0,0,24,0"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding IsKadesSelected, Mode=TwoWay}"/>
                        <RadioButton Content="Sekretaris Desa" GroupName="pejabat"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding IsSekdesSelected, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
