<!--
    Pembaca dokumen dari dialog persetujuan. Isinya disusun oleh
    MarkdownKeFlowDocument — sama seperti halaman Dokumentasi — sehingga
    pengguna membaca dokumen penuh tanpa meninggalkan aplikasi.
-->
<Window x:Class="SuDesApp.Wpf.Views.PersetujuanBacaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctrl="clr-namespace:SuDesApp.Wpf.Controls"
        Title="Dokumen" Width="880" Height="700" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" CornerRadius="0"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Margin="14" CornerRadius="14" Effect="{StaticResource BayanganTebal}">
        <Border CornerRadius="14" ClipToBounds="True"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Height="30"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        MouseLeftButtonDown="CaptionBorder_MouseLeftButtonDown">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" x:Name="JudulText" Text="Dokumen"
                                   Style="{StaticResource WindowTitleText}" FontWeight="SemiBold"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}"
                                Command="{x:Static ctrl:AppChromeCommands.Close}"
                                ToolTip="Tutup (Esc)">
                            <Path Data="M 0 0 L 8 8 M 8 0 L 0 8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"/>
                        </Button>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="VersiText" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="GalatText" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource WarningTextBrush}"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" ClipToBounds="True">
                        <FlowDocumentScrollViewer x:Name="Pembaca"
                                                  IsToolBarVisible="False"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Background="Transparent" Padding="0"/>
                    </Border>

                    <Button Grid.Row="2" Content="Tutup" Width="110" HorizontalAlignment="Right"
                            Margin="0,12,0,0" IsDefault="True" IsCancel="True"
                            Style="{StaticResource PrimaryButton}"
                            Click="Tutup_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
