<UserControl x:Class="SuDesApp.Wpf.Views.KeputusanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             FontSize="14" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + toggle SK/PERDES/PERKADES -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Style="{StaticResource HeaderIconChip}">
                        <TextBlock Text="&#128220;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Buku Surat Keputusan, Peraturan Desa, dan Peraturan Kepala Desa — klik dua kali baris untuk mengedit."
                                   Style="{StaticResource HeaderSubtitle}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="SK" Command="{Binding SetSkCommand}" MinWidth="100" Padding="16,5" Margin="0,0,6,0"
                            ToolTip="Tampilkan buku Surat Keputusan">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSk}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ToggleHoverBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="PERDES" Command="{Binding SetPerdesCommand}" MinWidth="100" Padding="16,5" Margin="0,0,6,0"
                            ToolTip="Tampilkan buku Peraturan Desa">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPerdes}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ToggleHoverBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="PERKADES" Command="{Binding SetPerkadesCommand}" MinWidth="100" Padding="16,5" Margin="0,0,6,0"
                            ToolTip="Tampilkan buku Peraturan Kepala Desa">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPerkades}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ToggleHoverBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Ringkasan -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Margin="0,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle, StringFormat=TOTAL {0}}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TotalJenisCount}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                            Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Margin="6,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TAMPIL SAAT INI" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TampilCount}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                            Background="{DynamicResource SuccessSubtleBrush}" VerticalAlignment="Center">
                        <TextBlock Text="▤" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Margin="6,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TAHUN TERBARU" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TahunTerbaruLabel}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                            Background="{DynamicResource WarningSubtleBrush}" VerticalAlignment="Center">
                        <TextBlock Text="📅" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}" Margin="6,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="DENGAN LAMPIRAN" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock FontSize="20" FontWeight="Bold" Margin="0,2,0,0" Foreground="{DynamicResource TextBrush}">
                            <Run Text="{Binding JumlahLampiran, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding TampilCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                            Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Center">
                        <TextBlock Text="📎" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Toolbar: filter tahun + cari + aksi.
             WrapPanel: tujuh tombol aksi + kotak cari 250 px tidak mungkin muat di
             ±604 px lebar konten pada lebar jendela minimum. Dengan kolom Auto,
             StackPanel tidak bisa menyusut sehingga "Cetak" dan "Batal" terdorong
             keluar jendela dan tidak bisa diklik. -->
        <Border Grid.Row="2" Style="{StaticResource ToolbarCard}">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <Border Width="250" MinWidth="180" Height="34" Margin="0,2,8,2"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchWatermark" Grid.Column="1" Text="Cari nomor, tentang, keterangan, tahun…"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,0"/>
                        <Button x:Name="ClearSearchBtn" Grid.Column="2" Click="ClearSearch_Click"
                                ToolTip="Bersihkan pencarian" Visibility="Collapsed"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                    <ComboBox ItemsSource="{Binding TahunOptions}" SelectedItem="{Binding SelectedTahun}"
                              Width="110"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusInfo}" VerticalAlignment="Center" Margin="0,2,12,2"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>

                <Button Content="Segarkan" Command="{Binding SegarkanCommand}" Style="{StaticResource SecondaryButton}" Margin="0,2,6,2"
                        VerticalAlignment="Center"
                        ToolTip="Muat ulang data dari berkas arsip"/>
                <Button Content="Tambah" Command="{Binding TambahCommand}" Style="{StaticResource PrimaryButton}" Margin="0,2,6,2"
                        VerticalAlignment="Center"
                        ToolTip="Input data baru"/>
                <Button Content="Salin" Command="{Binding SalinCommand}" Style="{StaticResource SecondaryButton}" Margin="0,2,6,2"
                        VerticalAlignment="Center"
                        ToolTip="Buat data baru dari baris terpilih (nomor/tentang/keterangan ikut tersalin)"/>
                <Button Content="Edit" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButton}" Margin="0,2,6,2"
                        VerticalAlignment="Center"
                        ToolTip="Ubah data terpilih"/>
                <Button Content="Hapus" Command="{Binding HapusCommand}" Style="{StaticResource DangerButton}" Margin="0,2,6,2"
                        VerticalAlignment="Center"
                        ToolTip="Hapus data terpilih beserta berkas lampirannya"/>
                <Button Content="Cetak" Command="{Binding CetakCommand}" Style="{StaticResource SuccessButton}" Margin="0,2,6,2"
                        VerticalAlignment="Center"
                        ToolTip="Cetak PDF seluruh arsip sesuai filter tahun"/>
                <Button Content="Batal" Command="{Binding BatalCommand}" Style="{StaticResource OutlineButton}" Margin="0,2,6,2"
                        VerticalAlignment="Center"
                        ToolTip="Kembali ke halaman utama"/>
            </WrapPanel>
        </Border>

        <!-- Kartu Contoh Perdes: hanya tampil di tab PERDES -->
        <Border Grid.Row="3" Padding="16,14" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource GridHostCard}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPerdes}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Style="{StaticResource AccentSectionBar}"/>
                    <TextBlock Text="CONTOH PERDES" FontWeight="Bold" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Pilih contoh untuk membuka formulir PERDES dengan halaman naskah yang bisa disunting. Identitas desa diisi dari Pengaturan Surat, lalu naskah disimpan sebagai PDF di arsip PERDES."
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding ContohPerdes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.BukaContohPerdesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding BerkasAda}"
                                    HorizontalContentAlignment="Left"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,7" Margin="0,0,6,6"
                                    ToolTip="Buka contoh ini di formulir PERDES">
                                <TextBlock Text="{Binding Judul}" TextWrapping="Wrap"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Contoh bukan peraturan yang berlaku. Periksa nomor, tanggal, dasar hukum, dan isi sebelum disimpan ke Buku Perdes."
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Grid data -->
        <Border Grid.Row="4" Style="{StaticResource GridHostCard}" Padding="1">
            <Grid>
                <!-- Halaman tampil lebih dulu; data menyusul — garis ini menandai
                     bahwa arsip masih dimuat (bukan benar-benar kosong). -->
                <ProgressBar Panel.ZIndex="5" Height="3" IsIndeterminate="True"
                             VerticalAlignment="Top"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Foreground="{DynamicResource PrimaryBrush}"/>
                <!-- Tinggi baris mengikuti isi: nomor, tentang,
                     keterangan, dan nama berkas lampiran bisa panjang —
                     teks melipat sampai tuntas alih-alih dipotong.
                     DataGrid sengaja tidak dipakai: RowHeight="Auto"
                     memicu loop layout (stack overflow), tinggi tetap
                     memotong teks. Kepala kolom ada di dalam ScrollViewer
                     yang sama sehingga selalu sejajar dengan baris. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Kepala kolom: lebar kolomnya sama persis dengan baris -->
                        <Border Style="{StaticResource TabelKepalaPita}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="1.5*" MinWidth="150"/>
                                    <ColumnDefinition Width="1*" MinWidth="100"/>
                                    <ColumnDefinition Width="3*" MinWidth="180"/>
                                    <ColumnDefinition Width="2*" MinWidth="140"/>
                                    <ColumnDefinition Width="1.7*" MinWidth="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="No." FontWeight="Bold"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="Nomor" FontWeight="Bold"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2" Text="Tanggal" FontWeight="Bold"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="3" Text="Tentang" FontWeight="Bold"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="4" Text="Keterangan" FontWeight="Bold"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="5" Text="File Lampiran" FontWeight="Bold"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>

                        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                                 SelectionMode="Single"
                                 ItemContainerStyle="{StaticResource TabelBarisZebra}"
                                 AlternationCount="4"
                                 BorderThickness="0" Background="Transparent" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="DataGridKeputusan_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="1.5*" MinWidth="150"/>
                                                <ColumnDefinition Width="1*" MinWidth="100"/>
                                                <ColumnDefinition Width="3*" MinWidth="180"/>
                                                <ColumnDefinition Width="2*" MinWidth="140"/>
                                                <ColumnDefinition Width="1.7*" MinWidth="150"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding No}"
                                                       VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Nomor}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       VerticalAlignment="Top" Margin="0,0,12,0"
                                                       ToolTip="{Binding Nomor}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Tanggal}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Tentang}"
                                                       TextWrapping="Wrap" VerticalAlignment="Top"
                                                       Margin="0,0,12,0" ToolTip="{Binding Tentang}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Keterangan}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" VerticalAlignment="Top"
                                                       Margin="0,0,12,0" ToolTip="{Binding Keterangan}"/>
                                            <Grid Grid.Column="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource AccentSubtleBrush}"
                                                        Visibility="{Binding PunyaLampiran, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding EkstensiFile}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding FileWord}" FontSize="13"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"
                                                           TextWrapping="Wrap" VerticalAlignment="Top"
                                                           ToolTip="{Binding FileWord}"/>
                                                <Button Grid.Column="2" Content="Buka" Width="58" Padding="4,0"
                                                        Command="{Binding DataContext.OpenWordFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding PunyaLampiran}"
                                                        ToolTip="Buka berkas lampiran (Word/PDF)"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <Border Background="{DynamicResource SurfaceBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasRows}" Value="False"/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <c:EmptyStateView Judul="Belum ada data keputusan"
                                     Pesan="Coba ubah kata kunci pencarian atau pilih tahun lain, atau gunakan tombol Tambah untuk mengisi data baru."/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
