<UserControl x:Class="SuDesApp.Wpf.Views.TutupBukuTahunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Style bawaan ComboBoxItem mengikat alignment ke ItemsControl di
             atasnya lewat RelativeSource. Di halaman ini ComboBoxItem kadang
             direalisasi sebelum ComboBox selesai dibangun, jadi binding itu
             gagal dan memunculkan error WPF. Alignment ditulis langsung. -->
        <Style x:Key="TahunItem" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Kepala halaman: kartu header_primary seragam seperti halaman lain ===== -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="{x:Static u:IkonMenu.Dokumen}" FontSize="20"
                               FontFamily="{StaticResource AppIconFont}"
                               Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Tutup Buku Tahunan" Style="{StaticResource HeaderTitle}"
                               AutomationProperties.Name="Tutup buku tahunan"/>
                    <TextBlock Style="{StaticResource HeaderSubtitle}"
                               Text="Periksa keutuhan penomoran satu tahun, tutup atau buka bukunya, lalu cetak arsip register."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Pemilih tahun + aksi muat & cetak ===== -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tahun" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="120" ItemsSource="{Binding TahunTersedia}"
                              ItemContainerStyle="{StaticResource TahunItem}"
                              Style="{StaticResource FormCombo}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center"
                              SelectedItem="{Binding TahunTerpilih}" IsEnabled="{Binding BukanLoading}"
                              AutomationProperties.Name="Tahun buku yang ditutup"/>
                    <Button Content="Muat Ulang" Command="{Binding MuatCommand}" Margin="8,0,0,0"
                            Style="{StaticResource OutlineButton}" Height="30"
                            AutomationProperties.Name="Muat ulang penomoran tahun ini"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cetak Excel" Command="{Binding CetakExcelCommand}"
                            Style="{StaticResource SecondaryButton}" Height="30" Margin="0,0,8,0"/>
                    <Button Content="Cetak PDF" Command="{Binding CetakPdfCommand}"
                            Style="{StaticResource SecondaryButton}" Height="30"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Isi: deret nomor + catatan penomoran ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Kartu status + tabel deret -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Status buku: lencana hijau saat tertutup, merah saat masih terbuka -->
                    <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Status:" FontWeight="SemiBold" Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <!-- Lencana ikut warna tema: hijau = buku tertutup,
                                         merah = masih terbuka. -->
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                                <Setter Property="Background" Value="{DynamicResource ErrorSubtleBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusTertutup}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding LabelStatus}" FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusTertutup}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Ringkasan}" TextWrapping="Wrap" FontSize="12"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding JumlahSurat}" FontSize="24" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}"
                                       ToolTip="Jumlah surat yang tercatat pada tahun ini"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Deret}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="12,0,12,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kode" Binding="{Binding Awalan}" Width="110"/>
                            <DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah}" Width="70"/>
                            <DataGridTextColumn Header="Pertama" Binding="{Binding NomorPertama}" Width="80"/>
                            <DataGridTextColumn Header="Terakhir" Binding="{Binding NomorTerakhir}" Width="80"/>
                            <DataGridTextColumn Header="Hilang" Binding="{Binding NomorHilang.Count}" Width="70"/>
                            <DataGridTextColumn Header="Ganda" Binding="{Binding NomorGanda.Count}" Width="70"/>
                            <DataGridTextColumn Header="Tak Terbaca" Binding="{Binding NomorTidakTerbaca.Count}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Catatan penomoran: kartu peringatan bertema (bukan kuning konstan) -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}"
                    Background="{DynamicResource WarningSubtleBrush}"
                    BorderBrush="{DynamicResource WarningBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}" Margin="0,0,0,8">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="Catatan penomoran" Style="{StaticResource FormSectionTitle}"/>
                        </StackPanel>

                        <TextBlock Text="Nomor yang hilang tidak menghalangi penutupan. Nomor ganda, nomor tidak terbaca, dan nomor yang tahunnya beda harus diperbaiki dulu."
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource WarningTextBrush}"/>
                        <ItemsControl ItemsSource="{Binding DaftarCatatan}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Tidak ada catatan: penomoran tahun ini rapi."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"
                                   Visibility="{Binding TampilkanTanpaCatatan, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Aksi tutup / buka ===== -->
        <Border Grid.Row="3" Style="{StaticResource FormCard}" Margin="0,14,0,0">
            <StackPanel>
                <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                    <Border Style="{StaticResource AccentSectionBar}"/>
                    <TextBlock Text="Catatan penutupan" Style="{StaticResource FormSectionTitle}"/>
                </StackPanel>

                <TextBox Style="{StaticResource FormField}" Height="58" VerticalAlignment="Top"
                         Text="{Binding CatatanTutup, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Catatan penutupan buku"/>

                <CheckBox Content="Tutup dengan paksa meski penomoran bermasalah"
                          IsChecked="{Binding Paksa}" Margin="0,10,0,0"/>

                <TextBlock Text="Penomoran tahun ini bermasalah. Perbaiki dulu, atau centang tutup dengan paksa dan tuliskan alasannya."
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource ErrorTextBrush}"
                           Visibility="{Binding AdaMasalahBlocking, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Tutup Buku" Command="{Binding TutupCommand}" Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding BisaTutup}"
                            AutomationProperties.Name="Tutup buku"/>
                    <Button Content="Buka Kembali" Command="{Binding BukaCommand}" Style="{StaticResource OutlineButton}"
                            IsEnabled="{Binding BisaBuka}"/>
                    <TextBlock Text="Menutup buku tidak menghapus data dan selalu bisa dibalik."
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Text="{Binding PesanTolak}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource ErrorTextBrush}"
                           Visibility="{Binding AdaPesanTolak, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
