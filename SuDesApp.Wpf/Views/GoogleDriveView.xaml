<UserControl x:Class="SuDesApp.Wpf.Views.GoogleDriveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SuDesApp.Wpf.ViewModels"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#128193;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Segarkan" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,6,0"/>
                <Button Content="Naik" Command="{Binding UpCommand}" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,6,0"/>
                <Button Content="Upload" Command="{Binding UploadCommand}" Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,6,0"/>
                <Button Content="Upload Surat" Command="{Binding UploadSuratCommand}" Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,6,0"/>
                <Button Content="Unduh" Command="{Binding DownloadCommand}" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,6,0"/>
                <Button Content="Buka di Browser" Command="{Binding OpenOnlineCommand}" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,6,0"/>
                <Button Content="Hapus" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Height="32" Margin="0,0,6,0"/>
                <Button Content="Backup Database" Command="{Binding BackupDatabaseCommand}" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,6,0"
                        ToolTip="Cadangkan database aplikasi ke folder SuDesApp-Backup di Google Drive (snapshot konsisten, cadangan lama otomatis dipangkas)"/>
                <Button Content="Pulihkan Database" Command="{Binding RestoreDatabaseCommand}" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,6,0"
                        ToolTip="Pulihkan database dari berkas cadangan .db yang dipilih di daftar (unduh + validasi + impor; database lama dicadangkan otomatis)"/>
                <Button Command="{Binding AccountCommand}" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,6,0"
                        ToolTip="Kelola koneksi atau ganti akun Google"
                        Visibility="{Binding IsOAuthEnabled, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl ContentTemplate="{StaticResource GoogleGLogo}"
                                        Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Koneksi / Ganti Akun" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Batal" Command="{Binding BatalCommand}" Style="{StaticResource OutlineButton}" Height="32"/>
            </StackPanel>
        </Border>

        <!-- Path -->
        <Border Grid.Row="2" Style="{StaticResource ToolbarCard}" Padding="10,6" Margin="0,0,0,8">
            <TextBlock Text="{Binding PathLabel}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
        </Border>

        <!-- Daftar file -->
        <Border Grid.Row="3" Style="{StaticResource GridHostCard}">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" RowHeight="28"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      KeyDown="DataGrid_KeyDown">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Nama" Width="3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#128193;" Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" ToolTip="{Binding Name}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Jenis" Binding="{Binding TypeDisplay}" Width="1*"/>
                    <DataGridTextColumn Header="Ukuran" Binding="{Binding SizeDisplay}" Width="0.8*"/>
                    <DataGridTextColumn Header="Diubah" Binding="{Binding ModifiedDisplay}" Width="1.1*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="4" Background="{DynamicResource StatusBarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>