<UserControl x:Class="SuDesApp.Wpf.Views.GoogleDriveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SuDesApp.Wpf.ViewModels"
             FontSize="14" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#128193;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Segarkan" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                <Button Content="Naik" Command="{Binding UpCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                <Button Content="Upload" Command="{Binding UploadCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"/>
                <Button Content="Upload Surat" Command="{Binding UploadSuratCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"/>
                <Button Content="Unduh" Command="{Binding DownloadCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                <Button Content="Buka di Browser" Command="{Binding OpenOnlineCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                <Button Content="Hapus" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0"/>
                <Button Content="Backup Database" Command="{Binding BackupDatabaseCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                        ToolTip="Cadangkan database aplikasi ke folder SuDesApp-Backup di Google Drive (snapshot konsisten, cadangan lama otomatis dipangkas)"/>
                <Button Content="Pulihkan Database" Command="{Binding RestoreDatabaseCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                        ToolTip="Pulihkan database dari berkas cadangan .db yang dipilih di daftar (unduh + validasi + impor; database lama dicadangkan otomatis)"/>
                <Button Command="{Binding AccountCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                        ToolTip="Kelola koneksi atau ganti akun Google"
                        Visibility="{Binding IsOAuthEnabled, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl ContentTemplate="{StaticResource GoogleGLogo}"
                                        Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Koneksi / Ganti Akun" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Batal" Command="{Binding BatalCommand}" Style="{StaticResource OutlineButton}"/>
            </StackPanel>
        </Border>

        <!-- Path -->
        <Border Grid.Row="2" Style="{StaticResource ToolbarCard}" Padding="10,6" Margin="0,0,0,8">
            <TextBlock Text="{Binding PathLabel}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
        </Border>        <!-- Daftar file: nama file Google Drive bisa jauh lebih panjang dari
             lebar kolom, jadi tinggi baris mengikuti isi — teks melipat
             sampai tuntas. DataGrid sengaja tidak dipakai: RowHeight="Auto"
             memicu loop layout (stack overflow), tinggi tetap memotong teks.
             Kepala kolom ada di dalam ScrollViewer yang sama sehingga selalu
             sejajar dengan baris. -->
        <Border Grid.Row="3" Style="{StaticResource GridHostCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Kepala kolom: lebar kolomnya sama persis dengan baris -->
                    <Border Style="{StaticResource TabelKepalaPita}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" MinWidth="200"/>
                                <ColumnDefinition Width="1*" MinWidth="100"/>
                                <ColumnDefinition Width="0.8*" MinWidth="80"/>
                                <ColumnDefinition Width="1.1*" MinWidth="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nama" FontWeight="Bold"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="Jenis" FontWeight="Bold"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="Ukuran" FontWeight="Bold"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="3" Text="Diubah" FontWeight="Bold"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedRow}"
                             SelectionMode="Single"
                             ItemContainerStyle="{StaticResource TabelBarisZebra}"
                             AlternationCount="4"
                             BorderThickness="0" Background="Transparent" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             MouseDoubleClick="DataGrid_MouseDoubleClick"
                             KeyDown="DataGrid_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" MinWidth="200"/>
                                            <ColumnDefinition Width="1*" MinWidth="100"/>
                                            <ColumnDefinition Width="0.8*" MinWidth="80"/>
                                            <ColumnDefinition Width="1.1*" MinWidth="110"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Margin="0,0,12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#128193;" Foreground="{DynamicResource TextBrush}"
                                                       Margin="0,0,6,0" VerticalAlignment="Top"
                                                       Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap"
                                                       VerticalAlignment="Top" ToolTip="{Binding Name}"
                                                       Foreground="{DynamicResource TextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding TypeDisplay}"
                                                   TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                                                   TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding ModifiedDisplay}"
                                                   TextWrapping="Wrap" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Status -->
        <Border Grid.Row="4" Background="{DynamicResource StatusBarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource StatusBarTextBrush}" FontSize="13"/>
        </Border>
    </Grid>
</UserControl>