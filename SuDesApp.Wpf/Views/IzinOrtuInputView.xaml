<UserControl x:Class="SuDesApp.Wpf.Views.IzinOrtuInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             FontSize="13"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════
             BAR ATAS — Nomor Surat
             ═══════════════════════════════════════════════════════════════════ -->
        <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Padding="10" Header="Nomor Surat">
            <TextBox Style="{StaticResource FieldBox}"
                     IsEnabled="{Binding NomorSuratEnabled}"
                     Text="{Binding NomorSurat, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Nomor surat (otomatis jika dikelola register)"/>
        </GroupBox>

        <!-- ═══════════════════════════════════════════════════════════════════
             PEMBERI IZIN — Yang Memberi Izin (orang tua / suami)
             ═══════════════════════════════════════════════════════════════════ -->
        <GroupBox Grid.Row="2" Grid.Column="0" Padding="10" Header="Yang Memberi Izin">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="NIK *"/>
                <TextBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Name="Nik"
                          LostFocus="OnNikLostFocus"
                          Text="{Binding Nik, UpdateSourceTrigger=PropertyChanged}"
                          MaxLength="16" ToolTip="NIK Pemberi Izin (16 digit angka)"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Nama *"/>
                <TextBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"
                          CharacterCasing="Upper"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tempat Lahir *"/>
                <TextBox  Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding TempatLahir, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tgl. Lahir *"/>
                <TextBox  Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding TanggalLahir, UpdateSourceTrigger=LostFocus}"
                          ToolTip="Format: DD-MM-YYYY"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Jenis Kelamin *"/>
                <ComboBox  Grid.Row="4" Grid.Column="1" Style="{StaticResource DropDown}"
                           ItemsSource="{Binding JenisKelaminOptions}"
                           SelectedItem="{Binding JenisKelamin, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Agama *"/>
                <ComboBox  Grid.Row="5" Grid.Column="1" Style="{StaticResource DropDown}"
                           ItemsSource="{Binding AgamaOptions}"
                           SelectedItem="{Binding Agama, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Status Perkawinan *"/>
                <ComboBox  Grid.Row="6" Grid.Column="1" Style="{StaticResource DropDown}"
                           ItemsSource="{Binding StatusPerkawinanOptions}"
                           SelectedItem="{Binding StatusPerkawinan, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Pekerjaan *"/>
                <TextBox  Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding Pekerjaan, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Dusun/Jalan *"/>
                <TextBox  Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding Dusun, UpdateSourceTrigger=LostFocus}"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Desa *"/>
                <TextBox  Grid.Row="9" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding Desa, UpdateSourceTrigger=LostFocus}"/>

                <Grid Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Kecamatan *"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Kecamatan, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Kabupaten *"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Kabupaten, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ═══════════════════════════════════════════════════════════════════
             YANG DIBERI IZIN — Anak / Suami
             ═══════════════════════════════════════════════════════════════════ -->
        <GroupBox Grid.Row="2" Grid.Column="2" Padding="10" Header="Yang Diberi Izin (Anak)">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="NIK *"/>
                <TextBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Name="NikAnak"
                          LostFocus="OnNikAnakLostFocus"
                          Text="{Binding NIKAnak, UpdateSourceTrigger=PropertyChanged}"
                          MaxLength="16" ToolTip="NIK Anak (16 digit angka)"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Nama *"/>
                <TextBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding NamaAnak, UpdateSourceTrigger=PropertyChanged}"
                          CharacterCasing="Upper"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tempat Lahir *"/>
                <TextBox  Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding TempatLahirAnak, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tgl. Lahir *"/>
                <TextBox  Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding TanggalLahirAnak, UpdateSourceTrigger=LostFocus}"
                          ToolTip="Format: DD-MM-YYYY"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Jenis Kelamin *"/>
                <ComboBox  Grid.Row="4" Grid.Column="1" Style="{StaticResource DropDown}"
                           ItemsSource="{Binding JenisKelaminAnakOptions}"
                           SelectedItem="{Binding JenisKelaminAnak, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Agama *"/>
                <ComboBox  Grid.Row="5" Grid.Column="1" Style="{StaticResource DropDown}"
                           ItemsSource="{Binding AgamaAnakOptions}"
                           SelectedItem="{Binding AgamaAnak, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Status Perkawinan *"/>
                <ComboBox  Grid.Row="6" Grid.Column="1" Style="{StaticResource DropDown}"
                           ItemsSource="{Binding StatusPerkawinanAnakOptions}"
                           SelectedItem="{Binding StatusPerkawinanAnak, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Pekerjaan"/>
                <TextBox  Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding PekerjaanAnak, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Dusun/Jalan"/>
                <TextBox  Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding DusunAnak, UpdateSourceTrigger=LostFocus}"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Desa *"/>
                <TextBox  Grid.Row="9" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding DesaAnak, UpdateSourceTrigger=LostFocus}"/>

                <Grid Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Kecamatan *"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding KecamatanAnak, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Kabupaten *"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding KabupatenAnak, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ═══════════════════════════════════════════════════════════════════
             BAR BAWAH — Informasi Tujuan Keberangkatan (full-width)
             ═══════════════════════════════════════════════════════════════════ -->
        <GroupBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Padding="10"
                  Header="Informasi Keberangkatan">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Negara Tujuan *"/>
                <TextBox  Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding NegaraTujuan, UpdateSourceTrigger=PropertyChanged}"
                          CharacterCasing="Upper"
                          ToolTip="Negara tujuan keberangkatan"/>

                <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Nama PT"/>
                <TextBox  Grid.Column="4" Style="{StaticResource FieldBox}"
                          Text="{Binding NamaPT, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Nama perusahaan / PT"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>