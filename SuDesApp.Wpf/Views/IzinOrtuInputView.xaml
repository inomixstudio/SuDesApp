<UserControl x:Class="SuDesApp.Wpf.Views.IzinOrtuInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             FontSize="13"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
            >

    <Grid IsSharedSizeScope="True">
        <StackPanel>

            <!-- NOMOR SURAT -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="NOMOR SURAT" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nomor Surat *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource FormField}"
                                 IsEnabled="{Binding NomorSuratEnabled}"
                                 Text="{Binding NomorSurat, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nomor surat (otomatis jika dikelola register)"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- YANG MEMBERI IZIN | YANG DIBERI IZIN (ANAK) — berdampingan -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource FormCard}" Padding="14">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="YANG MEMBERI IZIN" Style="{StaticResource FormSectionTitle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="96" MaxWidth="130" SharedSizeGroup="FormLabelPair"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="NIK *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                     Name="Nik" LostFocus="OnNikLostFocus"
                                     Text="{Binding Nik, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="16" ToolTip="NIK Pemberi Izin (16 digit angka)"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Nama *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"
                                     CharacterCasing="Upper"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tempat Lahir *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding TempatLahir, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Tgl. Lahir *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding TanggalLahir, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Format: DD-MM-YYYY"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Jenis Kelamin *" Style="{StaticResource FormLabel}"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FormCombo}"
                                      ItemsSource="{Binding JenisKelaminOptions}"
                                      SelectedItem="{Binding JenisKelamin, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Agama *" Style="{StaticResource FormLabel}"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FormCombo}"
                                      ItemsSource="{Binding AgamaOptions}"
                                      SelectedItem="{Binding Agama, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Status Perkawinan *" Style="{StaticResource FormLabel}"/>
                            <ComboBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FormCombo}"
                                      ItemsSource="{Binding StatusPerkawinanOptions}"
                                      SelectedItem="{Binding StatusPerkawinan, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Pekerjaan *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Pekerjaan, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Dusun/Jalan *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Dusun, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Desa *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Desa, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Kecamatan *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="10" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Kecamatan, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Kabupaten *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="11" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Kabupaten, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource FormCard}" Padding="14">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="YANG DIBERI IZIN (ANAK)" Style="{StaticResource FormSectionTitle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="96" MaxWidth="130" SharedSizeGroup="FormLabelPair"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="NIK *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                     Name="NikAnak" LostFocus="OnNikAnakLostFocus"
                                     Text="{Binding NIKAnak, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="16" ToolTip="NIK Anak (16 digit angka)"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Nama *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding NamaAnak, UpdateSourceTrigger=PropertyChanged}"
                                     CharacterCasing="Upper"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tempat Lahir *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding TempatLahirAnak, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Tgl. Lahir *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding TanggalLahirAnak, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Format: DD-MM-YYYY"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Jenis Kelamin *" Style="{StaticResource FormLabel}"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FormCombo}"
                                      ItemsSource="{Binding JenisKelaminAnakOptions}"
                                      SelectedItem="{Binding JenisKelaminAnak, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Agama *" Style="{StaticResource FormLabel}"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FormCombo}"
                                      ItemsSource="{Binding AgamaAnakOptions}"
                                      SelectedItem="{Binding AgamaAnak, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Status Perkawinan *" Style="{StaticResource FormLabel}"/>
                            <ComboBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FormCombo}"
                                      ItemsSource="{Binding StatusPerkawinanAnakOptions}"
                                      SelectedItem="{Binding StatusPerkawinanAnak, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Pekerjaan" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding PekerjaanAnak, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Dusun/Jalan" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding DusunAnak, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Desa *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding DesaAnak, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Kecamatan *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="10" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding KecamatanAnak, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Kabupaten *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="11" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding KabupatenAnak, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- INFORMASI KEBERANGKATAN -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="INFORMASI KEBERANGKATAN" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Negara Tujuan *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding NegaraTujuan, UpdateSourceTrigger=PropertyChanged}"
                                 CharacterCasing="Upper"
                                 ToolTip="Negara tujuan keberangkatan"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Nama PT" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding NamaPT, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nama perusahaan / PT"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- PEJABAT PENANDATANGAN -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="PEJABAT PENANDATANGAN" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Kepala Desa" GroupName="pejabat" Margin="0,0,24,0"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding IsKadesSelected, Mode=TwoWay}"/>
                        <RadioButton Content="Sekretaris Desa" GroupName="pejabat"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding IsSekdesSelected, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
