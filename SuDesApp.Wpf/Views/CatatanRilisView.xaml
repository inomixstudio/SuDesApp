<UserControl x:Class="SuDesApp.Wpf.Views.CatatanRilisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#x1F4E2;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CATATAN RILIS" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Pembaruan dan perbaikan aplikasi" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Daftar versi (scroll; tiap versi = kartu Material) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <!-- Judul versi + badge TERBARU -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="34" Height="34" CornerRadius="8"
                                            Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F4CC;" FontSize="14" Foreground="{DynamicResource AccentTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding VersionText}" FontWeight="Bold"
                                               FontSize="15" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="10"
                                            Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsLatest, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="TERBARU" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <!-- Section per versi -->
                                <ItemsControl ItemsSource="{Binding Sections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="4" Height="14" CornerRadius="2"
                                                            Background="{DynamicResource AccentBrush}"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Heading}" FontWeight="SemiBold"
                                                               FontSize="13" Foreground="{DynamicResource TextBrush}"
                                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Points}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- Grid (bukan StackPanel Horizontal) agar kolom teks
                                                                 terikat lebar viewport dan wrap — tidak memicu
                                                                 scroll horizontal. -->
                                                            <Grid Margin="12,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="&#x2022;"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           LineHeight="20"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Statusbar halaman: info versi (kiri) + identitas aplikasi (kanan) -->
        <c:AppStatusBar Grid.Row="2" Margin="0,12,0,0"
                        StatusText="{Binding VersionFooter, FallbackValue='Catatan rilis'}"/>
    </Grid>
</UserControl>