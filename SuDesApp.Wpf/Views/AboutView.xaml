<UserControl x:Class="SuDesApp.Wpf.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             xmlns:about="clr-namespace:SuDesApp.Wpf.Views.About"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">

    <!--
        Halaman Tentang Aplikasi — dibuat simple, modern, dan ringan.
        Saat dibuka hanya dirender: hero + kartu akun Google + nav kiri.
        Konten berat (fitur, teknologi, kartu dukungan, detail) baru dibangun
        saat bagiannya dipilih (lazy) — pola sama dengan Panduan WhatsApp
        dan Pencadangan Database.

        Penting: ContentControl memakai Content="{Binding}" (VM halaman) karena
        ContentPresenter menaruh nilai Content ke DataContext template. Bila
        Content-nya "BagianAktif" seluruh binding di bagian (deskripsi,
        teknologi, dst.) akan kosong.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="About/AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== Hero: logo + judul + deskripsi + lencana identitas ====== -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource HeaderIconChip}">
                    <Image Source="{Binding AppLogo}" Stretch="Uniform" Width="40" Height="40"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="TENTANG APLIKASI" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="{Binding DeskripsiSingkat}" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>

                <!-- Lencana versi + pengembang + ringkasan fitur/teknologi -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#33FFFFFF" CornerRadius="12" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock Text="{Binding AssemblyVersion, StringFormat='v{0}'}" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource HeaderTextBrush}"/>
                    </Border>
                    <Border Background="#22FFFFFF" CornerRadius="12" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock Text="{Binding AssemblyCompany}" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{DynamicResource HeaderSubtitleBrush}"/>
                    </Border>
                    <Border Background="#26FFFFFF" CornerRadius="12" Padding="10,5">
                        <TextBlock FontSize="11" Foreground="{DynamicResource HeaderTextBrush}">
                            <Run Text="{Binding JumlahFitur, Mode=OneWay}"/><Run Text=" fitur  "/>
                            <Run Text="&#x2022;  "/>
                            <Run Text="{Binding JumlahTeknologi, Mode=OneWay}"/><Run Text=" teknologi"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== Kartu akun Google (bila terhubung) ====== -->
        <Border Grid.Row="1" Style="{StaticResource AboutCard}" Padding="14" Margin="0,14,0,0"
                Visibility="{Binding HasGoogleAccount, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="22" Background="#4285F4">
                    <Grid>
                        <Image Source="{Binding GooglePhoto}" Stretch="UniformToFill"
                               Visibility="{Binding HasGooglePhoto, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding GoogleInitial}" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGooglePhoto}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding GoogleName}" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Border Background="{DynamicResource SuccessSubtleBrush}" CornerRadius="9"
                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Terhubung" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessTextBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding GoogleEmail}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ====== Nav kiri + konten bagian aktif ====== -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel navigasi kiri -->
            <Border Grid.Column="0" Style="{StaticResource WaNavPanel}" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PILIH BAGIAN" FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,2,8,10"/>
                    <ItemsControl ItemsSource="{Binding Bagian}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Tag="{Binding}" Style="{StaticResource WaNavItem}"
                                        ToolTip="{Binding DeskripsiStatus}"
                                        MouseLeftButtonUp="NavBagian_MouseLeftButtonUp">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource WaNavSelBar}"/>
                                        <TextBlock Text="{Binding Ikon}" Style="{StaticResource WaNavItemIcon}"
                                                   Width="20" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource WaNavItemText}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Konten bagian aktif (satu per satu, dibuat lazy) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding}" Focusable="False">
                    <ContentControl.Resources>
                        <DataTemplate x:Key="TemplateDetailAplikasi">
                            <about:BagianDetailAplikasiView/>
                        </DataTemplate>
                        <DataTemplate x:Key="TemplateDetailLengkap">
                            <about:BagianDetailLengkapView/>
                        </DataTemplate>
                        <DataTemplate x:Key="TemplateFitur">
                            <about:BagianFiturView/>
                        </DataTemplate>
                        <DataTemplate x:Key="TemplateTeknologi">
                            <about:BagianTeknologiView/>
                        </DataTemplate>
                        <DataTemplate x:Key="TemplateDukungan">
                            <about:BagianDukunganView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource TemplateDetailAplikasi}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="DetailLengkap">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplateDetailLengkap}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="Fitur">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplateFitur}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="Teknologi">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplateTeknologi}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="Dukungan">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplateDukungan}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </ScrollViewer>
        </Grid>

        <!-- ====== Statusbar ====== -->
        <c:AppStatusBar Grid.Row="3" Margin="0,14,0,0"
                        StatusText="{Binding BagianAktif.DeskripsiStatus}"/>
    </Grid>
</UserControl>