<UserControl x:Class="SuDesApp.Wpf.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             xmlns:about="clr-namespace:SuDesApp.Wpf.Views.About"
             xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities"
             FontSize="14" SnapsToDevicePixels="True" UseLayoutRounding="True">

    <!--
        Halaman Tentang Aplikasi.

        Susunan halaman: satu hero identitas (logo asli aplikasi, judul, versi,
        pengembang, dan ringkasan), lalu panel navigasi bagian di kiri dan isi
        bagian aktif di kanan.

        Saat dibuka hanya hero + kartu akun Google + navigasi yang dirender.
        Konten tiap bagian baru dibangun saat bagiannya dipilih (lazy) — pola
        yang sama dengan Pencadangan Database.

        Penting: ContentControl memakai Content="{Binding}" (VM halaman) karena
        ContentPresenter menaruh nilai Content ke DataContext template. Bila
        Content-nya "BagianAktif" seluruh binding di bagian (deskripsi,
        teknologi, dst.) akan kosong.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="About/AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== Hero: identitas aplikasi ====== -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Piring merek: logo aplikasi yang sebenarnya. Ikon garis tetap
                     digambar di belakangnya sebagai cadangan bila berkas logo tidak
                     termuat, sehingga piring tidak pernah tampil kosong. -->
                <Border Style="{StaticResource HeaderIconChip}">
                    <Grid>
                        <TextBlock Text="{x:Static u:IkonMenu.Tentang}"
                                   FontFamily="{StaticResource AppIconFont}"
                                   FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding AppLogo}" Stretch="Uniform"
                               ToolTip="{Binding AssemblyProduct}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="TENTANG APLIKASI" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="{Binding Tagline}" Style="{StaticResource HeaderSubtitle}"
                               MaxWidth="620" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding AssemblyCopyright}" FontSize="11" Margin="0,7,0,0"
                               Foreground="{DynamicResource HeaderSubtitleBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Lencana versi + pengembang + ringkasan fitur/teknologi -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource LapisanKuatBrush}" CornerRadius="14" Padding="12,6" Margin="0,0,8,0"
                            Effect="{StaticResource BayanganLembut}">
                        <TextBlock Text="{Binding VersiTampil}" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource HeaderTextBrush}"/>
                    </Border>
                    <Border Background="{DynamicResource LapisanLembutBrush}" CornerRadius="14" Padding="12,6" Margin="0,0,8,0">
                        <TextBlock Text="{Binding AssemblyCompany}" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{DynamicResource HeaderSubtitleBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                    </Border>
                    <Border Background="{DynamicResource LapisanSedangBrush}" CornerRadius="14" Padding="12,6">
                        <TextBlock FontSize="11" Foreground="{DynamicResource HeaderTextBrush}">
                            <Run Text="{Binding JumlahFitur, Mode=OneWay}"/><Run Text=" fitur  "/>
                            <Run Text="&#x2022;  "/>
                            <Run Text="{Binding JumlahTeknologi, Mode=OneWay}"/><Run Text=" teknologi"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== Kartu akun Google (bila terhubung) ====== -->
        <Border Grid.Row="1" Style="{StaticResource AboutCard}" Padding="16" Margin="0,14,0,0"
                Visibility="{Binding HasGoogleAccount, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="{DynamicResource GoogleBiruBrush}"
                        Effect="{StaticResource BayanganLembut}">
                    <Grid>
                        <Image Source="{Binding GooglePhoto}" Stretch="UniformToFill"
                               Visibility="{Binding HasGooglePhoto, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding GoogleInitial}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PutihBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGooglePhoto}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding GoogleName}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Border Background="{DynamicResource SuccessSubtleBrush}" CornerRadius="10"
                                Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Terhubung" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessTextBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding GoogleEmail}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== Nav kiri + konten bagian aktif ====== -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel navigasi kiri: jumlah bagian di kepala, identitas di kaki -->
            <Border Grid.Column="0" Style="{StaticResource WaNavPanel}" Margin="0,0,16,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,4,10,10">
                        <TextBlock Text="PILIH BAGIAN" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="7,1">
                            <TextBlock Text="{Binding Bagian.Count}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Kaki panel: identitas ringkas — versi dan pengembang yang
                         sedang dipakai, tanpa harus membuka Detail aplikasi. -->
                    <Border DockPanel.Dock="Bottom" Margin="4,12,4,0" Padding="10,9" CornerRadius="8"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding VersiTampil}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding AssemblyCompany}" FontSize="10" Margin="0,2,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Bagian}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Tag="{Binding}" Style="{StaticResource WaNavItem}"
                                        ToolTip="{Binding DeskripsiStatus}"
                                        MouseLeftButtonUp="NavBagian_MouseLeftButtonUp">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource WaNavSelBar}"/>
                                        <TextBlock Text="{Binding Ikon}" Style="{StaticResource WaNavItemIcon}"
                                                   Width="22" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource WaNavItemText}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Konten bagian aktif (satu per satu, dibuat lazy) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <ContentControl Content="{Binding}" Focusable="False">
                    <ContentControl.Resources>
                        <DataTemplate x:Key="TemplateDetailAplikasi">
                            <about:BagianDetailAplikasiView/>
                        </DataTemplate>
                        <DataTemplate x:Key="TemplateDetailLengkap">
                            <about:BagianDetailLengkapView/>
                        </DataTemplate>
                        <DataTemplate x:Key="TemplatePerusahaan">
                            <about:BagianPerusahaanView/>
                        </DataTemplate>
                        <DataTemplate x:Key="TemplatePersetujuan">
                            <about:BagianPersetujuanView/>
                        </DataTemplate>
                        <DataTemplate x:Key="TemplateFitur">
                            <about:BagianFiturView/>
                        </DataTemplate>
                        <DataTemplate x:Key="TemplateTeknologi">
                            <about:BagianTeknologiView/>
                        </DataTemplate>
                        <DataTemplate x:Key="TemplateTerimaKasih">
                            <about:BagianTerimaKasihView/>
                        </DataTemplate>
                        <DataTemplate x:Key="TemplateDukungan">
                            <about:BagianDukunganView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource TemplateDetailAplikasi}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="DetailLengkap">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplateDetailLengkap}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="Perusahaan">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplatePerusahaan}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="Persetujuan">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplatePersetujuan}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="Fitur">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplateFitur}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="Teknologi">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplateTeknologi}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="TerimaKasih">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplateTerimaKasih}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="Dukungan">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplateDukungan}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </ScrollViewer>
        </Grid>

        <!-- ====== Statusbar ====== -->
        <c:AppStatusBar Grid.Row="3" Margin="0,16,0,0"
                        StatusText="{Binding BagianAktif.DeskripsiStatus}"/>
    </Grid>
</UserControl>
