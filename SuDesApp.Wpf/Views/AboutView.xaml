<UserControl x:Class="SuDesApp.Wpf.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <!-- Pola sama dengan Catatan Rilis: header tetap di atas (tidak ikut scroll),
         hanya konten di bawahnya yang digulir. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header (tetap) dengan logo aplikasi -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Chip logo: 52px (lebih besar dari HeaderIconChip) untuk keterbacaan logo -->
                <Border Width="52" Height="52" CornerRadius="12" Background="White" Padding="6"
                        VerticalAlignment="Center">
                    <Image Source="{Binding AppLogo}" Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="TENTANG SuDesApp" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Informasi versi, teknologi yang digunakan, dan kontak pengembang" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>

                <!-- Chip versi (kanan header) -->
                <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="12,5"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AssemblyVersion, StringFormat='v{0}'}"
                                   FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Konten (scroll vertikal saja) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <!-- Kartu memanjang penuh mengikuti lebar halaman (tanpa batas 760px)
                 agar tidak ada konten yang terpotong -->
            <StackPanel>
                <!-- Kartu akun Google (bila terhubung) -->
                <Border Style="{StaticResource CardStyle}" Padding="14"
                        Visibility="{Binding HasGoogleAccount, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <!-- Foto profil; bila tidak ada, lingkaran inisial -->
                        <Border Width="48" Height="48" CornerRadius="24" Background="#4285F4">
                            <Grid>
                                <Image Source="{Binding GooglePhoto}" Stretch="UniformToFill"
                                       Visibility="{Binding HasGooglePhoto, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding GoogleInitial}" FontSize="20" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasGooglePhoto}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding GoogleName}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                <Border Background="{DynamicResource SuccessSubtleBrush}" CornerRadius="9"
                                        Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Terhubung" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessTextBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding GoogleEmail}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <ContentControl ContentTemplate="{StaticResource GoogleGLogo}"
                                                Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Terhubung ke Google Drive" FontSize="10.5"
                                           Foreground="{DynamicResource SuccessTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tentang Aplikasi -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="TENTANG APLIKASI" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AssemblyDescription}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="22"/>
                    </StackPanel>
                </Border>

                <!-- Detail aplikasi -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="DETAIL APLIKASI" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Produk" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AssemblyProduct}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Versi" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AssemblyVersion, StringFormat='v{0}'}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Pengembang" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AssemblyCompany}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Copyright" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AssemblyCopyright}"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Repository" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button Grid.Row="4" Grid.Column="1" Content="github.com/inomixstudio/Surat-Desa"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="https://github.com/inomixstudio/Surat-Desa"
                                    ToolTip="https://github.com/inomixstudio/Surat-Desa"
                                    Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Padding="0"
                                    Background="Transparent" BorderThickness="0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Fitur Utama -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="FITUR UTAMA" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Features}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                                                Background="{DynamicResource AccentSubtleBrush}" Margin="0,0,8,0"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="&#x2713;" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Teknologi -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="TEKNOLOGI" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Teknologi sesuai yang benar-benar dipakai aplikasi (cek PackageReference
                             SuDesApp.Core & SuDesApp.Wpf): Desktop WPF, DI/Logging Microsoft.Extensions,
                             MVVM kustom, SQLite + Dapper, bukan WebView2 tetapi PDFium, dst. -->
                        <WrapPanel Orientation="Horizontal">
                            <Border Style="{StaticResource CardStyle}" CornerRadius="16" Padding="12,6" Margin="0,0,8,8">
                                <Button Content="&#x1F5A5;  WPF (.NET 8)" Command="{Binding OpenUrlCommand}" CommandParameter="https://dotnet.microsoft.com/apps/wpf"
                                        Style="{StaticResource LinkButton}" Padding="0" Background="Transparent" BorderThickness="0"/>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" CornerRadius="16" Padding="12,6" Margin="0,0,8,8">
                                <Button Content="&#x2699;  MVVM + Layanan (.NET 8)" Command="{Binding OpenUrlCommand}" CommandParameter="https://learn.microsoft.com/dotnet/core/extensions/dependency-injection"
                                        Style="{StaticResource LinkButton}" Padding="0" Background="Transparent" BorderThickness="0"/>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" CornerRadius="16" Padding="12,6" Margin="0,0,8,8">
                                <Button Content="&#x1F5C4;  SQLite" Command="{Binding OpenUrlCommand}" CommandParameter="https://www.sqlite.org"
                                        Style="{StaticResource LinkButton}" Padding="0" Background="Transparent" BorderThickness="0"/>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" CornerRadius="16" Padding="12,6" Margin="0,0,8,8">
                                <Button Content="&#x26A1;  Dapper" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/DapperLib/Dapper"
                                        Style="{StaticResource LinkButton}" Padding="0" Background="Transparent" BorderThickness="0"/>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" CornerRadius="16" Padding="12,6" Margin="0,0,8,8">
                                <Button Content="&#x1F4C4;  QuestPDF" Command="{Binding OpenUrlCommand}" CommandParameter="https://www.questpdf.com"
                                        Style="{StaticResource LinkButton}" Padding="0" Background="Transparent" BorderThickness="0"/>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" CornerRadius="16" Padding="12,6" Margin="0,0,8,8">
                                <Button Content="&#x1F4D1;  Pdfium (Pratinjau &amp; Cetak PDF)" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/pvginkel/PdfiumViewer"
                                        Style="{StaticResource LinkButton}" Padding="0" Background="Transparent" BorderThickness="0"/>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" CornerRadius="16" Padding="12,6" Margin="0,0,8,8">
                                <Button Content="&#x1F4CA;  EPPlus (Excel)" Command="{Binding OpenUrlCommand}" CommandParameter="https://epplussoftware.com"
                                        Style="{StaticResource LinkButton}" Padding="0" Background="Transparent" BorderThickness="0"/>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" CornerRadius="16" Padding="12,6" Margin="0,0,8,8">
                                <Button Content="&#x1F4C1;  Google Drive API" Command="{Binding OpenUrlCommand}" CommandParameter="https://developers.google.com/drive"
                                        Style="{StaticResource LinkButton}" Padding="0" Background="Transparent" BorderThickness="0"/>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" CornerRadius="16" Padding="12,6" Margin="0,0,8,8">
                                <Button Content="&#x1F4C8;  Google Sheets API" Command="{Binding OpenUrlCommand}" CommandParameter="https://developers.google.com/sheets/api"
                                        Style="{StaticResource LinkButton}" Padding="0" Background="Transparent" BorderThickness="0"/>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" CornerRadius="16" Padding="12,6" Margin="0,0,8,8">
                                <Button Content="&#x1F4E6;  Newtonsoft.Json" Command="{Binding OpenUrlCommand}" CommandParameter="https://www.newtonsoft.com/json"
                                        Style="{StaticResource LinkButton}" Padding="0" Background="Transparent" BorderThickness="0"/>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" CornerRadius="16" Padding="12,6" Margin="0,0,8,8">
                                <Button Content="&#x1F510;  DPAPI (Kredensial Aman)" Command="{Binding OpenUrlCommand}" CommandParameter="https://learn.microsoft.com/dotnet/api/system.security.cryptography.protecteddata"
                                        Style="{StaticResource LinkButton}" Padding="0" Background="Transparent" BorderThickness="0"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Dukung Pengembangan -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="DUKUNG PENGEMBANGAN" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="  GitHub Repository" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/inomixstudio/Surat-Desa"
                                ToolTip="https://github.com/inomixstudio/Surat-Desa"
                                Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        <Button Content="  Website Resmi" Command="{Binding OpenUrlCommand}" CommandParameter="https://desa-sumberjaya.com"
                                Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        <Button Content="  Support Us" Command="{Binding OpenUrlCommand}" CommandParameter="https://saweria.co/arieino"
                                Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        <Button Content="  Email Pengembang" Command="{Binding OpenUrlCommand}" CommandParameter="mailto:inomixstudio@gmail.com"
                                Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <Separator Margin="0,0,0,12"/>
                        <TextBlock Text="KRITIK &amp; SARAN" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <Button Content="  desasumberjaya2020@gmail.com" Command="{Binding OpenUrlCommand}"
                                CommandParameter="mailto:desasumberjaya2020@gmail.com"
                                Style="{StaticResource LinkButton}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>