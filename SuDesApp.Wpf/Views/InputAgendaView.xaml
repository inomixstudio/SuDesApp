<UserControl x:Class="SuDesApp.Wpf.Views.InputAgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kepala halaman -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#128209;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, Mode=OneWay}" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Isi data surat pada buku agenda Surat Masuk/Keluar. Isian disimpan ke arsip desa; lampiran PDF atau gambar boleh ditambahkan."
                               Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
            <StackPanel>

                <!-- Data surat -->
                <Border Style="{StaticResource FormCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="DATA SURAT" Style="{StaticResource FormSectionTitle}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nomor Surat" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding NomorSurat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Nomor Surat"
                                     ToolTip="Nomor surat sebagaimana tertulis di berkas"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Tanggal Surat" Style="{StaticResource FormLabel}"
                                       Margin="16,6,10,6"/>
                            <StackPanel Grid.Row="0" Grid.Column="3">
                                <TextBox Style="{StaticResource FormField}"
                                         Text="{Binding TanggalSurat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Tanggal Surat"
                                         ToolTip="Format DD-MM-YYYY, misal 15-08-2026"/>
                                <TextBlock Text="Format: DD-MM-YYYY (mis. 15-08-2026)" FontSize="11" Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tgl Diterima / Dikirim" Style="{StaticResource FormLabel}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBox Style="{StaticResource FormField}"
                                         Text="{Binding TanggalTerimaKirim, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Tanggal Diterima atau Dikirim"
                                         ToolTip="Format DD-MM-YYYY. Kosongkan bila surat belum diterima/dikirim."/>
                                <TextBlock Text="Format: DD-MM-YYYY (opsional)" FontSize="11" Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Asal / Tujuan Surat" Style="{StaticResource FormLabel}"
                                       Margin="16,6,10,6"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource FormField}"
                                     Text="{Binding AsalTujuan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Asal atau Tujuan Surat"
                                     ToolTip="Instansi atau pihak asal surat (surat masuk) atau tujuan surat (surat keluar)"/>
                        </Grid>

                        <TextBlock Text="Perihal" Style="{StaticResource FormLabel}" Margin="0,10,0,0"/>
                        <TextBox Style="{StaticResource FormField}" Margin="0,4,0,0"
                                 Text="{Binding Perihal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Perihal"/>

                        <TextBlock Text="Isi Ringkas" Style="{StaticResource FormLabel}" Margin="0,10,0,0"/>
                        <TextBox Style="{StaticResource FormField}" Margin="0,4,0,0" MinHeight="64" Height="64"
                                 Text="{Binding IsiRingkas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Isi Ringkas"/>

                        <TextBlock Text="Keterangan" Style="{StaticResource FormLabel}" Margin="0,10,0,0"/>
                        <TextBox Style="{StaticResource FormField}" Margin="0,4,0,0" Height="48"
                                 Text="{Binding Keterangan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Keterangan"/>
                    </StackPanel>
                </Border>

                <!-- Lampiran -->
                <Border Style="{StaticResource FormCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="LAMPIRAN (OPSIONAL)" Style="{StaticResource FormSectionTitle}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Pilih Berkas" Width="112" Height="32" Margin="0,0,8,0"
                                    Command="{Binding PilihLampiranCommand}" Style="{StaticResource SecondaryButton}"
                                    ToolTip="Pilih berkas PDF atau gambar hasil pindai surat"/>
                            <Button Content="Buka" Width="64" Height="32" Margin="0,0,8,0"
                                    Command="{Binding BukaLampiranCommand}" Style="{StaticResource SecondaryButton}"
                                    ToolTip="Buka berkas lampiran"/>
                            <Button Content="Hapus" Width="70" Height="32"
                                    Command="{Binding HapusLampiranCommand}" Style="{StaticResource OutlineButton}"
                                    ToolTip="Buang lampiran (berkas dihapus saat Simpan)"/>
                            <Border CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSubtleBrush}"
                                    Visibility="{Binding HasLampiran, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding EkstensiLampiran}" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding LampiranDisplay, Mode=OneWay}" FontSize="12" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LampiranDisplay, Mode=OneWay}"/>
                        <TextBlock Text="Hanya berkas PDF atau gambar (pindai/tangkapan surat) yang dapat dilampirkan. Berkas hanya disalin ke folder arsip; isinya tidak dibaca aplikasi."
                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Panel aksi -->
        <Border Grid.Row="2" Style="{StaticResource ToolbarCard}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Data disimpan ke buku agenda desa. Setelah tersimpan, halaman kembali ke daftar agenda dan daftarnya diperbarui."/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Batal" Width="110" Height="34" Margin="0,0,8,0"
                            Command="{Binding CancelCommand}" Style="{StaticResource OutlineButton}"
                            ToolTip="Kembali tanpa menyimpan"/>
                    <Button Content="Simpan" Width="120" Height="34"
                            Command="{Binding SaveCommand}" Style="{StaticResource SuccessButton}"
                            ToolTip="Simpan data ke buku agenda"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
