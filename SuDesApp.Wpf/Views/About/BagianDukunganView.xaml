<UserControl x:Class="SuDesApp.Wpf.Views.About.BagianDukunganView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:views="clr-namespace:SuDesApp.Wpf.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Root menegaskan ulang DataContext ke VM halaman (lihat BagianDetailAplikasiView). -->
    <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:AboutView}}">
        <StackPanel>
            <!-- Dukung pengembangan -->
            <Border Style="{StaticResource AboutCard}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="DUKUNG PENGEMBANGAN" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>
                    <TextBlock Text="SuDesApp dikembangkan secara terbuka dan gratis. Bantu lewat tautan di bawah ini."
                               Style="{StaticResource SectionSubtitle}" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Kartu tautan: Tag=URL, klik via code-behind -->
                        <Border Grid.Row="0" Grid.Column="0" Tag="https://github.com/inomixstudio/SudesApp"
                                Style="{StaticResource TautanKartu}" MouseLeftButtonUp="Tautan_MouseLeftButtonUp"
                                ToolTip="https://github.com/inomixstudio/SudesApp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4A0;" FontSize="16" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="GitHub Repository" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Kode sumber &amp; rilis" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Tag="https://desa-sumberjaya.com"
                                Style="{StaticResource TautanKartu}" MouseLeftButtonUp="Tautan_MouseLeftButtonUp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F310;" FontSize="16" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Website Resmi" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="desa-sumberjaya.com" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Tag="https://saweria.co/arieino"
                                Style="{StaticResource TautanKartu}" MouseLeftButtonUp="Tautan_MouseLeftButtonUp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F49D;" FontSize="16" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Support Us" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Dukungan donasi" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2" Tag="mailto:inomixstudio@gmail.com"
                                Style="{StaticResource TautanKartu}" MouseLeftButtonUp="Tautan_MouseLeftButtonUp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2709;" FontSize="16" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Email Pengembang" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="inomixstudio@gmail.com" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Kritik & saran -->
            <Border Style="{StaticResource AboutCard}" Background="{DynamicResource AccentSubtleBrush}"
                    BorderBrush="{DynamicResource AccentBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#x1F4AC;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="KRITIK &amp; SARAN" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Masukan Anda membantu aplikasi ini berkembang. Kirim langsung ke:"
                               FontSize="11.5" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap"/>
                    <Border Tag="mailto:desasumberjaya2020@gmail.com" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource TautanKartuSurface}"
                            MouseLeftButtonUp="Tautan_MouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2709;" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"
                                       Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="desasumberjaya2020@gmail.com" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
