<UserControl xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities" x:Class="SuDesApp.Wpf.Views.About.BagianPersetujuanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SuDesApp.Wpf.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Root menegaskan ulang DataContext ke VM halaman (lihat BagianDetailAplikasiView). -->
    <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:AboutView}}">
        <Border Style="{StaticResource AboutCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Style="{StaticResource AccentSectionBar}"/>
                    <TextBlock Text="PERSETUJUAN DOKUMEN" Style="{StaticResource SectionTitle}"/>
                </StackPanel>
                <TextBlock Text="Versi Kebijakan Privasi dan Syarat &amp; Ketentuan yang Anda setujui di komputer ini. Persetujuan diminta saat aplikasi pertama kali dipakai atau diaktifkan, dan diminta ulang bila versi dokumennya diperbarui."
                           Style="{StaticResource SectionSubtitle}" Margin="0,0,0,14"/>

                <!-- Ringkasan: kapan terakhir menyetujui / berapa dokumen tercatat -->
                <Border Background="{DynamicResource AccentSubtleBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static u:IkonMenu.Gembok}" FontSize="15" Margin="0,0,9,0"
                                   VerticalAlignment="Center" FontFamily="{StaticResource AppIconFont}"/>
                        <TextBlock Text="{Binding RingkasanPersetujuan}" FontSize="13"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextBrush}"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Persetujuan}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- Judul + lencana status -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Judul}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <Border Grid.Column="1" CornerRadius="10" Padding="9,2"
                                                VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SudahDisetujui}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusTampil}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SudahDisetujui}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Inti permintaan: versi yang DISETUJUI + waktunya -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Versi disetujui"
                                                   Style="{StaticResource DetailLabel}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VersiDisetujui}"
                                                   Style="{StaticResource DetailNilai}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Disetujui pada"
                                                   Style="{StaticResource DetailLabel}" Margin="0,6,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisetujuiPadaTampil}"
                                                   FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextBrush}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Di komputer ini"
                                                   Style="{StaticResource DetailLabel}" Margin="0,6,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VersiTerpasang}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>

                                    <!-- Dokumen terpasang sudah lebih baru dari yang disetujui -->
                                    <TextBlock Text="{Binding Catatan}" FontSize="11" Margin="0,8,0,0"
                                               TextWrapping="Wrap" LineHeight="16"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               Visibility="{Binding PerluPembaruan, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Dokumen lengkapnya dapat dibaca kapan saja di Bantuan → Dokumentasi → Kebijakan."
                           FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
