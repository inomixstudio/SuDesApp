<UserControl xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities" x:Class="SuDesApp.Wpf.Views.About.BagianPerusahaanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:views="clr-namespace:SuDesApp.Wpf.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Bagian "Perusahaan": siapa yang membuat dan merawat SuDesApp.

        Struktur halaman mengikuti pertanyaan pengguna secara berurutan:
        1. bagan naungan — sekilas terbaca bahwa Sumberjaya Dev berada di bawah
           PT Duta Publik dan SuDesApp adalah produknya;
        2. kartu perusahaan induk — logo + badan hukum + bidang usaha + tautan;
        3. kartu pengembang — logo + peran + saluran kontak.

        Logo perusahaan berlatar terang, jadi keduanya diletakkan di atas piring
        putih (PiringLogo) agar tampil sama di seluruh tema, termasuk tema gelap
        dan kontras tinggi.
    -->
    <!-- Root menegaskan ulang DataContext ke VM halaman (lihat BagianDetailAplikasiView). -->
    <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:AboutView}}">
        <StackPanel>

            <!-- ======================= 1. Bagan naungan ======================= -->
            <Border Style="{StaticResource AboutCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="STRUKTUR PERUSAHAAN" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionSubtitle}" Margin="0,0,0,18"
                               Text="SuDesApp dibangun dan dirawat Sumberjaya Dev — unit pengembangan perangkat lunak di bawah naungan PT Duta Publik."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Simpul induk: monogram Duta Publik -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PiringIkonBagan}">
                            <Image Source="{Binding IkonDutaPublik}" Stretch="Uniform" Width="40" Height="32"
                                   ToolTip="Duta Publik — dutapublik.com"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource BaganSimpul}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PerusahaanInduk}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource BaganLencana}">
                                        <TextBlock Text="Perusahaan induk" Style="{StaticResource BaganLencanaTeks}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding BidangInduk}" FontSize="11" Margin="0,3,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Penghubung induk → pengembang -->
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <Border Style="{StaticResource BaganGaris}"/>
                            <TextBlock Style="{StaticResource BaganUjung}"/>
                        </StackPanel>

                        <!-- Simpul pengembang: monogram Sumberjaya Dev -->
                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PiringIkonBagan}">
                            <Image Source="{Binding IkonSumberjayaDev}" Stretch="Uniform" Width="32" Height="40"
                                   ToolTip="Sumberjaya Dev — software developer"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource BaganSimpul}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding MerekPengembang}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource BaganLencana}">
                                        <TextBlock Text="Unit teknologi" Style="{StaticResource BaganLencanaTeks}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Pengembangan perangkat lunak &amp; aplikasi" FontSize="11" Margin="0,3,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Penghubung pengembang → produk -->
                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <Border Style="{StaticResource BaganGaris}"/>
                            <TextBlock Style="{StaticResource BaganUjung}"/>
                        </StackPanel>

                        <!-- Simpul produk: ikon aplikasi -->
                        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource PiringIkonBagan}">
                            <Image Source="{Binding AppLogo}" Stretch="Uniform" Width="36" Height="36"
                                   ToolTip="{Binding AssemblyTitle}"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource BaganSimpul}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AssemblyProduct}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource BaganLencana}">
                                        <TextBlock Text="Produk" Style="{StaticResource BaganLencanaTeks}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Aplikasi administrasi &amp; surat-menyurat desa" FontSize="11" Margin="0,3,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 2. Kartu perusahaan induk ==================== -->
            <Border Style="{StaticResource AboutCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="PERUSAHAAN INDUK" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DeskripsiInduk}" Style="{StaticResource SectionSubtitle}" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PiringLogo}" Padding="14,12">
                            <Image Source="{Binding LogoDutaPublik}" Stretch="Uniform" Width="260" Height="54"
                                   ToolTip="{Binding DutaPublikTampil}"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PerusahaanInduk}" Style="{StaticResource MerekJudul}"/>
                            <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="Badan hukum:"/><Run Text=" "/><Run Text="{Binding BadanHukumInduk, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding BidangInduk}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding MotoInduk}" Style="{StaticResource MerekMoto}"/>

                            <Border Tag="{Binding UrlDutaPublik}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource TautanKartu}"
                                    MouseLeftButtonUp="Tautan_MouseLeftButtonUp"
                                    ToolTip="{Binding UrlDutaPublik}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static u:IkonMenu.Dunia}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="{StaticResource AppIconFont}"/>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}">
                                        <Run Text="Kunjungi"/><Run Text=" "/><Run Text="{Binding DutaPublikTampil, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== 3. Kartu pengembang ===================== -->
            <Border Style="{StaticResource AboutCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="PENGEMBANG APLIKASI" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DeskripsiPengembang}" Style="{StaticResource SectionSubtitle}" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PiringLogo}" Padding="14,12">
                            <Image Source="{Binding LogoSumberjayaDev}" Stretch="Uniform" Width="186" Height="142"
                                   ToolTip="{Binding MerekPengembang}"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MerekPengembang}" Style="{StaticResource MerekJudul}"/>
                            <TextBlock Text="Software developer — pengembangan, pemeliharaan, dan dukungan teknis aplikasi desa."
                                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Tag="{Binding EmailPengembang}" Margin="0,0,10,0"
                                        Style="{StaticResource TautanKartu}"
                                        MouseLeftButtonUp="Tautan_MouseLeftButtonUp"
                                        ToolTip="{Binding EmailPengembangTampil}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static u:IkonMenu.Surel}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="{StaticResource AppIconFont}"/>
                                        <TextBlock Text="{Binding EmailPengembangTampil}" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Tag="{Binding RepoUrl}" Style="{StaticResource TautanKartu}"
                                        MouseLeftButtonUp="Tautan_MouseLeftButtonUp"
                                        ToolTip="{Binding RepoUrl}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static u:IkonMenu.Kode}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="{StaticResource AppIconFont}"/>
                                        <TextBlock Text="{Binding RepoTampil}" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
