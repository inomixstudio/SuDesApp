<UserControl x:Class="SuDesApp.Wpf.Views.About.BagianTeknologiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:views="clr-namespace:SuDesApp.Wpf.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Root menegaskan ulang DataContext ke VM halaman (lihat BagianDetailAplikasiView). -->
    <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:AboutView}}">
        <Border Style="{StaticResource AboutCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Style="{StaticResource AccentSectionBar}"/>
                    <TextBlock Text="TEKNOLOGI" Style="{StaticResource SectionTitle}"/>
                </StackPanel>
                <TextBlock Text="Teknologi di balik SuDesApp. Klik chip untuk membuka dokumentasi resminya."
                           Style="{StaticResource SectionSubtitle}" Margin="0,0,0,12"/>

                <!-- Chips teknologi (diklik → buka URL). Border dengan Tag + event
                     MouseLeftButtonUp, pola yang sama dengan navigasi PanduanWa. -->
                <ItemsControl ItemsSource="{Binding Teknologi}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Tag="{Binding}" Style="{StaticResource ChipTeknologi}"
                                    MouseLeftButtonUp="ChipTeknologi_MouseLeftButtonUp">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Ikon}" FontSize="13" VerticalAlignment="Center"
                                               Margin="0,0,7,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nama}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding Keterangan}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
