<UserControl x:Class="SuDesApp.Wpf.Views.About.BagianFiturView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:views="clr-namespace:SuDesApp.Wpf.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Root menegaskan ulang DataContext ke VM halaman (lihat BagianDetailAplikasiView). -->
    <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:AboutView}}">
        <Border Style="{StaticResource AboutCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="12,0,12,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="FITUR UTAMA" Style="{StaticResource SectionTitle}"/>
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="9" Padding="8,2"
                                Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding JumlahFitur, StringFormat='{}{0} fitur'}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Fitur utama yang tersedia di SuDesApp."
                               Style="{StaticResource SectionSubtitle}" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- ItemsControl polos (bukan ListBox): tanpa seleksi, tanpa latar
                     baris kotak-kotak; seluruh 18 fitur tampil sebagai daftar teks
                     dan halaman yang menggulung. -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Features}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Grid Auto+* (bukan StackPanel horizontal) agar teks
                                 membungkus dengan benar pada lebar kartu. -->
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#x2713;" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           VerticalAlignment="Top" Margin="0,1,9,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
