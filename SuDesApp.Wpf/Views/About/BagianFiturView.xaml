<UserControl x:Class="SuDesApp.Wpf.Views.About.BagianFiturView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:views="clr-namespace:SuDesApp.Wpf.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AboutStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Bagian "Fitur utama".

        Fitur dikelompokkan menurut pekerjaan sehari-hari kantor desa, bukan
        ditampilkan sebagai satu daftar panjang. Tiap kelompok mendapat kartunya
        sendiri: ikon, nama kelompok, jumlah fitur, satu kalimat penjelas, lalu
        butir-butirnya.
    -->
    <!-- Root menegaskan ulang DataContext ke VM halaman (lihat BagianDetailAplikasiView). -->
    <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:AboutView}}">
        <StackPanel>
            <!-- Ringkasan di atas daftar -->
            <Border Style="{StaticResource AboutCard}" Background="{DynamicResource PanelBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="FITUR UTAMA" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <TextBlock Text="Semua yang bisa dilakukan SuDesApp, disusun menurut pekerjaan yang dijalankan di kantor desa."
                                   Style="{StaticResource SectionSubtitle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="10,5" Margin="0,0,8,0">
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{Binding JumlahFitur, Mode=OneWay}"/><Run Text=" fitur"/>
                            </TextBlock>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="10,5">
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{Binding JumlahKelompokFitur, Mode=OneWay}"/><Run Text=" kelompok"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Satu kartu per kelompok fitur -->
            <ItemsControl ItemsSource="{Binding FiturKelompok}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AboutCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="{Binding Ikon}" FontSize="14" VerticalAlignment="Center"
                                               Margin="0,0,9,0"/>
                                    <TextBlock Text="{Binding Judul}" Style="{StaticResource SectionTitle}"/>
                                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="9"
                                            Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Butir.Count, StringFormat='{}{0} fitur'}"
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Keterangan}" Style="{StaticResource SectionSubtitle}"
                                           Margin="0,0,0,12"/>

                                <!-- ItemsControl polos (bukan ListBox): tanpa seleksi, tanpa latar
                                     baris kotak-kotak; seluruh butir tampil sebagai daftar teks
                                     dan halaman yang menggulung. -->
                                <ItemsControl ItemsSource="{Binding Butir}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Grid Auto+* (bukan StackPanel horizontal) agar teks
                                                 membungkus dengan benar pada lebar kartu. -->
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#x2713;" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           VerticalAlignment="Top" Margin="0,1,9,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
