<UserControl x:Class="SuDesApp.Wpf.Views.WaPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="14" SnapsToDevicePixels="True" UseLayoutRounding="True"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <!-- Baris daftar permintaan: tinggi ikuti isi (bukan DataGrid).
             Penyelarasan dasar dan zebra (baris bergantian ZebraBrush)
             dari gaya bersama TabelBarisZebra; baris yang belum
             dibaca tetap ditampilkan tebal. Daftar pakai
             AlternationCount=4. -->
        <Style x:Key="WaBaris" TargetType="ListBoxItem" BasedOn="{StaticResource TabelBarisZebra}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRead}" Value="False">
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Lencana status permintaan: warna per status. -->
        <DataTemplate x:Key="StatusWa">
            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Top">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="BARU">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="PERLU_PERBAIKAN">
                                <Setter Property="Foreground" Value="DarkOrange"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="DITOLAK">
                                <Setter Property="Foreground" Value="Firebrick"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="SELESAI">
                                <Setter Property="Foreground" Value="SeaGreen"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#128172;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Layanan Surat Online" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Permintaan dari warga lewat WhatsApp, Google Sheet, atau API Desa diproses otomatis (surat dibuat, PDF/tautan dikirim balik). Panel ini untuk memantau antrian dan menangani permintaan yang perlu campur tangan operator."
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Segarkan" Command="{Binding SegarkanCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                        ToolTip="Muat ulang daftar permintaan dari database."/>
                <Button Grid.Column="1" Content="Setujui &amp; Buat Surat" Command="{Binding SetujuiCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                        ToolTip="Buat surat dari permintaan terpilih dan kirim notifikasi ke pemohon (pilih baris dulu). Permintaan yang sudah SELESAI/DIPROSES otomatis tidak diproses ulang."/>
                <Button Grid.Column="2" Content="Tolak" Command="{Binding TolakCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0"
                        ToolTip="Tolak permintaan terpilih (pilih baris dulu). Pesan penolakan dikirim ke nomor WhatsApp pemohon."/>
                <Button Grid.Column="3" Content="Tandai Dibaca" Command="{Binding TandaiDibacaCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                        ToolTip="Tandai permintaan terpilih sebagai sudah dibaca. Bila tidak ada baris terpilih, semua permintaan ditandai dibaca (huruf tebal = belum dibaca)."/>
                <Button Grid.Column="4" Content="Kirim Tautan Unduh" Command="{Binding KirimPdfCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,6,0"
                        ToolTip="Generate ulang PDF surat permintaan terpilih, unggah ke Google Drive, lalu kirim TAUTAN UNDUH via WhatsApp ke pemohon (teks/link saja — tanpa lampiran berkas). Surat harus sudah dibuat."/>

                <TextBlock Grid.Column="6" Foreground="{DynamicResource TextSecondaryBrush}" Text="Filter status:" VerticalAlignment="Center" Margin="0,0,6,0" HorizontalAlignment="Right"/>
                <ComboBox Grid.Column="7" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}"
                          Width="150" ToolTip="Tampilkan permintaan sesuai status."/>
            </Grid>
        </Border>

        <!-- Banner pemberitahuan kesiapan layanan online (tampil bila ada kondisi yang menghalangi) -->
        <StackPanel Grid.Row="2">
            <!-- 1) Akun Google belum terhubung — mode tautan Google Formulir/Sheet aktif -->
            <Border Background="{DynamicResource WarningSubtleBrush}" BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GoogleRequiredNotConnected}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding GoogleRequiredMessage}" Foreground="{DynamicResource WarningTextBrush}"
                               TextWrapping="Wrap" LineHeight="17"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Masuk dengan Akun Google" Padding="14,0"
                                Style="{StaticResource PrimaryButton}"
                                ToolTip="Membuka halaman Login dengan Google. Setelah terhubung, kembali ke panel ini dan klik Segarkan."
                                Click="OnLoginGoogleClick"/>
                        <Button Content="Periksa Pengaturan Formulir &amp; Sheet" Padding="14,0" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Buka Pengaturan Aplikasi bagian Google Formulir &amp; Sheet"
                                Click="OnBukaPengaturanGoogleClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2) Gateway WhatsApp belum siap (token kosong) -->
            <Border Background="{DynamicResource WarningSubtleBrush}" BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WaGatewayNotReady}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding WaGatewayMessage}" Foreground="{DynamicResource WarningTextBrush}"
                           TextWrapping="Wrap" LineHeight="17"/>
            </Border>
        </StackPanel>

        <!-- Ringkasan -->
        <TextBlock Grid.Row="3" Text="{Binding Ringkasan}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="2,0,0,8"/>

        <!-- Daftar permintaan: tinggi baris ikuti isi — nama dan
             jenis surat yang panjang membungkus sampai tuntas
             alih-alih dipotong. Kepala kolom ikut satu ScrollViewer
             sehingga selalu sejajar dengan baris. DataGrid sengaja
             tidak dipakai: RowHeight="Auto" memicu loop layout
             (stack overflow), tinggi tetap memotong teks. -->
        <Border Grid.Row="4" Style="{StaticResource GridHostCard}" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Kepala kolom: lebar kolomnya sama persis dengan baris -->
                    <Border Style="{StaticResource TabelKepalaPita}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Kode" FontWeight="Bold"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Tanggal" FontWeight="Bold"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="Nama" FontWeight="Bold"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="3" Text="NIK" FontWeight="Bold"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="4" Text="Jenis Surat" FontWeight="Bold"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="5" Text="Status" FontWeight="Bold"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="6" Text="No. WhatsApp" FontWeight="Bold"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="7" Text="Sumber" FontWeight="Bold"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <ListBox ItemsSource="{Binding Items}"
                             AlternationCount="4"
                             BorderThickness="0" Background="Transparent" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectionMode="Single"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource WaBaris}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Kode}"
                                                   VerticalAlignment="Top" ToolTip="{Binding Kode}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Tanggal}"
                                                   VerticalAlignment="Top" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Nama}"
                                                   TextWrapping="Wrap" VerticalAlignment="Top"
                                                   Margin="0,0,12,0" ToolTip="{Binding Nama}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Nik}"
                                                   TextWrapping="Wrap" VerticalAlignment="Top"
                                                   Margin="0,0,12,0" ToolTip="{Binding Nik}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Jenis}"
                                                   TextWrapping="Wrap" VerticalAlignment="Top"
                                                   Margin="0,0,12,0" ToolTip="{Binding Jenis}"/>
                                        <ContentControl Grid.Column="5" Content="{Binding}"
                                                        ContentTemplate="{StaticResource StatusWa}"
                                                        Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="6" Text="{Binding NomorWa}"
                                                   TextWrapping="Wrap" VerticalAlignment="Top"
                                                   Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="7" Text="{Binding Sumber}"
                                                   TextWrapping="Wrap" VerticalAlignment="Top"
                                                   ToolTip="{Binding Sumber}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Detail permintaan terpilih -->
        <Border Grid.Row="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Foreground="{DynamicResource TextBrush}" Text="Detail Permintaan" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Selected.RingkasanDetail}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
                    <TextBlock Text="{Binding Selected.CatatanTampil}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource WarningTextBrush}"
                               Visibility="{Binding Selected.AdaCatatan, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Pesan asli dari pemohon:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding Selected.DetailPesan, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="104"
                             Background="Transparent" FontFamily="Consolas" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Placeholder saat belum ada baris terpilih -->
        <TextBlock Grid.Row="5" Text="Pilih permintaan di tabel untuk melihat detail lengkap dan pesan aslinya."
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="2,0,0,10"
                   Visibility="Collapsed">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Riwayat kirim -->
        <Expander Grid.Row="6" Header="Riwayat Kirim WhatsApp" IsExpanded="False">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                <ListBox ItemsSource="{Binding RiwayatLog}" FontFamily="Consolas" FontSize="11"
                         MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent"/>
            </Border>
        </Expander>
    </Grid>
</UserControl>
