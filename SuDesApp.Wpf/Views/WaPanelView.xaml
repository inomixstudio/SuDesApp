<UserControl x:Class="SuDesApp.Wpf.Views.WaPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True"
             Unloaded="OnUnloaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#128172;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Layanan Surat Online (WhatsApp)" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Permintaan dari warga diproses otomatis (surat dibuat, PDF dikirim balik). Panel ini untuk memantau antrian dan menangani permintaan yang perlu campur tangan operator."
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Segarkan" Command="{Binding SegarkanCommand}" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,6,0"
                        ToolTip="Muat ulang daftar permintaan dari database."/>
                <Button Grid.Column="1" Content="Setujui &amp; Buat Surat" Command="{Binding SetujuiCommand}" Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,6,0"
                        ToolTip="Buat surat dari permintaan terpilih dan kirim notifikasi ke pemohon (pilih baris dulu). Permintaan yang sudah SELESAI/DIPROSES otomatis tidak diproses ulang."/>
                <Button Grid.Column="2" Content="Tolak" Command="{Binding TolakCommand}" Style="{StaticResource DangerButton}" Height="32" Margin="0,0,6,0"
                        ToolTip="Tolak permintaan terpilih (pilih baris dulu). Pesan penolakan dikirim ke nomor WhatsApp pemohon."/>
                <Button Grid.Column="3" Content="Tandai Dibaca" Command="{Binding TandaiDibacaCommand}" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,6,0"
                        ToolTip="Tandai permintaan terpilih sebagai sudah dibaca. Bila tidak ada baris terpilih, semua permintaan ditandai dibaca (huruf tebal = belum dibaca)."/>
                <Button Grid.Column="4" Content="Kirim Tautan Unduh" Command="{Binding KirimPdfCommand}" Style="{StaticResource SuccessButton}" Height="32" Margin="0,0,6,0"
                        ToolTip="Generate ulang PDF surat permintaan terpilih, unggah ke Google Drive, lalu kirim TAUTAN UNDUH via WhatsApp ke pemohon (teks/link saja — tanpa lampiran berkas). Surat harus sudah dibuat."/>

                <TextBlock Grid.Column="6" Foreground="{DynamicResource TextSecondaryBrush}" Text="Filter status:" VerticalAlignment="Center" Margin="0,0,6,0" HorizontalAlignment="Right"/>
                <ComboBox Grid.Column="7" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}"
                          Width="150" Height="30" ToolTip="Tampilkan permintaan sesuai status."/>
            </Grid>
        </Border>

        <!-- Banner pemberitahuan kesiapan layanan online (tampil bila ada kondisi yang menghalangi) -->
        <StackPanel Grid.Row="2">
            <!-- 1) Akun Google belum terhubung — mode tautan Google Formulir/Sheet aktif -->
            <Border Background="{DynamicResource WarningSubtleBrush}" BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GoogleRequiredNotConnected}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding GoogleRequiredMessage}" Foreground="{DynamicResource WarningTextBrush}"
                               TextWrapping="Wrap" LineHeight="17"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Masuk dengan Akun Google" Height="28" Padding="14,0"
                                Style="{StaticResource PrimaryButton}"
                                ToolTip="Membuka halaman Login dengan Google. Setelah terhubung, kembali ke panel ini dan klik Segarkan."
                                Click="OnLoginGoogleClick"/>
                        <Button Content="Periksa Pengaturan Formulir &amp; Sheet" Height="28" Padding="14,0" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Buka Pengaturan Aplikasi bagian Google Formulir &amp; Sheet"
                                Click="OnBukaPengaturanGoogleClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2) Gateway WhatsApp belum siap (token kosong) -->
            <Border Background="{DynamicResource WarningSubtleBrush}" BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WaGatewayNotReady}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding WaGatewayMessage}" Foreground="{DynamicResource WarningTextBrush}"
                           TextWrapping="Wrap" LineHeight="17"/>
            </Border>
        </StackPanel>

        <!-- Ringkasan -->
        <TextBlock Grid.Row="3" Text="{Binding Ringkasan}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="2,0,0,8"/>

        <!-- Grid data: mengisi seluruh sisa tinggi halaman -->
        <Border Grid.Row="4" Style="{StaticResource GridHostCard}" Margin="0,0,0,10">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" RowHeight="28">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRowStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRead}" Value="False">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="105">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding Kode}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal}" Width="118"/>
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="1.5*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Nama}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="NIK" Binding="{Binding Nik}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding Nik}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Jenis Surat" Binding="{Binding Jenis}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Jenis}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="135">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="BARU">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="PERLU_PERBAIKAN">
                                        <Setter Property="Foreground" Value="DarkOrange"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="DITOLAK">
                                        <Setter Property="Foreground" Value="Firebrick"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="SELESAI">
                                        <Setter Property="Foreground" Value="SeaGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="No. WhatsApp" Binding="{Binding NomorWa}" Width="120"/>
                    <DataGridTextColumn Header="Sumber" Binding="{Binding Sumber}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Detail permintaan terpilih -->
        <Border Grid.Row="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Foreground="{DynamicResource TextBrush}" Text="Detail Permintaan" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Selected.RingkasanDetail}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                    <TextBlock Text="{Binding Selected.CatatanTampil}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource WarningTextBrush}"
                               Visibility="{Binding Selected.AdaCatatan, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Pesan asli dari pemohon:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding Selected.DetailPesan, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="104"
                             Background="Transparent" FontFamily="Consolas" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Placeholder saat belum ada baris terpilih -->
        <TextBlock Grid.Row="5" Text="Pilih permintaan di tabel untuk melihat detail lengkap dan pesan aslinya."
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="2,0,0,10"
                   Visibility="Collapsed">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Riwayat kirim -->
        <Expander Grid.Row="6" Header="Riwayat Kirim WhatsApp" IsExpanded="False">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                <ListBox ItemsSource="{Binding RiwayatLog}" FontFamily="Consolas" FontSize="11"
                         MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent"/>
            </Border>
        </Expander>
    </Grid>
</UserControl>
