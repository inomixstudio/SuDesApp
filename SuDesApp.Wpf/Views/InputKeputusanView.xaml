<UserControl x:Class="SuDesApp.Wpf.Views.InputKeputusanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="14" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kepala halaman -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#128220;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, Mode=OneWay}" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Isi identitas SK / Peraturan desa. Kolom bertanda * wajib diisi dan nomor harus unik untuk jenis arsip yang sama."
                               Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
            <StackPanel>

                <!-- Identitas keputusan -->
                <Border Style="{StaticResource FormCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="IDENTITAS KEPUTUSAN / PERATURAN" Style="{StaticResource FormSectionTitle}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nomor *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Nomor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Nomor Keputusan"
                                     ToolTip="Nomor SK / Perdes / Perkades"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Tanggal *" Style="{StaticResource FormLabel}"
                                       Margin="16,6,10,6"/>
                            <StackPanel Grid.Row="0" Grid.Column="3">
                                <TextBox Style="{StaticResource FormField}"
                                         Text="{Binding Tanggal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Tanggal Keputusan"
                                         ToolTip="Format DD-MM-YYYY, misal 15-08-2026"/>
                                <TextBlock Text="Format: DD-MM-YYYY (mis. 15-08-2026)" FontSize="11" Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tentang *" Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Top" Margin="0,10,10,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                     Grid.ColumnSpan="3" Height="72" Margin="0,10,0,0" AcceptsReturn="True"
                                     Text="{Binding Tentang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Tentang"
                                     ToolTip="Pokok isi keputusan/peraturan"/>
                        </Grid>

                        <TextBlock Text="Keterangan *" Style="{StaticResource FormLabel}" Margin="0,10,0,0"/>
                        <TextBox Style="{StaticResource FormField}" Margin="0,4,0,0" Height="48"
                                 Text="{Binding Keterangan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Keterangan"/>
                    </StackPanel>
                </Border>

                <!-- Naskah Perdes: halaman yang disunting lalu dirender generator PDF -->
                <Border Style="{StaticResource FormCard}"
                        Visibility="{Binding IsPerdes, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="NASKAH PERATURAN DESA" Style="{StaticResource FormSectionTitle}"/>
                        </StackPanel>

                        <TextBlock Text="Naskah disusun per halaman dan dirender oleh generator PDF aplikasi — bukan dari berkas Word. Setiap halaman dimulai di lembar baru; isi yang panjang mengalir ke lembar berikutnya. Nomor, tahun, dan tanggal pada kepala surat serta penutup mengikuti isian di atas saat pratinjau atau simpan."
                                   TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Tambah Halaman" Command="{Binding TambahHalamanCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    ToolTip="Tambahkan satu bagian naskah baru"/>
                            <Button Content="Pratinjau PDF" Command="{Binding PratinjauNaskahCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    ToolTip="Buat dan lihat PDF dari naskah yang sedang disunting"/>
                            <Button Content="Lihat PDF Tersimpan" Command="{Binding OpenWordFileCommand}"
                                    IsEnabled="{Binding HasStoredOrPickedFile, FallbackValue=False}"
                                    Style="{StaticResource OutlineButton}"
                                    ToolTip="Buka berkas PDF yang sudah tersimpan di arsip"/>
                        </WrapPanel>

                        <Border Background="{DynamicResource ZebraBrush}" CornerRadius="6"
                                Padding="10,7" Margin="0,0,0,10">
                            <TextBlock Text="{Binding InfoNaskah}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ListBox Grid.Column="0" ItemsSource="{Binding HalamanNaskah}"
                                     SelectedItem="{Binding HalamanTerpilih, Mode=TwoWay}"
                                     Height="440" BorderThickness="1"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     Background="{DynamicResource SurfaceBrush}"
                                     AutomationProperties.Name="Daftar halaman naskah">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding Judul}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Ringkasan}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Column="2" IsEnabled="{Binding AdaHalamanTerpilih}">
                                <TextBlock Text="Nama halaman" Style="{StaticResource FormLabel}"
                                           ToolTip="Hanya menjadi label di daftar halaman; teks yang dicetak ada di kotak Isi halaman."/>
                                <TextBox Style="{StaticResource FormField}" Margin="0,0,0,8"
                                         Text="{Binding HalamanTerpilih.Judul, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Label daftar halaman — tidak ikut dicetak"
                                         AutomationProperties.Name="Nama halaman naskah"/>

                                <TextBlock Text="Isi halaman" Style="{StaticResource FormLabel}" Margin="0,6,0,0"/>
                                <TextBox Style="{StaticResource FormField}" Height="360" Margin="0,0,0,8"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="13"
                                         Text="{Binding HalamanTerpilih.Isi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Isi halaman naskah"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Naik" Command="{Binding NaikkanHalamanCommand}"
                                            Style="{StaticResource OutlineButton}" Margin="0,0,6,0"
                                            ToolTip="Pindahkan halaman ini ke atas"/>
                                    <Button Content="Turun" Command="{Binding TurunkanHalamanCommand}"
                                            Style="{StaticResource OutlineButton}" Margin="0,0,6,0"
                                            ToolTip="Pindahkan halaman ini ke bawah"/>
                                    <Button Content="Hapus Halaman" Command="{Binding HapusHalamanCommand}"
                                            Style="{StaticResource OutlineButton}"
                                            Foreground="{DynamicResource ErrorBrush}"
                                            ToolTip="Hapus halaman naskah ini"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Lampiran Word/PDF (SK/Perkades) -->
                <Border Style="{StaticResource FormCard}"
                        Visibility="{Binding IsBukanPerdes, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="LAMPIRAN (OPSIONAL)" Style="{StaticResource FormSectionTitle}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Pilih File Word / PDF" Width="168" Margin="0,0,8,0"
                                    Command="{Binding PickWordFileCommand}" Style="{StaticResource SecondaryButton}"
                                    ToolTip="Word (.docx/.doc) akan dibaca otomatis untuk mengisi formulir — berkas .doc lama dikonversi otomatis; PDF hanya dilampirkan"/>
                            <Button Content="Lihat" Width="70"
                                    Command="{Binding OpenWordFileCommand}"
                                    IsEnabled="{Binding HasStoredOrPickedFile, FallbackValue=False}"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Buka berkas lampiran"/>
                            <TextBlock Text="{Binding WordFileDisplay, Mode=OneWay}" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                        </StackPanel>

                        <TextBlock Text="Word dibaca otomatis untuk mengisi Nomor/Tanggal/Tentang/Keterangan; berkas .doc lama dikonversi otomatis lebih dulu. PDF hanya disimpan sebagai lampiran."
                                   FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Panel aksi -->
        <Border Grid.Row="2" Style="{StaticResource ToolbarCard}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Nomor harus unik untuk jenis arsip yang sama. Setelah tersimpan, halaman kembali ke daftar SK / Peraturan dan daftarnya diperbarui."/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Batal" Width="110" Margin="0,0,8,0"
                            Command="{Binding CancelCommand}" Style="{StaticResource OutlineButton}"
                            ToolTip="Kembali tanpa menyimpan"/>
                    <Button Content="Simpan" Width="120"
                            Command="{Binding SaveCommand}" Style="{StaticResource SuccessButton}"
                            ToolTip="Simpan data ke arsip SK / Peraturan"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Penghalang saat berkas Word sedang dibaca -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource TiraiBrush}" Panel.ZIndex="100"
                Visibility="{Binding IsLoadingWord, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="320" MinWidth="220">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="40" Height="40" Margin="0,0,0,16"/>
                    <TextBlock Text="Membaca berkas Word..." FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" TextAlignment="Center"/>
                    <TextBlock Text="Mohon tunggu, aplikasi sedang memproses berkas..." FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
