<UserControl x:Class="SuDesApp.Wpf.Views.VerifikasiSuratView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="{x:Static u:IkonMenu.Dokumen}" FontSize="18"
                               FontFamily="{StaticResource AppIconFont}"
                               Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource HeaderSubtitle}"
                               TextWrapping="Wrap" MaxWidth="640"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Masukan kode -->
            <Border Grid.Column="0" Style="{StaticResource FormCard}" Padding="16" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="KODE VERIFIKASI" Style="{StaticResource FormSectionTitle}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Ketik kode yang tercetak di kaki surat (bentuknya seperti SD-7K3M-9QX2), atau tempelkan seluruh isi QR."/>

                    <TextBox Text="{Binding Kode, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldBox}" Margin="0,8,0,0"
                             FontFamily="Consolas" FontSize="15" Height="34"
                             ToolTip="Huruf besar/kecil dan tanda hubung tidak berpengaruh"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Periksa" Command="{Binding CekCommand}"
                                Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,8,0"/>
                        <Button Content="Bersihkan" Command="{Binding BersihkanCommand}"
                                Style="{StaticResource OutlineButton}" Height="32"/>
                    </StackPanel>

                    <TextBlock Text="Sedang memeriksa…" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding SedangMemeriksa, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{Binding PesanGalat}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource ErrorTextBrush}"
                               Visibility="{Binding AdaGalat, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Hasil -->
            <Border Grid.Column="1" Style="{StaticResource FormCard}" Padding="18" Margin="12,0,0,0"
                    VerticalAlignment="Top"
                    Visibility="{Binding AdaHasil, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sah}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding PesanHasil}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock Text="{Binding KodeTampil}" Margin="0,8,0,0" FontFamily="Consolas"
                               FontSize="14" FontWeight="SemiBold"/>

                    <Border Margin="0,14,0,0" Padding="0" Visibility="{Binding AdaDataSurat, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nomor surat" Style="{StaticResource FieldLabel}" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NomorSuratTampil}" Margin="0,4" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Jenis surat" Style="{StaticResource FieldLabel}" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding JenisSuratTampil}" Margin="0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tanggal surat" Style="{StaticResource FieldLabel}" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TanggalSuratTampil}" Margin="0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Pemohon" Style="{StaticResource FieldLabel}" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PemohonTampil}" Margin="0,4"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
