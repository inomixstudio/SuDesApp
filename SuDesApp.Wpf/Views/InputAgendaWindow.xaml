<Window x:Class="SuDesApp.Wpf.Views.InputAgendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctrl="clr-namespace:SuDesApp.Wpf.Controls"
        Title="{Binding Title}"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        Height="470" Width="520"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        FontSize="13"
        WindowStyle="None"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <DockPanel Background="{DynamicResource WindowBackgroundBrush}">
        <!-- ===== Title bar bertema ===== -->
        <Border DockPanel.Dock="Top" Height="30" Background="{DynamicResource SidebarBackgroundBrush}"
                MouseLeftButtonDown="CaptionBorder_MouseLeftButtonDown">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource WindowTitleText}" FontWeight="SemiBold"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}"
                        Command="{x:Static ctrl:AppChromeCommands.Close}" ToolTip="Tutup (Esc)">
                    <Path Data="M 0 0 L 8 8 M 8 0 L 0 8"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"/>
                </Button>
            </DockPanel>
        </Border>

        <!-- Panel bawah: simpan/batal -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" Padding="10,8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Simpan" Width="110" Height="34" Margin="0,0,8,0"
                        Command="{Binding SaveCommand}" IsDefault="True"/>
                <Button Content="Batal" Width="110" Height="34"
                        Command="{Binding CancelCommand}" IsCancel="True"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <TextBlock Foreground="{DynamicResource TextBrush}" Text="Data Surat" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{DynamicResource TextBrush}" Text="Nomor Surat" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NomorSurat, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource TextBrush}" Text="Tanggal Surat (DD-MM-YYYY)" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TanggalSurat, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Foreground="{DynamicResource TextBrush}" Text="Tgl Diterima/Dikirim" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TanggalTerimaKirim, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Foreground="{DynamicResource TextBrush}" Text="Asal / Tujuan Surat" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AsalTujuan, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Foreground="{DynamicResource TextBrush}" Text="Perihal" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Perihal, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Foreground="{DynamicResource TextBrush}" Text="Isi Ringkas" VerticalAlignment="Top" Margin="0,4,0,10"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding IsiRingkas, UpdateSourceTrigger=PropertyChanged}"
                             Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Foreground="{DynamicResource TextBrush}" Text="Keterangan" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Keterangan, UpdateSourceTrigger=PropertyChanged}"
                             Height="50" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
    </Border>
</Window>