<UserControl x:Class="SuDesApp.Wpf.Views.PanduanWaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             xmlns:panduanWa="clr-namespace:SuDesApp.Wpf.Views.PanduanWa"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">

    <!--
        Halaman Panduan WhatsApp — navigasi daftar bagian di KIRI, konten di kanan.
        Hanya bagian aktif yang dirender (UserControl konten dibuat lazy saat
        pertama dipilih) sehingga membuka halaman terasa ringan; sebelumnya
        seluruh 6 kartu dibangun sekaligus dalam satu ScrollViewer panjang.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PanduanWa/PanduanWaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Pemetaan kunci bagian → UserControl kontennya (dibuat lazy).
                 Catatan penting bukan bagian navigasi — kartunya dirender tetap
                 di bawah konten (lihat root Grid). -->
            <DataTemplate x:Key="TemplateGambaran">
                <panduanWa:BagianGambaranView/>
            </DataTemplate>
            <DataTemplate x:Key="TemplateA">
                <panduanWa:BagianAView/>
            </DataTemplate>
            <DataTemplate x:Key="TemplateB">
                <panduanWa:BagianBView/>
            </DataTemplate>
            <DataTemplate x:Key="TemplateC">
                <panduanWa:BagianCView/>
            </DataTemplate>
            <DataTemplate x:Key="TemplateD">
                <panduanWa:BagianDView/>
            </DataTemplate>
            <DataTemplate x:Key="TemplateE">
                <panduanWa:BagianEView/>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header halaman -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <DockPanel>
                <Border Style="{StaticResource HeaderIconChip}" DockPanel.Dock="Left">
                    <TextBlock Text="&#x1F4AC;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Panduan WhatsApp" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Aktifkan layanan surat online otomatis dengan WhatsApp Cloud API resmi dari Meta (gratis): daftar aplikasi Meta, pasang token, arahkan webhook pesan masuk warga ke aplikasi ini."
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Isi: navigasi bagian di kiri + konten bagian aktif di kanan -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel navigasi kiri -->
            <Border Grid.Column="0" Style="{StaticResource WaNavPanel}" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ISI PANDUAN" FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,4,8"/>

                    <ItemsControl ItemsSource="{Binding Bagian}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Tag="{Binding}" Style="{StaticResource WaNavItem}"
                                        ToolTip="{Binding DeskripsiStatus}"
                                        MouseLeftButtonUp="NavBagian_MouseLeftButtonUp">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Penanda aksen: garis tipis di kiri item terpilih -->
                                        <Border Style="{StaticResource WaNavSelBar}"/>
                                        <TextBlock Text="{Binding Ikon}" Style="{StaticResource WaNavItemIcon}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource WaNavItemText}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Konten bagian aktif (hanya satu yang dirender). Catatan penting
                 TIDAK di dalam sini — kartunya slot tetap di bawah (Row 2),
                 selalu terlihat tanpa menggulung dan konsisten di semua bagian.
                 Content="{Binding}" sengaja: ContentPresenter menaruh nilai
                 Content ke DataContext template, jadi bila diisi "BagianAktif"
                 seluruh UserControl bagian tidak bisa membaca VM halaman. -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding}" Focusable="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource TemplateGambaran}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="A">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplateA}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="B">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplateB}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="C">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplateC}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="D">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplateD}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BagianAktif.Kunci}" Value="E">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TemplateE}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </ScrollViewer>
        </Grid>

        <!-- Catatan penting — slot tetap satu-satunya di halaman (pola statusbar:
             selalu tampil, posisi tidak berubah antar bagian, tidak berulang). -->
        <panduanWa:BagianCatatanView Grid.Row="2" Margin="0,12,0,12"/>

        <!-- Statusbar halaman: status bagian aktif (kiri) + identitas aplikasi (kanan) -->
        <c:AppStatusBar Grid.Row="3" Margin="0,0,0,0"
                        StatusText="{Binding BagianAktif.DeskripsiStatus}"/>
    </Grid>
</UserControl>
