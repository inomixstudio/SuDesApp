<UserControl x:Class="SuDesApp.Wpf.Views.PanduanWaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <!-- Kartu langkah -->
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- Bar aksen untuk judul bagian -->
        <Style x:Key="StepSectionBar" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <!-- Nomor langkah berbentuk lingkaran -->
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StepBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Mock jendela browser/aplikasi (warna sengaja "chrome" terang —
             meniru tampilan browser asli, tapi teks & border memakai tema agar
             tidak menyolok di tema gelap) -->
        <Style x:Key="MockWindow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="MockTitleBar" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
        </Style>
        <Style x:Key="MockMono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="MockField" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="12,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <!-- Header (tetap, tidak ikut scroll) -->
            <Border Grid.Row="0" Style="{StaticResource PageHeader}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource HeaderIconChip}">
                        <TextBlock Text="&#x1F4AC;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Panduan WhatsApp" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Aktifkan layanan surat online otomatis dengan WhatsApp Cloud API resmi dari Meta (gratis): daftar aplikasi Meta, pasang token, arahkan webhook pesan masuk warga ke aplikasi ini."
                                   Style="{StaticResource HeaderSubtitle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        <!-- Konten (scroll vertikal saja) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

            <!-- GAMBARAN BESAR -->
            <Border Style="{StaticResource StepCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Style="{StaticResource StepSectionBar}"/>
                        <TextBlock Text="GAMBARAN BESAR" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                        Layanan otomatis memiliki dua arah:<LineBreak/>
                        <Run FontWeight="SemiBold">1. Pesan KELUAR</Run> (tautan form &amp; tautan unduh PDF ke warga) — dikirim dari aplikasi lewat <Run FontWeight="SemiBold">WhatsApp Cloud API resmi Meta</Run>. Cukup pasang access token + Phone Number ID di Pengaturan Aplikasi. Aplikasi hanya mengirim teks/tautan — tidak pernah mengirim berkas.<LineBreak/>
                        <Run FontWeight="SemiBold">2. Pesan MASUK</Run> (permintaan warga) — dikirim oleh Meta ke &quot;webhook&quot;, yaitu alamat HTTPS publik komputer kantor. Butuh satu kali pengaturan jaringan (Bagian C).<LineBreak/>
                        <Run FontWeight="SemiBold">3. Mode tautan (Google Form/Sheet)</Run> — pesan apa pun dari warga dibalas tautan form untuk diisi sendiri; setup di Bagian D. Tanpa ini, warga mengikuti percakapan format (contoh di Bagian E).<LineBreak/>
                        <Run FontWeight="SemiBold">Kenapa Cloud API?</Run> Ini satu-satunya cara resmi memakai WhatsApp lewat aplikasi — bukan penyamaran WhatsApp Web — sehingga jauh lebih aman dari risiko nomor diblokir, tanpa branding pihak ketiga.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- BAGIAN A -->
            <Border Style="{StaticResource StepCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{StaticResource StepSectionBar}"/>
                        <TextBlock Text="BAGIAN A — DAFTAR META &amp; AKTIFKAN WHATSAPP (± 30 menit, sekali saja)" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0">
                        <!-- Langkah 1 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StepBadge}" Margin="0,1,10,0">
                                <TextBlock Style="{StaticResource StepBadgeText}" Text="1"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Buat akun &amp; aplikasi di Meta for Developers" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="Buka https://developers.facebook.com dari browser, daftar/login memakai akun Facebook desa. Lalu My Apps → Create App → pilih tipe &quot;Business&quot; → beri nama (mis. &quot;Surat Desa&quot;). Di dashboard aplikasi, tambahkan produk &quot;WhatsApp&quot; (klik tombol WhatsApp → Set up)." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                <!-- Mock halaman developer -->
                                <Border Style="{StaticResource MockWindow}" MaxWidth="440" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <Border Style="{StaticResource MockTitleBar}">
                                            <TextBlock Style="{StaticResource MockMono}" Text="developers.facebook.com  —  App Dashboard"/>
                                        </Border>
                                        <StackPanel Margin="14,12">
                                            <Border Style="{StaticResource MockField}">
                                                <TextBlock Style="{StaticResource MockMono}" Text="App :  Surat Desa   |   Tipe :  Business"/>
                                            </Border>
                                            <Border Style="{StaticResource MockField}">
                                                <TextBlock Style="{StaticResource MockMono}" Text="Produk :  [+] WhatsApp   →  Set up"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <!-- Langkah 2 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StepBadge}" Margin="0,1,10,0">
                                <TextBlock Style="{StaticResource StepBadgeText}" Text="2"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ambil Phone Number ID &amp; access token (versi uji coba dulu)" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="Di menu WhatsApp → API Setup: terdapat nomor uji coba gratis (5 penerima) — pas untuk pengujian sebelum produksi. Catat Phone Number ID dan salin access token sementara (24 jam). Aplikasi bisa langsung diuji dengan dua nilai ini (Bagian B)." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                <!-- Mock API setup -->
                                <Border Style="{StaticResource MockWindow}" MaxWidth="440" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <Border Style="{StaticResource MockTitleBar}">
                                            <TextBlock Style="{StaticResource MockMono}" Text="WhatsApp  →  API Setup"/>
                                        </Border>
                                        <StackPanel Margin="14,12">
                                            <Border Style="{StaticResource MockField}">
                                                <TextBlock Style="{StaticResource MockMono}" Text="Phone Number ID :  123456789012345"/>
                                            </Border>
                                            <Border Style="{StaticResource MockField}">
                                                <TextBlock Style="{StaticResource MockMono}" Text="Access Token    :  EAAG… (uji 24 jam)"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <!-- Langkah 3 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StepBadge}" Margin="0,1,10,0">
                                <TextBlock Style="{StaticResource StepBadgeText}" Text="3"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Untuk PRODUKSI: nomor desa + token permanen" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                    Nomor uji coba tidak untuk warga. Beralih ke produksi:<LineBreak/>
                                    1. Siapkan <Run FontWeight="SemiBold">nomor WhatsApp khusus desa</Run> (tidak boleh sedang terpasang di HP/WhatsApp Web) + verifikasi di WhatsApp Manager.<LineBreak/>
                                    2. Buat <Run FontWeight="SemiBold">System User</Run> di Business Settings (Business → Users → System Users) beri peran Admin, lalu buat <Run FontWeight="SemiBold">permanent access token</Run> (Generate Token → permission whatsapp_business_messaging + whatsapp_business_management).<LineBreak/>
                                    3. Untuk volume besar, lengkapi verifikasi bisnis Meta — tanpa itu tetap jalan dengan batas 250 penerima unik/24 jam.
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- BAGIAN B -->
            <Border Style="{StaticResource StepCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{StaticResource StepSectionBar}"/>
                        <TextBlock Text="BAGIAN B — PASANG TOKEN DI APLIKASI (± 1 menit)" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                        Buka menu <Run FontWeight="SemiBold">Pengaturan → Pengaturan Aplikasi</Run>, gulir ke blok <Run FontWeight="SemiBold">Gateway WhatsApp</Run>:<LineBreak/>
                        1. Pilih <Run FontWeight="SemiBold">WhatsApp Cloud API — resmi Meta</Run>.<LineBreak/>
                        2. Tempel <Run FontWeight="SemiBold">Access token</Run> dan <Run FontWeight="SemiBold">Phone Number ID</Run> ke kolom yang tersedia.<LineBreak/>
                        3. Isi <Run FontWeight="SemiBold">Verify token webhook</Run> dengan kata sandi buatan sendiri (mis. desa-rahasia-2026) — akan dipakai lagi di Bagian C.<LineBreak/>
                        4. Klik <Run FontWeight="SemiBold">Uji koneksi</Run> — muncul &quot;Terhubung ✓&quot; beserta nama nomor WhatsApp bila sukses.<LineBreak/>
                        5. Selesai untuk arah pesan keluar: tautan form &amp; tautan unduh PDF otomatis terkirim ke nomor warga.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- BAGIAN C -->
            <Border Style="{StaticResource StepCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{StaticResource StepSectionBar}"/>
                        <TextBlock Text="BAGIAN C — WEBHOOK: PESAN MASUK WARGA (sekali setup)" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                        Meta mengirim pesan masuk dengan cara &quot;mendorong&quot; ke alamat web HTTPS publik (webhook). Komputer kantor belum punya alamat publik, jadi pilih <Run FontWeight="SemiBold">satu</Run> opsi:
                    </TextBlock>

                    <!-- Opsi 1 -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12" Margin="0,8,0,8">
                        <StackPanel>
                            <TextBlock Text="Opsi 1 — Domain sendiri + HTTPS (jika kantor punya domain &amp; IP publik)" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                Meta mewajibkan HTTPS dengan sertifikat valid. Arahkan subdomain (mis. wa.desaanda.go.id) ke IP kantor lewat DNS, port forward ke komputer aplikasi:<LineBreak/>
                                • Port luar: <Run FontWeight="SemiBold">443</Run> (HTTPS) → proxy ke listener aplikasi di port <Run FontWeight="SemiBold">8787</Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Opsi 2 -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Opsi 2 — Tunnel gratis cloudflared (tanpa sentuh router)" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                Unduh cloudflared (paket gratis Cloudflare), jalankan sekali di komputer kantor:
                            </TextBlock>
                            <Border Background="#1E1E1E" CornerRadius="3" Padding="10,7" Margin="0,6,0,0">
                                <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#D4D4D4"
                                           Text="cloudflared tunnel --url http://localhost:8787"/>
                            </Border>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                Cloudflare menampilkan alamat HTTPS publik semacam https://acme-words.trycloudflare.com.<LineBreak/>
                                Catat alamat itu — langkah selanjutnya memakainya. (Opsional: buat shortcut agar berjalan otomatis saat komputer menyala.)
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Isi webhook di Meta -->
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0">
                        Lalu di dashboard aplikasi Meta, buka <Run FontWeight="SemiBold">WhatsApp → Configuration → Webhook</Run>, isi:
                    </TextBlock>
                    <Border Background="#1E1E1E" CornerRadius="3" Padding="10,7" Margin="0,6,0,0">
                        <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#7EE787"
                                   Text="Callback URL     :  https://alamat-publik-anda.trycloudflare.com/wa-webhook"/>
                    </Border>
                    <Border Background="#1E1E1E" CornerRadius="3" Padding="10,7" Margin="0,4,0,0">
                        <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#7EE787"
                                   Text="Verify token     :  (sama dengan yang diisi di Pengaturan Aplikasi)"/>
                    </Border>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                        Klik <Run FontWeight="SemiBold">Verify and save</Run> — aplikasi otomatis menjawab verifikasi Meta (listener berjalan setiap aplikasi dibuka, port 8787). Terakhir, di bagian <Run FontWeight="SemiBold">Webhook fields</Run> klik <Run FontWeight="SemiBold">Subscribe</Run> pada <Run FontWeight="SemiBold">messages</Run>. Pastikan aplikasi SuDesApp sedang berjalan, lalu coba kirim &quot;halo&quot; dari WhatsApp lain ke nomor desa: balasan instruksi harus muncul.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- BAGIAN D — MODE TAUTAN GOOGLE FORM/SHEET -->
            <Border Style="{StaticResource StepCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{StaticResource StepSectionBar}"/>
                        <TextBlock Text="BAGIAN D — GOOGLE FORMULIR &amp; SHEET JAWABAN (± 20 menit, sekali setup)" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Prinsip: Formulir → warga; Sheet → aplikasi -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}">Prinsipnya dua wajah:</Run>
                            yang DIKIRIM ke warga adalah tautan <Run FontWeight="SemiBold">Google Formulir</Run> (halaman isian yang enak dibuka di HP);
                            yang DIBACA aplikasi adalah <Run FontWeight="SemiBold">Google Sheet jawaban</Run> di belakangnya.
                            Formulir dan Sheet terhubung otomatis lewat fitur bawaan Google (Responses → Link to Sheets).
                        </TextBlock>
                    </Border>

                    <!-- Syarat: login akun Google -->
                    <Border Background="{DynamicResource WarningSubtleBrush}" BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" LineHeight="16" Foreground="{DynamicResource WarningTextBrush}">
                            <Run FontWeight="Bold">⚠️ SYARAT UTAMA — login akun Google.</Run> Layanan online ini<Run FontWeight="SemiBold"> belum bisa berfungsi</Run> sebelum aplikasi login dengan akun Google, karena:
                            Google Formulir adalah tautan yang dikirim ke warga, Google Sheet adalah tempat jawaban dibaca aplikasi, dan Google Drive adalah tempat PDF surat disimpan + sumber tautan unduh — semuanya milik akun yang terhubung itu.
                            Masuk lewat <Run FontWeight="SemiBold">Login dengan Google</Run> di sidebar (akun harus punya akses Editor ke Formulir/Sheet). Cek kesiapan lewat chip statusbar dan banner di panel Layanan Online.
                        </TextBlock>
                    </Border>

                    <!-- Langkah 1 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource StepBadge}" Margin="0,1,10,0">
                            <TextBlock Style="{StaticResource StepBadgeText}" Text="1"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Buat Google Form permohonan surat" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                Buka <Run FontWeight="SemiBold">forms.google.com</Run> dengan akun Google desa, lalu klik tombol <Run FontWeight="Bold">Blank</Run> (Formulir kosong) untuk membuat form baru.
                                Masukkan judul form (mis. "Permohonan Surat Desa Sumberjaya") dan deskripsi singkat.
                                Tambahkan kolom-kolom berikut (nama kolom bebas, usahakan mirip agar mudah dicek):
                                <LineBreak/>• <Run FontWeight="Bold">Wajib semua jenis:</Run> <Run FontWeight="SemiBold">Jenis Surat</Run> (gunakan "Dropdown" atau "Multiple choice"), NIK ("Short answer"), Nama ("Short answer"), Tempat Lahir ("Short answer"), Tanggal Lahir (dd-mm-yyyy) ("Date"), JK (L/P) ("Multiple choice"), Agama ("Dropdown"), Status Perkawinan ("Dropdown"), Pekerjaan ("Short answer"), Alamat ("Paragraph"), Keperluan ("Paragraph"), dan <Run FontWeight="SemiBold">No. WhatsApp</Run> ("Short answer" — kolom paling penting karena alamat pengiriman tautan unduh PDF).
                                <LineBreak/>• <Run FontWeight="Bold">SKU:</Run> tambah Bidang Usaha ("Short answer") &amp; Sejak Tahun ("Short answer").
                                <LineBreak/>• <Run FontWeight="Bold">Pengantar SKCK:</Run> tambah Pendidikan ("Short answer") &amp; Kewarganegaraan ("Short answer").
                                <LineBreak/>• <Run FontWeight="Bold">Izin Orang Tua:</Run> tambah data anak (NIK Anak, Nama Anak, TTL Anak, JK Anak, Agama Anak, Status Anak, Alamat Anak — semuanya "Short answer"), Negara Tujuan ("Short answer"), Nama PT/PERUSAHAAN ("Short answer").
                                <LineBreak/>• <Run FontWeight="Bold">Kolom opsional:</Run> <Run FontWeight="SemiBold">Token</Run> ("Short answer" — terisi otomatis bila warga membuka tautan yang diberikan aplikasi; berguna bila hanya memakai Sheet tanpa form).
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Langkah 2 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource StepBadge}" Margin="0,1,10,0">
                            <TextBlock Style="{StaticResource StepBadgeText}" Text="2"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Hubungkan form ke Google Sheet jawaban (wajib)" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                Di editor form: tab <Run FontWeight="SemiBold">Responses</Run> → ikon hijau <Run FontWeight="SemiBold">Link to Sheets</Run> → pilih &quot;Create a new spreadsheet&quot;. Google membuat Sheet jawaban (tab biasanya bernama <Run FontWeight="SemiBold">Form Responses 1</Run>). Sheet inilah yang dibaca aplikasi — tautan untuk warga diambil di langkah berikutnya.
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Langkah 3 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource StepBadge}" Margin="0,1,10,0">
                            <TextBlock Style="{StaticResource StepBadgeText}" Text="3"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ambil tautan Google Formulir untuk warga" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                Di editor form klik <Run FontWeight="SemiBold">Kirim</Run> → ikon <Run FontWeight="SemiBold">tautan (🔗)</Run> → centang &quot;Perpendek URL&quot; lalu salin — bentuknya <Run FontWeight="SemiBold">https://docs.google.com/forms/d/…/viewform</Run>. Inilah tautan yang otomatis dikirim aplikasi ke WhatsApp warga. (Bila form dibuat dengan akun berbeda dari akun Google aplikasi: buka Sheet jawaban → <Run FontWeight="SemiBold">Bagikan</Run> → tambah email akun aplikasi sebagai <Run FontWeight="SemiBold">Editor</Run>.)
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Langkah 4 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource StepBadge}" Margin="0,1,10,0">
                            <TextBlock Style="{StaticResource StepBadgeText}" Text="4"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Aktifkan mode di aplikasi" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                Buka <Run FontWeight="SemiBold">Pengaturan → Pengaturan Aplikasi → Google Formulir &amp; Sheet (Mode Tautan)</Run>:<LineBreak/>
                                1. Centang <Run FontWeight="SemiBold">Aktifkan</Run>.<LineBreak/>
                                2. Tempel <Run FontWeight="SemiBold">URL Google Formulir</Run> (tautan viewform dari Langkah 3 — ini yang diterima warga).<LineBreak/>
                                3. Tempel <Run FontWeight="SemiBold">URL Sheet jawaban</Run> (yang berisi /d/…/edit — ini yang dibaca aplikasi).<LineBreak/>
                                4. Klik <Run FontWeight="SemiBold">Uji koneksi Formulir &amp; Sheet</Run> — keduanya harus ✓.<LineBreak/>
                                Kolom Token tidak perlu dibuat di form: aplikasi menempelkannya otomatis saat mengirim tautan (prefill).
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Langkah 5 -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource StepBadge}" Margin="0,1,10,0">
                            <TextBlock Style="{StaticResource StepBadgeText}" Text="5"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Cara membaca kolom Status di Sheet" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                Kolom Status dibuat otomatis oleh aplikasi di baris header:<LineBreak/>
                                • <Run FontWeight="SemiBold">DIPROSES (PMT-…)</Run> — jawaban sudah masuk database dan sedang dibuat PDF-nya.<LineBreak/>
                                • <Run FontWeight="SemiBold">SELESAI — surat … tautan unduh Google Drive dikirim</Run> — warga sudah menerima tautan unduh PDF via WhatsApp.<LineBreak/>
                                • <Run FontWeight="SemiBold">PERLU_DATA: …</Run> — isi belum lengkap (sebutan kolomnya ditulis di situ); minta warga mengisi ulang/melengkapi.<LineBreak/>
                                • <Run FontWeight="SemiBold">JENIS_TAK_DIKENAL</Run> — kolom Jenis Surat kosong/tidak dikenali (isi contoh: SKTM).<LineBreak/>
                                • <Run FontWeight="SemiBold">GAGAL: …</Run> — kesalahan teknis; cek panel Layanan Online di aplikasi.
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- BAGIAN E -->
            <Border Style="{StaticResource StepCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{StaticResource StepSectionBar}"/>
                        <TextBlock Text="BAGIAN E — UJI ALUR PENUH" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                        Mode tautan (Google Formulir &amp; Sheet jawaban, aktif dari Pengaturan Aplikasi):<LineBreak/>
                        1. Dari WhatsApp pribadi Anda, kirim pesan apa pun (mis. &quot;halo&quot;) ke nomor desa → balasan berisi <Run FontWeight="SemiBold">tautan Google Formulir</Run> + Token.<LineBreak/>
                        2. Buka tautan, isi form, klik Kirim → jawaban masuk ke Google Sheet.<LineBreak/>
                        3. Aplikasi membaca Sheet (± 30 detik), menyimpan permohonan, dan menulis status di kolom <Run FontWeight="SemiBold">Status</Run> pada Sheet.<LineBreak/>
                        4. PDF surat dibuat otomatis → WhatsApp Anda menerima <Run FontWeight="SemiBold">tautan unduh PDF</Run> (berkas tersimpan juga di folder Drive “Surat Online”).<LineBreak/>
                        5. Surat tercatat di Register Surat seperti surat buatan biasa; kolom Status di Sheet berubah menjadi SELESAI.<LineBreak/>
                        Mode percakapan (bila mode tautan dimatikan): kirim FORMAT SKTM → isi format → YA.<LineBreak/>
                        Catatan Cloud API: balasan teks/tautan dalam 24 jam sejak pesan warga terakhir <Run FontWeight="SemiBold">gratis</Run>. Selama jam &amp; hari layanan tutup, permintaan tetap tercatat dan diproses otomatis saat layanan dibuka.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- CATATAN -->
            <Border Style="{StaticResource StepCard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x26A0;&#xFE0F;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                        Catatan penting: Cloud API adalah jalur RESMI Meta — nomor desa tidak berisiko diblokir seperti gateway tidak resmi. Tetap hindari mengirim pesan massal ke nomor yang tidak pernah menghubungi desa (bisa terkena penilaian kualitas Meta). Pola layanan surat ini — warga chat duluan, aplikasi membalas — adalah pola paling aman dan sebagian besar gratis.
                    </TextBlock>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
