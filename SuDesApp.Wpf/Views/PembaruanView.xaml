<UserControl xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities" x:Class="SuDesApp.Wpf.Views.PembaruanView"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             xmlns:views="clr-namespace:SuDesApp.Wpf.Views"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="14" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <!--
            Kartu pemberitahuan halaman Pembaruan tidak lagi didefinisikan di sini,
            melainkan memakai bentuk bersama di Themes/NotifikasiInline.xaml
            (kunci "KartuPesanInline") supaya seluruh halaman memakai pola kabar yang
            sama — tampil di dalam halaman, bukan sebagai dialog popup.
        -->
        <!-- Pembalik visibility untuk keadaan kosong kartu rincian (BoolToVis bawaan
             hanya mengenal arah true -> tampil). -->
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <!--
        Halaman Pembaruan disusun dalam DUA kartu berdampingan, bukan satu kartu
        sempit di tengah:

          • Kartu kiri — status & tindakan: versi, status pemeriksaan, kabar,
            kemajuan unduhan, dan seluruh tombol aksi.
          • Kartu kanan — rincian pembaruan: jenis pembaruan, rincian ukuran,
            daftar perbaikan, dan riwayat pemasangan.

        Saat pemeriksaan selesai, keterangan pembaruan muncul di kartu kanan,
        sehingga kartu kiri tetap pendek dan halaman tidak perlu digulir hanya
        untuk melihat tombol. Masing-masing kartu menggulir sendiri bila isinya
        lebih panjang dari layar — halaman tidak lagi punya ScrollViewer
        bersarang di dalam kartu sempit.
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="{x:Static u:IkonMenu.MuatUlang}" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource AppIconFont}"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PEMBARUAN APLIKASI" Style="{StaticResource HeaderTitle}"
                               AutomationProperties.Name="PEMBARUAN APLIKASI"/>
                    <TextBlock Text="Pembaruan kecil dipasang sebagai tambalan; pembaruan besar menggunakan installer penuh"
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Dua kartu: kiri status &amp; tindakan, kanan rincian pembaruan -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== Kartu kiri: status &amp; tindakan ==================== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="22,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Kepala kartu: ikon status + versi yang sedang dipakai -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="26"
                                    Background="{DynamicResource AccentSubtleBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Static u:IkonMenu.Arsip}" FontSize="24"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppIconFont}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="STATUS PEMBARUAN" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding CurrentVersionText}"
                                           FontSize="13" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           AutomationProperties.Name="Versi Saat Ini:"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                       LineHeight="22"/>
                        </Border>

                        <!-- Pemberitahuan inline: hasil pemeriksaan, kegagalan unduh, dan keputusan
                             penting ditampilkan di dalam halaman — tanpa dialog popup. -->
                        <ItemsControl ItemsSource="{Binding Pesan}"
                                      Visibility="{Binding AdaPesan, Converter={StaticResource BoolToVis}}"
                                      ItemTemplate="{StaticResource KartuPesanInline}"
                                      Margin="0,0,0,6"
                                      AutomationProperties.Name="Pemberitahuan pembaruan"/>

                        <!-- Progress bar + keterangan byte + tombol Jeda/Lanjut -->
                        <Grid Margin="0,10,0,4"
                              Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ProgressBar Grid.Row="0" Height="10"
                                         Minimum="0" Maximum="100" Value="{Binding DownloadPercent, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}"/>

                            <!-- Keterangan ukuran: menunjukkan bagian yang sudah terunduh,
                                 dan saat dijeda menegaskan sisanya tetap tersimpan. -->
                            <TextBlock Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding CatatanUnduhan, Mode=OneWay}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnduhanDijeda}" Value="True">
                                                <Setter Property="Text" Value="{Binding InfoSisaUnduhan, Mode=OneWay}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                                        Visibility="{Binding JedaLanjutTersedia, Converter={StaticResource BoolToVis}}">
                                <Button Content="{Binding TeksTombolJeda, Mode=OneWay}"
                                        Command="{Binding JedaLanjutCommand}" Padding="14,0"
                                        Style="{StaticResource OutlineButton}"
                                        ToolTip="Hentikan unduhan sementara — bagian yang sudah terunduh tetap tersimpan dan bisa dilanjutkan kapan saja"
                                        AutomationProperties.Name="Jeda atau lanjutkan unduhan"/>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"
                                           TextWrapping="Wrap" MaxWidth="320"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Bagian yang sudah terunduh tetap tersimpan, jadi melanjutkan tidak mengulang dari awal.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UnduhanDijeda}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Tombol aksi -->
                        <WrapPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Periksa Pembaruan" Command="{Binding CheckCommand}" Margin="0,0,8,8" Padding="16,0"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Periksa Pembaruan"/>

                            <Button Content="{Binding TeksTombolTambalan, Mode=OneWay}"
                                    Command="{Binding PerbaruiTambalanCommand}" Margin="0,0,8,8" Padding="16,0"
                                    Style="{StaticResource SuccessButton}"
                                    Visibility="{Binding BisaTambalan, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.Name="Perbarui Sekarang (tambalan kecil)"/>

                            <!-- Labelnya berubah menjadi "Lanjutkan Unduhan (42%)" bila masih ada
                                 sisa unduhan installer dari percobaan sebelumnya. -->
                            <Button Content="{Binding TeksTombolInstaller, Mode=OneWay}"
                                    Command="{Binding UnduhInstallerCommand}" Margin="0,0,8,8" Padding="16,0"
                                    Style="{StaticResource OutlineButton}"
                                    Visibility="{Binding BisaInstaller, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.Name="Unduh atau lanjutkan installer pembaruan besar"/>

                            <Button Content="Batalkan &amp; Buang Sisa" Command="{Binding BatalCommand}" Margin="0,0,0,8" Padding="16,0"
                                    Style="{StaticResource OutlineButton}"
                                    ToolTip="Hentikan sekarang dan buang bagian yang sudah terunduh"
                                    Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}"/>
                        </WrapPanel>

                        <TextBlock Text="Pembaruan kecil (tambalan) hanya mengganti berkas yang berubah; database, template, dan pengaturan Anda tidak pernah ikut diganti."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,14,0,0"/>
                        <TextBlock Text="SuDesApp • Pembaruan melalui GitHub Releases dengan verifikasi SHA-256"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ==================== Kartu kanan: rincian pembaruan ==================== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="22,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="RINCIAN PEMBARUAN" Style="{StaticResource SectionTitle}"
                                   AutomationProperties.Name="Rincian Pembaruan"/>

                        <!-- Keadaan kosong: pemeriksaan belum pernah dijalankan atau
                             aplikasi sudah versi terbaru. Menjaga kartu kanan tetap
                             terisi tanpa ikut mendorong kartu kiri. -->
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16,12"
                                Margin="0,10,0,0"
                                Visibility="{Binding PenawaranTersedia, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Belum ada pembaruan untuk ditampilkan"
                                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Jenis pembaruan, ukuran berkas, dan daftar perbaikan akan muncul di sini setelah pemeriksaan."
                                           FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Penawaran pembaruan: jenis, rincian ukuran, dan daftar perbaikan -->
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16,12" Margin="0,10,0,10"
                                Visibility="{Binding PenawaranTersedia, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding JenisPembaruanText}" FontSize="14" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                           AutomationProperties.Name="Jenis Pembaruan"/>

                                <TextBlock Text="{Binding RincianPembaruanText}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding BisaTambalan, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding AlasanInstallerText}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource WarningTextBrush}"/>

                                <TextBlock Text="Yang diperbaiki / ditambah:" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,6"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <ItemsControl ItemsSource="{Binding Perbaikan}"
                                              AutomationProperties.Name="Daftar perbaikan pembaruan">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13"
                                                       Margin="0,2,0,2" LineHeight="19"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Riwayat pembaruan: pembaruan yang pernah dicoba dipasang, terbaru dulu -->
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16,12"
                                Visibility="{Binding RiwayatTersedia, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Riwayat Pembaruan" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               AutomationProperties.Name="Riwayat Pembaruan"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RingkasanRiwayat}" VerticalAlignment="Center" FontSize="11"
                                                   Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <!-- Riwayat boleh dibuang seluruhnya; tindakannya dikonfirmasi
                                             lewat kartu keputusan di dalam halaman ini. -->
                                        <Button Content="Bersihkan Riwayat"
                                                Command="{Binding BersihkanRiwayatCommand}" Padding="10,0" FontSize="11"
                                                Style="{StaticResource OutlineButton}"
                                                Foreground="{DynamicResource ErrorTextBrush}"
                                                BorderBrush="{DynamicResource ErrorBrush}"
                                                ToolTip="Buang seluruh riwayat pembaruan yang tersimpan di komputer ini"
                                                AutomationProperties.Name="Bersihkan riwayat pembaruan"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Berkas riwayat yang tidak terbaca: dijelaskan di sini, dan tetap
                                     bisa dibuang lewat tombol Bersihkan Riwayat di atas. -->
                                <TextBlock Text="Berkas riwayat pembaruan tidak dapat dibaca. Anda bisa membuangnya lewat tombol Bersihkan Riwayat."
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding RiwayatTidakTerbaca, Converter={StaticResource BoolToVis}}"/>

                                <ItemsControl ItemsSource="{Binding Riwayat}"
                                              AutomationProperties.Name="Riwayat pembaruan">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="0" Margin="0,0,0,8"
                                                    Background="{DynamicResource PanelBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Indikator hasil: garis tepi kiri hijau bila berhasil,
                                                         merah bila gagal — warna sama dengan label Hasil. -->
                                                    <Border Grid.Column="0" CornerRadius="3,0,0,3">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Berhasil}" Value="False">
                                                                        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,10,0,10" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Versi}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextBrush}"/>
                                                            <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4"
                                                                    Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Jenis}" FontSize="11"
                                                                           Foreground="{DynamicResource AccentTextBrush}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Berkas}" FontSize="13" Margin="12,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Tanggal}" FontSize="11" Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding Pesan}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding Hasil}" FontSize="13" FontWeight="SemiBold"
                                                               Margin="10,0,14,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Berhasil}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Statusbar halaman: status pembaruan (kiri) + identitas aplikasi (kanan) -->
        <c:AppStatusBar Grid.Row="2" Margin="0,12,0,0"
                        StatusText="{Binding StatusText, FallbackValue='Siap memeriksa pembaruan', Mode=OneWay}"/>
    </Grid>
</UserControl>
