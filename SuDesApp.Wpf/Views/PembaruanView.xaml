<UserControl x:Class="SuDesApp.Wpf.Views.PembaruanView"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <!--
            Kartu pemberitahuan halaman Pembaruan tidak lagi didefinisikan di sini,
            melainkan memakai bentuk bersama di Themes/NotifikasiInline.xaml
            (kunci "KartuPesanInline") supaya seluruh halaman memakai pola kabar yang
            sama — tampil di dalam halaman, bukan sebagai dialog popup.
        -->
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#x1F504;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PEMBARUAN APLIKASI" Style="{StaticResource HeaderTitle}"
                               AutomationProperties.Name="PEMBARUAN APLIKASI"/>
                    <TextBlock Text="Pembaruan kecil dipasang sebagai tambalan; pembaruan besar menggunakan installer penuh"
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Konten -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="28"
                HorizontalAlignment="Center" VerticalAlignment="Stretch" MaxWidth="620">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Ikon status -->
                <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentSubtleBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="&#x1F4E6;" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="{Binding CurrentVersionText}"
                           FontSize="14" FontWeight="Medium"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"
                           AutomationProperties.Name="Versi Saat Ini:"/>

                <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                               LineHeight="22"/>
                </Border>

                <!-- Pemberitahuan inline: hasil pemeriksaan, kegagalan unduh, dan keputusan
                     penting ditampilkan di dalam halaman — tanpa dialog popup. -->
                <ItemsControl ItemsSource="{Binding Pesan}"
                              Visibility="{Binding AdaPesan, Converter={StaticResource BoolToVis}}"
                              ItemTemplate="{StaticResource KartuPesanInline}"
                              Margin="0,0,0,6"
                              AutomationProperties.Name="Pemberitahuan pembaruan"/>

                <!-- Penawaran pembaruan: jenis, rincian ukuran, dan daftar perbaikan -->
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16,12" Margin="0,4,0,10"
                        Visibility="{Binding PenawaranTersedia, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding JenisPembaruanText}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                   AutomationProperties.Name="Jenis Pembaruan"/>

                        <TextBlock Text="{Binding RincianPembaruanText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding BisaTambalan, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="{Binding AlasanInstallerText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource WarningTextBrush}"/>

                        <TextBlock Text="Yang diperbaiki / ditambah:" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,6"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Perbaikan}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                                   Margin="0,2,0,2" LineHeight="19"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>                <!-- Riwayat pembaruan: pembaruan yang pernah dicoba dipasang, terbaru dulu -->
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16,12" Margin="0,4,0,10"
                        Visibility="{Binding RiwayatTersedia, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Riwayat Pembaruan" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       AutomationProperties.Name="Riwayat Pembaruan"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RingkasanRiwayat}" VerticalAlignment="Center" FontSize="11"
                                           Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <!-- Riwayat boleh dibuang seluruhnya; tindakannya dikonfirmasi
                                     lewat kartu keputusan di dalam halaman ini. -->
                                <Button Content="Bersihkan Riwayat"
                                        Command="{Binding BersihkanRiwayatCommand}"
                                        Height="26" Padding="10,0" FontSize="11.5"
                                        Style="{StaticResource OutlineButton}"
                                        Foreground="{DynamicResource ErrorTextBrush}"
                                        BorderBrush="{DynamicResource ErrorBrush}"
                                        ToolTip="Buang seluruh riwayat pembaruan yang tersimpan di komputer ini"
                                        AutomationProperties.Name="Bersihkan riwayat pembaruan"/>
                            </StackPanel>
                        </Grid>

                        <!-- Berkas riwayat yang tidak terbaca: dijelaskan di sini, dan tetap
                             bisa dibuang lewat tombol Bersihkan Riwayat di atas. -->
                        <TextBlock Text="Berkas riwayat pembaruan tidak dapat dibaca. Anda bisa membuangnya lewat tombol Bersihkan Riwayat."
                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding RiwayatTidakTerbaca, Converter={StaticResource BoolToVis}}"/>

                        <ItemsControl ItemsSource="{Binding Riwayat}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="0" Margin="0,0,0,8"
                                            Background="{DynamicResource PanelBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Indikator hasil: garis tepi kiri hijau bila berhasil,
                                                 merah bila gagal — warna sama dengan label Hasil. -->
                                            <Border Grid.Column="0" CornerRadius="3,0,0,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Berhasil}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,10,0,10" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Versi}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4"
                                                            Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Jenis}" FontSize="10.5"
                                                                   Foreground="{DynamicResource AccentTextBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Berkas}" FontSize="12" Margin="12,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Tanggal}" FontSize="11" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Pesan}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding Hasil}" FontSize="12" FontWeight="SemiBold"
                                                       Margin="10,0,14,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Berhasil}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Progress bar + keterangan byte + tombol Jeda/Lanjutkan -->
                <Grid Margin="0,10,0,4"
                      Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" Height="10"
                                 Minimum="0" Maximum="100" Value="{Binding DownloadPercent, Mode=OneWay}"
                                 Foreground="{DynamicResource AccentBrush}"/>

                    <!-- Keterangan ukuran: menunjukkan bagian yang sudah terunduh,
                         dan saat dijeda menegaskan sisanya tetap tersimpan. -->
                    <TextBlock Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap"
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding CatatanUnduhan, Mode=OneWay}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UnduhanDijeda}" Value="True">
                                        <Setter Property="Text" Value="{Binding InfoSisaUnduhan, Mode=OneWay}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                                Visibility="{Binding JedaLanjutTersedia, Converter={StaticResource BoolToVis}}">
                        <Button Content="{Binding TeksTombolJeda, Mode=OneWay}"
                                Command="{Binding JedaLanjutCommand}"
                                Height="32" Padding="14,0"
                                Style="{StaticResource OutlineButton}"
                                ToolTip="Hentikan unduhan sementara — bagian yang sudah terunduh tetap tersimpan dan bisa dilanjutkan kapan saja"
                                AutomationProperties.Name="Jeda atau lanjutkan unduhan"/>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"
                                   TextWrapping="Wrap" MaxWidth="320"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Bagian yang sudah terunduh tetap tersimpan, jadi melanjutkan tidak mengulang dari awal.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UnduhanDijeda}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Tombol aksi -->
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Content="Periksa Pembaruan" Command="{Binding CheckCommand}"
                            Height="36" Margin="0,0,8,8" Padding="16,0"
                            Style="{StaticResource PrimaryButton}"
                            AutomationProperties.Name="Periksa Pembaruan"/>

                    <Button Content="{Binding TeksTombolTambalan, Mode=OneWay}"
                            Command="{Binding PerbaruiTambalanCommand}"
                            Height="36" Margin="0,0,8,8" Padding="16,0"
                            Style="{StaticResource SuccessButton}"
                            Visibility="{Binding BisaTambalan, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Perbarui Sekarang (tambalan kecil)"/>

                    <!-- Labelnya berubah menjadi "Lanjutkan Unduhan (42%)" bila masih ada
                         sisa unduhan installer dari percobaan sebelumnya. -->
                    <Button Content="{Binding TeksTombolInstaller, Mode=OneWay}"
                            Command="{Binding UnduhInstallerCommand}"
                            Height="36" Margin="0,0,8,8" Padding="16,0"
                            Style="{StaticResource OutlineButton}"
                            Visibility="{Binding BisaInstaller, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Unduh atau lanjutkan installer pembaruan besar"/>

                    <Button Content="Batalkan &amp; Buang Sisa" Command="{Binding BatalCommand}"
                            Height="36" Margin="0,0,0,8" Padding="16,0"
                            Style="{StaticResource OutlineButton}"
                            ToolTip="Hentikan sekarang dan buang bagian yang sudah terunduh"
                            Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>

                <TextBlock Text="Pembaruan kecil (tambalan) hanya mengganti berkas yang berubah; database, template, dan pengaturan Anda tidak pernah ikut diganti."
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" Margin="0,14,0,0"/>
                <TextBlock Text="SuDesApp • Pembaruan melalui GitHub Releases dengan verifikasi SHA-256"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Statusbar halaman: status pembaruan (kiri) + identitas aplikasi (kanan) -->
        <c:AppStatusBar Grid.Row="2" Margin="0,12,0,0"
                        StatusText="{Binding StatusText, FallbackValue='Siap memeriksa pembaruan', Mode=OneWay}"/>
    </Grid>
</UserControl>
