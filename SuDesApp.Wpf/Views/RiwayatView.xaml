<UserControl x:Class="SuDesApp.Wpf.Views.RiwayatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             FontSize="14" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#128337;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Toolbar: pencarian + aksi -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                         FontSize="13" Padding="8,6" VerticalContentAlignment="Center"
                         ToolTip="Cari pengguna, jenis surat, nomor, aksi, atau detail">
                    <TextBox.Style>
                        <!-- Berdasarkan gaya TextBox tema supaya TIDAK memakai
                             chrome bawaan Windows (kotak putih cekung sistem);
                             pemicu teks kosong di bawah menimpa latar tema
                             dengan petunjuk pencarian. -->
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Resources>
                                <VisualBrush x:Key="HintBrush" Stretch="None" AlignmentX="Left">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="Cari: pengguna, jenis, nomor, aksi..." Margin="4,0,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Grid.Column="1" Content="Bersihkan Riwayat" Command="{Binding ClearCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                        ToolTip="Hapus seluruh riwayat aktivitas (tidak dapat dibatalkan)"/>
                <Button Grid.Column="2" Content="Batal" Command="{Binding BatalCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Daftar riwayat: DataGrid baca-saja dengan gaya ModernDataGrid yang
             sama dengan tabel lain di aplikasi. Kolom bintang + scrollbar
             otomatis dari gaya; teks panjang dipotong elipsis dan dibaca
             utuh lewat tooltip — tinggi baris tetap 40 px supaya seragam.
             Daftar sengaja diikat dua arah ke Items via binding biasa:
             koleksi diganti utuh setiap kali dimuat/bersih, jadi baris lama
             ikut hilang begitu tombol Bersihkan Riwayat ditekan. -->
        <Border Grid.Row="2" Style="{StaticResource GridHostCard}">
            <Grid>
                <DataGrid ItemsSource="{Binding Items}"
                          Style="{StaticResource ModernDataGrid}"
                          AutomationProperties.Name="Tabel riwayat aktivitas">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Waktu" Width="150" MinWidth="130"
                                            Binding="{Binding WaktuDisplay}"/>
                        <DataGridTextColumn Header="Pengguna" Width="2*" MinWidth="140"
                                            Binding="{Binding Pengguna}" FontWeight="SemiBold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Pengguna}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Jenis" Width="150" MinWidth="120"
                                            Binding="{Binding JenisDokumen}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Dokumen" Width="2*" MinWidth="140"
                                            Binding="{Binding Dokumen}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Dokumen}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Aksi" Width="100" MinWidth="90"
                                            Binding="{Binding Aksi}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Detail" Width="3*" MinWidth="180"
                                            Binding="{Binding Detail}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Detail}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Keadaan kosong: grid tidak boleh tampak rusak saat riwayat
                     belum ada atau sudah dibersihkan. -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding TidakAdaAktivitas, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Belum ada aktivitas tercatat." FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Riwayat terisi otomatis saat surat atau arsip dibuat, diubah, statusnya diubah, atau dihapus."
                               TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statusbar halaman: pesan keadaan + identitas aplikasi (kontrol bersama). -->
        <c:AppStatusBar Grid.Row="3" Margin="0,12,0,0"
                        StatusText="{Binding StatusText, Mode=OneWay}"/>
    </Grid>
</UserControl>
