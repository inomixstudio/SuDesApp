<Window xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities" x:Class="SuDesApp.Wpf.Views.PengumumanPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informasi Terbaru" Height="Auto" Width="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True"
        SizeToContent="Height">
    <Window.Resources>
        <!-- Pemisah tipis antar pengumuman -->
        <Style x:Key="Pemisah" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="16,8"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
    </Window.Resources>

    <Border Margin="8" CornerRadius="12" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35"/>
        </Border.Effect>

        <StackPanel>
            <!-- Kepala card: judul + tombol tutup -->
            <Grid Margin="14,12,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static u:IkonMenu.Lonceng}" FontSize="14" VerticalAlignment="Center" FontFamily="{StaticResource AppIconFont}"/>
                    <TextBlock Text="INFORMASI TERBARU" FontSize="13" FontWeight="Bold"
                               Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="TombolTutup" Content="{x:Static u:IkonMenu.Keluar}"
                        Style="{StaticResource SecondaryButton}" Padding="10,2"
                        Click="Tutup_Click"
                        ToolTip="Tutup popup (pengumuman tetap tersedia di lonceng notifikasi)" FontFamily="{StaticResource AppIconFont}"/>
            </Grid>

            <!-- Daftar pengumuman yang ditampilkan putaran ini -->
            <ItemsControl x:Name="DaftarPengumuman" Margin="14,10,14,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Ikon}" FontSize="14"
                                           VerticalAlignment="Top" Margin="0,0,7,0"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Judul}" FontWeight="SemiBold"
                                               FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Isi}" FontSize="13"
                                               Margin="0,3,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding WaktuTampil}" FontSize="11"
                                               Margin="0,3,0,0" Opacity="0.8"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Pemisah}" Margin="14,10,14,0"/>
            <TextBlock Text="Pengumuman ini tidak akan ditampilkan lagi di perangkat ini."
                       FontSize="11" Margin="14,0,14,10" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85"/>
        </StackPanel>
    </Border>
</Window>
