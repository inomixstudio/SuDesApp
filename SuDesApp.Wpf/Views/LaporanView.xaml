<UserControl x:Class="SuDesApp.Wpf.Views.LaporanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             xmlns:conv="clr-namespace:SuDesApp.Wpf.Converters"
             xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities"
             xmlns:vm="clr-namespace:SuDesApp.Wpf.ViewModels"
             FontSize="14" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <!-- Kebalikan BoolToVis: isi halaman disembunyikan saat kartu keadaan tampil. -->
        <conv:InverseBoolConverter x:Key="TampilIsi"/>
    </UserControl.Resources>

    <c:DataPageFrame Margin="20">

        <!-- Kepala halaman memakai pola Data Warga: judul membungkus dan aksi
             tetap di header; pada lebar sempit tombol turun ke baris berikutnya. -->
        <c:DataPageFrame.HeaderContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource HeaderIconChip}" Margin="0,0,14,0">
                    <TextBlock Text="{x:Static u:IkonMenu.Laporan}" FontSize="20"
                               FontFamily="{StaticResource AppIconFont}"
                               Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource HeaderTitle}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>

                <WrapPanel Grid.Column="2" Orientation="Horizontal"
                           HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="TombolCetakLaporan" Command="{Binding CetakPdfCommand}"
                            Style="{StaticResource HeaderActionButton}" Margin="0,0,8,4"
                            ToolTip="Susun laporan menjadi PDF lalu buka pratinjau — cetak atau ekspor dari halaman pratinjau">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static u:IkonMenu.Cetak}" FontSize="13"
                                       FontFamily="{StaticResource AppIconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Cetak PDF" Margin="6,0,0,0" VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TombolSimpanExcel" Content="Simpan Excel" Command="{Binding SimpanExcelCommand}"
                            Style="{StaticResource HeaderGhostButton}" Margin="0,0,8,4"
                            ToolTip="Simpan laporan sebagai berkas Excel (.xlsx)"/>
                    <Button x:Name="TombolSegarkan" Content="Segarkan" Command="{Binding MuatUlangCommand}"
                            Style="{StaticResource HeaderGhostButton}" Margin="0,0,0,4"/>
                </WrapPanel>
            </Grid>
        </c:DataPageFrame.HeaderContent>

        <c:DataPageFrame.PageContent>
        <Grid>

        <!-- KEADAAN GAGAL MEMUAT — pengganti seluruh isi halaman.
             Dulu penyusunan angka yang gagal hanya meninggalkan dialog galat lalu
             halaman kosong: kartu rekapitulasi dan pratinjau dikosongkan. Satu
             kartu ini menyebut sebabnya (pesan dari layanan laporan), menyediakan
             tombol susun ulang, dan memberi petunjuk apa yang perlu diperiksa. -->
        <Border Style="{StaticResource FormCard}" Padding="24,22" VerticalAlignment="Top"
                Visibility="{Binding TampilkanKartuKeadaan, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Keadaan halaman laporan">
            <c:EmptyStateView Ikon="{x:Static u:IkonMenu.Laporan}"
                              Judul="{Binding JudulKeadaan}"
                              Pesan="{Binding SebabKeadaan}"
                              Petunjuk="{Binding PetunjukKeadaan}">
                <c:EmptyStateView.Aksi>
                    <Button Content="Susun ulang laporan"
                            Command="{Binding MuatUlangCommand}"
                            Style="{StaticResource PrimaryButton}"
                            ToolTip="Hitung ulang angka laporan dari data warga yang tersimpan"/>
                </c:EmptyStateView.Aksi>
            </c:EmptyStateView>
        </Border>

        <Grid Visibility="{Binding TampilkanKartuKeadaan, Converter={StaticResource TampilIsi}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- Kartu rekapitulasi -->
        <ItemsControl Grid.Row="0" ItemsSource="{Binding KartuStatistik}" Margin="0,12,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- WrapPanel: kartu membungkus ke baris berikutnya pada
                         jendela sempit — pola halaman APBDes (isi selalu
                         dibungkus, tidak pernah melewati tepi halaman).
                         UniformGrid Rows="1" lama memaksa SEMUA kartu satu baris;
                         dengan MinWidth 900 panel itu melebar melewati tepi
                         halaman pada jendela minimum dan kartu kanan terpotong. -->
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,10,0" Padding="12,10" MinWidth="120">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Nilai}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tekankan}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Keterangan}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Dua kolom: pemilih isi laporan (kiri) + pratinjau tabel (kanan).
             Saat halaman menyempit di bawah ambang, code-behind menumpuk keduanya
             vertikal (lihat LaporanView.xaml.cs - SusunTataLetak). -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="BarisBawah" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="KolomKiri" Width="0.32*" MinWidth="340" MaxWidth="760"/>
                <ColumnDefinition x:Name="KolomPembagi" Width="Auto"/>
                <ColumnDefinition x:Name="KolomKanan" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pembesar lebar kolom Isi laporan (klik-tahan lalu geser) -->
            <GridSplitter Grid.Column="1" x:Name="PembagiKolom"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE" ToolTip="Geser untuk mengubah lebar kolom Isi laporan">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Width" Value="10"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- Pemilih isi laporan -->
            <Border Grid.Column="0" Style="{StaticResource ToolbarCard}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Text="Isi laporan" TextWrapping="Wrap"
                                   Margin="0,0,12,0" ToolTip="Isi laporan"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Pilih semua" Command="{Binding AlihkanSemuaCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Hapus semua" Command="{Binding MatikanSemuaCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding PilihanTabel}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Grid (Auto + bintang), bukan StackPanel mendatar:
                                         StackPanel memberi anaknya lebar tak terhingga
                                         sehingga Judul/Keterangan tidak pernah membungkus
                                         dan meluber keluar kartu pada jendela sempit. -->
                                    <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,4,8" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding Dipakai}"
                                                      VerticalAlignment="Top" Margin="0,1,8,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Judul}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Keterangan}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Pratinjau tabel (Ringkasan Penduduk dkk.) -->
            <Border x:Name="KartuPratinjau" Grid.Column="2" Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ToolbarCard}" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding StatusText}"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Text="{Binding PeriodeTampil}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
                        <ItemsControl ItemsSource="{Binding TabelPratinjau}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Judul}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding Catatan}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,2,0,4" TextWrapping="Wrap"/>
                                        <!-- Tinggi baris mengikuti isi:
                                             keterangan bisa panjang, jadi teks
                                             melipat sampai tuntas alih-alih
                                             dipotong. DataGrid sengaja tidak
                                             dipakai: RowHeight="Auto" memicu
                                             loop layout (stack overflow), tinggi
                                             tetap memotong teks.
                                             TIDAK ada ScrollViewer bersarang di
                                             sini: setiap tabel menjadi jebakan
                                             gulir 260 px — roda tetikus men-scroll
                                             wilayah dalam sampai ujung lalu
                                             tertahan, sehingga halaman pratinjau
                                             terasa macet. ScrollViewer LUAR (Grid.Row="1")
                                             sekarang menggulir seluruh kolom
                                             pratinjau; teks baris sudah membungkus
                                             jadi tidak ada yang perlu dipotong. -->
                                        <StackPanel>
                                                <!-- Kepala kolom: lebar kolomnya sama persis dengan baris -->
                                                <Border Style="{StaticResource TabelKepalaPita}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="120"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="110"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Keterangan" FontWeight="Bold"
                                                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="Jumlah" FontWeight="Bold"
                                                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="0,0,12,0"/>
                                                        <TextBlock Grid.Column="2" Text="Persentase" FontWeight="Bold"
                                                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Grid>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding Baris}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="0,0,0,1" Padding="0,7">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" MinWidth="120"/>
                                                                        <ColumnDefinition Width="140"/>
                                                                        <ColumnDefinition Width="110"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                               TextWrapping="Wrap" VerticalAlignment="Top"
                                                                               Margin="0,0,12,0" ToolTip="{Binding Label}"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Nilai}"
                                                                               VerticalAlignment="Top" Margin="0,0,12,0"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Persentase}"
                                                                               VerticalAlignment="Top"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" Margin="12,0,12,10" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Angka pada layar, PDF, dan Excel dihitung dari satu sumber data yang sama saat tombol ditekan, sehingga hasil cetak selalu sama dengan yang tampil di sini."/>
                </Grid>
            </Border>
        </Grid>
        </Grid>
        </Grid>
        </c:DataPageFrame.PageContent>
    </c:DataPageFrame>
</UserControl>
