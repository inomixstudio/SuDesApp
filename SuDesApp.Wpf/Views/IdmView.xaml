<UserControl x:Class="SuDesApp.Wpf.Views.IdmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities"
             xmlns:local="clr-namespace:SuDesApp.Wpf.Views"
             FontSize="14" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <!-- Isi sel tabel rincian. Semua kolom teks MEMBUNGKUS: tabel memakai
             lebar penuh halaman dan kolom bintang, jadi tidak ada teks yang
             terpotong walau jendela sempit — barisnya yang menjadi lebih tinggi. -->
        <!-- Jarak kanan 10 px sama dengan margin kepala kolom supaya tepi teks
             sejajar dan isi dua kolom bersebelahan tidak menempel. -->
        <!-- WARNA TEKS WAJIB ADA DI SINI. TextBlock yang memakai Style eksplisit
             tidak lagi memakai gaya implisit TextBlock (Foreground TextBrush),
             sehingga tanpa setter ini warnanya jatuh ke hitam bawaan WPF — di tema
             gelap teks rincian indikator tampak hitam di atas latar gelap. -->
        <Style x:Key="SelIdm" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,10,2"/>
        </Style>
        <Style x:Key="SelIdmTebal" TargetType="TextBlock" BasedOn="{StaticResource SelIdm}">
            <!-- Baris subtotal resmi (IKS/IKE/IKL/IDM) ditebalkan seperti di situs pusat. -->
            <Setter Property="FontWeight" Value="{Binding Ketebalan}"/>
        </Style>
        <Style x:Key="SelIdmAngka" TargetType="TextBlock" BasedOn="{StaticResource SelIdmTebal}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="SelIdmNomor" TargetType="TextBlock" BasedOn="{StaticResource SelIdmTebal}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style x:Key="SelIdmKecil" TargetType="TextBlock" BasedOn="{StaticResource SelIdm}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <!-- Kepala kolom tabel rincian. Lebar tiap kolom didefinisikan SEKALI di
             sini (dan diulang persis pada baris) — kolom bintang membuat tabel
             mengikuti lebar jendela, jadi tidak ada kolom yang terdorong keluar
             layar. -->
        <Style x:Key="KepalaSel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <!-- Tipografi angka ringkasan. Ukuran disengaja berbeda hanya pada DUA
             tingkat: skor utama (30 px) dan status desa (20 px); seluruh angka
             pendukung memakai satu ukuran 15 px, jadi tidak ada keping yang
             tampak berbeda tanpa alasan. -->
        <Style x:Key="LabelAngka" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="NilaiAngka" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <!-- Angka utama kartu status: skor IDM, sengaja jauh lebih besar. -->
        <Style x:Key="NilaiAngkaBesar" TargetType="TextBlock" BasedOn="{StaticResource NilaiAngka}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="28"/>
        </Style>
        <Style x:Key="NilaiKata" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- Petak keping: tiap angka ringkasan dibungkus petak agar deretan
             statistik terbaca sebagai kartu-kartu kecil, bukan teks lepas.
             Latar PANEL (bukan Surface) + tanpa bayangan karena petak ini
             berdiri DI ATAS permukaan kartu. -->
        <Style x:Key="KepingPetak" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="KepingAngka" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
        </Style>

        <!-- Judul section dengan balok aksen di kiri: dipakai seluruh judul di
             halaman ini supaya hierarki kartu seragam dengan halaman lain. -->
        <Style x:Key="JudulSectionIdm" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Identitas desa: nama desa titik perhatian pertama, baris di
             bawahnya sekunder. -->
        <Style x:Key="MetaDesa" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <!-- Chip pil: dipakai tahun riwayat. Sudut membulat penuh + garis tepi
             tipis supaya tiap tahun terbaca sebagai label kecil. -->
        <Style x:Key="ChipPil" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,6,5"/>
        </Style>

        <!-- Teks kecil penjelas di dalam kartu. Satu tempat agar seluruh
             keterangan tambahan di halaman ini memakai ukuran yang sama. -->
        <Style x:Key="TeksBantu" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="TeksBantuKecil" TargetType="TextBlock" BasedOn="{StaticResource TeksBantu}">
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Petak dimensi Indeks Desa: dua kolom agar enam dimensi terbaca
             sebagai daftar ringkas, bukan tumpukan panjang. -->
        <Style x:Key="PetakDimensi" TargetType="Border" BasedOn="{StaticResource KepingPetak}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <!-- Header dan alat halaman tetap terlihat; isi halaman menggulir sebagai
         satu kesatuan: tiga kartu ringkasan di atas, rincian indikator penuh
         selebar halaman di bawahnya. -->
    <Grid>
            <c:DataPageFrame Margin="20,18,20,20">
                <c:DataPageFrame.HeaderContent>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource HeaderIconChip}" Margin="0,0,14,0">
                        <TextBlock Text="{x:Static u:IkonMenu.Pembangunan}" FontSize="20"
                                   FontFamily="{StaticResource AppIconFont}"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource HeaderTitle}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource HeaderSubtitle}"/>
                    </StackPanel>
                </Grid>
                </c:DataPageFrame.HeaderContent>
                <c:DataPageFrame.PageContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Alat halaman: memuat ulang, membuka situs pusat, dokumentasi,
                     dan cetak. Tidak ada isian — data sepenuhnya milik kementerian.
                     Deretan tombol memakai WrapPanel: bila jendela sempit, tombol
                     pindah baris, bukan terpotong di tepi kanan. -->
                <Border Grid.Row="0" Style="{StaticResource ToolbarCard}" Padding="16,12" Margin="0,12,0,0">
                    <StackPanel>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Muat ulang" Command="{Binding MuatCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,2,0,2"/>
                            <Button Content="Buka situs pusat" Command="{Binding BukaSitusCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="10,2,0,2"/>
                            <Button Content="Dokumentasi sumber 2025" Command="{Binding BukaDokumentasiIndeksDesaCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="10,2,0,2"
                                    ToolTip="Baca sumber dan catatan data Indeks Desa 2025 di dokumentasi Markdown dalam aplikasi"/>
                            <!-- Cetak/ekspor: ringkasan + rincian indikator yang sedang tampil
                                 dirender ke PDF, lalu dibuka di pratinjau PDF (tombol Cetak dan
                                 Ekspor ada di sana). Nonaktif selama belum ada data. -->
                            <Button Content="Cetak / PDF" Command="{Binding CetakCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="10,2,0,2"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="{Binding TooltipCetak}"/>
                        </WrapPanel>

                        <TextBlock Text="{Binding PesanStatus}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding AdaPesanStatus, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="{Binding PesanGalat}" Foreground="{DynamicResource ErrorTextBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding AdaGalat, Converter={StaticResource BoolToVis}}"/>

                        <!-- Internet mati: data terakhir yang berhasil dimuat tetap tampil,
                             dan baris ini memberi tahu tanggal pengambilannya. -->
                        <TextBlock Text="{Binding PesanCadangan}" Foreground="{DynamicResource WarningTextBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding AdaPesanCadangan, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="{Binding PeringatanSumber}" Foreground="{DynamicResource WarningTextBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding AdaPeringatanSumber, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" x:Name="HalamanScrollViewer" Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                <StackPanel>

                <!-- Belum ada data yang tampil dan tidak sedang memuat (mis. baru dibuka):
                     tampilkan petunjuk cara menampilkan data. -->
                <Border Style="{StaticResource FormCard}" Padding="16,14" Margin="0,0,0,12"
                        Visibility="{Binding AdaPemberitahuanMenunggu, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding PesanMenunggu}" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" MaxWidth="560"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               AutomationProperties.Name="Pemberitahuan IDM"/>
                </Border>

                <!-- TIGA KARTU ATAS — status desa, tren penilaian (grafik), dan
                     Indeks Desa 2025. Urutan anak adalah urutan tampil; panel
                     pemilik kebijakan tiga/dua/satu kolom, jarak antar kartu,
                     dan pemerataan tinggi baris (PanelKartuResponsif). -->
                <c:PanelKartuResponsif x:Name="KartuAtas" Jarak="12">

                    <!-- ===================== KARTU 1: STATUS DESA ===================== -->
                    <Border x:Name="StatusDesaCard"
                            Style="{StaticResource FormCard}" Padding="16,14"
                            Visibility="{Binding AdaData, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource JudulSectionIdm}">
                                <Border Style="{StaticResource AccentSectionBar}"/>
                                <TextBlock Text="STATUS DESA" Style="{StaticResource FormSectionTitle}"/>
                            </StackPanel>

                            <!-- Identitas desa: nama desa sebagai judul kartu, wilayah
                                 dan kode desa sebagai meta sekunder. -->
                            <TextBlock Text="{Binding NamaDesaTampil}" FontSize="20" FontWeight="Bold"
                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                       AutomationProperties.Name="Nama desa"/>
                            <TextBlock Text="{Binding WilayahTampil}" Style="{StaticResource MetaDesa}"
                                       AutomationProperties.Name="Wilayah desa"/>
                            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding KodeDesaTampil}" FontFamily="Consolas"
                                           Style="{StaticResource MetaDesa}" Margin="0,0,10,0"
                                           AutomationProperties.Name="Kode desa"/>
                                <Border Style="{StaticResource ChipPil}" Margin="0,0,0,0">
                                    <TextBlock Text="{Binding TahunTampil}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </WrapPanel>

                            <StackPanel Visibility="{Binding AdaDataIdm, Converter={StaticResource BoolToVis}}">
                                <!-- Judul seri lama menyebut tahun batas seri supaya keping
                                     IKS/IKE/IKL di bawah tidak terbaca sebagai penilaian 2025. -->
                                <TextBlock Text="{Binding JudulSeriLamaTampil}" Style="{StaticResource LabelAngka}"
                                           Margin="0,10,0,0"
                                           AutomationProperties.Name="Judul bagian riwayat IDM lama"/>

                                <!-- Skor utama + status desa: dua angka yang paling dicari
                                     operator. Skor besar di kiri, status berwarna di kanan. -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="SKOR IDM" Style="{StaticResource LabelAngka}"/>
                                        <TextBlock Text="{Binding SkorTampil}" Style="{StaticResource NilaiAngkaBesar}"
                                                   Margin="0,1,0,0" AutomationProperties.Name="Skor IDM"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                HorizontalAlignment="Right" Margin="10,0,0,0">
                                        <TextBlock Text="KATEGORI" Style="{StaticResource LabelAngka}"
                                                   HorizontalAlignment="Right"/>
                                        <Border Background="{DynamicResource AccentSubtleBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="12"
                                                Padding="10,3" Margin="0,3,0,0"
                                                HorizontalAlignment="Right">
                                            <!-- Warna teks mengikuti kategori pusat
                                                 (Mandiri/Maju/Tertinggal/Rawan) memakai brush teks
                                                 tema, jadi tetap kontras pada tema terang dan gelap. -->
                                            <TextBlock Text="{Binding StatusTampil}" FontSize="20" FontWeight="Bold"
                                                       AutomationProperties.Name="Status desa">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusTampil}" Value="MANDIRI">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusTampil}" Value="MAJU">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusTampil}" Value="TERTINGGAL">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusTampil}" Value="RAWAN">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Tiga bidang penilaian pusat: satu baris petak kecil. -->
                                <UniformGrid Columns="3" Margin="0,10,0,0">
                                    <Border Style="{StaticResource KepingPetak}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="IKS" Style="{StaticResource LabelAngka}"/>
                                            <TextBlock Text="{Binding IksTampil}" Style="{StaticResource NilaiAngka}"
                                                       AutomationProperties.Name="Indeks Ketahanan Sosial"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource KepingPetak}" Margin="6,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="IKE" Style="{StaticResource LabelAngka}"/>
                                            <TextBlock Text="{Binding IkeTampil}" Style="{StaticResource NilaiAngka}"
                                                       AutomationProperties.Name="Indeks Ketahanan Ekonomi"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource KepingPetak}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="IKL" Style="{StaticResource LabelAngka}"/>
                                            <TextBlock Text="{Binding IklTampil}" Style="{StaticResource NilaiAngka}"
                                                       AutomationProperties.Name="Indeks Ketahanan Lingkungan"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Target status dan skor minimal: dua kolom seimbang. -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="TARGET STATUS" Style="{StaticResource LabelAngka}"/>
                                        <TextBlock Text="{Binding TargetTampil}" Style="{StaticResource NilaiKata}"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="SKOR MINIMAL" Style="{StaticResource LabelAngka}"/>
                                        <TextBlock Text="{Binding SkorMinimalTampil}" Style="{StaticResource NilaiAngka}"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding PesanTarget}" Style="{StaticResource TeksBantu}"
                                           Margin="0,8,0,0"/>

                                <!-- Tahun lain + sumber data. -->
                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Tahun lain:" Style="{StaticResource TeksBantu}"
                                               Margin="0,0,6,4"/>
                                    <ItemsControl ItemsSource="{Binding Riwayat}" Margin="0,0,6,0"
                                                  AutomationProperties.Name="Tahun penilaian IDM">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ChipPil}">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextBrush}">
                                                        <Run Text="{Binding Tahun, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Skor, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Status, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Tanpa seri IDM lama: status desa tetap bisa dibaca dari
                                 Indeks Desa 2025 pada kartu di sebelah. -->
                            <TextBlock Text="Seri IDM lama (IKS/IKE/IKL) tidak tersedia untuk desa ini; penilaian yang tampil berasal dari Indeks Desa 2025."
                                       Style="{StaticResource TeksBantu}" Margin="0,12,0,0"
                                       Visibility="{Binding AdaDataIdm, Converter={StaticResource InvBoolToVis}}"/>

                            <!-- Tahun-tahun setelah data yang tampil belum terbit → pengguna
                                 diberi tahu SEMUA tahun yang kosong, bukan hanya tahun berjalan. -->
                            <TextBlock Text="{Binding PesanTahun}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningTextBrush}"
                                       Visibility="{Binding AdaPesanTahun, Converter={StaticResource BoolToVis}}"/>

                            <!-- Indikator data terbaru yang terbit + tanggal pemeriksaan portal. -->
                            <Border Background="{DynamicResource AccentSubtleBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="10,5"
                                    Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Visibility="{Binding AdaIndikatorTerbit, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Tahun penilaian terbaru yang diterbitkan portal pusat dan waktu portal terakhir diperiksa.">
                                <StackPanel>
                                    <TextBlock Text="{Binding IndikatorTerbitTampil}" FontSize="11" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Data terbaru yang terbit"/>
                                    <TextBlock Text="{Binding PemeriksaanTampil}" FontSize="11" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding AdaPemeriksaan, Converter={StaticResource BoolToVis}}"
                                               AutomationProperties.Name="Tanggal pemeriksaan portal"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding SumberTampil}" Style="{StaticResource TeksBantuKecil}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ===================== KARTU 2: TREN PENILAIAN ===================== -->
                    <Border x:Name="TrenCard"
                            Style="{StaticResource FormCard}" Padding="16,14"
                            Visibility="{Binding AdaData, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource JudulSectionIdm}">
                                <Border Style="{StaticResource AccentSectionBar}"/>
                                <TextBlock Text="TREN PENILAIAN" Style="{StaticResource FormSectionTitle}"/>
                            </StackPanel>
                            <TextBlock Text="Skor IDM, IKS, IKE, dan IKL per tahun terbit."
                                       Style="{StaticResource TeksBantu}" Margin="0,2,0,0"/>

                            <!-- Grafik hanya menggambar seri IDM lama — penilaian 2025
                                 memakai Indeks Desa (enam dimensi) dan tidak digabungkan
                                 ke garis IDM agar seri tidak tercampur. -->
                            <TextBlock Text="{Binding CatatanTren2025Tampil}"
                                       Style="{StaticResource TeksBantu}" Margin="0,4,0,0"
                                       AutomationProperties.Name="Catatan penilaian 2025 terpisah dari grafik IDM lama"
                                       Visibility="{Binding AdaIndeksDesa2025, Converter={StaticResource BoolToVis}}"/>

                            <!-- Susunan 2x2 memberi tiap keterangan ruang tetap di kartu
                                 yang sempit. Pola garis meniru grafik agar seri tidak
                                 dibedakan dengan warna saja; nama akses memperluas
                                 semua singkatan. -->
                            <Grid Margin="0,7,0,0" AutomationProperties.Name="Legenda tren penilaian IDM">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,5"
                                            AutomationProperties.Name="IDM, Indeks Desa Membangun, skor utama"
                                            AutomationProperties.HelpText="Garis penuh tebal dengan penanda bulat.">
                                    <Grid Width="28" Height="16" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Line X1="1" Y1="8" X2="27" Y2="8" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="3"/>
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource PrimaryBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="IDM · skor utama" FontSize="11" Margin="6,0,0,0"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5"
                                            AutomationProperties.Name="IKS, Indeks Ketahanan Sosial"
                                            AutomationProperties.HelpText="Garis penuh dengan penanda bulat.">
                                    <Grid Width="28" Height="16" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Line X1="1" Y1="8" X2="27" Y2="8" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="IKS · sosial" FontSize="11" Margin="6,0,0,0"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0"
                                            AutomationProperties.Name="IKE, Indeks Ketahanan Ekonomi"
                                            AutomationProperties.HelpText="Garis putus-putus dengan penanda bulat.">
                                    <Grid Width="28" Height="16" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Line X1="1" Y1="8" X2="27" Y2="8" Stroke="{DynamicResource WarningTextBrush}"
                                              StrokeThickness="2" StrokeDashArray="4,2"/>
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningTextBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="IKE · ekonomi" FontSize="11" Margin="6,0,0,0"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                                            AutomationProperties.Name="IKL, Indeks Ketahanan Lingkungan"
                                            AutomationProperties.HelpText="Garis titik-titik dengan penanda bulat.">
                                    <Grid Width="28" Height="16" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Line X1="1" Y1="8" X2="27" Y2="8" Stroke="{DynamicResource ErrorTextBrush}"
                                              StrokeThickness="2" StrokeDashArray="1,2" StrokeDashCap="Round"/>
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource ErrorTextBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="IKL · lingkungan" FontSize="11" Margin="6,0,0,0"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <c:GrafikTrenIdm Deret="{Binding DeretTren}" Height="220" Margin="0,8,0,0"
                                             KuasIdm="{DynamicResource PrimaryBrush}"
                                             KuasIks="{DynamicResource AccentBrush}"
                                             KuasIke="{DynamicResource WarningTextBrush}"
                                             KuasIkl="{DynamicResource ErrorTextBrush}"
                                             KuasGaris="{DynamicResource BorderBrush}"
                                             KuasTeks="{DynamicResource TextSecondaryBrush}"
                                             Visibility="{Binding AdaDataIdm, Converter={StaticResource BoolToVis}}"
                                             AutomationProperties.Name="Grafik tren penilaian IDM"/>

                            <!-- Tanpa seri IDM lama tidak ada yang bisa digambar; pesan ini
                                 menjaga kartu tetap memberi keterangan, bukan kosong. -->
                            <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10"
                                    Margin="0,8,0,0" MinHeight="120"
                                    Visibility="{Binding AdaDataIdm, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="Grafik tren memerlukan seri IDM lama (IKS/IKE/IKL). Untuk desa ini seri tersebut tidak tersedia; penilaian terbaru tampil sebagai Indeks Desa 2025."
                                           Style="{StaticResource TeksBantu}" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===================== KARTU 3: INDEKS DESA 2025 ===================== -->
                    <Border x:Name="IndeksDesaCard"
                            Style="{StaticResource FormCard}" Padding="16,14"
                            Visibility="{Binding AdaData, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource JudulSectionIdm}">
                                <Border Style="{StaticResource AccentSectionBar}"/>
                                <TextBlock Text="INDEKS DESA 2025" Style="{StaticResource FormSectionTitle}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding AdaIndeksDesa2025, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Enam dimensi resmi (Permendesa No. 9/2024), terpisah dari seri IDM lama."
                                           Style="{StaticResource TeksBantu}" Margin="0,2,0,0"/>

                                <!-- Angka utama 2025: total poin, nilai indeks, dan status. -->
                                <Border Style="{StaticResource KepingPetak}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL POIN · AKUMULASI" Style="{StaticResource LabelAngka}"/>
                                        <TextBlock Text="{Binding SkorTotalIndeksDesa2025}" Style="{StaticResource NilaiAngkaBesar}"
                                                   Margin="0,1,0,0"
                                                   AutomationProperties.Name="Total poin Indeks Desa 2025"/>
                                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Nilai indeks " FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding NilaiIndeksDesa2025}" Style="{StaticResource NilaiKata}"
                                                       Margin="0,0,10,0"
                                                       AutomationProperties.Name="Nilai Indeks Desa 2025"/>
                                            <TextBlock Text="·" FontSize="13" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusIndeksDesa2025}" Style="{StaticResource NilaiKata}"
                                                       Foreground="{DynamicResource SuccessTextBrush}"
                                                       AutomationProperties.Name="Status Indeks Desa 2025"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Enam dimensi resmi, dua kolom. -->
                                <ItemsControl ItemsSource="{Binding DimensiIndeksDesa2025}" Margin="0,2,0,0"
                                              AutomationProperties.Name="Enam dimensi Indeks Desa 2025">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PetakDimensi}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Nama}" FontSize="11"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Margin="0,0,8,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Skor}" FontSize="14"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Expander Margin="0,4,0,0"
                                          AutomationProperties.Name="Rincian sub-dimensi Indeks Desa 2025">
                                    <Expander.Header>
                                        <TextBlock Text="Rincian sub-dimensi resmi" FontSize="13"
                                                   Margin="14,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </Expander.Header>
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="Dataset pemerintah menerbitkan skor pada tingkat sub-dimensi; jawaban tiap butir kuesioner tidak tersedia di berkas ini."
                                                   Style="{StaticResource TeksBantu}" FontSize="11" Margin="0,0,0,5"/>
                                        <ItemsControl ItemsSource="{Binding RincianSubDimensiIndeksDesa2025}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="0,0,0,1" Padding="2,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Nama}" FontWeight="SemiBold"
                                                                           FontSize="13" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextBrush}"/>
                                                                <TextBlock Text="{Binding Dimensi}" FontSize="11"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Skor, StringFormat={}{0} poin}"
                                                                       FontFamily="Consolas" FontWeight="SemiBold"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       AutomationProperties.Name="Skor sub-dimensi dalam poin"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>

                                <!-- Ketetapan status desa 2025 dan tautan dokumen JDIH.
                                     Keterangan lengkap dipindah ke tooltip judul: kartu
                                     atas perlu tetap ringkas agar rincian indikator di
                                     bawahnya terlihat tanpa menggulir jauh. -->
                                <Border Style="{StaticResource KepingPetak}" Padding="12,10" Margin="0,8,0,0"
                                        ToolTip="{Binding KeteranganTerbitanBaru}"
                                        Visibility="{Binding AdaTerbitanBaru, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="KABAR DATA RESMI PUSAT" Style="{StaticResource LabelAngka}"/>
                                        <TextBlock Text="{Binding JudulTerbitanBaru}" TextWrapping="Wrap"
                                                   FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   AutomationProperties.Name="Dokumen resmi status desa"/>
                                        <Button Content="Buka dokumen resmi" Command="{Binding BukaTerbitanCommand}"
                                                Style="{StaticResource OutlineButton}" HorizontalAlignment="Left"
                                                Margin="0,8,0,0" Padding="10,3"
                                                ToolTip="Halaman JDIH Kementerian Desa dan PDT — situs resmi pemerintah pusat"
                                                AutomationProperties.Name="Buka dokumen resmi terbitan pusat"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tanpa dataset 2025: kartu tetap menjelaskan sebabnya. -->
                            <TextBlock Text="Dataset Indeks Desa 2025 tidak memuat kode desa ini, atau belum berhasil dimuat. Muat ulang saat tersambung ke internet."
                                       Style="{StaticResource TeksBantu}" Margin="0,8,0,0"
                                       Visibility="{Binding AdaIndeksDesa2025, Converter={StaticResource InvBoolToVis}}"/>

                            <TextBlock Text="{Binding SumberIndeksDesa2025}" Style="{StaticResource TeksBantuKecil}"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding TanggalPembaruanSumberIndeksDesa2025}" Style="{StaticResource TeksBantuKecil}"
                                       Margin="0,2,0,0"
                                       AutomationProperties.Name="Tanggal pembaruan dataset menurut sumber resmi"/>

                            <!-- RUJUKAN RESMI 2025 — dulu kartu selebar halaman di atas
                                 dashboard sehingga mendorong data utama ke bawah. Kini
                                 menjadi lipatan rapat di kartu Indeks Desa: alamatnya tetap
                                 bisa diklik, tanpa memakan ruang baca utama. -->
                            <Expander Margin="0,8,0,0"
                                      AutomationProperties.Name="Rujukan resmi 2025">
                                <Expander.Header>
                                    <TextBlock Text="Rujukan resmi 2025" FontSize="13"
                                               Margin="14,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding SumberResmi2025}" Margin="0,4,0,0"
                                              AutomationProperties.Name="Daftar sumber resmi 2025">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1" Padding="0,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Judul}" FontSize="13" FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding Keterangan}" FontSize="11" TextWrapping="Wrap"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap">
                                                        <Hyperlink Foreground="{DynamicResource AccentTextBrush}"
                                                                   TextDecorations="Underline" Cursor="Hand"
                                                                   ToolTip="Buka di peramban"
                                                                   Command="{Binding DataContext.BukaTautanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}">
                                                            <Run Text="{Binding Alamat, Mode=OneWay}"/>
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>
                </c:PanelKartuResponsif>

                <!-- ===================== RINCIAN INDIKATOR (PENUH LEBAR) ===================== -->
                <Border x:Name="RincianCard" Style="{StaticResource FormCard}" Padding="16,14" Margin="0,12,0,0"
                        Visibility="{Binding AdaData, Converter={StaticResource BoolToVis}}">
                    <!-- x:Name dipakai pengikatan lebar tabel di bawah: slot di dalam
                         kartu ini selalu berukuran lebar penuh halaman (tidak
                         bergantung pada pengukuran ScrollViewer), jadi tabel ikut
                         membesar/menyesuaikan begitu halaman dibuka. -->
                    <StackPanel x:Name="RincianTabelSlot">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource JudulSectionIdm}">
                                <Border Style="{StaticResource AccentSectionBar}"/>
                                <TextBlock Text="RINCIAN INDIKATOR — DATA PUSAT" Style="{StaticResource FormSectionTitle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Indikator.Count, StringFormat={}{0} baris}"
                                       Style="{StaticResource TeksBantuKecil}" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding AdaDataIdm, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <TextBlock Text="Nomor indikator dimulai ulang setiap bidang (IKS, IKE, IKL); baris tebal adalah subtotal resmi. Kolom Pihak menyebut pusat, provinsi, kabupaten, atau desa. Semua kolom disalin apa adanya dari idm.kemendesa.go.id."
                                   Style="{StaticResource TeksBantu}" Margin="0,2,0,0"/>

                        <!-- Tabel lebar: seluruh kolom muat pada layar lebar; pada jendela
                             sempit tabel digulir mendatar (barisnya tidak dipotong). -->
                        <ScrollViewer x:Name="RincianScrollViewer" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Auto"
                                      Focusable="False"
                                      Visibility="{Binding AdaDataIdm, Converter={StaticResource BoolToVis}}"
                                      AutomationProperties.Name="Rincian indikator IDM">
                            <!-- ScrollViewer mengukur konten dengan lebar tak terbatas saat
                                 gulir mendatar aktif, sehingga kolom bintang perlu lebar
                                 eksplisit. Ikat lebarnya ke slot induk (RincianTabelSlot)
                                 — BUKAN ke ScrollViewer itu sendiri: ActualWidth-nya masih
                                 0 pada ukuran pertama saat halaman baru dibuka sehingga
                                 tabel bisa tersangkut di lebar minimum. Batas minimum
                                 tetap menjaga kolom terbaca dan mengaktifkan gulir
                                 mendatar pada jendela sempit. -->
                            <StackPanel Width="{Binding ActualWidth, ElementName=RincianTabelSlot}"
                                        MinWidth="900">
                                <Border Style="{StaticResource TabelKepalaPita}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.7*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="No" Style="{StaticResource KepalaSel}"
                                                   TextAlignment="Center" Margin="0,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="Bidang" Style="{StaticResource KepalaSel}"/>
                                        <TextBlock Grid.Column="2" Text="Indikator" Style="{StaticResource KepalaSel}"/>
                                        <TextBlock Grid.Column="3" Text="Skor" Style="{StaticResource KepalaSel}"
                                                   TextAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="Keterangan pusat" Style="{StaticResource KepalaSel}"/>
                                        <TextBlock Grid.Column="5" Text="Kegiatan yang disarankan" Style="{StaticResource KepalaSel}"/>
                                        <TextBlock Grid.Column="6" Text="Pihak" Style="{StaticResource KepalaSel}"/>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Indikator}" AlternationCount="2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="baris"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="84"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="1.7*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding NomorTampil}"
                                                               Style="{StaticResource SelIdmNomor}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Bidang}"
                                                               Style="{StaticResource SelIdmTebal}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Indikator}"
                                                               Style="{StaticResource SelIdmTebal}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Skor}"
                                                               Style="{StaticResource SelIdmAngka}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Keterangan}"
                                                               Style="{StaticResource SelIdm}"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Kegiatan}"
                                                               Style="{StaticResource SelIdm}"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding Pihak}"
                                                               Style="{StaticResource SelIdmKecil}"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Value="1">
                                                    <DataTrigger.Binding>
                                                        <Binding Path="(ItemsControl.AlternationIndex)"
                                                                 RelativeSource="{RelativeSource AncestorType=ContentPresenter}"/>
                                                    </DataTrigger.Binding>
                                                    <Setter TargetName="baris" Property="Background"
                                                            Value="{DynamicResource ZebraBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14,12" Margin="0,8,0,0"
                                Visibility="{Binding AdaDataIdm, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="Rincian indikator berasal dari portal IDM pusat. Untuk desa ini seri IDM lama tidak tersedia, sehingga tidak ada baris indikator yang bisa ditampilkan."
                                       Style="{StaticResource TeksBantu}" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>
                </c:DataPageFrame.PageContent>
            </c:DataPageFrame>

        <!-- Dialog progres gaya SplashStartupWindow: bar progres 4 px statis di
             bawah judul (pola strip splash), deret titik langkah yang BERJALAN KE
             KANAN (bukan daftar ke bawah), lalu teks langkah yang sedang berjalan —
             persis pola indikator tahap splash. Kartu menutupi seluruh halaman
             selama data IDM diambil dari situs pusat; tombol di belakangnya
             tertutup tirai modal PaletTetap sehingga tidak bisa diklik saat
             memuat. -->
        <Border Visibility="{Binding SedangMemuat, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource TiraiBrush}"
                AutomationProperties.Name="Dialog Progres IDM">
            <Border MaxWidth="440" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.35"
                                      Color="{DynamicResource BayanganHitamColor}"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Kepala kartu: judul + keterangan singkat. -->
                    <StackPanel Margin="24,16,24,12">
                        <TextBlock Text="Memuat data IDM" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Mengambil data dari situs pusat Kemendesa…"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Strip progres gaya splash: bar 4 px STATIS (template
                         ProgressBar tema tidak punya animasi tak-tentu), penuh lebar
                         kartu, ujung membulat 3 px persis strip splash, berwarna
                         OnPrimaryTextBrush (putih) di atas latar PrimaryBrush. -->
                    <ProgressBar Height="4" IsIndeterminate="True"
                                 BorderThickness="0"
                                 Background="{DynamicResource PrimaryBrush}"
                                 Foreground="{DynamicResource OnPrimaryTextBrush}"
                                 AutomationProperties.Name="Progres pemuatan IDM"/>

                    <!-- Isi: deret ceklis + teks langkah. -->
                    <StackPanel Margin="24,14,24,20">
                        <!-- Deret ceklis KE KANAN: satu titik per langkah dengan garis
                             penghubung di antaranya (titik berdenyut saat berjalan,
                             lingkaran terisi + centang saat selesai). Nama langkah ikut
                             dibawa sebagai AutomationProperties.Name + tooltip supaya
                             tetap terbaca pembaca layar walau teksnya tidak dicetak
                             di bawah setiap titik (pola indikator tahap splash). -->
                        <ItemsControl ItemsSource="{Binding TahapanMemuat}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid AutomationProperties.Name="{Binding Teks}"
                                          ToolTip="{Binding Teks}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="18" Height="18"
                                              VerticalAlignment="Center">
                                            <!-- Halo denyut: beranimasi selamanya, tapi hanya
                                                 terlihat saat langkahnya sedang berjalan. -->
                                            <Ellipse Width="18" Height="18" Opacity="0"
                                                     Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                                     IsHitTestVisible="False">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Aktif">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.5" To="0" Duration="0:0:1.2"
                                                                                 RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                            <!-- Cincin langkah (selalu ada di bawah isi). -->
                                            <Ellipse Width="18" Height="18"
                                                     Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.6"/>
                                            <!-- Isi penuh + centang: muncul saat langkah selesai. -->
                                            <Ellipse Width="18" Height="18"
                                                     Fill="{DynamicResource PrimaryBrush}">
                                                <Ellipse.Style>
                                                    <!-- Opacity disetel DI GAYA, bukan sebagai atribut lokal:
                                                         nilai lokal menempel dan mengalahkan setter pemicu,
                                                         sehingga centang tidak akan pernah muncul. -->
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Selesai">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <!-- Centang digores persis koordinat indikator tahap splash. -->
                                            <Path Data="M 4.6,9.4 L 7.5,12.3 L 13.6,6"
                                                  Stroke="{DynamicResource OnPrimaryTextBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round">
                                                <Path.Style>
                                                    <!-- Opacity lewat gaya (lihat catatan pada lingkaran isi di atas). -->
                                                    <Style TargetType="Path">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Selesai">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>

                                        <!-- Garis penghubung ke titik berikutnya. Letaknya
                                             SETELAH titik, jadi titik terakhir tidak menyisakan
                                             ekor garis; menyala penuh hanya untuk langkah yang
                                             sudah selesai (pola konektor splash). -->
                                        <Rectangle Grid.Column="1" Width="14" Height="2"
                                                   RadiusX="1" RadiusY="1"
                                                   Margin="5,0,5,0" VerticalAlignment="Center"
                                                   Fill="{DynamicResource PrimaryBrush}">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Selesai">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Terakhir}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Langkah yang sedang berjalan — teks lengkapnya, seperti baris
                             teks tahap di splash. Semua langkah sebelumnya sudah
                             tercentang di deret atas. -->
                        <TextBlock Text="{Binding TahapAktifTeks}" FontSize="13" FontWeight="Medium"
                                   Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                   AutomationProperties.Name="Langkah IDM yang sedang berjalan"/>

                        <TextBlock Text="Biasanya hanya membutuhkan beberapa detik." FontSize="11"
                                   Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
