<UserControl x:Class="SuDesApp.Wpf.Views.DokumenBacaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities"
             FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">

    <!--
        Pembaca dokumen bawaan aplikasi (berkas .md di folder docs). Isi dokumen
        disusun oleh MarkdownKeFlowDocument menjadi FlowDocument, jadi dokumen
        dibaca DI DALAM aplikasi: tidak ada aplikasi luar yang dibuka dan tidak ada
        jendela asing yang menutupi aplikasi desa. Bilah alat bawaan
        FlowDocumentScrollViewer (termasuk tombol cetak) sengaja disembunyikan —
        halaman ini untuk membaca, bukan mencetak.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: judul dokumen + keterangan berkas + tombol kembali ke daftar -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource HeaderIconChip}">
                        <TextBlock Text="{x:Static u:IkonMenu.Dokumentasi}"
                                   FontFamily="{StaticResource AppIconFont}" FontSize="18"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource HeaderTitle}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource HeaderSubtitle}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding NamaBerkas}" FontSize="11.5" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource HeaderSubtitleBrush}"/>
                        <TextBlock Text="{Binding UkuranText}" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource HeaderSubtitleBrush}" Opacity="0.85"/>
                    </StackPanel>
                    <Button Content="Kembali" Command="{Binding BatalCommand}"
                            ToolTip="Kembali ke daftar Dokumentasi"
                            Style="{StaticResource HeaderGhostButton}" Height="30"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Galat baca: berkas hilang/tidak bisa dibaca dijelaskan apa adanya. -->
        <Border Grid.Row="1" Margin="0,0,0,12"
                Background="{DynamicResource ErrorSubtleBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14,10"
                Visibility="{Binding AdaGalat, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#9888;" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource ErrorTextBrush}"/>
                <TextBlock Text="{Binding PesanGalat}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource ErrorTextBrush}"/>
            </StackPanel>
        </Border>

        <!-- Isi dokumen: kertas putih di atas latar kartu, tanpa bilah alat. -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True">
            <FlowDocumentScrollViewer Document="{Binding Isi}"
                                      IsToolBarVisible="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent" Padding="0"/>
        </Border>
    </Grid>
</UserControl>
