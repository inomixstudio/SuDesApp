<UserControl x:Class="SuDesApp.Wpf.Views.ApiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             FontSize="14" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="KotakStatus" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <c:DataPageFrame Margin="20">
        <c:DataPageFrame.HeaderContent>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Style="{StaticResource HeaderIconChip}">
                        <TextBlock Text="{x:Static u:IkonMenu.Api}" FontSize="20" FontFamily="{StaticResource AppIconFont}" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap" MaxWidth="620"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding LabelUji}" Command="{Binding UjiKoneksiCommand}" Style="{StaticResource HeaderGhostButton}" Margin="0,0,8,0" ToolTip="Kirim permintaan nyata ke endpoint /status memakai kunci di bawah"/>
                    <Button Content="Simpan" Command="{Binding SimpanCommand}" Style="{StaticResource HeaderActionButton}"/>
                </StackPanel>
            </Grid>
        </c:DataPageFrame.HeaderContent>
        <c:DataPageFrame.PageContent>
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status listener -->
        <Border Grid.Row="1" Style="{StaticResource KotakStatus}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AlamatStatus}" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding GalatText}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource ErrorTextBrush}"
                               Visibility="{Binding AdaGalat, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding HasilTes}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Muat Ulang" Command="{Binding MuatUlangCommand}"
                        Style="{StaticResource OutlineButton}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Pengaturan + kunci, dan daftar endpoint -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FormCard}" Padding="16" VerticalAlignment="Top">
                <!-- Isi kartu pengaturan lebih tinggi daripada ruang yang tersedia pada
                     jendela kecil: tanpa ScrollViewer seluruh isinya terpotong dan
                     tidak bisa dilihat. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Panduan singkat diletakkan paling atas supaya operator
                             tidak perlu menebak urutan langkah: halaman ini memang
                             satu-satunya tempat menyalakan API. -->
                        <TextBlock Text="CARA MENJALANKAN" Style="{StaticResource FormSectionTitle}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="1. Centang Aktifkan API di bawah.&#10;2. Tekan Buat Kunci Baru, lalu Salin kuncinya.&#10;3. Tekan Simpan di kanan atas — API menyala dan kotak status di atas berubah.&#10;4. Tekan Uji Koneksi untuk memastikan listener menjawab.&#10;Untuk dipakai HP di jaringan yang sama: centang Izinkan akses dari jaringan, isi IP HP pada kolom IP yang diizinkan, lalu Simpan lagi."/>

                        <TextBlock Text="PENGATURAN" Style="{StaticResource FormSectionTitle}" Margin="0,16,0,0"/>

                        <CheckBox Content="Aktifkan API" IsChecked="{Binding Aktif}" Margin="0,10,0,0"
                                  ToolTip="Bila tidak aktif, tidak ada port yang dibuka"/>
                        <TextBlock Text="Bila aktif, listener menyalakan diri sendiri setiap aplikasi dibuka."
                                   Style="{StaticResource FieldLabel}" Margin="22,2,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                        <TextBox Text="{Binding Port}" Style="{StaticResource FieldBox}" Margin="0,4,0,0"
                                 ToolTip="1025 sampai 65535. Port di bawah 1024 butuh hak administrator"/>

                        <TextBlock Text="Batas permintaan per menit per alamat" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                        <TextBox Text="{Binding BatasPermintaan}" Style="{StaticResource FieldBox}" Margin="0,4,0,0"
                                 ToolTip="Minimal 5, maksimal 600. Mencegah satu klien membebani aplikasi"/>

                        <CheckBox Content="Izinkan akses dari jaringan" IsChecked="{Binding IzinkanJaringan}"
                                  Margin="0,14,0,0"
                                  ToolTip="Matikan bila API hanya dipakai dari komputer ini"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="22,2,0,0" TextWrapping="Wrap"
                                    Text="Membuka untuk jaringan membutuhkan IP yang diizinkan dan biasanya hak administrator."/>
                        <TextBlock Text="IP yang diizinkan" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding IpDiizinkan, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}" Margin="0,4,0,0"
                                 ToolTip="Pisahkan IP komputer yang diizinkan dengan koma, mis. 192.168.1.20, 192.168.1.21"/>

                        <CheckBox Content="Catat pemanggilan API ke Riwayat Aktivitas"
                                  IsChecked="{Binding CatatAktivitas}" Margin="0,10,0,0"/>

                        <Border Style="{StaticResource KotakStatus}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="KUNCI API" Style="{StaticResource FormSectionTitle}" FontSize="13"/>
                                <TextBlock Text="Dikirim di header X-Api-Key atau Authorization: Bearer."
                                           Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <!-- Mode=OneWay: TeksKunci properti hitung (bisa berupa
                                     bintang saat disembunyikan) dan kotak ini memang
                                     hanya-pembaca; binding TwoWay bawaan TextBox membuat
                                     binding gagal dibuat sehingga kunci tidak tampil. -->
                                <TextBox x:Name="KotakKunci" Text="{Binding TeksKunci, Mode=OneWay}"
                                         FontSize="13" Padding="8,6" Margin="0,8,0,0"
                                         IsReadOnly="True"/>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{Binding LabelKunci}" Command="{Binding TampilkanKunciCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                    <Button Content="Salin" Command="{Binding SalinKunciCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                    <Button Content="Buat Kunci Baru" Command="{Binding BuatKunciCommand}"
                                            Style="{StaticResource OutlineButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Kunci cakupan sempit: kunci tambahan untuk sistem luar
                             (dashboard kecamatan, website desa) supaya bocornya satu
                             kunci tidak membuka semua endpoint. -->
                        <Border Style="{StaticResource KotakStatus}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="KUNCI CAKUPAN" Style="{StaticResource FormSectionTitle}" FontSize="13"/>
                                <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Kunci sempit untuk sistem luar. Agregat hanya membaca statistik; Permintaan hanya mengirim/memantau surat online. Kunci utama tetap berwenang penuh."/>

                                <TextBlock Text="Cakupan" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                                <ComboBox ItemsSource="{Binding PilihanCakupan}"
                                          SelectedValue="{Binding CakupanTerpilih}"
                                          SelectedValuePath="Nilai" DisplayMemberPath="Tampilan"
                                          Style="{StaticResource FormCombo}" Margin="0,4,0,0"
                                          ToolTip="Pilih cakupan kunci yang akan dibuat"/>

                                <TextBlock Text="Nama pemegang (opsional)" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                <TextBox Text="{Binding NamaKunciCakupan, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldBox}" Margin="0,4,0,0"
                                         ToolTip="Misalnya &quot;Dashboard Kecamatan&quot; — untuk mengenali siapa pemegang kunci"/>

                                <Button Content="Buat Kunci Cakupan" Command="{Binding BuatKunciCakupanCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                                        ToolTip="Simpan kunci baru dengan cakupan terpilih, lalu salin nilainya dari daftar di bawah"/>

                                <TextBlock Text="Belum ada kunci cakupan."
                                           Style="{StaticResource FieldLabel}" Margin="0,10,0,0"
                                           Visibility="{Binding TidakAdaKunciCakupan, Converter={StaticResource BoolToVis}}"/>

                                <ItemsControl ItemsSource="{Binding KunciCakupan}" Margin="0,6,0,0"
                                              Visibility="{Binding AdaKunciCakupan, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NamaTampil}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding RingkasTampil}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>

                                                <!-- RelativeSource: tombol ada di dalam ItemTemplate,
                                                     perintahnya milik DataContext halaman. -->
                                                <Button Grid.Column="1" Content="Salin" Padding="8,0" Margin="0,0,6,0"
                                                        Style="{StaticResource SecondaryButton}"
                                                        ToolTip="Salin nilai kunci lengkap ke papan klip"
                                                        Command="{Binding DataContext.SalinKunciCakupanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="2" Content="Hapus" Padding="8,0"
                                                        Style="{StaticResource DangerButton}"
                                                        ToolTip="Hapus permanen kunci ini; sistem luar yang memakainya langsung ditolak"
                                                        Command="{Binding DataContext.HapusKunciCakupanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GridHostCard}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,14,16,0">
                        <TextBlock Text="ENDPOINT TERSEDIA" Style="{StaticResource FormSectionTitle}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Semua endpoint memakai prefix yang sama. Endpoint ini tidak mengeluarkan NIK, alamat, atau nomor HP warga."/>
                    </StackPanel>

                    <!-- Daftar endpoint berbentuk tabel (kepala kolom + baris) yang
                         tinggi barisnya mengikuti isi, sehingga keterangan sepanjang
                         apa pun tampil utuh tanpa dipotong. DataGrid sengaja tidak
                         dipakai: RowHeight="Auto" pernah memicu loop layout tanpa
                         henti di halaman ini (stack overflow), sedangkan tinggi tetap
                         memotong teks panjang. -->
                    <ScrollViewer Grid.Row="1" Margin="12,10,12,14"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Kepala kolom (lebar kolomnya sama persis dengan baris) -->
                            <Border Style="{StaticResource TabelKepalaPita}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="1.2*" MinWidth="140"/>
                                        <ColumnDefinition Width="110" MinWidth="90"/>
                                        <ColumnDefinition Width="2*" MinWidth="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Metode" FontWeight="Bold"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Endpoint" FontWeight="Bold"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="Kategori" FontWeight="Bold"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="3" Text="Keterangan" FontWeight="Bold"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Endpoint}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1" Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="1.2*" MinWidth="140"/>
                                                    <ColumnDefinition Width="110" MinWidth="90"/>
                                                    <ColumnDefinition Width="2*" MinWidth="150"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Metode}"
                                                           FontWeight="SemiBold" VerticalAlignment="Top"
                                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding JalurPenuh}"
                                                           TextWrapping="Wrap" VerticalAlignment="Top"
                                                           Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding KategoriTampil}"
                                                           TextWrapping="Wrap" VerticalAlignment="Top"
                                                           Margin="0,0,12,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Keterangan}"
                                                           TextWrapping="Wrap" VerticalAlignment="Top"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Contoh pemanggilan per endpoint: integrator cukup salin
                                 di sini tanpa membaca kode listener. Teksnya selalu
                                 disusun ulang dari pengaturan alamat yang sedang
                                 berlaku (lihat ApiViewModel.SusunContohPanggilan). -->
                            <TextBlock Text="CONTOH PEMANGGILAN (CURL)" Style="{StaticResource FormSectionTitle}"
                                       Margin="0,16,0,0"/>
                            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,4,0,6"
                                       Text="Ganti &lt;KUNCI_API&gt; dengan kunci di kolom PENGATURAN. Alamat mengikuti port yang sedang berlaku. Teks yang satu ini bisa langsung ditempel di PowerShell atau terminal Linux/Mac."/>

                            <ItemsControl ItemsSource="{Binding ContohPanggilan}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource KotakStatus}" Padding="12,10"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Judul}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Keterangan}" Style="{StaticResource FieldLabel}"
                                                               TextWrapping="Wrap" Margin="0,3,0,0"/>

                                                    <!-- Label + tombol Salin berpasangan per blok:
                                                         perintah curl dan bentuk jawaban masing-masing
                                                         punya tombolnya sendiri, supaya integrator bisa
                                                         menempel skema jawaban langsung ke parser
                                                         miliknya tanpa mengurai teks curl. -->
                                                    <Grid Margin="0,7,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Perintah:"
                                                                   Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                                        <Button Grid.Column="1" Content="Salin" Padding="8,2"
                                                                FontSize="11" Style="{StaticResource SecondaryButton}"
                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                ToolTip="Salin perintah curl ke papan klip"
                                                                Command="{Binding DataContext.SalinContohCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                    <TextBox Text="{Binding Curl, Mode=OneWay}" IsReadOnly="True"
                                                             FontFamily="Consolas" FontSize="13"
                                                             Padding="8,5" TextWrapping="Wrap"/>

                                                    <Grid Margin="0,7,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Bentuk jawaban:"
                                                                   Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                                        <Button Grid.Column="1" Content="Salin" Padding="8,2"
                                                                FontSize="11" Style="{StaticResource SecondaryButton}"
                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                ToolTip="Salin bentuk jawaban (JSON) ke papan klip"
                                                                Command="{Binding DataContext.SalinJawabanContohCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                    <TextBox Text="{Binding Jawaban, Mode=OneWay}" IsReadOnly="True"
                                                             FontFamily="Consolas" FontSize="13"
                                                             Padding="8,5" TextWrapping="Wrap"
                                                             AcceptsReturn="True"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        </Grid>
        </c:DataPageFrame.PageContent>
    </c:DataPageFrame>
</UserControl>
