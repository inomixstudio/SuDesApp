<UserControl x:Class="SuDesApp.Wpf.Views.GarapanInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             FontSize="13"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nomor Surat: memanjang penuh di atas -->
        <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Padding="10" Header="Nomor Surat">
            <TextBox Style="{StaticResource FieldBox}"
                     IsEnabled="{Binding NomorSuratEnabled}"
                     Text="{Binding NomorSurat, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Nomor surat (otomatis jika dikelola register)"/>
        </GroupBox>

        <!-- Kolom kiri: data penggarap -->
        <GroupBox Grid.Row="2" Grid.Column="0" Padding="10" Header="Data Penggarap">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="NIK *"/>
                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Name="Nik"
                         LostFocus="OnNikLostFocus"
                         Text="{Binding Nik, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="16" ToolTip="NIK Warga (16 digit angka)"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Nama *"/>
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper" ToolTip="Nama Lengkap (huruf saja)"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tempat Lahir *"/>
                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding TempatLahir, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tgl. Lahir *"/>
                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding TanggalLahir, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Format: DD-MM-YYYY"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Jenis Kelamin *"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource DropDown}"
                          ItemsSource="{Binding JenisKelaminOptions}"
                          SelectedItem="{Binding JenisKelamin, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Agama *"/>
                <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource DropDown}"
                          ItemsSource="{Binding AgamaOptions}"
                          SelectedItem="{Binding Agama, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Pekerjaan *"/>
                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding Pekerjaan, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Dusun/Jalan *"/>
                <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding Dusun, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Jln./Dusun dan RT/RW"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Desa *"/>
                <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding Desa, UpdateSourceTrigger=LostFocus}"/>

                <Grid Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Kecamatan *"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Kecamatan, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Kabupaten *"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Kabupaten, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Kolom kanan: detail garapan, keperluan, pejabat -->
        <StackPanel Grid.Row="2" Grid.Column="2">
            <GroupBox Padding="10" Header="Detail Tanah Garapan">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Lokasi Tanah *"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Lokasi, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="200" ToolTip="Masukkan lokasi tanah garapan"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="No. Persil"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding NomorPersil, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50" ToolTip="Masukkan nomor persil tanah"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Luas (M2) *"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Luas, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Masukkan luas tanah dalam meter persegi (contoh: 1000)"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Keterangan *"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource DropDown}"
                              ItemsSource="{Binding KeteranganGarapanOptions}"
                              SelectedItem="{Binding KeteranganGarapan, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Pilih status garapan (Garap/Sewa/Hak Milik)"/>
                </Grid>
            </GroupBox>

            <Grid Height="8"/>

            <GroupBox Padding="10" Header="Tanah Garapan Tambahan (bidang ke-2 dst.)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="＋ Tambah Bidang" Padding="10,2" Height="30" MinWidth="110"
                                    Command="{Binding AddRincianCommand}"
                                    ToolTip="Tambah baris bidang garapan tambahan"/>
                            <Button Content="Hapus" Padding="10,2" Height="30" MinWidth="70" Margin="6,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RemoveRincianCommand}"
                                    CommandParameter="{Binding SelectedRincian}"
                                    ToolTip="Hapus baris yang dipilih"/>
                            <Button Content="↻" Padding="6,2" Height="30" Width="34" Margin="6,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ClearRincianCommand}"
                                    ToolTip="Kosongkan daftar bidang tambahan"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="Kosongkan bila garapan hanya satu. Klik sel untuk mengedit — baris kosong otomatis dilewati saat disimpan:"/>
                    </DockPanel>

                    <DataGrid x:Name="RincianGrid" Grid.Row="1"
                              ItemsSource="{Binding RincianItems}"
                              SelectedItem="{Binding SelectedRincian, Mode=TwoWay}"
                              Style="{StaticResource EditableDataGrid}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              MinHeight="140"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lokasi Tanah" Width="200" MinWidth="100"
                                                Binding="{Binding Lokasi, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="No. Persil" Width="120" MinWidth="80"
                                                Binding="{Binding NomorPersil, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Luas (M2)" Width="90" MinWidth="60"
                                                Binding="{Binding Luas, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- DataGridComboBoxColumn TIDAK dipakai: kolom grid berada di luar visual tree
                                 sehingga RelativeSource/DataSource binding ke ViewModel gagal diam-diam
                                 (dropdown tampil kosong). DataGridTemplateColumn berada di dalam cell
                                 (visual tree utuh) sehingga binding ke VM via UserControl berhasil. -->
                            <DataGridTemplateColumn Header="Keterangan" Width="120" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding KeteranganGarapan}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="2,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.KeteranganGarapanOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding KeteranganGarapan, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Aksi" Width="64" MinWidth="64" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Hapus" Margin="2" Padding="6,2"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.RemoveRincianCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Hapus baris ini"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <Grid Height="8"/>

            <GroupBox Padding="10" Header="Keperluan Surat">
                <TextBox Style="{StaticResource FieldBox}"
                         Text="{Binding Keperluan, UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper"
                         ToolTip="Masukkan keperluan surat (contoh: Pengajuan Pinjaman)"/>
            </GroupBox>

            <Grid Height="8"/>

            <GroupBox Padding="10" Header="Pejabat Yang Menandatangani">
                <StackPanel Orientation="Horizontal">
                    <!-- Foreground dibiarkan dari tema (TextBrush) — memaksa HeaderTextBrush (putih)
                         membuat teks tak terlihat di atas latar terang GroupBox. -->
                    <RadioButton Content="Kepala Desa" GroupName="pejabat" Margin="0,0,24,0"
                                 VerticalAlignment="Center"
                                 IsChecked="{Binding IsKadesSelected, Mode=TwoWay}"/>
                    <RadioButton Content="Sekretaris Desa" GroupName="pejabat"
                                 VerticalAlignment="Center"
                                 IsChecked="{Binding IsSekdesSelected, Mode=TwoWay}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>