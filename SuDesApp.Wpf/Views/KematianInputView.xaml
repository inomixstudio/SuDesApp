<UserControl x:Class="SuDesApp.Wpf.Views.KematianInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="900"
             FontSize="13"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════
             BAR ATAS — Nomor Surat (memanjang penuh)
             ═══════════════════════════════════════════════════════════════════ -->
        <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Padding="10" Header="Nomor Surat">
            <TextBox Style="{StaticResource FieldBox}"
                     IsEnabled="{Binding NomorSuratEnabled}"
                     Text="{Binding NomorSurat, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Nomor surat (otomatis jika dikelola register)"/>
        </GroupBox>

        <!-- ═══════════════════════════════════════════════════════════════════
             KIRI — Data Pemohon (Jenazah)
             ═══════════════════════════════════════════════════════════════════ -->
        <GroupBox Grid.Row="2" Grid.Column="0" Padding="10" Header="Data Pemohon (Jenazah)">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="NIK *"/>
                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Name="Nik"
                         LostFocus="OnNikLostFocus"
                         Text="{Binding Nik, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="16" ToolTip="NIK Jenazah (16 digit angka)"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Nama Jenazah *"/>
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper" ToolTip="Nama Lengkap Jenazah"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tempat Lahir *"/>
                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding TempatLahir, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tgl. Lahir *"/>
                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding TanggalLahir, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Format: DD-MM-YYYY"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Jenis Kelamin *"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource DropDown}"
                          ItemsSource="{Binding JenisKelaminOptions}"
                          SelectedItem="{Binding JenisKelamin, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Agama *"/>
                <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource DropDown}"
                          ItemsSource="{Binding AgamaOptions}"
                          SelectedItem="{Binding Agama, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Pekerjaan *"/>
                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding Pekerjaan, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Dusun/Jalan *"/>
                <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding Dusun, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Jln./Dusun dan RT/RW"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Desa *"/>
                <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding Desa, UpdateSourceTrigger=LostFocus}"/>

                <Grid Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Kecamatan *"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Kecamatan, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Kabupaten *"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Kabupaten, UpdateSourceTrigger=LostFocus}"/>
                </Grid>

            </Grid>
        </GroupBox>

        <!-- ═══════════════════════════════════════════════════════════════════
             KANAN — Data Pelapor (bersebelahan dengan data jenazah)
             ═══════════════════════════════════════════════════════════════════ -->
        <GroupBox Grid.Row="2" Grid.Column="2" Padding="10" Header="Data Pelapor">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="NIK Pelapor"/>
                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Name="NikPelapor"
                         LostFocus="OnNikPelaporLostFocus"
                         Text="{Binding NIKPelapor, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="16" ToolTip="NIK Pelapor (16 digit angka)"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Nama Pelapor *"/>
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding NamaPelapor, UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Agama Pelapor"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource DropDown}"
                          ItemsSource="{Binding AgamaOptions}"
                          SelectedItem="{Binding AgamaPelapor, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tgl. Lahir Pelapor *"/>
                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding UmurPelapor, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Format: DD-MM-YYYY"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Pekerjaan Pelapor *"/>
                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding PekerjaanPelapor, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Hubungan Pelapor *"/>
                <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource DropDown}"
                          ItemsSource="{Binding HubunganPelaporOptions}"
                          SelectedItem="{Binding HubunganPelapor, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Contoh: Suami, Istri, Anak Kandung, Saudara"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Dusun/Jalan *"/>
                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding DusunPelapor, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Dusun/Jalan pelapor"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Desa *"/>
                <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding DesaPelapor, UpdateSourceTrigger=LostFocus}"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Kecamatan *"/>
                <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding KecPelapor, UpdateSourceTrigger=LostFocus}"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Kabupaten *"/>
                <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding KabPelapor, UpdateSourceTrigger=LostFocus}"/>
            </Grid>
        </GroupBox>

        <!-- ═══════════════════════════════════════════════════════════════════
             BAR BAWAH — Data Kematian & Pejabat Penandatangan
             ═══════════════════════════════════════════════════════════════════ -->
        <GroupBox Grid.Row="4" Grid.Column="0" Padding="10" Header="Data Kematian">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tanggal *"/>
                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding TanggalKematian, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Format: DD-MM-YYYY"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Hari Kematian"/>
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding HariKematian, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True" ToolTip="Terisi otomatis dari tanggal kematian"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Pukul *"/>
                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding PukulKematian, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Format: HH:mm"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Penyebab Kematian *"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource DropDown}"
                          ItemsSource="{Binding PenyebabKematianOptions}"
                          SelectedItem="{Binding PenyebabKematian, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Pilih penyebab kematian"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Grid.Column="2" Padding="10" Header="Pejabat Yang Menandatangani">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <RadioButton Content="Kepala Desa" IsChecked="True" IsEnabled="False"
                             VerticalAlignment="Center" ToolTip="Pejabat ditetapkan Kepala Desa."/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>