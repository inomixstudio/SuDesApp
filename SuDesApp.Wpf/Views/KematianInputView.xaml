<UserControl x:Class="SuDesApp.Wpf.Views.KematianInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="900"
             FontSize="13"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
            >

    <Grid IsSharedSizeScope="True">
        <StackPanel>

            <!-- NOMOR SURAT -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="NOMOR SURAT" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nomor Surat *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource FormField}"
                                 IsEnabled="{Binding NomorSuratEnabled}"
                                 Text="{Binding NomorSurat, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nomor surat (otomatis jika dikelola register)"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- DATA JENAZAH (PEMOHON) | DATA PELAPOR — berdampingan -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource FormCard}" Padding="14">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="DATA JENAZAH (PEMOHON)" Style="{StaticResource FormSectionTitle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="96" MaxWidth="130" SharedSizeGroup="FormLabelPair"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="NIK *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                     Name="Nik" LostFocus="OnNikLostFocus"
                                     Text="{Binding Nik, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="16" ToolTip="NIK Jenazah (16 digit angka)"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Nama Jenazah *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"
                                     CharacterCasing="Upper" ToolTip="Nama lengkap jenazah"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tempat Lahir *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding TempatLahir, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Tgl. Lahir *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding TanggalLahir, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Format: DD-MM-YYYY"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Jenis Kelamin *" Style="{StaticResource FormLabel}"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FormCombo}"
                                      ItemsSource="{Binding JenisKelaminOptions}"
                                      SelectedItem="{Binding JenisKelamin, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Agama *" Style="{StaticResource FormLabel}"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FormCombo}"
                                      ItemsSource="{Binding AgamaOptions}"
                                      SelectedItem="{Binding Agama, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Pekerjaan *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Pekerjaan, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Dusun/Jalan *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Dusun, UpdateSourceTrigger=LostFocus}" ToolTip="Jln./Dusun dan RT/RW"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Desa *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Desa, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Kecamatan *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Kecamatan, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Kabupaten *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="10" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Kabupaten, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource FormCard}" Padding="14">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="DATA PELAPOR" Style="{StaticResource FormSectionTitle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="96" MaxWidth="130" SharedSizeGroup="FormLabelPair"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="NIK Pelapor" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                     Name="NikPelapor" LostFocus="OnNikPelaporLostFocus"
                                     Text="{Binding NIKPelapor, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="16" ToolTip="NIK pelapor (16 digit angka)"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Nama Pelapor *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding NamaPelapor, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tgl. Lahir Pelapor *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding UmurPelapor, UpdateSourceTrigger=LostFocus}" ToolTip="Format: DD-MM-YYYY"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Pekerjaan Pelapor *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding PekerjaanPelapor, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Agama Pelapor" Style="{StaticResource FormLabel}"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FormCombo}"
                                      ItemsSource="{Binding AgamaOptions}"
                                      SelectedItem="{Binding AgamaPelapor, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Hubungan Pelapor *" Style="{StaticResource FormLabel}"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FormCombo}"
                                      ItemsSource="{Binding HubunganPelaporOptions}"
                                      SelectedItem="{Binding HubunganPelapor, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Dusun/Jalan Pelapor *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding DusunPelapor, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Desa Pelapor *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding DesaPelapor, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Kecamatan Pelapor *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding KecPelapor, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Kabupaten Pelapor *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding KabPelapor, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DATA KEMATIAN -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="DATA KEMATIAN" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tanggal Kematian *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding TanggalKematian, UpdateSourceTrigger=LostFocus}" ToolTip="Format: DD-MM-YYYY"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Hari Kematian" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                 IsReadOnly="True" Background="{DynamicResource PanelBrush}"
                                 Text="{Binding HariKematian, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Terisi otomatis dari tanggal kematian"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Pukul *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding PukulKematian, UpdateSourceTrigger=LostFocus}" ToolTip="Format: HH:mm"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Penyebab Kematian *" Style="{StaticResource FormLabel}"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormCombo}"
                                  ItemsSource="{Binding PenyebabKematianOptions}"
                                  SelectedItem="{Binding PenyebabKematian, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- PEJABAT PENANDATANGAN -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="PEJABAT PENANDATANGAN" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <RadioButton Content="Kepala Desa" IsChecked="True" IsEnabled="False"
                                 VerticalAlignment="Center"
                                 ToolTip="Pejabat ditetapkan Kepala Desa."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
