<UserControl xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities" x:Class="SuDesApp.Wpf.Views.PindahInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             FontSize="14"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
            >

    <!-- Satu kolom: field lebar penuh, hanya scroll vertikal. -->
    <Grid IsSharedSizeScope="True">
        <StackPanel>

            <c:NomorSuratCard/>

            <!-- DATA PEMOHON (ASAL) -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="DATA PEMOHON (ALAMAT ASAL)" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="NIK *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                 Name="Nik" LostFocus="OnNikLostFocus"
                                 Text="{Binding Nik, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="16" ToolTip="NIK Pemohon (16 digit angka)"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Nama *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"
                                 CharacterCasing="Upper"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tempat Lahir *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding TempatLahir, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Tgl. Lahir *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding TanggalLahir, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Format: DD-MM-YYYY" u:TanggalIsianOtomatis.Aktif="True" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Jenis Kelamin *" Style="{StaticResource FormLabel}"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FormCombo}"
                                  ItemsSource="{Binding JenisKelaminOptions}"
                                  SelectedItem="{Binding JenisKelamin, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Agama *" Style="{StaticResource FormLabel}"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FormCombo}"
                                  ItemsSource="{Binding AgamaOptions}"
                                  SelectedItem="{Binding Agama, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Status Perkawinan *" Style="{StaticResource FormLabel}"/>
                        <ComboBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FormCombo}"
                                  ItemsSource="{Binding StatusPerkawinanOptions}"
                                  SelectedItem="{Binding StatusPerkawinan, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Pekerjaan *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding Pekerjaan, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Dusun/Jalan, RT, dan RW dalam satu baris. -->
                        <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Dusun/Jalan *" Style="{StaticResource FormLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource FormField}"
                                         Text="{Binding Dusun, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Alamat asal (dusun/jalan) pemohon"/>
                            </Grid>

                            <Grid Grid.Column="1" Margin="0,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RT" Style="{StaticResource FormLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource FormField}" Width="88" MaxLength="3"
                                         Text="{Binding Rt, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Nomor RT"/>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RW" Style="{StaticResource FormLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource FormField}" Width="88" MaxLength="3"
                                         Text="{Binding Rw, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Nomor RW"/>
                            </Grid>
                        </Grid>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Desa *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding Desa, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Alamat asal (desa) pemohon"/>

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Kecamatan *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="11" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding Kecamatan, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Alamat asal (kecamatan) pemohon"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Kabupaten *" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="12" Grid.Column="1" Style="{StaticResource FormField}"
                                 Text="{Binding Kabupaten, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Alamat asal (kabupaten) pemohon"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ALAMAT TUJUAN PINDAH -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="ALAMAT TUJUAN PINDAH" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Alamat Tujuan *" Style="{StaticResource FormLabel}" VerticalAlignment="Top"/>
                        <TextBox Grid.Column="1" Style="{StaticResource FormField}" Height="90"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding AlamatTujuanPindah, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Alamat lengkap tujuan pindah (jalan/dusun, RT/RW, desa/kelurahan, kecamatan, kabupaten/kota, provinsi)."/>

                        <TextBlock Grid.Column="0" Text="Alasan Pindah *" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                        <TextBox Grid.Column="1" Style="{StaticResource FormField}" Height="60" Margin="0,6,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding AlasanPindah, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Alasan pindah (mis. pindah domisili, mengikuti pekerjaan, dll.)."/>
                    </Grid>

                    <TextBlock FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="* Alamat tujuan dan alasan pindah ikut tercetak pada surat."/>
                </StackPanel>
            </Border>

            <!-- KETERANGAN SURAT -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="KETERANGAN SURAT" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Keterangan" Style="{StaticResource FormLabel}" VerticalAlignment="Top"/>
                        <TextBox Grid.Column="1" Style="{StaticResource FormField}" Height="90"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Keterangan, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Keterangan surat (otomatis terisi; bisa disunting)."/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- PEJABAT PENANDATANGAN -->
            <Border Style="{StaticResource FormCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                        <Border Style="{StaticResource AccentSectionBar}"/>
                        <TextBlock Text="PEJABAT PENANDATANGAN" Style="{StaticResource FormSectionTitle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Kepala Desa" GroupName="pejabat" Margin="0,0,24,0"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding IsKadesSelected, Mode=TwoWay}"/>
                        <RadioButton Content="Sekretaris Desa" GroupName="pejabat"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding IsSekdesSelected, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="11" Margin="2,0,0,4" TextWrapping="Wrap"
                       Text="Petunjuk: Masukkan NIK pemohon. Data alamat asal akan diambil otomatis dari database bila NIK ditemukan."/>
        </StackPanel>
    </Grid>
</UserControl>
