<Window x:Class="SuDesApp.Wpf.Views.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctrl="clr-namespace:SuDesApp.Wpf.Controls"
        Title="Pesan" Width="430" SizeToContent="Height" MaxWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="20,10,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Title bar bertema ===== -->
            <Border Grid.Row="0" Margin="-20,0,-20,10" Height="30"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    MouseLeftButtonDown="CaptionBorder_MouseLeftButtonDown">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource WindowTitleText}" FontWeight="SemiBold"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}"
                            Command="{x:Static ctrl:AppChromeCommands.Close}"
                            ToolTip="Tutup (Esc)">
                        <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"/>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Baris ikon + judul -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Border x:Name="IconBadge" Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource PrimaryBrush}">
                    <TextBlock x:Name="IconText" Text="i" FontSize="18" FontWeight="Bold"
                               Foreground="White" FontFamily="Segoe UI Symbol"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" Text="Judul" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                           Margin="12,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Pesan (dibungkus scroll agar pesan sangat panjang tetap wajar) -->
            <ScrollViewer Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <TextBlock x:Name="MessageText" Text="Pesan" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20"/>
            </ScrollViewer>

            <!-- Tombol (visibilitas diatur code-behind sesuai kombinasi) -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnYes" Content="Ya" Width="96" Height="32" Margin="0,0,8,0" IsDefault="True"/>
                <Button x:Name="BtnNo" Content="Tidak" Width="96" Height="32" Margin="0,0,8,0"/>
                <Button x:Name="BtnCancel" Content="Batal" Width="96" Height="32" Margin="0,0,8,0"/>
                <Button x:Name="BtnOk" Content="OK" Width="96" Height="32" IsDefault="True" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
