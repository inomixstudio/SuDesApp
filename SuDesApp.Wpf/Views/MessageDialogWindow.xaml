<!-- Kartu membulat + bayangan lembut — gaya yang sama dengan SplashStartupWindow
     dan LoginWindow (ruang bayangan 18px di tepi window). NoResize: AllowsTransparency
     aman dipakai di sini karena resize mouse memang tidak dipakai. -->
<Window x:Class="SuDesApp.Wpf.Views.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctrl="clr-namespace:SuDesApp.Wpf.Controls"
        Title="Pesan" Width="430" SizeToContent="Height" MaxWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <!-- Border luar hanya membawa bayangan; ClipToBounds di border ini akan
         memotong DropShadowEffect (terverifikasi render), jadi clip ada di
         border dalam — title bar full-bleed tetap terpotong busur sudut. -->
    <Border Margin="18" CornerRadius="14" Effect="{StaticResource BayanganTebal}">
    <Border CornerRadius="14" ClipToBounds="True"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="20,10,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Title bar bertema ===== -->
            <Border Grid.Row="0" Margin="-20,0,-20,10" Height="30"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    MouseLeftButtonDown="CaptionBorder_MouseLeftButtonDown">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource WindowTitleText}" FontWeight="SemiBold"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}"
                            Command="{x:Static ctrl:AppChromeCommands.Close}"
                            ToolTip="Tutup (Esc)">
                        <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"/>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Baris ikon + judul -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" x:Name="IconBadge" Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource PrimaryBrush}">
                    <TextBlock x:Name="IconText" Text="i" FontSize="20"
                               Foreground="{DynamicResource OnPrimaryTextBrush}"
                               FontFamily="{StaticResource AppIconFont}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" x:Name="TitleText" Text="Judul" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                           Margin="12,0,0,0" TextWrapping="Wrap"/>
            </Grid>

            <!-- Pesan (dibungkus scroll agar pesan sangat panjang tetap wajar) -->
            <ScrollViewer Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <TextBlock x:Name="MessageText" Text="Pesan" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20"/>
            </ScrollViewer>

            <!-- Tombol (visibilitas diatur code-behind sesuai kombinasi).
                 Tombol aksi utama (Ya/OK) memakai warna penuh; pilihan kedua
                 (Tidak/Batal) bergaya garis supaya hierarki jelas. -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnYes" Content="Ya" Width="96" Margin="0,0,8,0"
                        IsDefault="True" Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BtnNo" Content="Tidak" Width="96" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="BtnCancel" Content="Batal" Width="96" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="BtnOk" Content="OK" Width="96"
                        IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
    </Border>
</Window>
