<Window x:Class="SuDesApp.Wpf.Views.InputKeputusanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctrl="clr-namespace:SuDesApp.Wpf.Controls"
        Title="{Binding Title}"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        Height="500" Width="500"
        MinHeight="460" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        FontSize="13"
        WindowStyle="None"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <DockPanel>
            <!-- ===== Title bar bertema ===== -->
            <Border DockPanel.Dock="Top" Height="30" Background="{DynamicResource SidebarBackgroundBrush}"
                    MouseLeftButtonDown="CaptionBorder_MouseLeftButtonDown">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource WindowTitleText}" FontWeight="SemiBold"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}"
                            Command="{x:Static ctrl:AppChromeCommands.Close}" ToolTip="Tutup (Esc)">
                        <Path Data="M 0 0 L 8 8 M 8 0 L 0 8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"/>
                    </Button>
                </DockPanel>
            </Border>
            <!-- Panel bawah: simpan/batal -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" Padding="10,8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Simpan" Width="110" Height="34" Margin="0,0,8,0"
                            Command="{Binding SaveCommand}" IsDefault="True"/>
                    <Button Content="Batal" Width="110" Height="34"
                            Command="{Binding CancelCommand}" IsCancel="True"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextBrush}" Text="Data Keputusan / Peraturan" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                    <!-- Pilih berkas lampiran Word/PDF (di atas) -->
                    <Border Margin="0,0,0,16" Padding="10" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Pilih File Word / PDF" Width="160" Height="32" Margin="0,0,8,0"
                                    Command="{Binding PickWordFileCommand}"/>
                            <TextBlock Text="{Binding WordFileDisplay, Mode=OneWay}" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <Button Content="Lihat" Width="70" Height="32"
                                    Command="{Binding OpenWordFileCommand}"
                                    IsEnabled="{Binding HasStoredOrPickedFile, FallbackValue=False}"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{DynamicResource TextBrush}" Text="Nomor" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Nomor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource TextBrush}" Text="Tanggal" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Tanggal, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Foreground="{DynamicResource TextBrush}" Text="Tentang" VerticalAlignment="Top" Margin="0,4,0,10"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Tentang, UpdateSourceTrigger=PropertyChanged}"
                                 Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Foreground="{DynamicResource TextBrush}" Text="Keterangan" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Keterangan, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Loading Overlay -->
        <Border Background="#80000000" Visibility="{Binding IsLoadingWord, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="100">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="300" MinWidth="200">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="40" Height="40" Margin="0,0,0,16"/>
                    <TextBlock Text="Membaca berkas Word..." FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" TextAlignment="Center"/>
                    <TextBlock Text="Mohon tunggu, aplikasi sedang memproses berkas..." FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
    </Border>
</Window>