<UserControl x:Class="SuDesApp.Wpf.Views.SinkronView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities"
             xmlns:local="clr-namespace:SuDesApp.Wpf.Views"
             FontSize="14" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource PageHeader}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource HeaderIconChip}">
                        <TextBlock Text="⇅" FontSize="20"
                                   FontFamily="{StaticResource AppIconFont}"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource HeaderSubtitle}"
                                   TextWrapping="Wrap" MaxWidth="900"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Konfigurasi Supabase -->
            <Border Grid.Row="1" Style="{StaticResource FormCard}" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="KONEKSI SUPABASE" Style="{StaticResource FormSectionTitle}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,4,0,10"
                               Text="Hubungkan aplikasi ini ke Supabase desa. Kata sandi basis data disimpan terenkripsi (DPAPI) per akun Windows."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="Host pooler" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"
                                     ToolTip="aws-0-ap-northeast-2.pooler.supabase.com"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="Pengguna" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Pengguna, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"
                                     ToolTip="postgres.&lt;project-ref&gt;"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Kata sandi basis data" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding KataSandi, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="Tenant / id desa" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Tenant, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"
                                     ToolTip="Id pelanggan di Supabase (32 karakter hex)"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="URL REST" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding UrlRest, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"
                                     ToolTip="https://&lt;project-ref&gt;.supabase.co"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="Kunci publik Supabase (publishable key) — dipakai aplikasi Android."/>
                    <TextBox Text="{Binding KunciPublik, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Simpan koneksi" Command="{Binding SimpanKonfigurasiCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Terbitkan skema formulir" Command="{Binding TerbitkanSkemaCommand}"
                                Style="{StaticResource OutlineButton}" Margin="0,0,8,0"/>
                        <Button Content="Terbitkan kop &amp; nomor" Command="{Binding TerbitkanPengaturanCommand}"
                                Style="{StaticResource OutlineButton}" Margin="0,0,8,0"
                                ToolTip="Terbitkan ulang identitas kop surat dan pola nomor. Android mengambilnya otomatis."/>
                        <TextBlock Text="Belum tersimpan / tidak lengkap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ErrorTextBrush}"
                                   Visibility="{Binding KonfigurasiLengkap, Converter={StaticResource InverseBoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Terbitkan skema formulir mengunggah definisi formulir 27 jenis surat ke Supabase supaya aplikasi Android memakai definisi yang sama persis."/>
                </StackPanel>
            </Border>

            <!-- Sinkronisasi -->
            <Border Grid.Row="2" Style="{StaticResource FormCard}" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="SINKRONISASI SURAT" Style="{StaticResource FormSectionTitle}"/>

                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,12"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="Surat menunggu di antrean: "/>
                        <Run Text="{Binding JumlahAntrean, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text=" (maksimum 10)."/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Sinkronkan sekarang" Command="{Binding SinkronCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Muat ulang" Command="{Binding MuatUlangCommand}"
                                Style="{StaticResource OutlineButton}"/>
                    </StackPanel>

                    <TextBlock Text="Sedang menyinkronkan…" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding SedangSinkron, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{Binding HasilRingkasan}" Margin="0,10,0,0" TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding AdaHasil, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Perangkat -->
            <Border Grid.Row="3" Style="{StaticResource FormCard}" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="PERANGKAT ANDROID" Style="{StaticResource FormSectionTitle}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,4,0,10"
                               Text="Pasang perangkat baru dengan memindai QR. QR berisi URL Supabase, kunci publik, surel, dan kata sandi perangkat."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox Text="{Binding NamaPerangkat, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}" Width="240"
                                 ToolTip="Nama perangkat, mis. 'Android Kades'"/>
                        <Button Content="Buat QR" Command="{Binding PasangCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" ItemsSource="{Binding Perangkat}"
                                 SelectedItem="{Binding PerangkatDipilih}"
                                 DisplayMemberPath="Nama" Height="120"
                                 Style="{StaticResource {x:Type ListBox}}"/>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top"
                                    Visibility="{Binding AdaPerangkatBaru, Converter={StaticResource BoolToVis}}">
                            <Border Padding="8" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Image Source="{Binding GambarQr}" Width="180" Height="180"
                                       Stretch="Uniform" SnapsToDevicePixels="True"/>
                            </Border>
                            <TextBlock Text="Pindai dari aplikasi Android" Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="atau ketik kode" Margin="0,12,0,2"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding KodePerangkat}"
                                       FontSize="40" FontWeight="Bold"
                                       HorizontalAlignment="Center" FontFamily="Consolas"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="Cabut perangkat terpilih" Command="{Binding CabutCommand}"
                            Style="{StaticResource OutlineButton}" Margin="0,12,0,0"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
