<UserControl x:Class="SuDesApp.Wpf.Views.SinkronView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities"
             xmlns:local="clr-namespace:SuDesApp.Wpf.Views"
             FontSize="14" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Bilah isi antrean: tipis, membulat secara visual lewat latar panel,
             dan berubah merah saat antrean penuh. -->
        <Style x:Key="BilahAntrean" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AntreanPenuh}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabelKpi" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="KeteranganKpi" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <DataTemplate x:Key="BarisPerangkat">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Nama}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="Terakhir online: "/>
                        <Run Text="{Binding TerakhirOnline, Mode=OneWay, TargetNullValue=belum pernah, StringFormat={}{0:dd MMM yyyy HH:mm}}"/>
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="8" Padding="8,1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Aktif}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="11" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="Text" Value="Nonaktif"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Aktif}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                        <Setter Property="Text" Value="Aktif"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Kepala halaman ===== -->
            <Border Grid.Row="0" Style="{StaticResource PageHeader}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource HeaderIconChip}">
                            <TextBlock Text="{x:Static u:IkonMenu.Sinkron}"
                                       FontSize="20"
                                       FontFamily="{StaticResource AppIconFont}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource HeaderTitle}"/>
                            <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource HeaderSubtitle}"
                                       TextWrapping="Wrap" MaxWidth="720"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Koneksi Supabase dipakai otomatis; ditandai sekali di kepala
                         halaman supaya operator tidak mencari kolom pengaturan. -->
                    <Border Grid.Column="1" CornerRadius="10" Padding="10,5" VerticalAlignment="Center"
                            Background="{DynamicResource SuccessBrush}"
                            Visibility="{Binding KonfigurasiLengkap, Converter={StaticResource BoolToVis}}"
                            ToolTip="Koneksi Supabase dibaca otomatis dari konfigurasi aplikasi saat dijalankan.">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="KONEKSI OTOMATIS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource HeaderTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" CornerRadius="10" Padding="10,5" VerticalAlignment="Center"
                            Background="{DynamicResource PanelBrush}"
                            Visibility="{Binding KonfigurasiLengkap, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="KONEKSI BELUM SIAP" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource HeaderTextBrush}" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== Tiga angka ringkas ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource KpiCard}" Padding="16,14">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="SURAT MENUNGGU" Style="{StaticResource LabelKpi}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{x:Static u:IkonMenu.SuratMasuk}"
                                       FontFamily="{StaticResource AppIconFont}" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <TextBlock Text="{Binding JumlahAntrean}" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="/ 10" FontSize="13" Margin="6,0,0,4" VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ProgressBar Style="{StaticResource BilahAntrean}" Value="{Binding JumlahAntrean, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource KeteranganKpi}"
                                   Text="Antrean dikosongkan setelah surat diimpor ke register."/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource KpiCard}" Padding="16,14">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="PERANGKAT" Style="{StaticResource LabelKpi}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{x:Static u:IkonMenu.Sinkron}"
                                       FontFamily="{StaticResource AppIconFont}" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <TextBlock Text="{Binding JumlahPerangkatAktif}" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="aktif" FontSize="13" Margin="6,0,0,4" VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource KeteranganKpi}">
                            <Run Text="Dari "/>
                            <Run Text="{Binding JumlahPerangkat, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" perangkat terpasang. Hanya satu yang boleh aktif."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource KpiCard}" Padding="16,14" Margin="0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="PENGATURAN ANDROID" Style="{StaticResource LabelKpi}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{x:Static u:IkonMenu.Pengaturan}"
                                       FontFamily="{StaticResource AppIconFont}" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <TextBlock Text="Otomatis" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource KeteranganKpi}"
                                   Text="Kop surat, pola nomor, dan skema formulir ditarik perangkat dari desktop."/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Sinkronisasi Surat ===== -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource FormCard}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="SINKRONISASI SURAT" Style="{StaticResource FormSectionTitle}"/>
                            <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,1"
                                    Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RingkasanAntrean}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextBrush}"/>
                            </Border>
                        </DockPanel>

                        <TextBlock Margin="0,6,0,10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Tarik surat yang dibuat di aplikasi Android dari antrean Supabase, lalu impor ke register desktop. Setiap surat diberi nomor resmi sekali saja."/>

                        <ProgressBar Style="{StaticResource BilahAntrean}" Value="{Binding JumlahAntrean, Mode=OneWay}"/>

                        <CheckBox Content="Sinkron otomatis" IsChecked="{Binding SinkronOtomatis}"
                                  Margin="0,12,0,0" ToolTip="Aktif: surat masuk register otomatis tiap antrean berkurang tanpa klik Sinkronkan."/>
                        <TextBlock Margin="24,2,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Bila aktif, antrean diimpor di latar tiap ±20 detik."/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Command="{Binding SinkronCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static u:IkonMenu.Sinkron}"
                                               FontFamily="{StaticResource AppIconFont}" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Sinkronkan sekarang" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding MuatUlangCommand}" Style="{StaticResource OutlineButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static u:IkonMenu.Riwayat}"
                                               FontFamily="{StaticResource AppIconFont}" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Muat ulang" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ImporUlangCommand}" Style="{StaticResource OutlineButton}"
                                    Margin="8,0,0,0"
                                    ToolTip="Impor ulang berkas gagal yang diarsipkan di folder Sinkron/Gagal.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static u:IkonMenu.Riwayat}"
                                               FontFamily="{StaticResource AppIconFont}" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Impor ulang arsip gagal" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                    Visibility="{Binding SedangSinkron, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Static u:IkonMenu.Sinkron}"
                                       FontFamily="{StaticResource AppIconFont}" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Sedang menyinkronkan…" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <Border Margin="0,12,0,0" CornerRadius="8" Padding="12,9"
                                Background="{DynamicResource AccentSubtleBrush}"
                                Visibility="{Binding AdaHasil, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static u:IkonMenu.Verifikasi}"
                                           FontFamily="{StaticResource AppIconFont}" FontSize="14"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           VerticalAlignment="Top" Margin="0,1,8,0"/>
                                <TextBlock Text="{Binding HasilRingkasan}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Hasil impor juga tercatat di log sinkron dan notifikasi aplikasi."/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Perangkat ===== -->
            <Border Grid.Row="3" Style="{StaticResource FormCard}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="PERANGKAT ANDROID" Style="{StaticResource FormSectionTitle}"/>
                        <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,1"
                                Background="{DynamicResource PanelBrush}" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{Binding JumlahPerangkatAktif, Mode=OneWay}"/>
                                <Run Text=" aktif · "/>
                                <Run Text="{Binding JumlahPerangkat, Mode=OneWay}"/>
                                <Run Text=" terpasang"/>
                            </TextBlock>
                        </Border>
                    </DockPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,12"
                               Text="Pasang satu perangkat dengan memindai QR atau mengetik kode 4 angka. Memasang perangkat baru menonaktifkan perangkat sebelumnya; antreannya tetap bisa disinkronkan."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="Pasang perangkat baru" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Buat QR" Command="{Binding BuatQrCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        ToolTip="Buat QR + kode: pindai dari aplikasi Android."/>
                                <Button Content="Buat Kode" Command="{Binding BuatKodeCommand}"
                                        Style="{StaticResource OutlineButton}" Margin="8,0,0,0"
                                        ToolTip="Buat kode 4 angka: ketik di aplikasi Android."/>
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Nama perangkat dibuat otomatis — tanpa mengisi apa pun. Tekan salah satu tombol, lalu scan QR atau ketik kode di Android."/>

                            <TextBlock Text="PERANGKAT TERPASANG" Style="{StaticResource FieldLabel}"
                                       Margin="0,14,0,4"/>
                            <ListBox ItemsSource="{Binding Perangkat}"
                                     SelectedItem="{Binding PerangkatDipilih}"
                                     ItemTemplate="{StaticResource BarisPerangkat}"
                                     MinHeight="96" MaxHeight="150"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                            <TextBlock Text="Belum ada perangkat terpasang." Margin="2,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding AdaPerangkat, Converter={StaticResource InverseBoolToVis}}"/>

                            <Button Content="Cabut perangkat terpilih" Command="{Binding CabutCommand}"
                                    Style="{StaticResource OutlineButton}" Margin="0,12,0,0"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Panel kode: QR + kode 4 angka setelah perangkat dibuat -->
                        <Border Grid.Column="1" Width="252" CornerRadius="10" Padding="14"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel Visibility="{Binding AdaPerangkatBaru, Converter={StaticResource BoolToVis}}">
                                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="8"
                                            Visibility="{Binding TampilkanQr, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{Binding GambarQr}" Width="188" Height="188"
                                               Stretch="Uniform" SnapsToDevicePixels="True"/>
                                    </Border>
                                    <TextBlock Text="{Binding PetunjukPasangUtama}" Margin="0,8,0,0"
                                               HorizontalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding PetunjukPasangKedua}" Margin="0,10,0,0"
                                               HorizontalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding KodePerangkat}"
                                               FontSize="36" FontWeight="Bold" FontFamily="Consolas"
                                               HorizontalAlignment="Center" Margin="0,0,0,2"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="Berlaku 10 menit dan hanya sekali pakai."
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding AdaPerangkatBaru, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="{x:Static u:IkonMenu.Gembok}"
                                               FontFamily="{StaticResource AppIconFont}" FontSize="24"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Belum ada kode aktif" Margin="0,8,0,0"
                                               HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Text="Tekan «Buat QR» atau «Buat Kode» — nama dibuat otomatis."
                                               Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
