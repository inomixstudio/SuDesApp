<!--
    Dialog persetujuan dokumen hukum (Kebijakan Privasi + Syarat & Ketentuan).

    Muncul SEBELUM jendela login pada pemasangan pertama, dan lagi setiap versi
    dokumen dinaikkan. Bentuk kartu bertema sama dengan MessageDialogWindow dan
    LoginWindow supaya aplikasi tidak terasa berganti gaya di langkah awal.
-->
<Window x:Class="SuDesApp.Wpf.Views.PersetujuanDokumenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctrl="clr-namespace:SuDesApp.Wpf.Controls"
        xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities"
        Title="Persetujuan Dokumen" Width="660" SizeToContent="Height"
        MaxWidth="760" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Margin="18" CornerRadius="14" Effect="{StaticResource BayanganTebal}">
        <Border CornerRadius="14" ClipToBounds="True"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid Margin="22,10,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== Title bar bertema ===== -->
                <Border Grid.Row="0" Margin="-22,0,-22,14" Height="30"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        MouseLeftButtonDown="CaptionBorder_MouseLeftButtonDown">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Persetujuan Dokumen"
                                   Style="{StaticResource WindowTitleText}" FontWeight="SemiBold"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}"
                                Command="{x:Static ctrl:AppChromeCommands.Close}"
                                ToolTip="Tutup (Esc) — aplikasi tidak dilanjutkan">
                            <Path Data="M 0 0 L 8 8 M 8 0 L 0 8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"/>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- ===== Kepala: ikon + judul + alasan dialog muncul ===== -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                            Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Top">
                        <TextBlock Text="{x:Static u:IkonMenu.Dokumentasi}"
                                   FontFamily="{StaticResource AppIconFont}" FontSize="20"
                                   Foreground="{DynamicResource OnPrimaryTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Grid (bukan StackPanel) supaya Judul/Subjudul membungkus
                         pada lebar kolom — StackPanel mengukur tanpa batas dan
                         teksnya meluap terpotong. -->
                    <Grid Grid.Column="1" Margin="14,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding Judul}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="{Binding Subjudul}" FontSize="13" Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" LineHeight="19"/>
                    </Grid>
                </Grid>

                <!-- ===== Daftar dokumen: versi yang terpasang + tombol baca ===== -->
                <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="4" Margin="0,0,0,14">
                    <ItemsControl ItemsSource="{Binding Dokumen}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource BorderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Grid (bukan StackPanel) agar semua teks membungkus
                                             pada lebar kolom, bukan meluap tanpa batas. -->
                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding Dokumen.Judul}" FontSize="14"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Grid.Row="1" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding VersiTerpasangTampil, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding TanggalBerlakuTampil, Mode=OneWay}"/>
                                            </TextBlock>

                                            <!-- Dokumen yang sudah disetujui pada versi lebih lama:
                                                 pengguna perlu tahu bahwa inilah yang berubah. -->
                                            <TextBlock Grid.Row="2" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource WarningTextBrush}"
                                                       Visibility="{Binding VersiBerubah, Converter={StaticResource BoolToVis}}">
                                                <Run Text="Sebelumnya Anda menyetujui Versi"/>
                                                <Run Text="{Binding Tercatat.Versi, Mode=OneWay}"/>
                                                <Run Text="— versi baru ini perlu disetujui ulang."/>
                                            </TextBlock>
                                        </Grid>

                                        <Button Grid.Column="1" Content="Baca" MinWidth="76"
                                                VerticalAlignment="Center" Margin="12,0,0,0"
                                                Style="{StaticResource SecondaryButton}"
                                                Tag="{Binding}"
                                                Click="Baca_Click"
                                                IsEnabled="{Binding BisaDibaca}"
                                                ToolTip="Baca dokumen lengkap di dalam aplikasi"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ===== Pernyataan persetujuan ===== -->
                <Border Grid.Row="3" Background="{DynamicResource LapisanLembutBrush}"
                        CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                    <!-- Grid luar (bukan StackPanel) agar Catatan juga membungkus. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row="0" IsChecked="{Binding Terima, Mode=TwoWay}"
                                  VerticalContentAlignment="Top">
                            <!-- Grid (bukan StackPanel) supaya TextWrapping punya batas
                                 lebar — StackPanel mengukur anaknya tanpa batas sehingga
                                 teks meluap dan terpotong di sisi kanan dialog. -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                                           Foreground="{DynamicResource TextBrush}">
                                    Saya telah membaca dan menyetujui Kebijakan Privasi serta
                                    Syarat dan Ketentuan yang berlaku pada versi di atas.
                                </TextBlock>

                                <!-- Jujur bila salah satu berkas tidak ikut terpasang -->
                                <TextBlock Grid.Row="1" Text="{Binding PesanBerkasHilang}" FontSize="11"
                                           Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="16"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           Visibility="{Binding AdaBerkasHilang, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </CheckBox>
                        <TextBlock Grid.Row="1" Text="{Binding Catatan}" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" LineHeight="16"/>
                    </Grid>
                </Border>

                <!-- ===== Galat simpan (jarang: folder preferensi tidak bisa ditulis) ===== -->
                <Border Grid.Row="4" Margin="0,0,0,10" Padding="12,9" CornerRadius="8"
                        Background="{DynamicResource WarningSubtleBrush}"
                        Visibility="{Binding AdaGalat, Converter={StaticResource BoolToVis}}">
                    <!-- Grid (bukan StackPanel Horizontal) supaya teks galat yang panjang
                         membungkus di sisa lebar, bukan meluap tanpa batas. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#9888;" FontSize="14" Margin="0,0,8,0"
                                   VerticalAlignment="Top"
                                   Foreground="{DynamicResource WarningTextBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PesanGalat}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningTextBrush}"/>
                    </Grid>
                </Border>

                <!-- ===== Tombol ===== -->
                <Grid Grid.Row="5" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Membungkus (bukan ellipsis): catatan tidak boleh hilang di balik tombol. -->
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Persetujuan hanya disimpan di komputer ini."
                               TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Keluar" Width="110" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="Keluar_Click"
                                IsCancel="True"
                                ToolTip="Tutup aplikasi tanpa menyetujui"/>
                        <Button Content="Setuju &amp; Lanjutkan" Width="184"
                                Style="{StaticResource PrimaryButton}"
                                IsDefault="True"
                                IsEnabled="{Binding BisaLanjut}"
                                Click="Setuju_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
