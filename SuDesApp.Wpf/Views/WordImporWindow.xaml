<Window x:Class="SuDesApp.Wpf.Views.WordImporWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctrl="clr-namespace:SuDesApp.Wpf.Controls"
        Title="Buat Template dari File Word"
        Width="800" Height="580" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False" WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="4" CornerRadius="0"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="20,10,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Title bar bertema ===== -->
            <Border Grid.Row="0" Margin="-20,0,-20,10" Height="30"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    MouseLeftButtonDown="CaptionBorder_MouseLeftButtonDown">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource WindowTitleText}" FontWeight="SemiBold"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}"
                            Command="{x:Static ctrl:AppChromeCommands.Close}"
                            ToolTip="Tutup (Esc)">
                        <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"/>
                    </Button>
                </DockPanel>
            </Border>

            <!-- ===== Kepala dialog ===== -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentSubtleBrush}"
                        VerticalAlignment="Top">
                    <TextBlock Text="&#128196;" FontSize="18" Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Buat template dari file Word" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{Binding NamaBerkas, Mode=OneWay}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>

            <!-- ===== Peringatan pembacaan berkas ===== -->
            <Border Grid.Row="2" Background="{DynamicResource WarningSubtleBrush}" CornerRadius="6" Padding="10,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding AdaPeringatan, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding TeksPeringatan, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource WarningTextBrush}"/>
            </Border>

            <!-- ===== Daftar bagian surat ===== -->
            <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Keterangan, Mode=OneWay}" TextWrapping="Wrap"
                               FontSize="12" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl ItemsSource="{Binding Baris}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding Pilih, Mode=TwoWay}"
                                                      VerticalAlignment="Top" Margin="0,7,0,0"
                                                      ToolTip="Ikut disimpan sebagai template surat"/>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Height="30" VerticalContentAlignment="Center"
                                                             Text="{Binding Nama, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding Pilih}"
                                                             ToolTip="Nama template yang tampil di daftar Template Surat"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Keterangan, Mode=OneWay}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Grid>

                                                <TextBlock Text="{Binding Ringkasan, Mode=OneWay}" TextWrapping="Wrap"
                                                           FontSize="12" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                                                <TextBlock Text="{Binding Cuplikan, Mode=OneWay}" TextWrapping="Wrap"
                                                           FontSize="11" Margin="0,3,0,0" Opacity="0.85"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                                                <!-- ===== Pratinjau singkat: halaman pertama hasil cetak ===== -->
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="{Binding TeksTombolPratinjau, Mode=OneWay}"
                                                            Command="{Binding PratinjauCommand}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Height="28" Padding="10,0"
                                                            ToolTip="Cetak contoh halaman pertama bagian ini supaya susunannya bisa diperiksa sebelum disimpan"/>
                                                    <TextBlock Text="Membuat pratinjau…" FontSize="11" Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding SedangPratinjau, Converter={StaticResource BoolToVis}}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>

                                                <TextBlock Text="{Binding PesanPratinjau, Mode=OneWay}" TextWrapping="Wrap"
                                                           FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource WarningTextBrush}"
                                                           Visibility="{Binding AdaPesanPratinjau, Converter={StaticResource BoolToVis}}"/>

                                                <Border Visibility="{Binding AdaPratinjau, Converter={StaticResource BoolToVis}}"
                                                        Background="White" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="6"
                                                        Margin="0,8,0,0" HorizontalAlignment="Left">
                                                    <StackPanel>
                                                        <Image Source="{Binding GambarPratinjau, Mode=OneWay}"
                                                               Width="300" Stretch="Uniform" StretchDirection="DownOnly"/>
                                                        <!-- Keterangan di atas kertas pratinjau yang SELALU putih: warnanya
                                                             dipatok abu gelap, bukan token tema — kalau memakai token, di
                                                             tema Gelap/Abu-abu tulisannya nyaris hilang di atas kertas putih. -->
                                                        <TextBlock Text="{Binding KeteranganPratinjau, Mode=OneWay}"
                                                                   FontSize="10" Margin="0,4,0,0"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="#4B5563"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== Kaki dialog ===== -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding RingkasanPilih, Mode=OneWay}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding TeksTombolPilih, Mode=OneWay}" Click="PilihSemua_Click"
                            Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,8,0"
                            ToolTip="Centang atau kosongkan seluruh bagian sekaligus"/>
                    <Button Content="Batal" Click="Batal_Click" Style="{StaticResource SecondaryButton}"
                            Height="34" Width="96" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Content="{Binding TeksTombolBuat, Mode=OneWay}" Click="Buat_Click"
                            Style="{StaticResource PrimaryButton}" Height="34" MinWidth="150"
                            IsEnabled="{Binding BisaBuat, Mode=OneWay}" IsDefault="True"
                            ToolTip="Simpan bagian yang dipilih menjadi template surat"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
