<UserControl x:Class="SuDesApp.Wpf.Views.NtcrInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             FontSize="13"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
              BAR ATAS | Nomor Surat (memanjang penuh)
        -->
        <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Padding="10" Header="Nomor Surat">
            <TextBox Style="{StaticResource FieldBox}"
                     IsEnabled="{Binding NomorSuratEnabled}"
                     Text="{Binding NomorSurat, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Nomor surat (otomatis jika dikelola register)"/>
        </GroupBox>

        <!--
        -->
        <GroupBox Grid.Row="2" Grid.Column="0" Padding="10" Header="Calon Mempelai Pria (Pemohon)">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="NIK *"/>
                <TextBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Name="Nik"
                          LostFocus="OnNikLostFocus"
                          Text="{Binding Nik, UpdateSourceTrigger=PropertyChanged}"
                          MaxLength="16" ToolTip="NIK calon mempelai pria (16 digit angka)"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Nama *"/>
                <TextBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"
                          CharacterCasing="Upper"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tempat Lahir *"/>
                <TextBox  Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding TempatLahir, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tgl. Lahir *"/>
                <TextBox  Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding TanggalLahir, UpdateSourceTrigger=LostFocus}"
                          ToolTip="Format: DD-MM-YYYY"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Jenis Kelamin *"/>
                <ComboBox  Grid.Row="4" Grid.Column="1" Style="{StaticResource DropDown}"
                           ItemsSource="{Binding JenisKelaminOptions}"
                           SelectedItem="{Binding JenisKelamin, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Agama *"/>
                <ComboBox  Grid.Row="5" Grid.Column="1" Style="{StaticResource DropDown}"
                           ItemsSource="{Binding AgamaOptions}"
                           SelectedItem="{Binding Agama, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Status Perkawinan *"/>
                <ComboBox  Grid.Row="6" Grid.Column="1" Style="{StaticResource DropDown}"
                           ItemsSource="{Binding StatusPerkawinanOptions}"
                           SelectedItem="{Binding StatusPerkawinan, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Pekerjaan *"/>
                <TextBox  Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding Pekerjaan, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Dusun/Jalan *"/>
                <TextBox  Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding Dusun, UpdateSourceTrigger=LostFocus}"
                          ToolTip="Alamat (dusun/jalan) calon mempelai pria"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Desa *"/>
                <TextBox  Grid.Row="9" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding Desa, UpdateSourceTrigger=LostFocus}"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Kecamatan *"/>
                <TextBox  Grid.Row="10" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding Kecamatan, UpdateSourceTrigger=LostFocus}"/>

                <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Kabupaten *"/>
                <TextBox  Grid.Row="11" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding Kabupaten, UpdateSourceTrigger=LostFocus}"/>
            </Grid>
        </GroupBox>

        <!--
        -->
        <GroupBox Grid.Row="2" Grid.Column="2" Padding="10" Header="Calon Mempelai Wanita">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="NIK *"/>
                <TextBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Name="NikIstri"
                          LostFocus="OnNikIstriLostFocus"
                          Text="{Binding NikIstri, UpdateSourceTrigger=PropertyChanged}"
                          MaxLength="16" ToolTip="NIK calon mempelai wanita (16 digit angka)"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Nama *"/>
                <TextBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding NamaIstri, UpdateSourceTrigger=PropertyChanged}"
                          CharacterCasing="Upper"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tempat Lahir *"/>
                <TextBox  Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding TempatLahirIstri, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tgl. Lahir *"/>
                <TextBox  Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding TanggalLahirIstri, UpdateSourceTrigger=LostFocus}"
                          ToolTip="Format: DD-MM-YYYY"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Agama *"/>
                <ComboBox  Grid.Row="4" Grid.Column="1" Style="{StaticResource DropDown}"
                           ItemsSource="{Binding AgamaOptions}"
                           SelectedItem="{Binding AgamaIstri, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Pekerjaan *"/>
                <TextBox  Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding PekerjaanIstri, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Alamat *"/>
                <TextBox  Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding AlamatIstri, UpdateSourceTrigger=PropertyChanged}"
                          AcceptsReturn="True" TextWrapping="Wrap" Height="56"
                          ToolTip="Alamat lengkap calon mempelai wanita (dusun, desa, kecamatan, kabupaten)"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Status Kawin *"
                           Visibility="{Binding IsN2, Converter={StaticResource BoolToVis}}"/>
                <ComboBox  Grid.Row="7" Grid.Column="1" Style="{StaticResource DropDown}"
                           ItemsSource="{Binding StatusPerkawinanIstriOptions}"
                           SelectedItem="{Binding StatusPerkawinanIstri, UpdateSourceTrigger=PropertyChanged}"
                           Visibility="{Binding IsN2, Converter={StaticResource BoolToVis}}"
                           ToolTip="Status perkawinan calon mempelai wanita (khusus Surat N2)"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Temuan (jika ada)"
                           Visibility="{Binding IsN2, Converter={StaticResource BoolToVis}}"/>
                <TextBox  Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldBox}"
                          Text="{Binding KeteranganTemuan, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding IsN2, Converter={StaticResource BoolToVis}}"
                          ToolTip="Dasar keterangan bila calon istri janda/duda, mis. Akta Kematian suami No. 123 tahun 2020"/>
            </Grid>
        </GroupBox>

        <!--
        -->
        <GroupBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Padding="10" Header="Nama Orang Tua">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ayah Calon Pria *"/>
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding NamaAyahCalonSuami, UpdateSourceTrigger=PropertyChanged}"
                             CharacterCasing="Upper"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ibu Calon Pria"/>
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding NamaIbuCalonSuami, UpdateSourceTrigger=PropertyChanged}"
                             CharacterCasing="Upper"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ayah Calon Wanita *"/>
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding NamaAyahCalonIstri, UpdateSourceTrigger=PropertyChanged}"
                             CharacterCasing="Upper"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="6">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ibu Calon Wanita"/>
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding NamaIbuCalonIstri, UpdateSourceTrigger=PropertyChanged}"
                             CharacterCasing="Upper"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!--
        -->
        <GroupBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Padding="10" Header="Keterangan">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Khusus N2: kolom Temuan (dasar keterangan janda/duda) -->
                <StackPanel Grid.Row="0" Visibility="{Binding IsN2, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="Temuan (wajib bila calon istri Sudah Kawin)"/>
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding KeteranganTemuan, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Dasar keterangan bila calon istri janda/duda, mis. Akta Kematian suami No. 123 tahun 2020"/>
                </StackPanel>

                <!-- Khusus N3: tujuan surat (kepentingan pendaftaran di KUA/Kemenag) -->
                <StackPanel Grid.Row="1" Visibility="{Binding IsN3, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="Surat ini dibuat untuk keperluan (Tujuan Surat)"/>
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding TujuanSurat, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Keperluan surat persetujuan, mis. pendaftaran keperluan pernikahan di KUA Kecamatan ..."/>
                </StackPanel>

                <TextBox Grid.Row="3" Style="{StaticResource FieldBox}"
                         Text="{Binding Keterangan, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                         ToolTip="Keterangan surat (tambahan, opsional)"/>
            </Grid>
        </GroupBox>

        <!--
        -->
        <GroupBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Padding="10" Header="Pejabat Yang Menandatangani">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Pejabat"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="220" Style="{StaticResource DropDown}"
                          ItemsSource="{Binding PejabatPenandatanganOptions}"
                          SelectedItem="{Binding SelectedPejabat, Mode=TwoWay}"
                          ToolTip="Pejabat penandatangan sesuai kop surat desa"/>
            </StackPanel>
        </GroupBox>

        <!--
        -->
        <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                   FontSize="11" Foreground="#777" Margin="4,0,0,0"
                   Text="Petunjuk: Data calon mempelai pria (pemohon) diisi di form dasar. N2 wajib mengisi Status Kawin calon wanita (bila Sudah Kawin, isi kolom Temuan). N3 wajib mengisi tujuan surat. Nama ayah/ibu wajib untuk N1, N3, dan N4."/>
    </Grid>
</UserControl>