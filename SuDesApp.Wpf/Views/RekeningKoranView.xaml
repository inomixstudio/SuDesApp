<UserControl x:Class="SuDesApp.Wpf.Views.RekeningKoranView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SuDesApp.Wpf.Controls"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontSize="14"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
            >

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20" IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#x1F4B3;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Permohonan Rekening Koran" Style="{StaticResource HeaderTitle}"
                               AutomationProperties.Name="PERMOHONAN REKENING KORAN"/>
                    <TextBlock Text="Surat permohonan cetak rekening koran desa (PDF otomatis)" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form: satu kolom, selalu muat lebar jendela (hanya scroll vertikal) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <c:NomorSuratCard TooltipNomorSurat="Nomor surat permohonan rekening koran — deret sendiri dengan awalan 130"/>

                <!-- DATA KEPALA DESA: penanda tangan surat ini adalah Kepala Desa -->
                <Border Style="{StaticResource FormCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="DATA KEPALA DESA" Style="{StaticResource FormSectionTitle}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama Kepala Desa *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding NamaKades, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Jabatan *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Jabatan, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Alamat dipecah empat komponen seperti kolom alamat di menu
                                 input surat, sehingga hasil cetaknya sama persis. -->
                            <!-- Dusun/Jalan, RT, dan RW dalam satu baris. Label berada DI SAMPING
                                 kotak isian (bukan di atas) sehingga sama dengan baris-baris lain;
                                 RT/RW sengaja sempit karena hanya memuat 3 angka. Deret ini
                                 memakai ColumnSpan="2" agar label pertamanya rata dengan label
                                 baris lain, dan RowSpan 2 agar nomor baris di bawahnya tetap. -->
                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dusun/Jalan *" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource FormField}"
                                             Text="{Binding AlamatDusun, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Alamat asal (jln./dusun)"/>
                                </Grid>

                                <Grid Grid.Column="1" Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="RT" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource FormField}" Width="88" MaxLength="3"
                                             Text="{Binding AlamatRt, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Nomor RT"/>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="RW" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource FormField}" Width="88" MaxLength="3"
                                             Text="{Binding AlamatRw, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Nomor RW"/>
                                </Grid>
                            </Grid>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Desa *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding AlamatDesa, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Kecamatan *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding AlamatKecamatan, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Kabupaten *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding AlamatKabupaten, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- DATA REKENING & PERIODE REKENING: berdampingan kiri-kanan agar
                     lebih ringkas. Keduanya memakai lebar setengah (*) sehingga ikut
                     menyusut saat jendela sempit, dan tetap memakai kolom label bersama
                     (SharedSizeGroup) agar sejajar dengan kartu-kartu lain di atasnya. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                <!-- DATA REKENING -->
                <Border Grid.Column="0" Style="{StaticResource FormCard}" Margin="0,0,6,14">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="DATA REKENING" Style="{StaticResource FormSectionTitle}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama Pemegang Rekening *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding NamaRekening, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Nomor Rekening *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding NomorRekening, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Bank *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding Bank, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="KCP *" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding KCP, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- PERIODE REKENING: kini berdampingan dengan DATA REKENING -->
                <Border Grid.Column="1" Style="{StaticResource FormCard}" Margin="6,0,0,14">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FormSectionHeaderPanel}">
                            <Border Style="{StaticResource AccentSectionBar}"/>
                            <TextBlock Text="PERIODE REKENING" Style="{StaticResource FormSectionTitle}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="170" SharedSizeGroup="FormLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Periode Mulai * (dd-mm-yyyy)" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding TanggalMulai, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tulis periode mulai dengan format dd-mm-yyyy, mis. 17-08-2026"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Periode Akhir * (dd-mm-yyyy)" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}"
                                     Text="{Binding TanggalSelesai, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tulis periode akhir dengan format dd-mm-yyyy, mis. 17-08-2026"/>
                        </Grid>

                    </StackPanel>
                </Border>

                </Grid>

                <!-- Catatan -->
                <Border Style="{StaticResource StatusBadgeStyle}" Background="{DynamicResource AccentSubtleBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" Padding="12,6"
                        HorizontalAlignment="Left" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4C5;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Periode surat otomatis menggunakan tanggal saat PDF dibuat."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Panel bawah: aksi -->
        <Border Grid.Row="2" Style="{StaticResource ToolbarCard}" Margin="0,12,0,0">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Left" Width="140" Height="8" IsIndeterminate="True"
                             VerticalAlignment="Center" Margin="0,0,12,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock DockPanel.Dock="Left" Text="Isi semua kolom bertanda * lalu klik Buat PDF."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Buat PDF" Width="120" Margin="0,0,8,0"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource SuccessButton}"/>
                    <Button Content="Batal" Width="110"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource OutlineButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
