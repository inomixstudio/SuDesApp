<UserControl x:Class="SuDesApp.Wpf.Views.InputSuratHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <DockPanel Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Kop: kartu header seragam (PageHeader) seperti halaman lain.
             Margin sisi 20; konten & panel bawah menyesuaikan agar total 20px. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PageHeader}" Margin="20,20,20,10">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconChip}">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Lengkapi data bertanda * lalu klik Simpan untuk membuat surat."
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Panel bawah: kartu aksi seragam (ToolbarCard) -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource ToolbarCard}" Margin="20,0,20,20">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="Nomor surat otomatis terisi (bisa diedit)."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Batal" Width="110" Height="34" Margin="0,0,8,0"
                            Command="{Binding CancelCommand}" IsCancel="True"
                            Style="{StaticResource OutlineButton}"/>
                    <Button Content="{Binding SaveButtonText}" Width="150" Height="34"
                            Command="{Binding SaveCommand}" IsDefault="True"
                            Style="{StaticResource PrimaryButton}"
                            AutomationProperties.Name="Simpan surat"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Area konten: view input spesifik surat.
             Margin 10 + margin root view input 10 = 20px, seragam dengan halaman lain. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding InputView}" Margin="10,0"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
