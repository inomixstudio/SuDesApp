<Window x:Class="SuDesApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctrl="clr-namespace:SuDesApp.Wpf.Controls"
        xmlns:u="clr-namespace:SuDesApp.Wpf.Utilities"
        xmlns:vm="clr-namespace:SuDesApp.Wpf.ViewModels"
        xmlns:views="clr-namespace:SuDesApp.Wpf.Views"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        Title="SuDesApp"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource WindowBackgroundBrush}"
        MinWidth="900" MinHeight="600">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Template: label section (BUAT SURAT / FORMULIR / PENGATURAN / BANTUAN).
             Bullet aksen di kiri menandai awal seksi; garis tipis memanjang ke
             kanan memberi kesan "kategori" yang lebih modern daripada label polos. -->
        <DataTemplate x:Key="SectionHeaderTemplate">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="6,18,8,8"/>
                        <Style.Triggers>
                            <!-- Mode ciut: label tidak muat; seksi ditandai garis pemisah
                                 pendek di tengah agar tetap terasa terpisah, tidak terpotong. -->
                            <DataTrigger Binding="{Binding DataContext.SidebarCiut, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Margin" Value="0,11,0,4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="5"/>
                            <Setter Property="Height" Value="5"/>
                            <Setter Property="CornerRadius" Value="2.5"/>
                            <Setter Property="Background" Value="{DynamicResource SidebarAccentBrush}"/>
                            <Setter Property="Margin" Value="0,0,8,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.SidebarCiut, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Title}"
                           FontSize="10.5" FontWeight="Bold"
                           Foreground="{DynamicResource SidebarAccentBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.SidebarCiut, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Grid.Column="2">
                    <Border.Style>
<Style TargetType="Border">
                        <Setter Property="Width" Value="34"/>
                        <Setter Property="Height" Value="1"/>
                        <Setter Property="Background" Value="{DynamicResource SidebarAccentBrush}"/>
                        <Setter Property="Opacity" Value="0.25"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="8,0,0,0"/>
                            <Style.Triggers>
                                <!-- Mode ciut: pemisah tipis di tengah sebagai pengganti label -->
                                <DataTrigger Binding="{Binding DataContext.SidebarCiut, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Grid.ColumnSpan" Value="3"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Width" Value="20"/>
                                    <Setter Property="Opacity" Value="0.45"/>
                                    <Setter Property="Margin" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Template: accordion yang memiliki children (accordion/cabang) -->
        <!-- Animasi halus: chevron '❯' berputar 90° (menjadi arah bawah)
             dengan CubicEase saat expand/collapse. Tinggi konten dianimasikan
             dari code-behind (MainWindow.OnAccordionExpanded) karena Expander
             bawaan tidak menganimasikan area kontennya. -->
        <DataTemplate x:Key="AccordionTemplate">
            <Expander Foreground="{DynamicResource SidebarTextBrush}"
                      Background="Transparent"
                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                      Margin="3,1"
                      BorderThickness="0"
                      AutomationProperties.Name="{Binding Title}">
                <!-- Template tanpa panah bawaan: WPF menampilkan toggle arrow default
                     di KIRI header; itu menghasilkan dua tanda bersama chevron kustom
                     di kanan. Template ini hanya header + konten — satu-satunya
                     indikator buka/tutup adalah chevron kanan yang berputar. -->
                <Expander.Template>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <!-- Header: latar pill halus saat hover / saat terbuka.
                                 Triggers IsMouseOver & IsChecked pada ToggleButton
                                 memberi umpan balik visual yang jelas untuk item grup. -->
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          FocusVisualStyle="{x:Null}"
                                          Background="Transparent"
                                          Cursor="Hand"
                                          Click="AccordionHeader_Click"
                                          ctrl:HoverAnimasiSidebar.Aktif="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Margin="0,1">
                                            <Border x:Name="bd" Background="Transparent"
                                                    CornerRadius="7"
                                                    Padding="6,3" SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <!-- Sorotan hover beranimasi (memudar, tidak berkedip) -->
                                            <Border x:Name="HoverOverlay" CornerRadius="7"
                                                    IsHitTestVisible="False"
                                                    Background="{DynamicResource SidebarHoverBrush}" Opacity="0"/>
                                            <Border x:Name="OpenOverlay" CornerRadius="7"
                                                    IsHitTestVisible="False"
                                                    Background="{DynamicResource SidebarPressedBrush}" Opacity="0"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <!-- Sorotan hover tidak lagi memakai EventTrigger: durasinya
                                                 mengikuti kecepatan animasi pilihan pengguna, jadi
                                                 dijalankan oleh HoverAnimasiSidebar (kode). -->
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="OpenOverlay" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}"
                                                  RecognizesAccessKey="True"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Mode ciut (hanya ikon): daftar anak disembunyikan; klik
                                 header akan melebarkan sidebar lagi (lihat kode-behind). -->
                            <DataTrigger Binding="{Binding DataContext.SidebarCiut, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Expander.Template>
                <Expander.Header>
                    <Grid Margin="2,4">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Description}" Value="">
                                        <Setter Property="ToolTip" Value="{x:Null}"/>
                                    </DataTrigger>
                                    <!-- Mode ciut: judul grup tidak terlihat, jadi nama grup
                                         dipindah ke tooltip supaya tetap bisa dikenali. -->
                                    <DataTrigger Binding="{Binding DataContext.SidebarCiut, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="ToolTip" Value="{Binding Title}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Chip ikon: bentuk persegi membulat agar header grup terasa
                             "kartu" dan lebih terstruktur daripada emoji mentah.
                             Ikon mengikuti GroupIcon (default folder). -->
                        <Border x:Name="ChipIcon" Grid.Column="0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="26"/>
                                    <Setter Property="Height" Value="26"/>
                                    <Setter Property="CornerRadius" Value="7"/>
                                    <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <!-- Grup terbuka: chip ikon sedikit lebih tegas supaya
                                             ikon grup tampak "aktif" sebelum daftar anak dibaca. -->
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Background" Value="#2EFFFFFF"/>
                                        </DataTrigger>
                                        <!-- Mode ciut: chip ikon grup dipusatkan di tengah pill -->
                                        <DataTrigger Binding="{Binding DataContext.SidebarCiut, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Grid.ColumnSpan" Value="3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding GroupIcon}" FontSize="13"
                                       FontFamily="{StaticResource AppIconFont}"
                                       Foreground="{DynamicResource SidebarAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="GroupTitle" Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <!-- Mode ciut: chip ikon dipusatkan selebar pill, jadi
                                             judul grup WAJIB disembunyikan — dulu judul tetap
                                             tampil dan bertumpuk dengan ikonnya. -->
                                        <DataTrigger Binding="{Binding DataContext.SidebarCiut, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="ChevronIcon" Grid.Column="2" Text="{x:Static u:IkonMenu.ChevronKanan}" FontFamily="{StaticResource AppIconFont}" FontSize="10"
                                   Foreground="{DynamicResource SidebarAccentBrush}" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="8,0,2,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <!-- Mode ciut: tidak ada daftar anak untuk dibuka,
                                             jadi chevron dihilangkan agar chip ikon tepat di tengah. -->
                                        <DataTrigger Binding="{Binding DataContext.SidebarCiut, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0" CenterX="5" CenterY="6"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Expander.Header>
                <!-- Chevron '❯' berputar 90° serentak dengan tinggi isi yang tumbuh/menyusut;
                     keduanya dijalankan dari kode (MainWindow.AnimasikanAccordion) supaya satu
                     durasi mengikuti kecepatan animasi pilihan pengguna. -->
                <!-- ClipToBounds: tinggi konten dianimasikan dari kode-behind, dan
                     tanpa ini isi bisa "bocor" ke luar selama animasi berjalan. -->
                <StackPanel x:Name="AccordionContent" Margin="12,0,2,2" ClipToBounds="True"
                            Visibility="Collapsed" RenderTransformOrigin="0,0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </StackPanel.RenderTransform>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Garis penghubung vertikal (tree guide): memperjelas bahwa
                             anak-anak berada dalam satu cabang. -->
                        <Border Grid.Column="0" Width="1" HorizontalAlignment="Left"
                                Margin="11,2,0,5"
                                Background="{DynamicResource SidebarAccentBrush}"
                                Opacity="0.25"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Children}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Title}"
                                            Command="{Binding Action}"
                                            Tag="{Binding Icon}"
                                            AutomationProperties.Name="{Binding Title}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarChildButton}">
                                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Description}" Value="">
                                                        <Setter Property="ToolTip" Value="{x:Null}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Expander>
        </DataTemplate>

        <!-- Template: tombol langsung (Surat Masuk, Register Surat, dll.) -->
        <DataTemplate x:Key="ButtonTemplate">                            <Button Content="{Binding Title}"
                    Command="{Binding Action}"
                    Margin="3,1"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    FocusVisualStyle="{x:Null}"
                    AutomationProperties.Name="{Binding Title}"
                    ctrl:HoverAnimasiSidebar.Aktif="True"
                    ctrl:HoverAnimasiSidebar.PillAktif="{Binding IsActive}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="ToolTip" Value="{Binding Description}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Description}" Value="">
                                <Setter Property="ToolTip" Value="{x:Null}"/>
                            </DataTrigger>
                            <!-- Saat sidebar ciut, label hilang sehingga tooltip judul
                                 menjadi satu-satunya penanda item. -->
                            <DataTrigger Binding="{Binding DataContext.SidebarCiut, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="ToolTip" Value="{Binding Title}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="7" Padding="10,8">
                                <Grid x:Name="MainGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Ikon memakai font ikon monokrom: warnanya mengikuti
                                         tema lewat SidebarAccentBrush. -->
                                    <TextBlock x:Name="IconText" Grid.Column="0" Text="{Binding Icon}"
                                               FontFamily="{StaticResource AppIconFont}"
                                               Foreground="{DynamicResource SidebarAccentBrush}" Opacity="0.9"
                                               Margin="0,0,10,0" FontSize="14" Width="18"
                                               TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}"
                                               Foreground="{DynamicResource SidebarTextBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <!-- Chevron halus muncul saat hover: memberi petunjuk
                                         bahwa item dapat diklik dan dinavigasi. -->
                                    <TextBlock x:Name="HoverChevron" Grid.Column="2" Text="{x:Static u:IkonMenu.ChevronKanan}" FontFamily="{StaticResource AppIconFont}" FontSize="9"
                                               Foreground="{DynamicResource SidebarAccentBrush}"
                                               VerticalAlignment="Center" Margin="8,0,2,0"
                                               Opacity="0">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="-4"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <!-- Ikon khusus mode ciut: dipusatkan di tengah pill -->
                                    <TextBlock x:Name="IconCenter" Grid.ColumnSpan="3" Text="{Binding Icon}"
                                               FontFamily="{StaticResource AppIconFont}"
                                               Foreground="{DynamicResource SidebarAccentBrush}"
                                               FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <!-- Sorotan hover/aktif sebagai lapisan beranimasi: perubahan
                                 warna memudar halus, bukan berkedip seketika. -->
                            <Border x:Name="HoverOverlay" CornerRadius="7" IsHitTestVisible="False"
                                    Background="{DynamicResource SidebarHoverBrush}" Opacity="0"/>
                            <Border x:Name="ActiveOverlay" CornerRadius="7" IsHitTestVisible="False"
                                    Background="{DynamicResource SidebarHoverBrush}" Opacity="0"/>
                            <!-- Pill aksen kiri: muncul saat hover/tekan/menjadi halaman aktif -->
                            <Border x:Name="AccentPill" Width="3" HorizontalAlignment="Left"
                                    CornerRadius="1.5" Margin="0,7"
                                    Background="{DynamicResource SidebarAccentBrush}"
                                    Opacity="0"/>
                            <!-- Cincin fokus keyboard: hanya terlihat saat navigasi Tab, memberi
                                 umpan balik yang jelas tanpa mengubah tampilan normal. -->
                            <Border x:Name="FocusBorder" CornerRadius="7" IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource SidebarAccentBrush}"
                                    BorderThickness="1" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Sorotan hover & chevron dijalankan HoverAnimasiSidebar (kode)
                                 dengan durasi sesuai kecepatan animasi pilihan pengguna. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconText" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarPressedBrush}"/>
                            </Trigger>
                            <!-- Halaman yang sedang dibuka: pill aksen menyala (fade halus lewat
                                 HoverAnimasiSidebar.PillAktif agar durasinya ikut kecepatan
                                 animasi pilihan pengguna), latar lebih tegas, dan judulnya
                                 dicetak semi-tebal. -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="ActiveOverlay" Property="Opacity" Value="1"/>
                                <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource SidebarAccentBrush}"/>
                            </DataTrigger>
                            <!-- Mode ciut: sembunyikan label & chevron, pusatkan ikon -->
                            <DataTrigger Binding="{Binding DataContext.SidebarCiut, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="HoverChevron" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="IconText" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="IconCenter" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="bd" Property="Padding" Value="0,8"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Selector: pilih template sesuai jenis item -->
        <views:SidebarItemTemplateSelector x:Key="SidebarSelector"
                                           SectionHeaderTemplate="{StaticResource SectionHeaderTemplate}"
                                           AccordionTemplate="{StaticResource AccordionTemplate}"
                                           ButtonTemplate="{StaticResource ButtonTemplate}"/>
    </Window.Resources>

    <Grid x:Name="LayoutGrid" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="60" MaxWidth="320"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Title bar bertema (baris layout sendiri — konten tidak tertutup) ===== -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="CaptionBorder_MouseLeftButtonDown">
            <DockPanel LastChildFill="False">
                <!-- Ikon di bilah judul diwarnai mengikuti tema (siluet dari berkas
                     ikon asli) supaya tidak lagi hijau tetap di tema lain. -->
                <Border DockPanel.Dock="Left" Width="15" Height="15" Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SidebarAccentBrush}"
                        CornerRadius="4">
                    <Border.OpacityMask>
                        <ImageBrush ImageSource="pack://application:,,,/Resources/AppIcon-256.png"
                                    Stretch="Uniform"/>
                    </Border.OpacityMask>
                </Border>
                <TextBlock DockPanel.Dock="Left" Text="SuDesApp" Style="{StaticResource WindowTitleText}"
                           FontWeight="SemiBold"/>
                <!-- Nama halaman yang sedang dibuka (mis. SuDesApp — Beranda) -->
                <TextBlock DockPanel.Dock="Left" Text="—" Style="{StaticResource WindowTitleText}"
                           Opacity="0.45" Margin="2,0,2,0"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding HalamanAktif}"
                           Style="{StaticResource WindowTitleText}"
                           Foreground="{DynamicResource SidebarAccentBrush}" FontWeight="SemiBold"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}"
                        Command="{x:Static ctrl:AppChromeCommands.Close}"
                        ToolTip="Tutup (Alt+F4)">
                    <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"/>
                </Button>
                <Button DockPanel.Dock="Right"
                        Command="{x:Static ctrl:AppChromeCommands.MaximizeRestore}"
                        ToolTip="Maksimalkan / Pulihkan">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <Rectangle Width="9" Height="9" StrokeThickness="1"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(ctrl:ChromeWindowBehavior.IsMaximized), RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Grid Width="10" Height="10">
                                                <Rectangle Width="7" Height="7" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <Rectangle Width="7" Height="7" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Grid>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}"
                        Command="{x:Static ctrl:AppChromeCommands.Minimize}"
                        ToolTip="Minimalkan">
                    <Rectangle Width="9" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </DockPanel>
        </Border>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" x:Name="SidebarBorder">
            <DockPanel>
<!-- Header aplikasi: logo dalam "kartu" transparan berlapis + strip
                      aksen tipis di dasar header sebagai penanda brand yang halus. -->
                 <Border x:Name="HeaderBorder" DockPanel.Dock="Top" SnapsToDevicePixels="True">
                     <Border.Background>
                         <!-- Latar gradien Primary → Secondary: memberi kedalaman visual
                              pada header tanpa mengubah warna tema (keduanya dari palet). -->
                         <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                             <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0"/>
                             <GradientStop Color="{DynamicResource SecondaryColor}" Offset="1"/>
                         </LinearGradientBrush>
                     </Border.Background>
                     <Border.Style>
                         <!-- Tinggi awal (mode terbuka) 66 px. Saat mode ikon-saja diubah
                              ke 108 dari kode-behind agar logo terpusat di atas dan tombol
                              di dasar tidak bertumpukan — keduanya beranimasi satu tempo
                              dengan lebar sidebar, jadi tidak melompat. -->
                         <Style TargetType="Border">
                             <Setter Property="Height" Value="66"/>
                         </Style>
                     </Border.Style>
                     <Grid>
                         <!-- Sheen diagonal halus: kesan "glass" yang menyala di sisi kiri atas,
                              kembali ke proporsi visual yang tenang di sisi kanan bawah. -->
                         <Border IsHitTestVisible="False" Opacity="0.5">
                             <Border.Background>
                                 <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                     <GradientStop Color="#38FFFFFF" Offset="0"/>
                                     <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                                 </LinearGradientBrush>
                             </Border.Background>
                         </Border>
                         <!-- Isi header satu baris ringkas: logo + nama dua baris di kiri (sejajar
                              dengan item navigasi) dan tombol buka/tutup di kanan.
                              Saat mode ikon-saja semuanya menyusun ulang: nama hilang,
                              logo terpusat di atas, tombol di dasar — tetap muat 64 px. -->
                         <Grid>
                             <!-- Blok brand: logo + nama aplikasi berdampingan. -->
                             <StackPanel x:Name="HeaderBrandBlock" Orientation="Horizontal">
                                 <StackPanel.Style>
                                     <Style TargetType="StackPanel">
                                         <Setter Property="HorizontalAlignment" Value="Left"/>
                                         <Setter Property="VerticalAlignment" Value="Center"/>
                                         <Setter Property="Margin" Value="14,0,0,0"/>
                                         <Style.Triggers>
                                             <DataTrigger Binding="{Binding SidebarCiut}" Value="True">
                                                 <Setter Property="HorizontalAlignment" Value="Center"/>
                                                 <Setter Property="VerticalAlignment" Value="Top"/>
                                                 <Setter Property="Margin" Value="0,14,0,0"/>
                                             </DataTrigger>
                                         </Style.Triggers>
                                     </Style>
                                 </StackPanel.Style>
                                 <Grid Width="44" Height="44" VerticalAlignment="Center">
                                     <!-- Cincin aksen mengikuti tema di balik logo. -->
                                     <Border Width="44" Height="44" CornerRadius="22"
                                             BorderBrush="{DynamicResource SidebarAccentBrush}"
                                             BorderThickness="1.5" Opacity="0.30"/>
                                     <Border x:Name="LogoKartuLuar" Width="38" Height="38"
                                             CornerRadius="11" Background="#12FFFFFF"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                         <Border x:Name="LogoKartuDalam" Width="32" Height="32"
                                                 CornerRadius="9" Background="#20FFFFFF"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                             <Image Source="Resources/AppIcon-256.png" Stretch="Uniform"
                                                    Margin="1" RenderOptions.BitmapScalingMode="HighQuality"/>
                                         </Border>
                                     </Border>
                                 </Grid>
                                 <!-- Nama aplikasi: memudar (diatur kode-behind) dan hilang
                                      penuh dari layout saat mode ikon-saja. -->
                                 <StackPanel x:Name="HeaderBrandText" Margin="10,0,0,0"
                                             VerticalAlignment="Center">
                                     <TextBlock Text="SuDesApp" Foreground="{DynamicResource HeaderTextBrush}"
                                                FontSize="18" FontWeight="Bold"
                                                TextTrimming="CharacterEllipsis"/>
                                     <TextBlock Text="Sistem Surat Desa" Foreground="{DynamicResource HeaderSubtitleBrush}"
                                                FontSize="11" Margin="0,2,0,0"
                                                TextTrimming="CharacterEllipsis"/>
                                     <StackPanel.Style>
                                         <Style TargetType="StackPanel">
                                             <Style.Triggers>
                                                 <DataTrigger Binding="{Binding SidebarCiut}" Value="True">
                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                 </DataTrigger>
                                             </Style.Triggers>
                                         </Style>
                                     </StackPanel.Style>
                                 </StackPanel>
                             </StackPanel>

                             <!-- Tombol buka/tutup: di kanan saat terbuka, pindah ke
                                  dasar-tengah saat ikon-saja (diposisikan ulang lewat
                                  trigger agar selalu muat di lebar 64 px). -->
                             <Button x:Name="SidebarToggleButton"
                                     ToolTip="Sembunyikan sidebar navigasi"
                                     Click="SidebarToggle_Click">
                                 <Button.Style>
                                     <!-- Tombol berbentuk pil halus: latar memudar dari transparan
                                          saat hover/tekan (lebih modern daripada IconButton bawaan
                                          yang memakai PanelBrush kontras tinggi di header gelap). -->
                                     <Style TargetType="Button">
                                         <Setter Property="Cursor" Value="Hand"/>
                                         <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                         <Setter Property="HorizontalAlignment" Value="Right"/>
                                         <Setter Property="VerticalAlignment" Value="Center"/>
                                         <Setter Property="Margin" Value="0,0,12,0"/>
                                         <Setter Property="Template">
                                             <Setter.Value>
                                                 <ControlTemplate TargetType="Button">
                                                     <Border x:Name="bd" Background="Transparent"
                                                             CornerRadius="11" Padding="9,5">
                                                         <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>
                                                     <ControlTemplate.Triggers>
                                                         <Trigger Property="IsMouseOver" Value="True">
                                                             <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                                         </Trigger>
                                                         <Trigger Property="IsPressed" Value="True">
                                                             <Setter TargetName="bd" Property="Background" Value="#3AFFFFFF"/>
                                                         </Trigger>
                                                     </ControlTemplate.Triggers>
                                                 </ControlTemplate>
                                             </Setter.Value>
                                         </Setter>
                                         <Style.Triggers>
                                             <DataTrigger Binding="{Binding SidebarCiut}" Value="True">
                                                 <Setter Property="HorizontalAlignment" Value="Center"/>
                                                 <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                 <Setter Property="Margin" Value="0,0,0,10"/>
                                             </DataTrigger>
                                         </Style.Triggers>
                                     </Style>
                                 </Button.Style>
                                 <TextBlock x:Name="SidebarToggleIcon" Text="{x:Static u:IkonMenu.GeserSidebar}" FontFamily="{StaticResource AppIconFont}"
                                            FontSize="11" Foreground="{DynamicResource HeaderTextBrush}"
                                            RenderTransformOrigin="0.5,0.5">
                                     <TextBlock.RenderTransform>
                                         <RotateTransform x:Name="SidebarToggleRotate" Angle="0"/>
                                     </TextBlock.RenderTransform>
                                 </TextBlock>
                             </Button>
                         </Grid>
                         <Border Height="2" Background="{DynamicResource AccentBrush}"
                                 Opacity="0.85" VerticalAlignment="Bottom"/>
                     </Grid>
                 </Border>

                <!-- Menu navigasi -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" Padding="0,6">
                    <ItemsControl ItemsSource="{Binding MenuItems}"
                                  ItemTemplateSelector="{StaticResource SidebarSelector}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Margin" Value="10,0"/>
                                <Style.Triggers>
                                    <!-- Mode ciut: margin dikecilkan agar pill selebar sidebar -->
                                    <DataTrigger Binding="{Binding SidebarCiut}" Value="True">
                                        <Setter Property="Margin" Value="6,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,1"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Content host utama ===== -->
        <Grid Grid.Row="1" Grid.Column="2">
            <ContentControl x:Name="MainContent"
                            Content="{Binding CurrentView, Mode=OneWay}"
                            Focusable="True"/>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,0">
                <!-- Chip indikator pembaruan otomatis saat ditutup — tersembunyi
                     kecuali saat proses pembaruan latar sedang berjalan -->
                <Border x:Name="AutoUpdateChip"
                        DockPanel.Dock="Right" Margin="0,0,8,0"
                        Background="{DynamicResource AccentSubtleBrush}"
                        CornerRadius="9" Padding="9,2" VerticalAlignment="Center"
                        Visibility="Collapsed"
                        ToolTip="Aplikasi sedang menyiapkan pembaruan kecil; berkas akan diganti setelah aplikasi tertutup.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AutoUpdateSpin" Text="{x:Static u:IkonMenu.Sinkron}" FontFamily="{StaticResource AppIconFont}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,5,0">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="AutoUpdateChipText" Text="Memeriksa pembaruan…" FontSize="10.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <!-- Ikon lonceng notifikasi (kanan) — ala Visual Studio -->
                <Border x:Name="NotificationBell"
                        DockPanel.Dock="Right" Margin="8,0,0,0"
                        Background="Transparent" CornerRadius="4" Padding="6,3"
                        Cursor="Hand" MouseLeftButtonUp="NotificationBell_Click"
                        ToolTip="Notifikasi">
                    <Grid>
                        <!-- Lonceng memakai font ikon (bukan emoji berwarna) supaya
                             warnanya ikut tema seperti ikon sidebar; pivot di bawah ikon
                             agar animasi berayun terasa seperti lonceng menggantung -->
                        <TextBlock x:Name="NotificationBellIcon" Text="{x:Static u:IkonMenu.Lonceng}"
                                   FontFamily="{StaticResource AppIconFont}" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource StatusBarTextBrush}"
                                   RenderTransformOrigin="0.5,0.85">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <!-- Badge angka (tersembunyi bila tidak ada notifikasi belum dibaca) -->
                        <Border Background="{DynamicResource ErrorBrush}" CornerRadius="7"
                                MinWidth="14" Height="14" Padding="3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-3,-4,0"
                                Visibility="{Binding Notifications.HasUnread, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Notifications.UnreadCountText}"
                                       FontSize="9" FontWeight="Bold" Foreground="{DynamicResource OnErrorTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Chip status gateway WhatsApp (kanan, bisa diklik → Pengaturan) -->
                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSubtleBrush}"
                        CornerRadius="9" Padding="9,2" VerticalAlignment="Center"
                        Cursor="Hand"
                        ToolTip="{Binding WaGatewayStatusTooltip}">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding WaChipClickCommand}"/>
                    </Border.InputBindings>
                    <TextBlock Text="{Binding WaGatewayStatus}"
                               FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WaGatewayStatus}" Value="WA: Token belum diisi">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding WaGatewayStatus}" Value="WA: Terhubung (Cloud API)">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                </Border>

                <!-- Chip kesehatan mode tautan Google Sheet (kanan, bisa diklik → Pengaturan) -->
                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSubtleBrush}"
                        CornerRadius="9" Padding="9,2" VerticalAlignment="Center"
                        Cursor="Hand"
                        ToolTip="{Binding WaSheetStatusTooltip}"
                        Visibility="{Binding WaSheetChipVisible, Converter={StaticResource BoolToVis}}">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding SheetChipClickCommand}"/>
                    </Border.InputBindings>
                    <TextBlock Text="{Binding WaSheetStatus}"
                               FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WaSheetStatus}" Value="Sheet: Siap">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WaSheetStatus}" Value="Sheet: Memeriksa…">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WaSheetStatus}" Value="Sheet: URL belum diisi">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WaSheetStatus}" Value="Sheet: Google belum terhubung">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WaSheetStatus}" Value="Sheet: Login belum dikonfigurasi">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WaSheetStatus}" Value="Sheet: API belum aktif">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WaSheetStatus}" Value="Sheet: Tidak terhubung">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Chip resolusi layar (kanan) — diisi ScreenResolutionService -->
                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSubtleBrush}"
                        CornerRadius="9" Padding="9,2" VerticalAlignment="Center"
                        ToolTip="Resolusi &amp; skala layar terdeteksi">
                    <TextBlock Text="{Binding ScreenInfo}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10.5" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding VillageInfo}"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Toast notifikasi kritis (Warning/Error): muncul sebentar di pojok kanan
             bawah di atas status bar supaya gagal penting tidak terlewat. Klik = buka flyout. -->
        <Border x:Name="NotificationToast" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,14,44" MaxWidth="390" CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                Padding="12,9" Cursor="Hand" Visibility="Collapsed"
                MouseLeftButtonUp="NotificationToast_Click"
                ToolTip="Klik untuk membuka daftar notifikasi">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" Text="⚠" FontWeight="Bold" Margin="0,0,8,0"
                               Foreground="{DynamicResource WarningTextBrush}"/>
                    <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               MaxWidth="300" Foreground="{DynamicResource TextBrush}"/>
                    <Button Content="✕" Width="22" Height="22" Margin="8,0,0,0" Padding="0"
                            Click="NotificationToastClose_Click" ToolTip="Tutup"
                            Style="{StaticResource IconButton}"/>
                </StackPanel>
                <TextBlock x:Name="ToastMessage" FontSize="11.5" Margin="0,4,0,0"
                           TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Popup daftar notifikasi (flyout lonceng, ala Visual Studio) -->
        <Popup x:Name="NotificationFlyout" PlacementTarget="{Binding ElementName=NotificationBell}"
               Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Closed="NotificationFlyout_Closed">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Width="360">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header popup -->
                    <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="8,8,0,0" Padding="12,8">
                        <Grid>
                            <TextBlock Text="NOTIFIKASI" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource HeaderTextBrush}"/>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Hyperlink Foreground="{DynamicResource HeaderSubtitleBrush}"
                                           Click="NotificationClear_Click">
                                    <Run Text="Bersihkan" FontSize="11"/>
                                </Hyperlink>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Daftar notifikasi (terbaru di atas). ListBox + VirtualizingStackPanel:
                         hanya baris terlihat yang dirender — tetap ringan walau isinya banyak.
                         Teks pesan dirender multi-line (tanpa scroll di dalam teks). -->
                    <ListBox x:Name="NotificationList" Grid.Row="1" ItemsSource="{Binding Notifications.Items}"
                             MaxHeight="360" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="NotificationList_SelectionChanged">
                        <!-- Baris polos: tanpa sorotan biru bawaan, hover halus saja.
                             Klik baris = pilih (SelectionChanged → navigasi tujuan). -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource BorderBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BisaDiklik}" Value="True">
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Ikon berwarna sesuai jenis notifikasi -->
                                                <TextBlock Text="{Binding Icon}" FontWeight="Bold" Margin="0,0,6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Success">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Error">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Info">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <!-- Titik belum dibaca (hilang setelah flyout ditutup) -->
                                                <Ellipse Width="7" Height="7" Margin="6,0,0,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource PrimaryBrush}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </StackPanel>
                                            <!-- Multi-line: tiap baris pesan jadi satu TextBlock -->
                                            <ItemsControl ItemsSource="{Binding MessageLines}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="11.5"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding TimeDisplay}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="✕" Width="22" Height="22" Padding="0"
                                                VerticalAlignment="Top" Margin="6,0,0,0"
                                                Click="NotificationItemDelete_Click"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Hapus notifikasi ini"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <TextBlock Grid.Row="1" Text="Tidak ada notifikasi"
                               HorizontalAlignment="Center" Margin="0,30"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notifications.Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>