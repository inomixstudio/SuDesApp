<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pembuat & pemeriksa berkas data wilayah pada folder Data/Wilayah.
    Data wilayah administratif Indonesia (provinsi → kabupaten/kota → kecamatan
    → desa/kelurahan + kode pos) dibundel aplikasi supaya kantor desa bisa
    memilih wilayah tanpa internet; alat ini yang mengubah dump SQL sumber
    menjadi satu berkas TSV terkompresi.

    Cara pakai (dotnet run dengan proyek ini):
      tanpa argumen  unduh sumber (bila belum ada) lalu tulis Data/Wilayah/wilayah.tsv.gz
      argumen "cek"  periksa berkas terbundel: struktur, jumlah, dan kesamaan
                     dengan sumber bila sumbernya tersedia (dipakai check-rilis)

    Proyek ini sengaja TIDAK dimasukkan ke SuDesApp.slnx: tidak ikut build gate
    dan tidak pernah masuk paket rilis; hanya dipanggil saat data wilayah
    berubah dan oleh Tools/check-rilis.ps1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
