{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Konfigurasi aplikasi memakai section yang sama dengan appsettings.json
  // milik WPF. Nilai databaseConnectionString ditimpa di appsettings.Development.json
  // supaya backend ini membaca berkas desa.db YANG SAMA dengan aplikasi desktop.
  "AppConfig": {
    "databaseConnectionString": "Data Source=desa.db",
    "templateFolder": "Templates",
    "tempPdfFolder": "TempPDF",
    "pdfOutputPath": "Output/PDF",
    "fontFolder": "Resources/Fonts",
    "logoPath": "Resources/logo.png",
    "updateCheckUrl": null,
    "githubRepo": "inomixstudio/SuDesApp",
    "githubPersonalAccessToken": null
  }
}
