<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SuDesApp</RootNamespace>
    <AssemblyName>SuDesApp.Core</AssemblyName>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <!-- TreatWarningsAsErrors untuk mencegah kode mati; CS86xx nullability
         sudah diperketat untuk Core (hanya CS8618 non-nullable field tersisa
         sebagai jembatan migrasinya, lihat roadmap nullable). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS8618;CS0108;CS0618;CS0168</WarningsNotAsErrors>
  </PropertyGroup>


  <ItemGroup>
    <!-- Folder artifacts menyimpan keluaran build/verifikasi. Karena berada di dalam proyek,
         file C# generated di sana harus dikecualikan dari kompilasi source. -->
    <Compile Remove="artifacts\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dapat diuji dari SuDesApp.Tests tanpa harus membuka API internal ke
         publik. Diperlukan untuk menguji aturan yang tidak boleh bocor lewat
         pintu lain, mis. ApiAutentikasi.CariCocok. HARUS berbentuk ItemGroup:
         sebagai <PropertyGroup>, properti ini diabaikan
         MSBuild tanpa peringatan sehingga attribute tidak ter-generate dan
         test gagal dengan CS0117. -->
    <InternalsVisibleTo Include="SuDesApp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pembuatan PDF seluruh surat, laporan, dan register dikerjakan mesin
         SudesPdf.Core milik aplikasi sendiri: tanpa QuestPDF, PDFium, atau
         pustaka PDF pihak ketiga lainnya, dan tanpa berkas font yang
         disematkan ke berkas keluaran. -->
    <ProjectReference Include="..\SudesPdf.Core\SudesPdf.Core.csproj" />
    <!-- Penulis/pembaca Excel (.xlsx) milik aplikasi sendiri, pengganti EPPlus:
         tanpa paket pihak ketiga dan tanpa permintaan lisensi komersial. -->
    <ProjectReference Include="..\SudesExPlus\SudesExPlus.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <!-- Koneksi Supabase (sinkronisasi surat Android). Role yang dipakai sama
         dengan server lisensi; RLS tetap berlaku untuk role non-pemilik. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.78.0.4313" />
    <!-- Provider SQLite MILIK SENDIRI: Microsoft.Data.Sqlite.Core + bundle
         e_sqlcipher. Database desa baru tetap SQLite biasa (SQLCipher hanya
         mengaktifkan enkripsi bila Password diisi), tetapi bundle ini membuat
         database terenkripsi dari versi lama tetap bisa dibuka setelah update.
         Paket "Microsoft.Data.Sqlite" biasa menarik bundle_e_sqlite3 dan tidak
         bisa membuka database SQLCipher, jadi jangan diganti kembali. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- QR untuk kaki surat (QrCodeSurat) -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <!-- DPAPI utk kredensial klien OAuth Google (GoogleClientCredentials) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gambar Garuda Pancasila ditanam (embedded) di assembly: dipakai kepala
         naskah SK sesuai format naskah dinas (Perbup 74/2020) tanpa bergantung
         pada berkas di folder instalasi. -->
    <EmbeddedResource Include="Resources\GarudaPancasila.png" />
    <None Remove="Resources\GarudaPancasila.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skema formulir yang dibagikan desktop -> Android. Ikut terpasang di
         folder keluaran (dibaca SkemaFormulir.Muat) dan diterbitkan desktop ke
         tabel skema_formulir di Supabase untuk dibaca Android. -->
    <None Include="Configuration\SkemaFormulir.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- (Dulu: NonClosingStreamWrapper/DapperExtensions/DatabaseMigrator yang
         dikecualikan compile; ketiganya sudah dihapus — entri Remove dibersihkan.) -->
  </ItemGroup>

  <!-- Kredensial OAuth Google tertanam: nilai asli hidup DI LUAR git di
       Utilities/GoogleClientCredentialsBawaan.lokal.cs (terdaftar di .gitignore;
       ikut compile otomatis lewat globbing SDK). Saat berkas lokal ada, simbol
       GOOGLE_KREDENSIAL_LOKAL membuat placeholder di GoogleClientCredentialsBawaan.cs
       menjadi kosong — source yang ter-commit tidak pernah memuat rahasia. -->
  <PropertyGroup Condition="Exists('Utilities\GoogleClientCredentialsBawaan.lokal.cs') And '$(Configuration)'!='Release'">
    <DefineConstants>$(DefineConstants);GOOGLE_KREDENSIAL_LOKAL</DefineConstants>
  </PropertyGroup>

  <!-- Berkas lokal TIDAK PERNAH ikut build Release: secret OAuth dilarang
       tertanam di assembly rilis. Build rilis wajib memakai kredensial dari
       penyimpanan DPAPI perangkat atau diisi teknisi lewat Pengaturan. Build
       Debug lokal tetap boleh memakai berkas lokal untuk pengembangan. -->
  <ItemGroup Condition="'$(Configuration)'=='Release'">
    <Compile Remove="**\*.lokal.cs" />
  </ItemGroup>

</Project>
