<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SuDesApp</RootNamespace>
    <AssemblyName>SuDesApp.Core</AssemblyName>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <!-- TreatWarningsAsErrors untuk mencegah kode mati; nullability + legacy warnings tetap warning -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8625;CS8629;CS0108;CS0618;CS0168</WarningsNotAsErrors>
  </PropertyGroup>


  <ItemGroup>
    <!-- Folder artifacts menyimpan keluaran build/verifikasi. Karena berada di dalam proyek,
         file C# generated di sana harus dikecualikan dari kompilasi source. -->
    <Compile Remove="artifacts\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dapat diuji dari SuDesApp.Tests tanpa harus membuka API internal ke
         publik. Diperlukan untuk menguji aturan yang tidak boleh bocor lewat
         pintu lain, mis. ApiAutentikasi.CariCocok. HARUS berbentuk ItemGroup:
         sebagai <PropertyGroup>, properti ini diabaikan
         MSBuild tanpa peringatan sehingga attribute tidak ter-generate dan
         test gagal dengan CS0117. -->
    <InternalsVisibleTo Include="SuDesApp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pembuatan PDF seluruh surat, laporan, dan register dikerjakan mesin
         SudesPdf.Core milik aplikasi sendiri: tanpa QuestPDF, PDFium, atau
         pustaka PDF pihak ketiga lainnya, dan tanpa berkas font yang
         disematkan ke berkas keluaran. -->
    <ProjectReference Include="..\SudesPdf.Core\SudesPdf.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="EPPlus" Version="8.7.2" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.77.0.4301" />
    <!-- Provider SQLite bawaan Microsoft.Data (bundle_e_sqlite3). Database desa
         disimpan sebagai SQLite biasa tanpa enkripsi dan tanpa berkas kunci,
         jadi tidak ada bundel SQLCipher yang perlu dikelola. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- QR untuk kaki surat (QrCodeSurat) -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <!-- DPAPI utk kredensial klien OAuth Google (GoogleClientCredentials) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gambar Garuda Pancasila ditanam (embedded) di assembly: dipakai kepala
         naskah SK sesuai format naskah dinas (Perbup 74/2020) tanpa bergantung
         pada berkas di folder instalasi. -->
    <EmbeddedResource Include="Resources\GarudaPancasila.png" />
    <None Remove="Resources\GarudaPancasila.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- File yang sengaja dikecualikan (sama seperti proyek utama) -->
    <Compile Remove="GeneratorPdf\NonClosingStreamWrapper.cs" />
    <Compile Remove="Configuration\DapperExtensions.cs" />
    <Compile Remove="db\DatabaseMigrator.cs" />
  </ItemGroup>

  <!-- Kredensial OAuth Google tertanam: nilai asli hidup DI LUAR git di
       Utilities/GoogleClientCredentialsBawaan.lokal.cs (terdaftar di .gitignore;
       ikut compile otomatis lewat globbing SDK). Saat berkas lokal ada, simbol
       GOOGLE_KREDENSIAL_LOKAL membuat placeholder di GoogleClientCredentialsBawaan.cs
       menjadi kosong — source yang ter-commit tidak pernah memuat rahasia. -->
  <PropertyGroup Condition="Exists('Utilities\GoogleClientCredentialsBawaan.lokal.cs')">
    <DefineConstants>$(DefineConstants);GOOGLE_KREDENSIAL_LOKAL</DefineConstants>
  </PropertyGroup>

</Project>
