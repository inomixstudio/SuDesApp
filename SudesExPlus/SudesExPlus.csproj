<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SudesExPlus</RootNamespace>
    <AssemblyName>SudesExPlus</AssemblyName>
    <!--
      SudesExPlus adalah pustaka Excel (.xlsx) milik aplikasi sendiri:
      pengganti EPPlus tanpa paket pihak ketiga dan tanpa permintaan lisensi
      komersial. Yang diimplementasikan hanya bagian yang dipakai SuDesApp —
      tulis dan baca workbook, gaya sel (font, isian, garis, perataan, bungkus
      teks, format angka), gabung sel, lebar kolom, tinggi baris, bekukan panel,
      dan rumus sel — tetapi berkas yang dihasilkan tetap .xlsx standar (OOXML)
      sehingga bisa dibuka Excel, LibreOffice, dan WPS. Pembaca mempertahankan
      seluruh atribut itu (termasuk warna tema+tint dan rumus bersama) supaya
      berkas pihak lain bisa dibuka lalu disimpan ulang tanpa kehilangan format.
    -->
  </PropertyGroup>
</Project>
