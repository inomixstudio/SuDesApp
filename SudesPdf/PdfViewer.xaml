<UserControl x:Class="SudesPdf.PdfViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button x:Name="ZoomOutButton" Content="−" Width="34" Margin="2" Click="ZoomOut_Click" />
            <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" MinWidth="54" TextAlignment="Center" />
            <Button x:Name="ZoomInButton" Content="+" Width="34" Margin="2" Click="ZoomIn_Click" />
            <Button Content="Sesuaikan lebar" Margin="8,2,2,2" Click="FitWidth_Click" />
            <Button Content="Cetak" Margin="8,2,2,2" Click="Print_Click" />
        </StackPanel>
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Pages" Margin="16" />
        </ScrollViewer>
    </Grid>
</UserControl>
